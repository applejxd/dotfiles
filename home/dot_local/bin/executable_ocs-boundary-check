#!/bin/sh
# 境界の実在を「挙動」で確かめる。`ocs --check` が境界の内側で 1 回走らせる。
#
# ★値を根拠にしない。エラーコード単独でも判定しない。判別できなければ不合格。
# 終了コード 0 = 合格 / 1 = 不合格
# see docs/spec/opencode-sandbox.md#境界チェック
#
# ★失敗は fail に集計して最後に返す。set -e で途中終了させてよいのは
#   検査と無関係な後始末だけなので、それらには `|| :` を付ける。
set -eu
# 作業領域の PATH にある偽の curl などで合格を装わせない。/usr は内側でも読み取り専用。
# BOUNDARY_CURL は試験用。ランチャーは必ず外して渡す
PATH=/usr/bin:/bin
export PATH
CURL="${BOUNDARY_CURL:-/usr/bin/curl}"

WS="${BOUNDARY_WORKSPACE:?BOUNDARY_WORKSPACE が未設定}"
DATA="${BOUNDARY_DATA_DIR:?BOUNDARY_DATA_DIR が未設定}"
# パスの列は改行区切り (空白・glob 文字を含むパスを壊さない)。ランチャーが組む。
HIDDEN="${BOUNDARY_HIDDEN?BOUNDARY_HIDDEN が未設定}"
HIDDEN_ABSENT="${BOUNDARY_HIDDEN_ABSENT:-}"
PROTECTED="${BOUNDARY_PROTECTED?BOUNDARY_PROTECTED が未設定}"
nl='
'
fail=0
ok()   { printf '  OK   %s\n' "$1"; }
bad()  { printf '  ★NG  %s\n' "$1"; fail=1; }
skip() { printf '  SKIP %s\n' "$1"; }

# 「読めない」を合格とする確認。BOUNDARY_HIDDEN はランチャーが境界の外で
# ホストに在ると確かめたものだけ。
# ★在るかではなく読めるかで見る。WSL の /mnt/c は Landlock で読めなくても stat は通る。
#   隠した結果の空の tmpfs と /dev/null は「読めない」に数える。中身は読まない。
hidden() { # $1=パス
  if [ -d "$1" ]; then
    if [ -n "$(find "$1" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
      bad "$1 の中が見えている"
    else
      ok "$1 は読めない"
    fi
  elif [ -f "$1" ] && ( : < "$1" ) 2>/dev/null; then
    bad "$1 を開ける"
  else
    ok "$1 は読めない"
  fi
}

# --- 1. ホストの秘密 / 常駐サービスの接続情報 / Windows 側 (WSL) ---
IFS=$nl
set -f
for p in $HIDDEN; do hidden "$p"; done
for p in $HIDDEN_ABSENT; do skip "$p はホストに無いので検査しない"; done
unset IFS
set +f

# --- 2. 作業領域と OpenCode のデータディレクトリへ書ける ---
for d in "$WS" "$DATA"; do
  probe="$d/.boundary-probe.$$"
  if ( : > "$probe" ) 2>/dev/null; then
    rm -f "$probe" || :; ok "$d へ書ける"
  else
    bad "$d へ書けない"
  fi
done

# --- 3. 保護対象を変更できないこと ---
IFS=$nl
set -f
for p in $PROTECTED; do
  if [ -d "$p" ]; then
    probe="$p/.boundary-protected.$$"
    if ( : > "$probe" ) 2>/dev/null; then
      rm -f "$probe" 2>/dev/null || :
      bad "保護対象へ書けてしまう: $p"
    else
      ok "保護対象へ書けない: $p"
    fi
  elif [ -e "$p" ]; then
    # ★通常ファイルは追記で開けるかを見る。mkdir の失敗を合格と読むと、
    #   書けるのに合格する。`>>` なので中身は変えない (`>` は切り詰める)。
    if ( : >> "$p" ) 2>/dev/null; then
      bad "保護対象へ書けてしまう: $p"
    else
      ok "保護対象へ書けない: $p"
    fi
  elif mkdir -p "$p" 2>/dev/null; then
    rmdir "$p" 2>/dev/null || :
    bad "保護対象を作れてしまう: $p"
  else
    ok "保護対象を作れない: $p"
  fi
done
unset IFS
set +f

# --- 4. 許可外ドメインへ出られないこと ---
# ★許可済みドメインが通ることを対照に使い、「ネットワーク自体が死んでいるだけ」を
#   合格にしない。プロキシの待ち受けが遅れることがあるので対照は数回試す。
if [ -x "$CURL" ]; then
  control=no
  i=0
  while [ "$i" -lt 15 ]; do
    if "$CURL" -s -m 10 -o /dev/null "https://${BOUNDARY_ALLOWED_HOST:-github.com}" 2>/dev/null; then
      control=yes
      break
    fi
    i=$((i + 1))
    sleep 2
  done
  if [ "$control" != yes ]; then
    bad "許可済みドメイン (${BOUNDARY_ALLOWED_HOST:-github.com}) へ到達できず、拒否か不通かを判別できない"
  elif "$CURL" -s -m 10 -o /dev/null "https://${BOUNDARY_DENIED_HOST:-example.com}" 2>/dev/null; then
    bad "許可外ドメイン (${BOUNDARY_DENIED_HOST:-example.com}) へ到達した"
  else
    ok "許可外ドメインへ到達しない (許可済みは通る)"
  fi
else
  bad "curl が無くネットワークの検査ができない"
fi

if [ "$fail" -eq 0 ]; then
  printf '境界チェック: 合格\n'
else
  printf '境界チェック: 不合格\n'
fi
exit "$fail"
