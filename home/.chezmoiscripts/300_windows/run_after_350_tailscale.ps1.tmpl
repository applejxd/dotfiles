{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username -}}
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# Tailscale を Unattended (ログオン前・サインアウト後も接続) にする。see docs/spec/structure.md#tailscale-の-unattended
# 初回のブラウザ認証は対話が要るのでここでは行わず、未ログインなら手順を表示して 0 で終わる。
$exe = Join-Path $env:ProgramFiles 'Tailscale\tailscale.exe'
if (-not (Test-Path -LiteralPath $exe -PathType Leaf)) {
  Write-Host 'tailscale: 未導入のため何もしません'
  exit 0
}

$status = (& $exe status --json 2>$null | Out-String)
$state = if ($status -match '"BackendState"\s*:\s*"([^"]+)"') { $Matches[1] } else { '' }
if ($state -ne 'Running') {
  Write-Host "tailscale: 未ログイン (state=$state)。初回は次を実行してブラウザで認証してください:"
  Write-Host '  tailscale up --unattended'
  exit 0
}

& $exe set --unattended
if ($LASTEXITCODE -ne 0) { throw "tailscale set --unattended failed: $LASTEXITCODE" }
Write-Host 'tailscale: unattended を有効にしました'
{{- end }}
