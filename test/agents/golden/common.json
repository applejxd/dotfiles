   "**/*.p12",
   "**/*.pfx",
   "**/*.jks",
   "**/*.keystore",
   "**/key.txt",
   "**/keys.txt",
   "**/*_key",
   "**/*.token",
   "**/*_token",
   "**/token.json",
   "**/service-account*.json",
