{{- /*
pi のプロファイル判定。単一ソース。"custom" か "stock" を返す。

使う側:
    {{ $stock := eq (includeTemplate "pi-profile" .) "stock" }}

stock になる条件 (どれか):
  - 環境変数 CHEZMOI_PI_PROFILE が stock
  - ファイル ~/.config/chezmoi/pi-profile の中身 (前後の空白を除く) が stock
それ以外 (無い・空・不正な値) は custom。リポジトリの既定は custom。
chezmoi.toml の [data] には置かない (chezmoi update は init を呼ばない)。
仕組みと切り替え手順は docs/spec/agent-config-generation.md#pi-のプロファイルcustom-と-stock が正本。
*/ -}}
{{- $profile := trim (env "CHEZMOI_PI_PROFILE") -}}
{{- if eq $profile "" -}}
{{-   $file := joinPath .chezmoi.homeDir ".config" "chezmoi" "pi-profile" -}}
{{-   if stat $file -}}
{{-     $profile = trim (include $file) -}}
{{-   end -}}
{{- end -}}
{{- if eq $profile "stock" }}stock{{ else }}custom{{ end -}}
