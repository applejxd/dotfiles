# see below for documentation
# https://mise.jdx.dev/configuration.html

[tools]
copilot = "latest"
{{- if or (ne .chezmoi.os "windows") (not (regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username)) }}
claude-code = "latest"
{{- end }}
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "windows") }}
herdr = "latest"
{{- end }}

{{- if ne .chezmoi.os "windows" }}
usage = "latest" # for mise completion

# CLI
fzf = "0.53.0"  # to prevent bug
ghq = "latest"
bat = "latest"
eza = "latest"
jj ="latest"
ripgrep = "latest"
"aqua:dylanaraps/neofetch" = "latest"

# TUI
btop = "latest"
"pipx:nvitop" = "latest"
ctop = "latest"
tmux = "latest"
"gem:tmuxinator" = "latest"
"aqua:neovim/neovim" = "latest" # unstable for vfox
lazygit = "v0.59.0" # to use correct tag
yazi = "latest"
"aqua:dev.yorhel.nl/ncdu" = "2.9.1" # see https://dev.yorhel.nl/ncdu

# dev
shellcheck = "latest"
hadolint = "latest"
"npm:markdownlint-cli2" = "latest"
python = "latest"
uv = "latest"
node = "latest"
deno = "latest"

# backends (keep the latest for building tools)
rust = "latest"
go = "latest"
ruby = "latest"

# others
chezmoi = "latest"
sops = "latest"

# see https://mise.jdx.dev/dev-tools/backends/go.html
"go:github.com/d-kuro/gwq/cmd/gwq" = "latest"

# see https://mise.jdx.dev/dev-tools/backends/cargo.html
"aqua:bvaisvil/zenith" = "latest"

{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}
"npm:@google/gemini-cli" = "latest"
# Bitwarden CLI: snap 版が動作しなくなったため mise (npm backend) で導入。
# chezmoi init 時点では bw 不在でも既存ガード (lookPath "bw") で apply が完走し、
# apply 中の `mise install` でこの bw が入る。詳細は README / docs/spec/security.md を参照。
"npm:@bitwarden/cli" = "latest"
# Claude Code の sandbox が使う seccomp フィルタ (Unix domain socket の遮断)。
# 無くても sandbox 自体は動くが、WSL2 では Windows バイナリ (cmd.exe や
# /mnt/c/... 配下) の起動が Unix socket 経由になるため、これが無いと
# sandbox 内から Windows 側のプロセスを起動して脱出できてしまう。
#
# 注意: Claude は apply-seccomp を npm のグローバル領域でしか自動検出せず、
# mise は独自ディレクトリへ隔離するのでここに書くだけでは見つけてもらえない。
# 公式が用意している代替手段 (settings.json の sandbox.seccomp.applyPath で
# パスを直接指定する) を使って橋渡ししている。生成は
# scripts/agents/generate.py の build_claude_sandbox が行う。
# see https://code.claude.com/docs/en/sandboxing (WSL2 notes / Dependencies)
"npm:@anthropic-ai/sandbox-runtime" = "latest"
yt-dlp = "latest"
{{- end }}

[settings]
# for Tkinter (prebuild binaries doesn't contain GUI modules)
# see https://www.python.jp/install/ubuntu/index.html
all_compile = true
# for task runner
experimental = true
# for API keys
sops.age_key_file = "~/.config/sops/age/keys.txt"
{{- end }}
