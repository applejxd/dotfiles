# AI CLI の permission / hook / sandbox / MCP の単一ソース。
#
# 生成先:
#   ~/.claude/settings.json              <- [bash] [file] [web] [claude] [sandbox] [[hooks]]
#   ~/.copilot/permissions-config.json   <- [bash.allow] [copilot.locations]
#   ~/.copilot/settings.json             <- [web] [copilot] [sandbox]
#   ~/.copilot/hooks/from-claude.json    <- [[hooks]]
#   ~/.copilot/mcp-config.json           <- [[mcp]]
#   ~/.codex/config.toml の mcp_servers  <- [[mcp]]
#   ~/.config/opencode/opencode.json     <- [bash] [file] [pi] [opencode] [[mcp]]
#
# ★仕組み・判断基準・既知の不具合・実測値は docs/spec/agent-permissions.md が正本。
#   値を足す前にそちらを読むこと。ここには「その行を編集するときに要る注記」
#   だけを置き、経緯は書かない。
#
# このファイルは chezmoi テンプレート。ユーザ・OS の出し分けはここに書く
# (生成側は展開後の表だけを見る)。

# ---------------------------------------------------------------------------
# AI CLI のシェルへ渡す既定値 (未設定のときだけ入れる。空文字は空のまま残す)
# ---------------------------------------------------------------------------
# 配り先: OpenCode の guide plugin (rules.json)、copilot の起動関数 (shellrc / PowerShell)。
# see docs/spec/agent-config-generation.md#shell-ツールの環境変数
[agent_env]
GIT_TERMINAL_PROMPT = "0"
GIT_EDITOR = "false"
GCM_INTERACTIVE = "never"

# ---------------------------------------------------------------------------
# Bash 系
# ---------------------------------------------------------------------------
[bash]
# 人が書くのはこの 3 リストだけ。パターンは素のトークン列 (例: "git push")。
# 照合は normalize 後のセグメント先頭トークン一致
# (cd && X -> X, git -C foo X -> git X, compound は &&/;/| で分割)。
# 評価順は deny -> ask -> allow。具体形を deny に置けば一般形を ask にできる
# (例: "git reset --hard" は deny、"git reset" は ask)。
#
# ★OpenCode だけは「後に書いた規則が勝つ」。generate.py が allow -> ask -> deny
#   の順に並べて同じ優先順位を作るので、リストの書き方は変えなくてよい。
# see docs/spec/agent-permissions.md 「3 層構成」「`ask` に載せるかどうかの判断軸」

# 自動承認。読み取り専用・冪等なものだけ
#
# ★Copilot へは **先頭トークンのコマンド名だけ** が渡る。"git diff" と書くと
#   Copilot では git 全体が承認される。破壊的な形を ask / deny に載せずに
#   allow だけ足すと、そのコマンドが Copilot で丸ごと無防備になる。
#
# ★作業ディレクトリを付け替える形式 (-C) は allow に入れない (バイパス経路)。
allow = [
  "git diff",
  "git status",
  "git log",
  "wc",
  "grep -n",
  "find",
  "gcc",
  "g++",
  "cmake -S",
  "cmake --build",
  "uv pip list",
  "uv sync",
  "docker ps",
  "mise run",
  # gh は Copilot 側で先頭トークンまで粗粒度化されるため allow に置かない。
  # 読み取り系は未掲載にして auto / assisted へ委譲し、mutation は ask / deny
  # または check_bash.py の gh api 意味解析で止める。
]

# 提案 -> ユーザーが承認 -> そのまま実行。
# 「危険だが承認すれば妥当」なもの。取り返しがつく変更はここに置く。
#
# ask に残す基準 (どれかに当たるもの):
#   1. 不可逆か            — 復旧できない削除・履歴の書き換え
#   2. 外部に見えるか      — リモートへの書き込み、外部との通信
#   3. 秘密や防御に触るか  — 認証情報、hook や permission の設定
# 引数を見れば妥当性が判断できるものは **未掲載** にして LLM 判定へ委ねる。
# allow に入れてはいけない (手動モードでも無条件に通り、かえって緩くなる)。
#
# ★Copilot は hook の ask を自動承認する既知バグがある。確実に止めたいものは
#   ask ではなく deny に置く。
# see docs/spec/agent-command-policy.md 「`ask` に載せるかどうかの判断軸」、
#     docs/research/agents/harness-comparison.md 「hook の ask が自動承認される」
ask = [
  # 削除は承認制。壊滅的なターゲット (ルート・ホーム・作業ディレクトリ全体・
  # .git 配下) は check_rm_root_guard が deny する。
  # 逆に workspace 内と確証できる削除は hook が承認を省いて auto / assisted
  # へ委ねる (詳細は docs/spec/agent-permissions.md の「`rm` の承認範囲」)。
  # この委譲を成立させるため ask_hook_owned にも載せている (下の注記を参照)
  "rm",
  # 未追跡ファイルを消すので git でも復旧できない
  "git clean",
  "git branch -D",
  "git commit",
  # --hard は deny。素の reset は index を戻すだけで作業ツリーを壊さない
  "git reset",
  # curl / wget は読み取りを未掲載にして auto / assisted へ委譲する。
  # mutation / upload は hook が ask、秘密送信・直接実行・危険な出力先は deny。
  # ループバック宛と確証できる curl の mutation は ask を外す (deny 層は不変)。
  # 詳細は docs/spec/agent-permissions.md の「ループバック宛の例外」を参照。
  # コンテナ/イメージは再作成・再 pull できるが状態を失う
  "docker rm",
  "docker rmi",
  # リモートに書き込むが取り消せる gh 操作
  "gh pr create",
  "gh pr checkout",
  "gh issue create",
  "gh issue close",
  "gh issue comment",
  # gh api は check_bash.py が REST method / GraphQL operation を解析する。
  # GET / HEAD / query は未掲載、mutation と判定不能形式だけ ask にする。
  # グローバルに常駐する (pipx run は未掲載で LLM 判定に委ねる)
  "pipx install",
  # プロジェクトの外に残る変更だけを ask にする (内で完結するものは未掲載)。
  # mise 系はここに書けない。normalize が runner の先頭 `mise` を落とすため
  # 前方一致しない (check_global_env_mutation が担当)。
  "uv tool install",
  "uv tool uninstall",
  "uv tool upgrade",
  "uv python install",
  "uv python uninstall",
  "cmake --install",
  # 認証情報がホームに残る / レジストリへ公開される
  "docker login",
  "docker push",
  # 素の疎通確認 (-z など) は使うが、-e/-c/-l は check_reverse_shell が deny する
  "nc",
  # 読み取り (--get / --list) も含めて確認を挟む。hook を無効化しうる
  # 書き込み (--global / core.hooksPath 等) は deny 側
  "git config",
]
# ★ask のうち「hook が承認要否まで判定する」もの。
#   ask には残しつつ Claude の permissions.ask へは出力しない
#   (静的 ask を出すと hook の exemption がどのモードでも無効化されるため)。
#   足したら check_bash.py の _ASK_EXEMPTIONS にも条件を書く。対応は
#   test_hook_owned_ask_is_not_emitted_as_a_static_claude_rule が検証する。
#
# ★OpenCode には除外が効かない (hook 機構が無く、委譲先が存在しない)。
#   そのため OpenCode へは素の ask として出る。ここに足すものは
#   「hook が無ければ毎回 ask で妥当」な粒度に保つこと。
# see docs/spec/agent-command-policy.md 「`rm` の承認範囲」
ask_hook_owned = [
  "rm",
]
# 承認の余地なく拒否。
# 判断基準: 外部に出る / システムを変える / 取り返しがつかない / 規約違反。
deny = [
  "sudo",
  # リモートに公開されるものは手動操作に委ねる
  "git push",
  "git reset --hard",
  "git rebase",
  # core.hooksPath の書き換えで hook 自体を無効化できる。
  # 読み取り (--get / --list) は allow 側にあるので通る。ただし --global / --system を
  # 付けた読み取りは下の deny に当たる
  "git config --global",
  "git config --system",
  "git config --local",
  "git config core.hooksPath",
  "git config --unset",
  "git config --add",
  "git config --replace-all",
  "git config --edit",
  # 履歴・参照を書き換える / 作業内容を失わせる操作
  "git filter-branch",
  "git update-ref -d",
  "git reflog expire",
  "git stash clear",
  "git stash drop",
  "git worktree remove",
  # 追跡ファイルの変更を破棄する (git でも復旧できない)
  "git checkout --",
  "git restore",
  # スケジュール実行で監視外に逃がす
  "crontab",
  "at",
  "batch",
  # サービスの状態を変える (status / show などの読み取りは許可)
  "systemctl enable",
  "systemctl disable",
  "systemctl mask",
  "systemctl start",
  "systemctl stop",
  "systemctl restart",
  "systemctl daemon-reload",
  "systemd-run",
  # ディスク・デバイスの破壊
  "mkfs",
  "mkfs.ext4",
  "mkfs.xfs",
  "fdisk",
  "parted",
  "wipefs",
  # 待ち受け・トンネル (外部からの侵入経路)
  "socat",
  "ncat",
  # 外部への通信・横展開の経路
  "telnet",
  "ssh",
  # システム全体を汚す
  "npm install -g",
  # ツール自身を置き換える操作 (実質不可逆で影響が全プロジェクトに及ぶ)。
  # mise の self-update / implode は check_tool_self_update が担当する。
  "uv self update",
  "rustup self update",
  "chezmoi upgrade",
  # pip は全面禁止 (uv / uvx を使う)。hook の check_pip_redirect が
  # プロジェクト種別を問わず代替案付きで hard-deny する
  "pip",
  "pip3",
  # DB クライアント。mongod はサーバのデーモン、クライアントは mongosh
  "psql",
  "mysql",
  "mongod",
  "mongosh",
  "redis-cli",
  # -a --volumes はデータボリュームまで消す
  "docker system prune",
  "docker volume prune",
  "docker image prune",
  "docker container prune",
  "docker network prune",
  # キャッシュ削除は再取得に時間がかかる
  "npm cache clean",
  "yarn cache clean",
  "pnpm store prune",
  # リモートに影響する gh 操作 (push と同じ基準)
  "gh pr merge",
  "gh release create",
  "gh repo delete",
  # ローカルの内容を外部へ出す経路 (git push を deny にしているのと同じ基準)
  "gh gist create",
  "gh secret set",
  "gh secret list",
  # トークンを直接引く操作 (gh api graphql は Projects v2 で使うので ask 側)
  "gh auth token",
  # 秘密情報ストアからの読み出し (Bitwarden / 1Password / Vault)
  "bw get",
  "bw list",
  "bw export",
  "op read",
  "op item get",
  "vault read",
  "vault kv get",
  "chezmoi secret",
  # リモート先を差し替えると push 先が変わる
  "git remote add",
  "git remote set-url",
  "scp",
  "rsync",
  "sftp",
  # クラウドストレージへの転送
  "aws s3 cp",
  "aws s3 sync",
  "gsutil cp",
  "az storage blob upload",
  "gh release upload",
]

# OpenCode だけ。deny の全項目を 3 つのどれかに分類し、静的 deny の前に説明付きで止める。
# 分類に漏れ・重複・deny に無い項目があると生成が止まる。deny を足したら必ずここにも足す。
# ★deny の一覧自体は変えない (plugin が壊れても静的 deny が止める)。
# see docs/spec/agent-command-policy.md#opencode-の-deny-の説明前段停止
[bash.deny_guide]
# 代替が無いもの (利用者に頼む)。迷ったらここ
user_message = "この操作はエージェントには許可されていません。迂回せず、実行してほしいコマンドと理由を利用者に示してください。"
user_only = [
  "sudo",
  "git push",
  "git reset --hard",
  "git rebase",
  "git filter-branch",
  "git update-ref -d",
  "git reflog expire",
  "git stash clear",
  "git stash drop",
  "git worktree remove",
  "git checkout --",
  "git restore",
  "crontab",
  "at",
  "batch",
  "systemctl enable",
  "systemctl disable",
  "systemctl mask",
  "systemctl start",
  "systemctl stop",
  "systemctl restart",
  "systemctl daemon-reload",
  "systemd-run",
  "mkfs",
  "mkfs.ext4",
  "mkfs.xfs",
  "fdisk",
  "parted",
  "wipefs",
  "socat",
  "ncat",
  "telnet",
  "ssh",
  "psql",
  "mysql",
  "mongod",
  "mongosh",
  "redis-cli",
  "gh pr merge",
  "gh release create",
  "gh repo delete",
  "gh gist create",
  "gh secret set",
  "gh secret list",
  "gh auth token",
  "bw get",
  "bw list",
  "bw export",
  "op read",
  "op item get",
  "vault read",
  "vault kv get",
  "chezmoi secret",
  "git remote add",
  "git remote set-url",
  "scp",
  "rsync",
  "sftp",
  "aws s3 cp",
  "aws s3 sync",
  "gsutil cp",
  "az storage blob upload",
  "gh release upload",
]
# 個別の guide 規則 ([[opencode.shell.guide]] の early = true) が前段で止めるもの。ここで二重にしない
elsewhere = ["pip", "pip3"]

# 代わりの手段があるもの。message に代替を書く
[[bash.deny_guide.alternative]]
commands = ["npm install -g"]
message = "npm install -g は許可されていません。グローバルに入れる CLI は mise で入れてください。chezmoi 管理の環境では、ソースの home/dot_config/mise/config.toml.tmpl の [tools] に `\"npm:<package>\" = \"latest\"` を追記して `chezmoi apply` します (`mise use -g` は次回の apply で失われうる)。chezmoi 管理でない環境なら `mise use -g npm:<package>` です。プロジェクトの依存なら -g 無しの `npm install <package>` を使ってください。"

[[bash.deny_guide.alternative]]
commands = ["uv self update", "chezmoi upgrade"]
message = "ツール自身の更新は許可されていません。導入元のパッケージマネージャ (mise / winget など) で更新してください。導入元が分からなければ、更新してほしいツールを利用者に示してください。"

[[bash.deny_guide.alternative]]
commands = ["rustup self update"]
message = "rustup 自体の更新は許可されていません。利用者に依頼してください。toolchain の更新は `rustup update` を使えます。"

[[bash.deny_guide.alternative]]
commands = [
  "git config --global",
  "git config --system",
  "git config --local",
  "git config core.hooksPath",
  "git config --unset",
  "git config --add",
  "git config --replace-all",
  "git config --edit",
]
message = "git config の書き込みは許可されていません。ユーザー設定は chezmoi 管理の home/dot_gitconfig.tmpl を編集して `chezmoi apply` で反映してください。リポジトリ単位の設定は、変更内容を利用者に示して依頼してください。読み取りは `--global` などを付けず `git config --get <key>` / `git config --list` の形で使えます。"

[[bash.deny_guide.alternative]]
commands = [
  "docker system prune",
  "docker volume prune",
  "docker image prune",
  "docker container prune",
  "docker network prune",
]
message = "docker の prune は許可されていません。消す対象を指定して `docker rm <container>` / `docker rmi <image>` を使ってください (確認が出ます)。ボリュームとネットワークの削除は利用者に依頼してください。"

[[bash.deny_guide.alternative]]
commands = ["npm cache clean", "yarn cache clean", "pnpm store prune"]
message = "キャッシュの削除は許可されていません (再取得に時間がかかります)。不具合の原因がキャッシュだと判断できるときだけ、実行してほしいコマンドと理由を利用者に示してください。"

[file]
# ★接頭辞の無い 4 キーは Claude と OpenCode が読む。`claude_read_allow` だけは
#   Claude 固有 (OpenCode へは出さない)。
#   Copilot の permissions-config.json にはファイル規則が無いので渡らない
#   (等価な保護は [sandbox] deny と check_file_read.py が担う)。
#   OpenCode へは read / edit の permission rule として出る。
#   `**` 記法は OpenCode に無いため generate.py が `*` 主体へ変換する
#   (see docs/spec/agent-config-generation.md 「glob の記法差」)。
#
# ★allow のリスト (下の claude_read_allow) だけは OpenCode へ出さない。
#   OpenCode は allow が既定なので同じ意味の規則が増えるだけになる。
claude_read_allow = [
  "README.md",
  "pyproject.toml",
]

# Claude / OpenCode に反映: Read(...) を ask に追加
read_ask_globs = []

# Claude / OpenCode に反映: Edit(...) を ask に追加
# (書き込み系 permission rule は Edit(path) に統一。Write(path) は v2.1.210 で deprecated)
write_ask_globs = [
  "mise.toml",
]

# Claude / OpenCode: Read(...) deny に展開。hook の bash ポリシーには反映しない
#
# ★`**/*key*` のような部分一致 glob は使わない。keyhac.bat / tokenizer.py の
#   ような正当なファイルを巻き込む。拡張子・接尾辞・既知の名前で指定する。
read_deny_globs = [
  "**/.ssh/**",
  "**/.gnupg/**",
  "**/sops/age/**",
  "**/.aws/credentials",
  "**/.netrc",
  "**/.npmrc",
  "**/.pypirc",
  "**/id_rsa*",
  "**/id_ed25519*",
  "**/id_ecdsa*",
  "**/id_dsa*",
  "**/*.pem",
  "**/*.key",
  "**/*.p12",
  "**/*.pfx",
  "**/*.jks",
  "**/*.keystore",
  "**/key.txt",
  "**/keys.txt",
  "**/*_key",
  "**/*.token",
  "**/*_token",
  "**/token.json",
  "**/service-account*.json",
  "**/secrets/**",
  "**/*secret*",
  "**/*credential*",
  "**/*password*",
  "**/.env",
  "**/.env.*",
  # CLI の資格情報とシェル履歴。bashrules/tables.toml の credential_paths /
  # history_basenames と対応 (test_secret_lists_in_sync.py が固定)
  "**/.config/gh/hosts.yml",
  "**/.docker/config.json",
  "**/.git-credentials",
  "**/.kube/config",
  "**/.config/gcloud/credentials.db",
  "**/.azure/msal_token_cache.json",
  "**/.terraform.d/credentials.tfrc.json",
  "**/.bash_history",
  "**/.mysql_history",
  "**/.node_repl_history",
  "**/.psql_history",
  "**/.python_history",
  "**/.sh_history",
  "**/.zsh_history",
  "~/.copilot/settings.json",
  "~/.copilot/config.json",
  # エージェント CLI のランタイム設定。MCP サーバ定義の headers / env に
  # PAT や API キーが平文で入りうる (`claude mcp add --env ...` など)。
  # 設定ファイル自体は chezmoi 管理外なので、読めなくても運用に支障はない。
  "~/.claude.json",
  # OpenCode のバックグラウンドサービス認証情報 (service.json の password)。
  # 同じ階層の opencode.json は生成物なので read は塞がない (write は下で塞ぐ)。
  "~/.config/opencode/service.json",
]

# Claude / OpenCode に反映: Edit(...) を deny に追加
# read_deny_globs と同じ理由で部分一致 glob は使わない
write_deny_globs = [
  "**/.ssh/**",
