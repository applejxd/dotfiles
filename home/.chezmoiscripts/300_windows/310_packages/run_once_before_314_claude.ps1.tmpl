{{- if ne .chezmoi.username "applejxd" }}
<#
  .SYNOPSIS
    Install Claude Code for native Windows
  .DESCRIPTION
    Install the latest Claude Code release with the official user-scoped installer
#>

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$installerPath = Join-Path ([System.IO.Path]::GetTempPath()) "claude-install-$PID.ps1"
$claudePath = Join-Path $env:USERPROFILE '.local\bin\claude.exe'

try {
  Write-Host 'Downloading the Claude Code installer...'
  Invoke-WebRequest -UseBasicParsing -Uri 'https://claude.ai/install.ps1' -OutFile $installerPath

  & $installerPath
  if ($LASTEXITCODE -ne 0) {
    throw "Claude Code installation failed with exit code $LASTEXITCODE"
  }

  if (-not (Test-Path -LiteralPath $claudePath -PathType Leaf)) {
    throw "Claude Code executable was not installed at $claudePath"
  }

  & $claudePath --version
  if ($LASTEXITCODE -ne 0) {
    throw "Claude Code verification failed with exit code $LASTEXITCODE"
  }
}
finally {
  if (Test-Path -LiteralPath $installerPath) {
    Remove-Item -LiteralPath $installerPath -Force
  }
}
{{- end }}
