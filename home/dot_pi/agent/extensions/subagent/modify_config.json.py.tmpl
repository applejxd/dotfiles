#!/usr/bin/env python3
"""pi の stock プロファイルの ~/.pi/agent/extensions/subagent/config.json。標準入力の現状を変換して出す。

pi-subagents (nicobailon。home/.chezmoitemplates/pi-stock-packages で版固定) の設定。
(複数形の extensions/subagents/ は凍結した自作拡張で、ここの対象ではない。)
- forceTopLevelAsync は true に強制する。前景の子には親の拡張が載らず、permission-system と
  cc-safety-net が効かないため (背景の子には載る)。利用者が false にしても apply で true に戻る。
- それ以外 (worktreeProvider・同時数・入れ子・起動数の上限) は、無いときだけ補う。利用者が変えた値は戻さない。
  同時数・入れ子の深さ・起動数の上限は取り払う (2026-11-10。初期値の 4・1・32 のままなら、新しい値へ移す。
  この 3 つの値を意図して選ぶことはできない: apply のたびに戻る。別の値なら保つ)。
- 利用者が足した他のキーは保つ。壊れた入力は触らない。何度流しても同じ結果になる。
stock でだけ配る (custom は .chezmoiignore.tmpl で除外)。
see docs/spec/agent-config-generation.md#pi-subagents-の設定
"""
from __future__ import annotations

import json
import sys

# 強制する値 (docs/configuration.md の forceTopLevelAsync)
FORCED = {
    "forceTopLevelAsync": True,
}

# 無いときだけ補う値 (docs/configuration.md の各見出し)
DEFAULTS = {
    # worktree: true の子の置き場の確保。Worktrunk を使わず pi 本体の Git worktree に固定する
    "worktreeProvider": "native",
    # 同時に動かす最上位の背景 run の数。0 は無制限
    "maxActiveAsyncRunsPerSession": 0,
    # 子が孫を起こす入れ子の深さ。入れ子にするかは agent ごとの許可 (allowNestedSubagents) で決まる
    "maxSubagentDepth": 8,
    # 1 回の run (workflow) が起こす子の累計 (既定は 64。0 は使えないので、実質無制限の大きな値)
    "maxSubagentSpawnsPerRun": 10000,
    # 1 つの run の中で同時に動く子の数 (既定は 20。正の整数のみ。0 は使えない)
    "globalConcurrencyLimit": 1000,
    # 1 つの親セッションが起こす子の累計。0 は無制限 (既定も無制限)
    "maxSubagentSpawnsPerSession": 0,
}

# tasks:[…] や chain の並列グループの上限 (既定は maxTasks 8・concurrency 4。docs/configuration.md の parallel)。
# 入れ子の dict なので、キーごとに無いときだけ補う
PARALLEL_DEFAULTS = {"maxTasks": 64, "concurrency": 16}

# 前の既定値。この値のままなら、利用者が選んだ値ではないので新しい既定へ移す
LEGACY_DEFAULTS = {
    "maxActiveAsyncRunsPerSession": 4,
    "maxSubagentDepth": 1,
    "maxSubagentSpawnsPerRun": 32,
}


def main() -> int:
    raw = sys.stdin.read()
    try:
        data = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        sys.stdout.write(raw)  # 壊れた入力は触らない
        return 0
    if not isinstance(data, dict):
        sys.stdout.write(raw)
        return 0
    for key, value in DEFAULTS.items():
        if key not in data or (key in LEGACY_DEFAULTS and data[key] == LEGACY_DEFAULTS[key]):
            data[key] = value
    parallel = data.get("parallel")
    if parallel is None:
        parallel = data["parallel"] = {}
    if isinstance(parallel, dict):
        for key, value in PARALLEL_DEFAULTS.items():
            parallel.setdefault(key, value)
    data.update(FORCED)
    json.dump(data, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
