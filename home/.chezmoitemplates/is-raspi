{{- /*
Raspberry Pi の判定。単一ソース。"true" か空文字を返す。

使う側:
    {{ $raspi := eq (includeTemplate "is-raspi" .) "true" }}

chezmoi.toml の [data] ではなくここに置くのは、chezmoi update が
chezmoi init を呼ばないため。[data] だと判定が更新されない。
手がかりの守備範囲は docs/spec/structure.md#raspberry-pi が正本。
*/ -}}
{{- if hasKey . "is_raspi" -}}
{{-   if .is_raspi }}true{{ end -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $osrelease := "" -}}
{{-   if hasKey .chezmoi "kernel" -}}
{{-     $osrelease = .chezmoi.kernel.osrelease | lower -}}
{{-   end -}}
{{-   if or (stat "/proc/device-tree/model")
           (contains "raspi" $osrelease)
           (contains "-rpi-" $osrelease)
           (stat "/etc/rpi-issue") -}}
true
{{-   end -}}
{{- end -}}
