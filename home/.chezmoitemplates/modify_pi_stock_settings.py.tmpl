#!/usr/bin/env python3
"""pi の stock プロファイルの ~/.pi/agent/settings.json。標準入力の現状を変換して出す。

自作ハーネスが入れた設定だけを取り除き、packages を pi-stock-packages の内容にする。
利用者のキー (テーマ・既定のモデルなど) は触らない。何度流しても同じ結果になる。
see docs/spec/agent-config-generation.md#pi-の設定
"""
from __future__ import annotations

import json
import sys

PACKAGES_TEXT = {{ .packages | toJson }}
# 検索の子 (researcher・evidence-auditor) の system prompt。機の検索・取得のツール名に合わせた文面 (.chezmoitemplates の 2 ファイル)
SEARCH_AGENT_PROMPTS = {
    "researcher": {{ .researcherPrompt | toJson }},
    "evidence-auditor": {{ .evidenceAuditorPrompt | toJson }},
}
# 会社 PC (is-work) か。検索の MCP が機で違う (家は websearch、会社 PC は agentcore-websearch)
IS_WORK = {{ if eq .isWork "true" }}True{{ else }}False{{ end }}
WORK_PI_PROFILE = {{ .workProfile | default "bedrock" | toJson }}
WORK_COPILOT_MODEL_STATE = "dotfilesWorkCopilotModels"
WORK_PARENT_MODELS = {
    "bedrock": ("amazon-bedrock", "us.anthropic.claude-sonnet-5-5"),
    "copilot": ("github-copilot", "gemini-4-neon"),
}
# 家の起動・モデル循環の候補。利用者が enabledModels を書いていれば保つ。
# 手動での /model 選択や、候補が解決できないときの Pi 本体のフォールバックは制限しない。
HOME_ENABLED_MODELS = ["github-copilot/*"]
HOME_PARENT_MIGRATION = "dotfilesHomeCopilotParentMigrated"
HOME_PARENT_DEFAULT = {
    "defaultProvider": "github-copilot",
    "defaultModel": "gemini-4-neon",
    "defaultThinkingLevel": "medium",
}
LEGACY_HOME_PARENT_MODELS = {"claude-sonnet-5.5": "xhigh", "gpt-6.2-sol": "high"}

# pi のシェル。Linux (Ubuntu / WSL) だけが、コマンド実行の囲い (pib-shell) を指す。空文字なら触らない。
# pib-shell は、環境変数 PIB_SANDBOX が立っているとき (= pib で起動したとき) だけ囲う。普段の pi は素の bash と同じ
SHELL_PATH = {{ .shellPath | toJson }}

# 自作ハーネスだけが入れる extensions / skills の項目 (scripts/agents/generate.py の宣言に対応)
HARNESS_EXTENSION_MARKS = (".config/pi/harness", "!extensions/**", "+extensions/", "-builtin:")
HARNESS_SKILL_MARKS = ("~/.claude/skills", "-~/.agents/skills/", "-~/.claude/skills/")
# Orca が ~/.agents/skills/ へ入れるスキルを、ディレクトリ名で除外する (戻すときは利用者が +skills/<名前> を足す)
# see docs/spec/agent-config-generation.md#pi-の設定
EXCLUDED_SKILLS = ("!computer-use", "!orca-cli", "!orchestration")

# pi の既定 (read・bash・edit・write) に、読み取り専用の探索ツールを足す (増分指定)。plan mode の探索と通常の探索で使う
# 利用者が +/- だけの増分指定に変えていたら保つ。自作ハーネスの全置換の値 (["read"] など) は初期値に置き換える
DEFAULT_TOOLS = ["+grep", "+find", "+ls"]

# 圧縮 (compaction): 窓が 100 万のモデルは 70 万で圧縮する。reserveTokens = 窓 - 発動点 = 300000 (窓の 3 割)
# 窓の大きさが違うモデルは補わない。利用者が別の値を書いていれば保つ (無いときだけ補う)
COMPACTION_RESERVE_TOKENS = 300000
COMPACTION_MODELS = (
    "github-copilot/claude-sonnet-5.5",
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5",
    "github-copilot/gpt-6-sol",
    "github-copilot/gpt-6.2-sol",
    "github-copilot/gemini-4-carbon",
    "github-copilot/gpt-5.3-codex",
    "github-copilot/gemini-3.8-flash",
) + (() if IS_WORK else ("github-copilot/gemini-4-neon",))


def add_compaction_overrides(data: dict) -> None:
    compaction = data.get("compaction")
    if compaction is None:
        compaction = {}
    if not isinstance(compaction, dict):
        return  # 想定外の形は触らない
    overrides = compaction.get("modelOverrides")
    if overrides is None:
        overrides = {}
    if not isinstance(overrides, dict):
        return
    for model in COMPACTION_MODELS:
        entry = overrides.get(model)
        if entry is None:
            entry = {}
        if not isinstance(entry, dict):
            continue
        entry.setdefault("reserveTokens", COMPACTION_RESERVE_TOKENS)
        overrides[model] = entry
    compaction["modelOverrides"] = overrides
    data["compaction"] = compaction


# pi-subagents の組み込みの子の tools を読み取り専用に絞る (subagents.agentOverrides.<name>.tools 。docs/agents.md)。
# 組み込みの既定: scout = read, grep, find, ls, bash, write, contact_supervisor / oracle = read, grep, find, ls, bash。
# bash・write を外す (scout は親への問い合わせ contact_supervisor を残す)。reviewer (読み取り専用) と worker は変えない。
# 検索の子 (researcher・evidence-auditor) は、組み込みの tools が pi-web-access のツール名 (stock では入れない) なので、
# 機の検索・取得の MCP を mcp: で渡す。家は websearch (検索も取得も)、会社 PC は agentcore-websearch (検索) と webfetch (取得)。
# 利用者がすでに同じ役の tools を書いていれば保つ (無いときだけ補う)。
# see docs/spec/mcp-servers.md#子のエージェントへの検索-mcp-の渡し方
SEARCH_MCP = ["mcp:agentcore-websearch", "mcp:webfetch"] if IS_WORK else ["mcp:websearch"]
AGENT_TOOL_OVERRIDES = {
    "scout": ["read", "grep", "find", "ls", "contact_supervisor"],
    "oracle": ["read", "grep", "find", "ls"],
    "researcher": ["read", "write", *SEARCH_MCP],
    "evidence-auditor": ["read", *SEARCH_MCP],
}
# 前の既定の tools (会社 PC は取得の MCP を足す前)。この配列のままなら、利用者が選んだ値ではないので新しい既定へ移す
LEGACY_AGENT_TOOLS = {
    "researcher": ["read", "write", "mcp:agentcore-websearch"],
    "evidence-auditor": ["read", "mcp:agentcore-websearch"],
} if IS_WORK else {}


# 役割ごとのモデル (subagents.agentOverridesByProvider.<プロバイダ>.<役>.model。`:` の後ろは思考の深さ)。
# pi-subagents が、親のセッションのモデルのプロバイダ (/model で替えても追従する) ごとに層を重ねる (docs/models.md)。
# `advisor` は `oracle` の別名で、設定は正規名の `oracle` に書く。
# see docs/spec/agent-config-generation.md#pi-subagents-の設定
PROVIDER_AGENT_MODELS = {
    "github-copilot": {
        "scout": "github-copilot/claude-sonnet-5.5:low",
        "researcher": "github-copilot/claude-sonnet-5.5:medium",
        "worker": "github-copilot/claude-sonnet-5.5:medium",
        "reviewer": "github-copilot/gpt-6.2-sol:high",
        "evidence-auditor": "github-copilot/gemini-4-carbon:medium",
        "oracle": "github-copilot/gemini-4-carbon:high",
    },
    "amazon-bedrock": {
        "scout": "amazon-bedrock/us.anthropic.claude-sonnet-5-5:low",
        "researcher": "amazon-bedrock/us.anthropic.claude-sonnet-5-5:medium",
        "worker": "amazon-bedrock/us.anthropic.claude-sonnet-5-5:medium",
        "reviewer": "amazon-bedrock/us.openai.gpt-6.1-sol:high",
        "evidence-auditor": "amazon-bedrock/us.openai.gpt-6.1-sol:high",
        "oracle": "amazon-bedrock/us.openai.gpt-6.1-sol:high",
    },
}


# 前の既定値 (プロバイダ, 役) -> モデルの一覧。この値のままなら、利用者が選んだ値ではないので新しい既定へ移す
LEGACY_AGENT_MODELS = {
    ("github-copilot", "reviewer"): ("github-copilot/gpt-6.1-sol:high",),
    ("github-copilot", "evidence-auditor"): (
        "github-copilot/gpt-6.1-sol:high",
        "github-copilot/gpt-6.2-sol:high",
    ),
    ("github-copilot", "oracle"): (
        "github-copilot/claude-sonnet-5.5:xhigh",
        "github-copilot/gpt-6.1-sol:high",
        "github-copilot/gpt-6.2-sol:high",
    ),
    ("amazon-bedrock", "oracle"): ("amazon-bedrock/us.anthropic.claude-sonnet-5-5:xhigh",),
}

WORK_BEDROCK_MODELS = dict.fromkeys(
    ("reviewer", "evidence-auditor", "oracle"), "amazon-bedrock/us.openai.gpt-6.2-sol:high"
)
COPILOT_EXECUTION_MODELS = {
    "worker": "github-copilot/gpt-6.2-sol:xhigh",
    "reviewer": "github-copilot/claude-sonnet-5.5:high",
    "evidence-auditor": "github-copilot/claude-sonnet-5.5:high",
}
WORK_COPILOT_MODELS = COPILOT_EXECUTION_MODELS | {
    "scout": "github-copilot/claude-sonnet-5.5:medium",
    "researcher": "github-copilot/gemini-4-neon:medium",
    "oracle": "github-copilot/claude-opus-5.5:medium",
}
HOME_COPILOT_MODELS = COPILOT_EXECUTION_MODELS | {
    "scout": "github-copilot/claude-sonnet-5.5:high",
    "researcher": "github-copilot/gemini-4-neon:xhigh",
}
LEGACY_HOME_COPILOT_MODELS = {
    "scout": "github-copilot/gemini-4-neon:medium",
    "worker": "github-copilot/claude-sonnet-5.5:high",
    "delegate": "github-copilot/gemini-4-neon:high",
}


def set_home_parent(data: dict) -> None:
    data.setdefault("enabledModels", list(HOME_ENABLED_MODELS))
    if not (HOME_PARENT_DEFAULT.keys() & data.keys()):
        data.update(HOME_PARENT_DEFAULT)
    elif data.get(HOME_PARENT_MIGRATION) is not True:
        model = data.get("defaultModel")
        old_effort = LEGACY_HOME_PARENT_MODELS.get(model) if isinstance(model, str) else None
        model_efforts = data.get("modelThinkingLevels")
        affected_models = {f"github-copilot/{model}", f"github-copilot/{HOME_PARENT_DEFAULT['defaultModel']}"}
        has_override = isinstance(model_efforts, dict) and bool(model_efforts.keys() & affected_models)
        if (
            data.get("defaultProvider") == "github-copilot"
            and old_effort is not None and data.get("defaultThinkingLevel") == old_effort
            and data["enabledModels"] == HOME_ENABLED_MODELS and not has_override
        ):
            data.update(HOME_PARENT_DEFAULT)
    data[HOME_PARENT_MIGRATION] = True


def preferred_model_pattern(scoped: list[str], preferred: str) -> str:
    return next((p for p in scoped if p == preferred or p.startswith(f"{preferred}:")), preferred)


def select_work_parent(data: dict, copilot_state: dict) -> str:
    provider, fallback_model = WORK_PARENT_MODELS[WORK_PI_PROFILE]
    # このキーは chezmoi 専用。Pi が使うのは下で生成する有効側の設定だけ。
    saved = data.get("dotfilesWorkPiModels")
    if not isinstance(saved, dict):
        saved = {}
    previous_provider = data.get("defaultProvider")
    model_keys = ("defaultModel", "defaultThinkingLevel")
    if isinstance(previous_provider, str) and previous_provider and previous_provider != provider:
        previous = saved.get(previous_provider)
        previous = previous if isinstance(previous, dict) else {}
        saved[previous_provider] = {**previous, **{key: data[key] for key in model_keys if key in data}}

    patterns = data.get("enabledModels")
    configured = [pattern for pattern in patterns if isinstance(pattern, str)] if isinstance(patterns, list) else []
    for other, _ in WORK_PARENT_MODELS.values():
        if other == provider:
            continue
        inactive = [p for p in configured if p.startswith(f"{other}/")]
        if inactive:
            previous = saved.get(other)
            previous = previous if isinstance(previous, dict) else {}
            saved[other] = {**previous, "enabledModels": inactive}
    unscoped = [p for p in configured if not p.startswith(("amazon-bedrock/", "github-copilot/"))]
    if unscoped:
        saved["unscopedEnabledModels"] = unscoped

    selected = saved.get(provider)
    selected = selected if isinstance(selected, dict) else {}
    scoped = [p for p in configured if p.startswith(f"{provider}/")]
    if not scoped and isinstance(selected.get("enabledModels"), list):
        scoped = [p for p in selected["enabledModels"] if isinstance(p, str) and p.startswith(f"{provider}/")]
    if previous_provider != provider:
        for key in model_keys:
            data.pop(key, None)
            if key in selected:
                data[key] = selected[key]
    migrate_parent = False
    if provider == "github-copilot" and copilot_state.get("parentMigrated") is not True:
        # 休眠プロファイルも、モデルと実効の思考レベルが旧既定と同じ場合だけ移す。
        legacy_model = "claude-sonnet-5.5"
        legacy_preferred = f"{provider}/{legacy_model}"
        legacy_pattern = preferred_model_pattern(scoped, legacy_preferred)
        per_model = data.get("modelThinkingLevels")
        legacy_effort = per_model.get(legacy_preferred, "medium") if isinstance(per_model, dict) else "medium"
        if legacy_pattern != legacy_preferred:
            legacy_effort = legacy_pattern.rsplit(":", 1)[-1]
        migrate_parent = (
            data.get("defaultModel") == legacy_model
            and data.get("defaultThinkingLevel") == legacy_effort == "medium"
        )
        if migrate_parent:
            data["defaultModel"] = fallback_model
        copilot_state["parentMigrated"] = True
    model = data.get("defaultModel")
    if not isinstance(model, str) or not model.strip():
        model = fallback_model
        data["defaultModel"] = model
    data.setdefault("defaultThinkingLevel", "medium")
    data["defaultProvider"] = provider
    if not scoped:
        scoped = [f"{provider}/*"]
    # Pi は新規セッションで候補の先頭を選ぶ。希望のモデルをプロバイダの glob より先に置く。
    preferred = f"{provider}/{model}"
    first = preferred if migrate_parent else preferred_model_pattern(scoped, preferred)
    data["enabledModels"] = [first, *(p for p in scoped if p != first)]
    saved.pop(provider, None)
    if saved:
        data["dotfilesWorkPiModels"] = saved
    else:
        data.pop("dotfilesWorkPiModels", None)
    return provider


def is_incremental(value: object) -> bool:
    return (
        isinstance(value, list)
        and len(value) > 0
        and all(isinstance(i, str) and i.startswith(("+", "-")) for i in value)
    )


def packages() -> list[str]:
    lines = (line.strip() for line in PACKAGES_TEXT.splitlines())
    return [line for line in lines if line and not line.startswith("#")]


def drop_marked(items: object, marks: tuple[str, ...]) -> list[object]:
    if not isinstance(items, list):
        return []
    return [i for i in items if not (isinstance(i, str) and any(i.startswith(m) or m in i for m in marks))]


def read_stdin() -> str:
    """標準入力を UTF-8 として読む。読めなければ、旧版が cp932 で書いた残りとして読み直す。

    背景と撤去の条件は docs/spec/agent-config-generation.md#旧版が書いた-cp932-のファイルの移行
    """
    data = sys.stdin.buffer.read()
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        text = data.decode("cp932")
    return text.replace("\r\n", "\n").replace("\r", "\n")  # text モードの標準入力と同じ改行の扱い


def main() -> int:
    # 標準出力は UTF-8 に固定する (Windows の既定は cp932)。入力は read_stdin が UTF-8 で読む。see docs/spec/agent-config-generation.md#modify-スクリプトの文字コード
    sys.stdout.reconfigure(encoding="utf-8")
    raw = read_stdin()
    try:
        data = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        sys.stdout.write(raw)  # 壊れた入力は触らない
        return 0
    if not isinstance(data, dict):
        sys.stdout.write(raw)
        return 0
    if not is_incremental(data.get("defaultTools")):
        data["defaultTools"] = list(DEFAULT_TOOLS)
    skills_not_list = "skills" in data and not isinstance(data["skills"], list)
    for key, marks in (("extensions", HARNESS_EXTENSION_MARKS), ("skills", HARNESS_SKILL_MARKS)):
        if key in data and not (key == "skills" and skills_not_list):
            kept = drop_marked(data[key], marks)
            if kept:
                data[key] = kept
            else:
                del data[key]
    skills = data.get("skills", [])
    if not skills_not_list:  # 配列でなければ触らない
        data["skills"] = skills + [i for i in EXCLUDED_SKILLS if i not in skills]
    data["packages"] = packages()
    copilot_state = data.get(WORK_COPILOT_MODEL_STATE) if IS_WORK else None
    if not isinstance(copilot_state, dict):
        copilot_state = {}
    work_provider = select_work_parent(data, copilot_state) if IS_WORK else None
    managed = copilot_state.get("managedModels")
    managed = {key: model for key, model in managed.items() if isinstance(model, str)} if isinstance(managed, dict) else {}
    if copilot_state.pop("researcherManaged", None) is True:
        managed.setdefault("researcher", WORK_COPILOT_MODELS["researcher"])
    if not IS_WORK:
        set_home_parent(data)
    if SHELL_PATH and "shellPath" not in data:  # 利用者が別のシェルを書いていれば保つ (pib が、囲いを指していないと知らせる)
        data["shellPath"] = SHELL_PATH
    subagents = data.get("subagents")
    if not isinstance(subagents, dict):
        subagents = {}
    overrides = subagents.get("agentOverrides")
    if not isinstance(overrides, dict):
        overrides = {}
    for name, tools in AGENT_TOOL_OVERRIDES.items():
        entry = overrides.get(name)
        if not isinstance(entry, dict):
            entry = {}
        if entry.get("tools") == LEGACY_AGENT_TOOLS.get(name):
            entry["tools"] = list(tools)
        entry.setdefault("tools", list(tools))
        overrides[name] = entry
    for name, prompt in SEARCH_AGENT_PROMPTS.items():
        # 組み込みの prompt は存在しないツール名を勧めるので、この repo の文面で置き換える (毎回これに揃える。管理するキー)
        overrides[name]["systemPrompt"] = prompt
    by_provider = subagents.get("agentOverridesByProvider")
    if not isinstance(by_provider, dict):
        by_provider = {}
    for provider, roles in PROVIDER_AGENT_MODELS.items():
        if work_provider is not None and provider != work_provider:
            # 非選択側には既定を生成しない。前の既定だけ除き、利用者の上書きは切り替え直すときのために残す。
            inactive = by_provider.get(provider)
            if isinstance(inactive, dict):
                for name, entry in list(inactive.items()):
                    known = {roles.get(name), *LEGACY_AGENT_MODELS.get((provider, name), ())}
                    # 新しい配分と偶然一致する利用者指定を、無効側の切り替えで消さない。
                    defaults = managed if provider == "github-copilot" else WORK_BEDROCK_MODELS
                    known.add(defaults.get(name))
                    if isinstance(entry, dict) and isinstance(entry.get("model"), str) and entry["model"] in known:
                        del entry["model"]
                        if not entry:
                            del inactive[name]
                if not inactive:
                    by_provider.pop(provider)
            if provider == "github-copilot":
                managed.clear()
            continue
        layer = by_provider.get(provider)
        if not isinstance(layer, dict):
            layer = {}
        profile_models = {}
        home_copilot = provider == "github-copilot" and not IS_WORK
        if provider == "github-copilot":
            profile_models = HOME_COPILOT_MODELS if home_copilot else WORK_COPILOT_MODELS
        elif IS_WORK:
            profile_models = WORK_BEDROCK_MODELS
        if home_copilot:
            delegate = layer.get("delegate")
            if isinstance(delegate, dict) and delegate.get("model") == LEGACY_HOME_COPILOT_MODELS["delegate"]:
                del delegate["model"]
                if not delegate:
                    del layer["delegate"]
        for name, model in (roles | profile_models).items():
            entry = layer.get(name)
            if not isinstance(entry, dict):
                entry = {}
            legacy = LEGACY_AGENT_MODELS.get((provider, name), ())
            if name in profile_models and name in roles:
                legacy += (roles[name],)
            if home_copilot and name in LEGACY_HOME_COPILOT_MODELS:
                legacy += (LEGACY_HOME_COPILOT_MODELS[name],)
            generated = "model" not in entry or entry["model"] in legacy
            if work_provider == "github-copilot":
                if generated:
                    managed[name] = model
                elif entry["model"] != managed.get(name):
                    managed.pop(name, None)
            if generated:
                entry["model"] = model
            layer[name] = entry
        by_provider[provider] = layer
    if IS_WORK:
        if managed:
            copilot_state["managedModels"] = managed
        else:
            copilot_state.pop("managedModels", None)
        if copilot_state:
            data[WORK_COPILOT_MODEL_STATE] = copilot_state
        else:
            data.pop(WORK_COPILOT_MODEL_STATE, None)
    subagents["agentOverridesByProvider"] = by_provider
    subagents["agentOverrides"] = overrides
    data["subagents"] = subagents
    add_compaction_overrides(data)
    json.dump(data, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
