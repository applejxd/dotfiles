{
  "shellTools": {
    "bg_run": { "commandArgument": "command", "workdirArgument": "cwd" }
  },
  "commandEffects": {
    "git": {
      "unlessOption": ["--output"],
      "subcommands": { "log": "read", "status": "read", "diff": "read", "show": "read" }
    },
    "python3": { "unlessOption": ["-c", "-m"], "effects": ["read"] }
  },
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*id_dsa*": "deny",
      "*id_ecdsa*": "deny",
      "*id_ed25519*": "deny",
      "~/.netrc": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.config/agents/websearch-keys.json": "deny",
      "~/.pi/agent/auth.json": { "action": "deny", "reason": "pi の認証情報は読まない・書かない。必要なら利用者に依頼する" },
      "~/.pi/agent/trust.json": { "action": "deny", "reason": "pi の信頼の設定はいじらない。必要なら利用者に依頼する" },
      "~/.pi/agent/models.json": { "action": "deny", "reason": "pi のモデル設定（鍵を含む）は読まない・書かない。必要なら利用者に依頼する" },
      "~/.pi/agent/models-store.json": { "action": "deny", "reason": "pi のモデル設定（鍵を含む）は読まない・書かない。必要なら利用者に依頼する" },
      "~/.pi/agent/mcp.json": { "action": "deny", "reason": "MCP の設定（認証を含む）は読まない・書かない。元データはリポジトリの [[mcp]]" },
      "~/.pi/agent/ayu/*": { "action": "deny", "reason": "pi-rewind のスナップショット（作業ツリーのコピー）は読まない。戻すなら /rewind を使う" }
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "bash": {
      "*": "allow",
      "rg *--pre*": "ask",
      "sudo *": { "action": "deny", "reason": "sudo は使わない" },
      "git push*": { "action": "deny", "reason": "push は利用者が行う" },
      "sh": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "bash": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "zsh": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "dash": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "sh -": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "bash -": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "sh -s*": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "bash -s*": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "gh *auth token*": { "action": "deny", "reason": "秘密を取得するコマンドは使わない。必要なら利用者が実行する" },
      "gh *secret set*": { "action": "deny", "reason": "秘密を取得するコマンドは使わない。必要なら利用者が実行する" },
      "gh *secret list*": { "action": "deny", "reason": "秘密を取得するコマンドは使わない。必要なら利用者が実行する" },
      "bw get*": { "action": "deny", "reason": "秘密を取得するコマンドは使わない。必要なら利用者が実行する" },
      "bw list*": { "action": "deny", "reason": "秘密を取得するコマンドは使わない。必要なら利用者が実行する" },
      "bw export*": { "action": "deny", "reason": "秘密を取得するコマンドは使わない。必要なら利用者が実行する" },
      "op read*": { "action": "deny", "reason": "秘密を取得するコマンドは使わない。必要なら利用者が実行する" },
      "op item get*": { "action": "deny", "reason": "秘密を取得するコマンドは使わない。必要なら利用者が実行する" },
      "vault read*": { "action": "deny", "reason": "秘密を取得するコマンドは使わない。必要なら利用者が実行する" },
      "vault kv get*": { "action": "deny", "reason": "秘密を取得するコマンドは使わない。必要なら利用者が実行する" },
      "chezmoi secret*": { "action": "deny", "reason": "秘密を取得するコマンドは使わない。必要なら利用者が実行する" },
      "printenv": { "action": "deny", "reason": "環境変数の一覧は出さない（秘密が混ざる）。必要な 1 つだけ printenv <名前> で読む" },
      "env": { "action": "deny", "reason": "環境変数の一覧は出さない（秘密が混ざる）。必要な 1 つだけ printenv <名前> で読む" },
      "gh *pr create*": "ask",
      "gh *pr edit*": "ask",
      "gh *pr review*": "ask",
      "gh *pr comment*": "ask",
      "gh *pr close*": "ask",
      "gh *pr reopen*": "ask",
      "gh *pr ready*": "ask",
      "gh *pr merge*": "ask",
      "gh *issue create*": "ask",
      "gh *issue edit*": "ask",
      "gh *issue comment*": "ask",
      "gh *issue close*": "ask",
      "gh *issue reopen*": "ask",
      "gh *issue lock*": "ask",
      "gh *issue unlock*": "ask",
      "gh *issue transfer*": "ask",
      "gh *issue pin*": "ask",
      "gh *issue unpin*": "ask",
      "gh *issue delete*": "ask",
      "gh *repo fork*": "ask",
      "gh *repo rename*": "ask",
      "gh *repo archive*": "ask",
      "gh *repo unarchive*": "ask",
      "gh *repo create*": "ask",
      "gh *repo edit*": "ask",
      "gh *repo delete*": "ask",
      "gh *release create*": "ask",
      "gh *release edit*": "ask",
      "gh *release delete*": "ask",
      "gh *release upload*": "ask",
      "gh *workflow run*": "ask",
      "gh *workflow enable*": "ask",
      "gh *workflow disable*": "ask",
      "gh *variable set*": "ask",
      "gh *variable delete*": "ask",
      "gh *gist create*": "ask",
      "gh *gist edit*": "ask",
      "gh *gist delete*": "ask",
      "gh api *-X*": "ask",
      "gh api *--method*": "ask",
      "gh api *-f *": "ask",
      "gh api *-F *": "ask",
      "gh api *--field*": "ask",
      "gh api *--raw-field*": "ask",
      "gh api *--input*": "ask",
      "chezmoi *apply*": "ask",
      "chezmoi *update*": "ask",
      "npm publish*": "ask",
      "yarn publish*": "ask",
      "pnpm publish*": "ask",
      "uv publish*": "ask",
      "twine upload*": "ask",
      "cargo publish*": "ask",
      "gem push*": "ask",
      "docker push*": "ask",
      "git rebase*": "ask",
      "git -C * rebase*": "ask",
      "git config*": "ask",
      "git -C * config*": "ask",
      "git filter-branch*": "ask",
      "git -C * filter-branch*": "ask",
      "git update-ref -d*": "ask",
      "git -C * update-ref -d*": "ask",
      "git reflog expire*": "ask",
      "git -C * reflog expire*": "ask",
      "git worktree remove*": "ask",
      "git -C * worktree remove*": "ask",
      "git remote add*": "ask",
      "git -C * remote add*": "ask",
      "git remote set-url*": "ask",
      "git -C * remote set-url*": "ask",
      "git config --get *": "allow",
      "git config --list*": "allow",
      "git config -l*": "allow",
      "scp *": "ask",
      "sftp *": "ask",
      "ssh *": "ask",
      "rsync *": "ask",
      "socat *": "ask",
      "ncat *": "ask",
      "nc *": "ask",
      "telnet *": "ask",
      "aws s3 cp*": "ask",
      "aws s3 sync*": "ask",
      "gsutil cp*": "ask",
      "az storage blob upload*": "ask",
      "crontab*": "ask",
      "at *": "ask",
      "batch*": "ask",
      "systemctl enable*": "ask",
      "systemctl disable*": "ask",
      "systemctl mask*": "ask",
      "systemctl start*": "ask",
      "systemctl stop*": "ask",
      "systemctl restart*": "ask",
      "systemctl daemon-reload*": "ask",
      "systemd-run*": "ask",
      "fdisk*": "ask",
      "parted*": "ask"
    },
    "mcp": {
      "*": "ask",
      "websearch": "allow",
      "agentcore-websearch": "allow"
    },
    "skill": {
      "*": "allow",
      "agent-workflow": { "action": "deny", "reason": "自作基盤（フルガード・計画モード・guarded_task）前提で、stock の pi では使えない。custom プロファイルへ戻すときはこの deny を外す" }
    },
    "todo": "allow",
    "ask_user_question": "allow",
    "subagent": "allow",
    "subagents_enable": "allow",
    "subagent_supervisor": "allow",
    "contact_supervisor": "allow",
    "intercom": "allow",
    "structured_output": "allow",
    "subagent_command": "allow",
    "subagent_launch": "allow",
    "bg_wait": "allow",
    "bg_status": "allow",
    "bg_kill": "allow",
    "plan_mode_question": "allow",
    "plan_mode_complete": "allow",
    "goal_complete": "allow",
    "goal_blocked": "allow",
    "goal_wait": "allow",
    "external_directory": { "*": "ask", "/tmp/*": "allow" },
    "external_directory_read": {
      "~/.pi/agent/npm/*": "allow",
      "~/.pi/agent/install/*": "allow",
      "~/.pi/agent/extensions/*": "allow",
      "~/.pi/agent/extensions/*/logs": "ask",
      "~/.pi/agent/extensions/*/logs/*": "ask",
      "~/.pi/agent/agents/*": "allow",
      "~/.pi/agent/git/*": "allow",
      "~/.pi/agent/prompts/*": "allow",
      "~/.pi/agent/skills/*": "allow",
      "~/.pi/agent/themes/*": "allow",
      "~/.pi/agent/AGENTS.md": "allow",
      "~/.pi/agent/settings.json": "allow",
      "~/.agents/skills": "allow",
      "~/.agents/skills/*": "allow",
      "/tmp": "allow",
      "/mnt/c/Users/applejxd/AppData/Local/Temp/orca-paste-*": "allow"
    }
  }
}
