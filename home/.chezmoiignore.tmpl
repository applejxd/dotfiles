# see https://www.chezmoi.io/reference/special-files/chezmoiignore/

# OS dependent modules
{{ if eq .chezmoi.os "windows" }}
# Unix のみ
.chezmoiscripts/000_unix/
.chezmoiscripts/000_unix/**
.chezmoiscripts/400_unix/
.chezmoiscripts/400_unix/**
.config/*
# AI CLI の共通ポリシーは Windows native でも必要
!.config/agents/
!.config/agents/command_policy.py
!.config/agents/common.toml
!.config/agents/agentcore_websearch_mcp.py
# Git の user (Bitwarden 由来) と global ignore。~/.gitconfig が [include] で読む。
# ディレクトリだけを戻す。/** で戻すと、下の「一度だけ展開する」除外まで打ち消す
!.config/git/
# Windows 向け mise 設定は gh / Herdr を宣言する (AI CLI は 314 が公式手段で導入)
!.config/mise/
!.config/mise/config.toml
# PowerShell プロファイルの実体 (Documents 配下は 1 行のローダーのみ)
!.config/powershell/
!.config/powershell/**
# OpenCode は 314 が Windows にも入れる。permission と guide plugin が無いと保護が無い
# see docs/spec/agent-permissions.md#windows-での扱い
!.config/opencode/
!.config/opencode/**
.config/tmuxinator/
.config/tmuxinator/**
.bash_profile
.bashrc
.gdbinit
.profile
.tmux.conf
.Xmodmap
.xsession
.xsessionrc
.zshenv
.zshrc
# Windows は権限不要の directory junction をスクリプトで作成
.copilot/skills
# pi 本体と設定は Windows にも配る。ハーネス (.config/pi) と pis は Unix だけで、
# ハーネス無しでは guarded_task が無く /fleet が働かないので prompts も配らない
# see docs/spec/pi-harness.md#windows
.pi/agent/prompts/
.pi/agent/prompts/**
.local/bin/pis
{{- else }}
# windows のみで導入
.chezmoiscripts/300_windows/
.chezmoiscripts/300_windows/**
.config/powershell/
.config/powershell/**
.wslconfig
AppData/
AppData/**
Documents/
Documents/**
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
# Mac OS X のみ
.chezmoiscripts/200_mac/
.chezmoiscripts/200_mac/**
.config/shell/osxenv.sh
.config/shell/osxrc.sh
.mackup.cfg
{{- end }}

{{- if ne .chezmoi.os "linux" }}
# OpenCode を bwrap で囲う起動スクリプトは Ubuntu / WSL 専用
# see docs/change/closed/0004-opencode-sandbox.md
.local/bin/ocs
.local/bin/ocs-boundary-check
.local/share/ocs
.local/share/ocs/**
.local/state/opencode-sandbox
.local/state/opencode-sandbox/**
# OpenCode の運用の小道具。Linux 以外では試していない
# see docs/spec/agent-permissions.md#保存した承認の確認とリセット
.local/bin/oc-utils
{{- end }}

{{- if ne .chezmoi.os "windows" }}
# 常駐サービスのポートを Windows だけ WSL からずらす。ほかでは OpenCode に任せる
# see docs/spec/agent-config-generation.md#常駐サービスのポート
.config/opencode/service.json
{{- end }}

{{- if eq .chezmoi.os "linux" }}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
.chezmoiscripts/100_linux/110_native/
.chezmoiscripts/100_linux/110_native/**
{{-   else }}
# WSL のみで導入
.chezmoiscripts/100_linux/120_wsl.sh
.config/shell/wslenv.sh
{{-     if eq (includeTemplate "is-raspi" .) "true" }}
# Raspberry Pi (ヘッドレス) では導入しない。
# VS Code 本体と拡張 20 個は SD カードを数百 MB 食うが、Remote-SSH で繋ぐ側に
# あればよい。i3 / polybar / X11 関連も接続する画面が無いと使わない。
.chezmoiscripts/100_linux/110_native/
.chezmoiscripts/100_linux/110_native/**
.config/i3/
.config/i3/**
.config/polybar/
.config/polybar/**
.Xmodmap
.xsession
.xsessionrc
{{-     end }}
{{-   end }}
{{- else }}
# Linux のみで導入
.chezmoiscripts/100_linux/
.chezmoiscripts/100_linux/**
{{- end }}

{{- if not (regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username) }}
# 個人 PC のみで導入
.config/git/user
.config/sops/age/keys.txt
.vscode-server/
.vscode-server/**
{{- end }}

# Bitwarden 由来のファイルは一度のみ展開する
# (毎回 Bitwarden を引くと chezmoi diff がマスターパスワードを要求するため)
#
# 展開済みかどうかとは別に BW_SESSION の有無でも判定する。セッションが無いと
# chezmoi が bw unlock を走らせ、未ログインの環境では
# 「You are not logged in.」で apply 全体が止まるため。
# 展開するときは次を実行する:
#   bw login && export BW_SESSION="$(bw unlock --raw)" && chezmoi apply
{{- $bwSession := ne (env "BW_SESSION") "" }}

{{- if or (not $bwSession) (stat (joinPath .chezmoi.homeDir ".config/sops/age/keys.txt")) }}
.config/sops/age/keys.txt
{{- end }}

{{- if or (not $bwSession) (stat (joinPath .chezmoi.homeDir ".config/git/user")) }}
.config/git/user
{{- end }}

# Python bytecode (generated at runtime, not part of dotfiles)
**/__pycache__
**/__pycache__/**
**/*.pyc

# Orca (stablyai/orca) が生成・管理する実体。いずれもマシン固有の内容
# (Windows 側の絶対パス、バージョンピン、worktree 実体) を含み、Orca 自身が
# 再生成・更新するため chezmoi では追跡しない。
# ここに列挙しておくと `chezmoi add` も警告を出して取り込みを拒否する。
#
# なお Orca は各 AI CLI の設定ファイルへ hook を注入する。それらは
# scripts/agents/generate.py が「自分の生成したエントリだけを差し替える」
# 実装になっているため、chezmoi apply で消えることはない。
# see docs/spec/agent-permissions.md
.orca
.orca/**
.orca-relay
.orca-relay/**
.orca-wsl
.orca-wsl/**
.local/share/orca
.local/share/orca/**
.local/bin/orca-ide
orca
orca/**

# npx skills (vercel-labs/skills) が管理する skill ストア。
# Orca が初回起動時にインストールを促し、以降も Orca 側が更新を管理するため
# chezmoi では追跡しない (二重管理を避ける)。
.agents
.agents/**

# powerpoint-studio スキルが実行時に作る成果物。
# スキル本体 (SKILL.md / scripts / assets / references / lock ファイル) は
# chezmoi の配布対象だが、以下は実行のたびに再生成されるため追跡しない。
# ここに列挙しておくと `chezmoi add` も警告を出して取り込みを拒否する。
#
# - .venv / node_modules: uv と npm が作る依存の実体
# - .pytest_cache / .ruff_cache / .tmp: ツールの作業領域
# - evals/*: 評価の入出力。生成物と実行ログで、レビュー対象ではない
.claude/skills/powerpoint-studio/.venv
.claude/skills/powerpoint-studio/.venv/**
.claude/skills/powerpoint-studio/node_modules
.claude/skills/powerpoint-studio/node_modules/**
.claude/skills/powerpoint-studio/.pytest_cache
.claude/skills/powerpoint-studio/.pytest_cache/**
.claude/skills/powerpoint-studio/.ruff_cache
.claude/skills/powerpoint-studio/.ruff_cache/**
.claude/skills/powerpoint-studio/.tmp
.claude/skills/powerpoint-studio/.tmp/**
.claude/skills/powerpoint-studio/evals/files
.claude/skills/powerpoint-studio/evals/files/**
.claude/skills/powerpoint-studio/evals/runs
.claude/skills/powerpoint-studio/evals/runs/**
.claude/skills/powerpoint-studio/evals/blind
.claude/skills/powerpoint-studio/evals/blind/**
.claude/skills/powerpoint-studio/evals/final-verification
.claude/skills/powerpoint-studio/evals/final-verification/**

# herdr の skill は run_after の herdr_integration が `herdr --skill` から毎回生成する。
# 取り込むと版が固定されて本体の更新に追従しなくなる。see docs/spec/structure.md
.claude/skills/herdr
.claude/skills/herdr/**
