#!{{ lookPath "bash" }}
# chezmoi modify_ script: rewrite permissions section of ~/.claude/settings.json
# from the single source of truth at home/dot_config/agents/common.toml.
# Other keys (hooks, env, plugins, ...) are preserved.
set -eu

REPO="{{ .chezmoi.workingTree }}"
COMMON="${REPO}/home/dot_config/agents/common.toml"
GENERATOR="${REPO}/scripts/agents/generate.py"

if [ ! -f "${COMMON}" ] || [ ! -f "${GENERATOR}" ]; then
  cat
  exit 0
fi

python3 "${GENERATOR}" --target claude-settings --common "${COMMON}" --existing /dev/stdin
