#!/usr/bin/env python3
"""pi をフルガード付きで起動する ``pis`` の入口。

usage: pis [--bypass] [--no-sandbox] [--role <役割>] [--] [pi の引数...]  (標準はサンドボックスの中)
本体は ``~/.local/share/ocs/pis.py``（隔離起動 ``ocs`` と同じ置き場）。ここから絶対パスで読み込み、
**sys.path・PYTHONPATH・カレントディレクトリからは探さない**（``ocs`` の入口と同じ読み込み）。
see docs/spec/pi-guard.md#起動
"""

from __future__ import annotations

import importlib
import importlib.util
import sys
from pathlib import Path

LIB = Path.home() / ".local/share/ocs"
PACKAGE = "ocs_lib"


def load(lib: Path):
    """``lib`` をパッケージとして読み込み、その ``pis`` を返す。"""
    for name in [n for n in sys.modules if n == PACKAGE or n.startswith(PACKAGE + ".")]:
        del sys.modules[name]
    spec = importlib.util.spec_from_file_location(
        PACKAGE, lib / "__init__.py", submodule_search_locations=[str(lib)]
    )
    if spec is None or spec.loader is None:
        raise ImportError(f"{lib} を読み込めない")
    package = importlib.util.module_from_spec(spec)
    sys.modules[PACKAGE] = package
    spec.loader.exec_module(package)
    return importlib.import_module(f"{PACKAGE}.pis")


if __name__ == "__main__":
    # 配備先へ __pycache__ を作らない (chezmoi の管理対象と中身を揃える)
    sys.dont_write_bytecode = True
    if not (LIB / "pis.py").is_file():
        print(f"pis: 本体が無い: {LIB}。chezmoi apply で配備する", file=sys.stderr)
        sys.exit(1)
    sys.exit(load(LIB).main())
