#!/bin/bash

set -euo pipefail

sudo -v

{{- $raspi := eq (includeTemplate "is-raspi" .) "true" }}

#-------------------#
# apt ソースの掃除  #
#-------------------#
# 壊れた・重複した登録を残すと apt update が毎回警告を出す。
# 掃除は update より前に行う (警告のもとを先に消すため)。

# VS Code: code パッケージが置く vscode.sources と、111_microsoft が過去に
# 置いた vscode.list が二重登録になる。110_native は Raspberry Pi では
# 無視されるため、掃除はここに置く (全 Linux で走る)。
if [[ -e /etc/apt/sources.list.d/vscode.sources && -e /etc/apt/sources.list.d/vscode.list ]]; then
    echo "VS Code の APT ソースが二重なので自前の .list を削除します"
    sudo rm -f /etc/apt/sources.list.d/vscode.list
fi

# GitHub CLI の APT 登録には触らない (鍵の更新も削除もしない)。
# gh は mise へ移したが、既存の登録・鍵・認証は自動で変更しない方針。
# NO_PUBKEY の警告が出る場合の手当ては docs/spec/troubleshooting-bootstrap.md#apt-update-が-github-cli-の-no_pubkey-を警告する を参照。

# Refresh
echo "Ubuntu パッケージを更新します..."
sudo apt-get update && sudo apt-get upgrade -y
echo "✅ 完了：Ubuntu パッケージを更新しました"

#--------#
# config #
#--------#

{{- if not $raspi }}

# Known folders
# xdg-user-dirs-update は Desktop 版にしか無い (Server / WSL では skip)
if command -v xdg-user-dirs-update >/dev/null 2>&1; then
    echo "既知のフォルダを整理します..."
    LANG=C xdg-user-dirs-update --force
    rm -rf デスクトップ ダウンロード テンプレート 公開 ドキュメント ミュージック ピクチャ ビデオ
    echo "✅ 完了：既知のフォルダを整理しました"
else
    echo "xdg-user-dirs-update が無いので既知のフォルダの整理を飛ばします"
fi
{{- end }}

# Basics
echo "基本的なツールをインストール/更新します..."
sudo apt-get install -y \
    wget curl git unzip tree tig jq \
    python3-tomlkit manpages-ja xdg-utils

{{- if not $raspi }}

# GUI (デスクトップ環境。ヘッドレスでは入れない)
sudo apt-get install -y \
    xsel i3 rofi polybar lxappearance
{{- end }}

# Build tools
# libyaml-dev は ruby の psych 拡張に要る (docs/spec/structure.md#ruby-はプレビルドで入れる)
sudo apt install -y \
    make cmake gcc g++ clang clang-tidy libclang-dev pkg-config build-essential \
    libyaml-dev

# clang が選ぶ最新の gcc に合わせる (docs/spec/structure.md#clang-が-c-の標準ヘッダを見つけられるようにする)
gcc_latest="$(find "/usr/lib/gcc/$(gcc -dumpmachine)" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort -V | tail -n 1)"
if apt-cache show "libstdc++-${gcc_latest}-dev" >/dev/null 2>&1; then
    sudo apt-get install -y "libstdc++-${gcc_latest}-dev"
fi

# sandbox tools
# 1 つでも欠けると AI CLI の sandbox が起動を拒否する
# (docs/research/agents/sandbox-capabilities.md#35-linux-の依存)
sudo apt-get -y install bubblewrap slirp4netns util-linux iptables socat

{{- if not $raspi }}

# use gtk instead of gnome for GUI in i3wm
# see https://www.simple-web-system.work/entry/2023/09/02/012031
echo "i3wm で GUI アプリケーションを使うための設定を行います..."
systemctl --user mask xdg-desktop-portal-gnome
{{- end }}

echo "✅ 完了：基本的なツールをインストール/更新しました"

{{- if $raspi }}

# メモリ枯渇で SSH ごと固まるのを防ぐ
# (docs/spec/structure.md#メモリが尽きても-ssh-できるようにする)
echo "zram と earlyoom をインストール/設定します..."
sudo apt-get install -y zram-tools earlyoom
# Ubuntu for Raspberry Pi は zram モジュールを別パッケージに分けている
if ! modinfo zram >/dev/null 2>&1; then
    sudo apt-get install -y linux-modules-extra-raspi
fi
sudo tee /etc/default/zramswap >/dev/null <<'EOF'
ALGO=zstd
PERCENT=50
PRIORITY=100
EOF
sudo tee /etc/sysctl.d/99-zram.conf >/dev/null <<'EOF'
vm.swappiness=100
vm.page-cluster=0
EOF
# systemd が空白で分割して渡すので、正規表現に空白や引用符を入れない
sudo tee /etc/default/earlyoom >/dev/null <<'EOF'
EARLYOOM_ARGS="-r 3600 --avoid ^(sshd|systemd|systemd-journal|systemd-logind|tailscaled)$"
EOF
sudo sysctl -q -p /etc/sysctl.d/99-zram.conf
# systemd の無い環境 (コンテナなど) では設定だけ置いて先へ進む
if [ ! -d /run/systemd/system ]; then
    echo "systemd が動いていないので earlyoom / zramswap の再起動を飛ばします"
elif ! modinfo zram >/dev/null 2>&1; then
    sudo systemctl restart earlyoom.service
    # カーネル更新の直後は、実行中のカーネル用のモジュールがまだ無い
    echo "zram は次の再起動から有効になります"
else
    sudo systemctl restart earlyoom.service
    sudo systemctl restart zramswap.service
fi
echo "✅ 完了：zram と earlyoom をインストール/設定しました"
{{- end }}

{{- if eq .chezmoi.os "linux" }}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
echo "ユーティリティツールをインストール/更新します..."
sudo apt-get install -y imagemagick ffmpeg
echo "✅ 完了：ユーティリティツールをインストール/更新しました"
{{-   end }}
{{- end }}

{{- if and (regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username) (not $raspi) }}
# Raspberry Pi では入れない。clamd が常駐で 1GB 超を占める
# (docs/spec/structure.md#raspberry-pi)
echo "ClamAV をインストール/更新します..."

echo "Installing security tools..." >&2
sudo apt-get -y install clamav clamav-daemon
# systemd の無い環境 (コンテナなど) ではサービスが動かないので、定義の更新ごと飛ばす
if [ -d /run/systemd/system ]; then
    sudo systemctl stop clamav-freshclam
    sudo freshclam
    sudo systemctl start clamav-daemon.service
    sudo systemctl start clamav-freshclam.service
else
    echo "systemd が動いていないので ClamAV のサービス操作と定義の更新を飛ばします"
fi

echo "✅ 完了：ClamAV をインストール/更新しました"
{{- end }}
