#!/bin/bash

set -euo pipefail

# 125 の mise bootstrap は別プロセスなので、PATH の activate に依存しない。
mise_path="${HOME}/.local/bin/mise"
herdr_path="$("$mise_path" -C "$HOME" which herdr)"
if [[ ! -x "$herdr_path" ]]; then
    echo "Herdr is not available at ${herdr_path}" >&2
    exit 1
fi

# `herdr integration install` は settings.json を末尾改行なしで書き戻す。
# この run_after_ は apply のたびに走るので、chezmoi が書いた形式 (末尾改行あり)
# へ戻さないと chezmoi diff に恒常的な差分が出続ける。
normalize_trailing_newline() {
    local path="$1"
    if [[ -s "$path" && -n "$(tail -c 1 "$path")" ]]; then
        printf '\n' >>"$path"
    fi
}

{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}
agent_command="copilot"
{{- else }}
agent_command="claude"
{{- end }}
# AI CLI は mise ではなく公式インストーラーで入るため、shell の activate 前でも
# 見つかるよう 126 の導入先を PATH へ足してから探す。
PATH="${HOME}/.local/bin:${HOME}/.opencode/bin:$PATH"
export PATH
agent_path="$(command -v "$agent_command" || true)"
if [[ ! -x "$agent_path" ]]; then
    echo "${agent_command} is not available on PATH" >&2
    exit 1
fi
"$herdr_path" integration install "$agent_command"
normalize_trailing_newline "${HOME}/.${agent_command}/settings.json"

skill_dir="${HOME}/.claude/skills/herdr"
skill_path="${skill_dir}/SKILL.md"
mkdir -p "$skill_dir"
skill_tmp="$(mktemp "${skill_dir}/.herdr-skill.XXXXXX")"
trap 'rm -f "$skill_tmp"' EXIT

"$herdr_path" --skill > "$skill_tmp"
if ! grep -q '^name: herdr$' "$skill_tmp"; then
    echo "Herdr returned an invalid agent skill" >&2
    exit 1
fi

chmod 0644 "$skill_tmp"
mv -f "$skill_tmp" "$skill_path"
