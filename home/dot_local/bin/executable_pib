#!/usr/bin/env python3
"""pi を、ツール単位の sandbox 拡張 (@yuru7/pi-sandbox) つきで起動する ``pib``。

runner・設定が配備されていないときは起動しない。拡張が既定の runner に黙って切り替わり、GPU も秘密の隠蔽も効かなくなるため。
see docs/spec/sandbox/pi-sandbox-runner.md#導入と確認
"""

from __future__ import annotations

import json
import os
import sys
from collections.abc import Mapping, Sequence
from pathlib import Path

EXTENSION = "npm:@yuru7/pi-sandbox@0.5.0"  # 版の固定。更新の手順は docs
PREFIX = "pib:"


def problems(env: Mapping[str, str], home: Path) -> list[str]:
    """runner・設定・拡張の設定のうち、足りないもの (空なら起動してよい)。"""
    runner = home / ".local" / "bin" / "pi-sandbox-runner"
    config = Path(
        env.get("PI_SANDBOX_RUNNER_CONFIG")
        or Path(env.get("XDG_CONFIG_HOME") or home / ".config") / "pi-sandbox" / "runner.toml"
    )
    agent_dir = Path(env.get("PI_CODING_AGENT_DIR") or home / ".pi" / "agent")
    settings = agent_dir / "pi-sandbox.json"

    found: list[str] = []
    if not os.access(runner, os.X_OK):
        found.append(f"runner が無い、または実行できない: {runner}")
    if not config.is_file():
        found.append(f"runner の設定が無い: {config}")
    try:
        data = json.loads(settings.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return [*found, f"拡張の設定を読めない: {settings}"]
    command = data.get("runnerCommand") if isinstance(data, dict) else None
    signatures = data.get("runnerFailureSignatures") if isinstance(data, dict) else None
    if not (isinstance(command, list) and command and Path(str(command[0])).name == runner.name):
        found.append(f"{settings} の runnerCommand が {runner.name} を指していない")
    if not (isinstance(signatures, list) and signatures):
        found.append(f"{settings} に runnerFailureSignatures が無い (runnerCommand と対で要る)")
    return found


def main(argv: Sequence[str], env: Mapping[str, str] | None = None) -> int:
    env = os.environ if env is None else env
    found = problems(env, Path(env.get("HOME") or Path.home()))
    if found:
        for line in found:
            print(f"{PREFIX} {line}", file=sys.stderr)
        print(f"{PREFIX} chezmoi apply で配備してから起動する", file=sys.stderr)
        return 2
    os.execvp("pi", ["pi", "-e", EXTENSION, *argv])  # 戻らない


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
