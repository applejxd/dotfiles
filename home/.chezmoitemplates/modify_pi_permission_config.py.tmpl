#!/usr/bin/env python3
"""pi の stock プロファイルの ~/.pi/agent/extensions/pi-permission-system/config.json。標準入力の現状を変換して出す。

@gotgenes/pi-permission-system (確認画面の役) の設定。リポジトリが持つのは方針
(permission・commandEffects) と shellTools の自分の項目 (bg_run) で、permission・commandEffects は毎回この値で置き換える。
shellTools は利用者が足した他の項目を保ち、リポジトリが持つ項目だけをこの値にする (マージ)。yoloMode など実行時の値
(拡張が /permission-system で書き換える) は、既存のファイルの値を保つ。無いものは拡張の既定で補う。
壊れた入力は触らない。何度流しても同じ結果になる。
方針の元データは home/.chezmoitemplates/pi-permission-policy.json (単一の編集点)。
see docs/spec/agent-config-generation.md#pi-の設定
"""
from __future__ import annotations

import json
import sys

POLICY = json.loads({{ .policy | toJson }})

# 拡張の既定 (docs/configuration.md の Runtime Knobs)。既存のファイルに無いときだけ補う
RUNTIME_DEFAULTS = {
    "debugLog": False,
    "permissionReviewLog": True,
    "yoloMode": False,
    "doublePressToConfirm": True,
    # 承認待ちのダイアログが開くときに端末の BEL を鳴らす (Zed・Orca がフォーカス外の端末の BEL を通知にする)。利用者が変えた値は保つ
    "promptNotifications": ["bell"],
    # 誰も答えない確認は、この時間 (ミリ秒) の後に拒否して先へ進む (承認は決してしない)。離席中に、確認 1 件で全体が止まらないようにする。
    # 答え始める (キーを押す) と時計は止まる。利用者が変えた値は保つ。see docs/spec/agent-config-generation.md#permission-system-の設定
    "promptTimeoutMs": 300000,
}


def main() -> int:
    raw = sys.stdin.read()
    try:
        data = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        sys.stdout.write(raw)  # 壊れた入力は触らない
        return 0
    if not isinstance(data, dict):
        sys.stdout.write(raw)
        return 0
    for key, value in RUNTIME_DEFAULTS.items():
        data.setdefault(key, value)
    policy = dict(POLICY)
    shell_tools = policy.pop("shellTools", {})
    data.update(policy)  # permission・commandEffects はリポジトリの値で置き換える
    if shell_tools:
        current = data.get("shellTools")
        merged = dict(current) if isinstance(current, dict) else {}
        merged.update(shell_tools)  # リポジトリの項目だけ置き換え、利用者の他の項目は保つ
        data["shellTools"] = merged
    json.dump(data, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
