{
  "config": {
    "default": true,
    // 行長は日本語混じりだと桁数の意味が薄いので見ない
    "MD013": false,
    // 「### 症状 / 原因 / 対処」のように、節ごとに同じ小見出しを繰り返す
    // 構成を許す。親が違う見出しは重複とみなさない。
    "MD024": { "siblings_only": true }
  },
  "ignores": [
    "node_modules",
    ".venv",
    // imozuru (MIT) の上流の文書。上流と同一に保つ (sha256 を references/upstream.md に記録)
    "home/dot_agents/skills/imozuru/references/theory.md",
    // conference-video の vendor/ (manim-skill、MIT) の上流の文書。無改変で保つ (vendor/UPSTREAM.md)
    "home/dot_agents/skills/conference-video/vendor/**",
    // pi-subagents (MIT) の組み込みの agent の写し。prompt なので上流と同一に保つ (permission の行だけ足してある。試験が食い違いを見る)
    "home/dot_pi/agent/agents/**",
    // pi の prompt template。先頭は frontmatter で、見出しから始まらない（コマンドの本文そのもの）
    "home/dot_pi/agent/prompts/**"
  ]
}
