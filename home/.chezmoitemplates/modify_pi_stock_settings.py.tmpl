#!/usr/bin/env python3
"""pi の stock プロファイルの ~/.pi/agent/settings.json。標準入力の現状を変換して出す。

自作ハーネスが入れた設定だけを取り除き、packages を pi-stock-packages の内容にする。
利用者のキー (テーマ・既定のモデルなど) は触らない。何度流しても同じ結果になる。
see docs/spec/agent-config-generation.md#pi-のプロファイルcustom-と-stock
"""
from __future__ import annotations

import json
import sys

PACKAGES_TEXT = {{ .packages | toJson }}

# 自作ハーネスだけが入れる extensions / skills の項目 (scripts/agents/generate.py の宣言に対応)
HARNESS_EXTENSION_MARKS = (".config/pi/harness", "!extensions/**", "+extensions/", "-builtin:")
HARNESS_SKILL_MARKS = ("~/.claude/skills", "-~/.agents/skills/", "-~/.claude/skills/")

# pi の既定 (read・bash・edit・write) に、読み取り専用の探索ツールを足す (増分指定)。plan mode の探索と通常の探索で使う
# 利用者が +/- だけの増分指定に変えていたら保つ。自作ハーネスの全置換の値 (["read"] など) は初期値に置き換える
DEFAULT_TOOLS = ["+grep", "+find", "+ls"]


def is_incremental(value: object) -> bool:
    return (
        isinstance(value, list)
        and len(value) > 0
        and all(isinstance(i, str) and i.startswith(("+", "-")) for i in value)
    )


def packages() -> list[str]:
    lines = (line.strip() for line in PACKAGES_TEXT.splitlines())
    return [line for line in lines if line and not line.startswith("#")]


def drop_marked(items: object, marks: tuple[str, ...]) -> list[object]:
    if not isinstance(items, list):
        return []
    return [i for i in items if not (isinstance(i, str) and any(i.startswith(m) or m in i for m in marks))]


def main() -> int:
    raw = sys.stdin.read()
    try:
        data = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        sys.stdout.write(raw)  # 壊れた入力は触らない
        return 0
    if not isinstance(data, dict):
        sys.stdout.write(raw)
        return 0
    if not is_incremental(data.get("defaultTools")):
        data["defaultTools"] = list(DEFAULT_TOOLS)
    for key, marks in (("extensions", HARNESS_EXTENSION_MARKS), ("skills", HARNESS_SKILL_MARKS)):
        if key in data:
            kept = drop_marked(data[key], marks)
            if kept:
                data[key] = kept
            else:
                del data[key]
    data["packages"] = packages()
    json.dump(data, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
