[init]
	defaultBranch = main
[credential]
{{- if eq .chezmoi.os "windows" }}
	helper = wincred
{{- else if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else }}
	helper = store
{{- end }}

# gh auth setup-git configuration for GitHub CLI
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[core]
	editor = vim
	quotepath = false
	# ~/.config/git/ignore (chezmoi管理) をグローバルgitignoreとして有効化
	excludesfile = {{ .chezmoi.destDir }}/.config/git/ignore
	# set case-sensitivity according to OS
	# (Windows filesystems are usually case-insensitive)
{{- if eq .chezmoi.os "windows" }}
	ignorecase = true
	autocrlf = true
{{- else }}
	ignorecase = false
	autocrlf = input
{{- end }}

# git-flow-next の worktree は、各リポジトリの .tmp/worktrees/ の下に作る。
# 既定は ../<repo>-worktrees/ で、作業ツリーの外に作ってしまう (書き込みの確認・削除が止まる)。
# 変数は接頭辞つきのブランチ名 (feature/x) で、feature/x と hotfix/x が衝突しない。
# リポジトリ側 (.git/config・.gitflow) の値が優先される。
# see docs/spec/development.md#ブランチモデルgitflow-lite
[gitflow]
	worktreePath = .tmp/worktrees/{{ "{{ branch }}" }}

[pull]
	# merge
    rebase = false

[ghq]
	root = {{ .chezmoi.destDir }}/src

# for overwriting by local config
[include]
	path = {{ .chezmoi.destDir }}/.config/git/config.local

# [user] (name/email) は Bitwarden 由来のため専用ファイルに分離している。
# see home/dot_config/git/private_user.tmpl
[include]
	path = {{ .chezmoi.destDir }}/.config/git/user
