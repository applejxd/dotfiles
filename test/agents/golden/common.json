  "redact": {
   "deny_path_output": true,
   "deny_path_unless": "(^|&&|;|\\n)\\s*(git|gh)\\s[^\\n]*\\s-{1,2}(m|am|message|body|title)[\\s=]",
   "enabled": true,
   "rule": [
    {
     "name": "秘密鍵",
     "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----"
    },
    {
     "name": "age 秘密鍵",
     "pattern": "AGE-SECRET-KEY-1[0-9A-Z]{50,}"
    },
    {
     "name": "AWS アクセスキー",
     "pattern": "\\b(AKIA|ASIA)[0-9A-Z]{16}\\b"
    },
    {
     "name": "GitHub トークン",
     "pattern": "\\bgh[pousr]_[A-Za-z0-9]{30,}\\b"
    },
    {
     "name": "Slack トークン",
     "pattern": "\\bxox[abprs]-[A-Za-z0-9-]{10,}\\b"
    },
    {
     "name": "API キー",
     "pattern": "\\bsk-[A-Za-z0-9_-]{20,}\\b"
    },
    {
     "name": "Google API キー",
     "pattern": "\\bAIza[0-9A-Za-z_-]{35}\\b"
    },
    {
     "name": "JWT",
     "pattern": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}"
    },
    {
     "name": "代入された秘密",
     "pattern": "(?<=(password|passwd|secret|token|api[_-]?key|access[_-]?key|client[_-]?secret)[\"']?\\s*[=:]\\s*)(\"[^\"\\n]{6,}\"|'[^'\\n]{6,}'|[A-Za-z0-9_\\-+/=.]{16,})"
    }
   ]
  },
