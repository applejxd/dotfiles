#!/usr/bin/env python3
"""box: リポジトリごとの Incus の箱を操作する薄い入口。本体は scripts/box/cli.py。

環境変数 BOX_SCRIPTS があればそれを scripts/ の場所に使う。無ければ ~/.local/share/chezmoi/scripts。
see docs/spec/sandbox/incus-box.md
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

scripts = Path(os.environ.get("BOX_SCRIPTS") or Path.home() / ".local/share/chezmoi/scripts")
sys.path.insert(0, str(scripts))

from box.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
