#!/usr/bin/env python3
"""pi の stock プロファイルの ~/.pi/agent/settings.json。標準入力の現状を変換して出す。

自作ハーネスが入れた設定だけを取り除き、packages を pi-stock-packages の内容にする。
利用者のキー (テーマ・既定のモデルなど) は触らない。何度流しても同じ結果になる。
see docs/spec/agent-config-generation.md#pi-のプロファイルcustom-と-stock
"""
from __future__ import annotations

import json
import sys

PACKAGES_TEXT = {{ .packages | toJson }}
# 会社 PC (is-work) か。検索の MCP が機で違う (家は websearch、会社 PC は agentcore-websearch)
IS_WORK = {{ if eq .isWork "true" }}True{{ else }}False{{ end }}
# pi のシェル。Linux (Ubuntu / WSL) だけが、コマンド実行の囲い (pib-shell) を指す。空文字なら触らない。
# pib-shell は、環境変数 PIB_SANDBOX が立っているとき (= pib で起動したとき) だけ囲う。普段の pi は素の bash と同じ
SHELL_PATH = {{ .shellPath | toJson }}

# 自作ハーネスだけが入れる extensions / skills の項目 (scripts/agents/generate.py の宣言に対応)
HARNESS_EXTENSION_MARKS = (".config/pi/harness", "!extensions/**", "+extensions/", "-builtin:")
HARNESS_SKILL_MARKS = ("~/.claude/skills", "-~/.agents/skills/", "-~/.claude/skills/")

# pi の既定 (read・bash・edit・write) に、読み取り専用の探索ツールを足す (増分指定)。plan mode の探索と通常の探索で使う
# 利用者が +/- だけの増分指定に変えていたら保つ。自作ハーネスの全置換の値 (["read"] など) は初期値に置き換える
DEFAULT_TOOLS = ["+grep", "+find", "+ls"]

# 圧縮 (compaction): 窓が 100 万のモデルは 70 万で圧縮する。reserveTokens = 窓 - 発動点 = 300000 (窓の 3 割)
# 窓の大きさが違うモデルは補わない。利用者が別の値を書いていれば保つ (無いときだけ補う)
COMPACTION_RESERVE_TOKENS = 300000
COMPACTION_MODELS = (
    "github-copilot/claude-sonnet-5.5",
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5",
    "github-copilot/gpt-6-sol",
    "github-copilot/gpt-5.3-codex",
    "github-copilot/gemini-3.8-flash",
)


def add_compaction_overrides(data: dict) -> None:
    compaction = data.get("compaction")
    if compaction is None:
        compaction = {}
    if not isinstance(compaction, dict):
        return  # 想定外の形は触らない
    overrides = compaction.get("modelOverrides")
    if overrides is None:
        overrides = {}
    if not isinstance(overrides, dict):
        return
    for model in COMPACTION_MODELS:
        entry = overrides.get(model)
        if entry is None:
            entry = {}
        if not isinstance(entry, dict):
            continue
        entry.setdefault("reserveTokens", COMPACTION_RESERVE_TOKENS)
        overrides[model] = entry
    compaction["modelOverrides"] = overrides
    data["compaction"] = compaction


# pi-subagents の組み込みの子の tools を読み取り専用に絞る (subagents.agentOverrides.<name>.tools 。docs/agents.md)。
# 組み込みの既定: scout = read, grep, find, ls, bash, write, contact_supervisor / oracle = read, grep, find, ls, bash。
# bash・write を外す (scout は親への問い合わせ contact_supervisor を残す)。reviewer (読み取り専用) と worker は変えない。
# 検索の子 (researcher・evidence-auditor) は、組み込みの tools が pi-web-access のツール名 (stock では入れない) なので、
# 機の検索の MCP を mcp: で渡す。家は websearch、会社 PC は agentcore-websearch (~/.pi/agent/mcp-adapter.json も要る)。
# 利用者がすでに同じ役の tools を書いていれば保つ (無いときだけ補う)。
# see docs/spec/mcp-servers.md#子のエージェントへの検索-mcp-の渡し方
SEARCH_MCP = "mcp:agentcore-websearch" if IS_WORK else "mcp:websearch"
AGENT_TOOL_OVERRIDES = {
    "scout": ["read", "grep", "find", "ls", "contact_supervisor"],
    "oracle": ["read", "grep", "find", "ls"],
    "researcher": ["read", "write", SEARCH_MCP],
    "evidence-auditor": ["read", SEARCH_MCP],
}


# 役割ごとのモデル (subagents.agentOverridesByProvider.<プロバイダ>.<役>.model。`:` の後ろは思考の深さ)。
# pi-subagents が、親のセッションのモデルのプロバイダ (/model で替えても追従する) ごとに層を重ねる (docs/models.md)。
# 以前の Copilot / Bedrock のカタログ (common.toml.tmpl の [pi.model.tier.*]・docs/spec/agent-model-assignment.md) に合わせる:
# worker = Sonnet 5.5 の medium、reviewer・evidence-auditor = 別系統の second_opinion (GPT 6.1 sol。worker と系統を分ける)、
# oracle = reviewer と同じ GPT 6.1 sol の high (2026-11-10。親・worker の Claude と別系統の二番目の意見にするため。根拠は docs/research/agents/oracle-model-2026-11.md)。
# Opus は高価で、カタログでは plan 役の既定。指示なしに自律で起動する子には使わない。
# scout = low、researcher = medium は、カタログに階層が無い新しい判断。Haiku は使わない。
# 利用者がすでに同じ役の model を書いていれば保つ (無いときだけ補う)。
PROVIDER_AGENT_MODELS = {
    "github-copilot": {
        "scout": "github-copilot/claude-sonnet-5.5:low",
        "researcher": "github-copilot/claude-sonnet-5.5:medium",
        "worker": "github-copilot/claude-sonnet-5.5:medium",
        "reviewer": "github-copilot/gpt-6.1-sol:high",
        "evidence-auditor": "github-copilot/gpt-6.1-sol:high",
        "oracle": "github-copilot/gpt-6.1-sol:high",
    },
    "amazon-bedrock": {
        "scout": "amazon-bedrock/us.anthropic.claude-sonnet-5-5:low",
        "researcher": "amazon-bedrock/us.anthropic.claude-sonnet-5-5:medium",
        "worker": "amazon-bedrock/us.anthropic.claude-sonnet-5-5:medium",
        "reviewer": "amazon-bedrock/us.openai.gpt-6.1-sol:high",
        "evidence-auditor": "amazon-bedrock/us.openai.gpt-6.1-sol:high",
        "oracle": "amazon-bedrock/us.openai.gpt-6.1-sol:high",
    },
}


# 前の既定値 (プロバイダ, 役) -> モデル。この値のままなら、利用者が選んだ値ではないので新しい既定へ移す
LEGACY_AGENT_MODELS = {
    ("github-copilot", "oracle"): "github-copilot/claude-sonnet-5.5:xhigh",
    ("amazon-bedrock", "oracle"): "amazon-bedrock/us.anthropic.claude-sonnet-5-5:xhigh",
}


def is_incremental(value: object) -> bool:
    return (
        isinstance(value, list)
        and len(value) > 0
        and all(isinstance(i, str) and i.startswith(("+", "-")) for i in value)
    )


def packages() -> list[str]:
    lines = (line.strip() for line in PACKAGES_TEXT.splitlines())
    return [line for line in lines if line and not line.startswith("#")]


def drop_marked(items: object, marks: tuple[str, ...]) -> list[object]:
    if not isinstance(items, list):
        return []
    return [i for i in items if not (isinstance(i, str) and any(i.startswith(m) or m in i for m in marks))]


def main() -> int:
    raw = sys.stdin.read()
    try:
        data = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        sys.stdout.write(raw)  # 壊れた入力は触らない
        return 0
    if not isinstance(data, dict):
        sys.stdout.write(raw)
        return 0
    if not is_incremental(data.get("defaultTools")):
        data["defaultTools"] = list(DEFAULT_TOOLS)
    for key, marks in (("extensions", HARNESS_EXTENSION_MARKS), ("skills", HARNESS_SKILL_MARKS)):
        if key in data:
            kept = drop_marked(data[key], marks)
            if kept:
                data[key] = kept
            else:
                del data[key]
    data["packages"] = packages()
    if SHELL_PATH and "shellPath" not in data:  # 利用者が別のシェルを書いていれば保つ (pib が、囲いを指していないと知らせる)
        data["shellPath"] = SHELL_PATH
    subagents = data.get("subagents")
    if not isinstance(subagents, dict):
        subagents = {}
    overrides = subagents.get("agentOverrides")
    if not isinstance(overrides, dict):
        overrides = {}
    for name, tools in AGENT_TOOL_OVERRIDES.items():
        entry = overrides.get(name)
        if not isinstance(entry, dict):
            entry = {}
        entry.setdefault("tools", list(tools))
        overrides[name] = entry
    by_provider = subagents.get("agentOverridesByProvider")
    if not isinstance(by_provider, dict):
        by_provider = {}
    for provider, roles in PROVIDER_AGENT_MODELS.items():
        layer = by_provider.get(provider)
        if not isinstance(layer, dict):
            layer = {}
        for name, model in roles.items():
            entry = layer.get(name)
            if not isinstance(entry, dict):
                entry = {}
            if entry.get("model") == LEGACY_AGENT_MODELS.get((provider, name)):
                entry["model"] = model
            entry.setdefault("model", model)
            layer[name] = entry
        by_provider[provider] = layer
    subagents["agentOverridesByProvider"] = by_provider
    subagents["agentOverrides"] = overrides
    data["subagents"] = subagents
    add_compaction_overrides(data)
    json.dump(data, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
