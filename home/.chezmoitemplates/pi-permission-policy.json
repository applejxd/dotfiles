{
  "shellTools": {
    "bg_run": { "commandArgument": "command", "workdirArgument": "cwd" }
  },
  "commandEffects": {
    "git": {
      "unlessOption": ["--output"],
      "subcommands": { "log": "read", "status": "read", "diff": "read", "show": "read" }
    }
  },
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*id_dsa*": "deny",
      "*id_ecdsa*": "deny",
      "*id_ed25519*": "deny",
      "~/.netrc": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.config/agents/websearch-keys.json": "deny"
    },
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch --list *": "allow",
      "git branch -a": "allow",
      "git branch -vv": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "rg *": "allow",
      "rg *--pre*": "ask",
      "grep *": "allow",
      "which *": "allow",
      "mise run *": "allow",
      "uv run *": "allow",
      "pytest *": "allow",
      "pre-commit *": "allow",
      "shellcheck *": "allow",
      "rm -rf *": { "action": "deny", "reason": "再帰的な強制削除は禁止。対象を絞って利用者に確認する" },
      "rm -fr *": { "action": "deny", "reason": "再帰的な強制削除は禁止。対象を絞って利用者に確認する" },
      "rm -r -f *": { "action": "deny", "reason": "再帰的な強制削除は禁止。対象を絞って利用者に確認する" },
      "rm -f -r *": { "action": "deny", "reason": "再帰的な強制削除は禁止。対象を絞って利用者に確認する" },
      "sudo *": { "action": "deny", "reason": "sudo は使わない" },
      "git push*": { "action": "deny", "reason": "push は利用者が行う" },
      "sh": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "bash": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "zsh": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "dash": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "sh -": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "bash -": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "sh -s*": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" },
      "bash -s*": { "action": "deny", "reason": "ネット上のスクリプトをシェルへ渡す実行は禁止" }
    },
    "mcp": { "*": "ask" },
    "skill": { "*": "allow" },
    "todo": "allow",
    "ask_user_question": "allow",
    "subagent": "allow",
    "subagents_enable": "allow",
    "bg_wait": "allow",
    "bg_status": "allow",
    "bg_kill": "allow",
    "plan_mode_question": "allow",
    "plan_mode_complete": "allow",
    "goal_complete": "allow",
    "goal_blocked": "allow",
    "goal_wait": "allow",
    "external_directory": "ask"
  }
}
