#!/usr/bin/env python3
"""pi を、コマンド実行の囲い (bwrap) つきで起動する ``pib [--offline] [pi の引数...]``。

``pib --help`` はこのコマンドの使い方 (日本語)。pi のヘルプを上書きする (pi のヘルプは ``pi --help``)。
``pib --status`` は、囲いが使える状態か、いま効いている設定 (見える場所・隠す場所。存在しない場所の印つき) を見せる。

pi のシェル (``shellPath`` = ``pib-shell``) は、環境変数 ``PIB_SANDBOX`` が立っているときだけ ``pi-sandbox-runner`` を通す。
``pib`` は、その環境変数を立てて ``pi`` を exec する。``--offline`` は、通信を丸ごと遮断する (強い設定)。
囲いが効かない状態 (runner・設定・bwrap が無い、``shellPath`` が ``pib-shell`` を指していない) では起動しない。
黙って囲いなしのシェルで動き、守られているつもりになるのを避けるため。

``pi`` は常に ``--no-approve`` で起動する (プロジェクトの ``.pi/`` の設定・拡張・MCP を、この実行では読まない)。
プロジェクトの ``.pi/settings.json`` は利用者の設定に勝つので、そこに ``shellPath`` があると囲いが外れる。起動時の作業ディレクトリを
検査するだけでは、セッションの再開や ``/resume`` で別のディレクトリのセッションへ移ったときに、その設定を検査できない。
``--no-approve`` は、実行時 (runtime) のプロジェクト設定の読み込みに効く (pi の project trust の仕様で、コマンドラインの指定が最優先)。
起動時のセッション保存先 (プロジェクトの ``sessionDir``) の先読みだけは、pi の仕様で残るが、``shellPath`` には影響しない。
``--approve`` は囲いを外せるので受け付けない。
see docs/spec/sandbox/pi-sandbox-runner.md#導入と確認
"""

from __future__ import annotations

import json
import os
import posixpath
import shutil
import subprocess
import sys
from collections.abc import Mapping, Sequence
from pathlib import Path

PREFIX = "pib:"
SANDBOX_ENV = "PIB_SANDBOX"
SHELL_NAME = "pib-shell"
RUNNER_NAME = "pi-sandbox-runner"


HELP = """\
pib — pi を、コマンド実行の囲い (bwrap) つきで起動する

使い方:
  pib [--offline] [pi の引数...]   囲いつきで pi を起動する
  pib [--offline] --status         囲いの状態と、いま効いている設定を表示する
  pib --help | -h                  このヘルプ

オプション (先頭にだけ置く):
  --offline   通信を丸ごと遮断する (強い設定)

pi の引数はそのまま渡る。--no-approve が常に付き (プロジェクトの .pi/ の設定を読まない)、
--approve / -a は使えない。pi 自身のヘルプは `pi --help`。

囲いに通るのは、pi が実行するコマンド (bash ツール・bg_run・!・子エージェント)。
書き込めるのは、作業ディレクトリと、設定の visible.write に書いた所だけ。
ホーム・/tmp・/mnt・/media・/run/user は空で覆われ、設定の visible に書いた所だけが見える。
それ以外 (/usr・/etc など) は読み取り専用で見える。hide に書いた所は隠れる。GPU は使える。

設定:
  共有      ~/.config/pi-sandbox/runner.toml         chezmoi 管理 (直接編集しない)
  この PC   ~/.config/pi-sandbox/runner.local.toml   管理外 ([visible] [hide] [env] だけ)
  見本      ~/.config/pi-sandbox/runner.local.toml.example
  反映は、次にコマンドを実行したとき (chezmoi apply は要らない)。

囲いの外が要る作業は、`pi` (囲いなし) か別のターミナルで行う。
詳細: docs/spec/sandbox/pi-sandbox-runner.md
"""


def _load_settings(path: Path) -> tuple[str, dict | None]:
    """設定ファイルを pi と同じように読む。(状態, 中身)。状態は missing / unreadable / ok。

    pi は BOM を取り除いて読む (``utf-8-sig``)。読めない (壊れた JSON・オブジェクトでない・ディレクトリなど) ものを、
    「shellPath が無い」と取り違えない (囲いを外す値を、検査をすり抜けて通してしまうため)。
    """
    try:
        text = path.read_text(encoding="utf-8-sig")
    except FileNotFoundError:
        return "missing", None
    except (OSError, UnicodeDecodeError):
        return "unreadable", None
    try:
        data = json.loads(text)
    except ValueError:
        return "unreadable", None
    return ("ok", data) if isinstance(data, dict) else ("unreadable", None)


def _is_the_shell(value: object, shell: Path, home: Path) -> bool:
    """``shellPath`` が、配備した pib-shell の絶対パスそのものか (``~/`` の略記は許す)。

    シンボリックリンクなどの別名は認めない。作業ツリーの中のリンクを、囲いの内側から別のシェルへ付け替えられるため
    (pi は値を realpath にせず、そのパスを実行する)。
    """
    if not isinstance(value, str):
        return False
    if value.startswith("~/"):
        value = str(home) + value[1:]
    return value == str(shell)


def _canonical(path: str) -> bool:
    """正規の絶対パスか (``.``・``..``・連続する ``/``・末尾の ``/``・先頭の ``//`` を含まない)。

    pi は設定のパスを、文字列だけで整える (Node の ``join`` / ``resolve``)。OS はシンボリックリンクを辿ってから ``..`` を解く。
    こうした整え方の違いは、pib が検査する設定と pi が読む設定を食い違わせる。解釈を合わせようとせず、
    食い違いようのない表記だけを受け付ける (正規の表記なら、どちらで解いても同じ場所を指す)。
    """
    return path.startswith("/") and not path.startswith("//") and posixpath.normpath(path) == path


def _agent_dir(env: Mapping[str, str], home: Path) -> tuple[Path | None, str | None]:
    """pi の設定ディレクトリ。(ディレクトリ, 受け付けない理由)。

    ``PI_CODING_AGENT_DIR`` は、pi が ``~`` と ``~/`` を展開する。展開したものが正規の絶対パスでなければ受け付けない
    (相対パス・``file://``・``~//x``・``link/../x`` など、解釈が食い違いうる表記)。
    """
    raw = env.get("PI_CODING_AGENT_DIR")
    if not raw:
        path = f"{home}/.pi/agent"
    elif raw == "~":
        path = str(home)
    elif raw.startswith("~/"):
        path = f"{home}/{raw[2:]}"
    else:
        path = raw
    if not _canonical(path):
        return None, (
            "PI_CODING_AGENT_DIR は、正規の絶対パス (. や .. や連続する / を含まない。~/ の略記は可) に限る"
            f" (pi との解釈の食い違いを避けるため): {raw!r}"
        )
    return Path(path), None


def problems(env: Mapping[str, str], home: Path, cwd: Path) -> list[str]:
    """囲いが効かない理由 (空なら起動してよい)。"""
    bin_dir = home / ".local" / "bin"
    runner, shell = bin_dir / RUNNER_NAME, bin_dir / SHELL_NAME
    config = Path(
        env.get("PI_SANDBOX_RUNNER_CONFIG")
        or Path(env.get("XDG_CONFIG_HOME") or home / ".config") / "pi-sandbox" / "runner.toml"
    )
    agent_dir, agent_problem = _agent_dir(env, home)

    found: list[str] = []
    home_text = env.get("HOME") or str(home)
    # pi は HOME から設定の場所を決める。.. を含むなどの表記は、pib と pi で別の場所になりうる
    if not _canonical(home_text):
        found.append(
            f"HOME は、正規の絶対パス (. や .. や連続する / を含まない) に限る: {home_text!r}"
        )
        agent_dir, agent_problem = None, "HOME が正規でないので、設定の場所を決められない"
    if not os.access(runner, os.X_OK):
        found.append(f"runner が無い、または実行できない: {runner}")
    if not os.access(shell, os.X_OK):
        found.append(f"シェルが無い、または実行できない: {shell}")
    if not config.is_file():
        found.append(f"runner の設定が無い: {config}")
    if shutil.which("bwrap", path=env.get("PATH")) is None:
        found.append("bwrap が見つからない")

    if agent_dir is None:
        found.append(agent_problem or "pi の設定ディレクトリを解決できない")
    else:
        settings = agent_dir / "settings.json"
        state, data = _load_settings(settings)
        if state == "unreadable":
            found.append(f"pi の設定を読めない: {settings}")
        elif not _is_the_shell(data.get("shellPath") if data else None, shell, home):
            found.append(
                f"{settings} の shellPath が {shell} (絶対パスそのもの) を指していない"
                f" (実際: {data.get('shellPath') if data else None!r})"
            )
    # プロジェクトの設定は、利用者の設定を上書きする。ここに shellPath があると、囲いなしのシェルで動く。
    # pi は null・false・0 なども上書きの値として保ち、通常の bash を選ぶので、「キーがある」ことを検査する
    project_settings = cwd / ".pi" / "settings.json"
    state, data = _load_settings(project_settings)
    if state == "unreadable":
        found.append(
            f"プロジェクトの設定を読めない (shellPath を上書きしていないと確かめられない): {project_settings}"
        )
    elif (
        data is not None
        and "shellPath" in data
        and not _is_the_shell(data["shellPath"], shell, home)
    ):
        found.append(
            f"{project_settings} の shellPath が囲いを外している (実際: {data['shellPath']!r})"
        )
    return found


def parse_args(argv: Sequence[str]) -> tuple[bool, list[str], str | None]:
    """(``--offline`` か, pi へ渡す引数, 受け付けない理由)。``--offline`` は先頭だけ。"""
    args = list(argv)
    offline = bool(args) and args[0] == "--offline"
    if offline:
        args = args[1:]
    if any(a in ("-a", "--approve") for a in args):
        return offline, args, "--approve は囲いを外せるので、pib では使えない (pi で起動する)"
    return offline, args, None


def status(env: Mapping[str, str], home: Path, offline: bool) -> int:
    """囲いが使える状態かと、いま効いている設定 (runner の ``--status``) を表示する。終了コードは、使えるなら 0、使えないなら 2。

    runner が「この場所・この設定では起動できない」と答えたとき (終了コード 2) も、使えない状態として数える。
    """
    found = problems(env, home, Path.cwd())
    runner = home / ".local" / "bin" / RUNNER_NAME
    detail_out = detail_err = ""
    if os.access(runner, os.X_OK):
        flags = ["--offline"] if offline else []
        result = subprocess.run(
            [str(runner), *flags, "--status"],
            env=dict(env),
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            check=False,
        )
        detail_out, detail_err = result.stdout, result.stderr
        if result.returncode != 0:
            found.append("runner が、この場所・この設定では起動できないと報告した (下の詳細)")
    print("囲い: " + ("使える" if not found else "使えない"))
    for line in found:
        print(f"  - {line}")
    print(detail_out, end="")
    print(detail_err, end="", file=sys.stderr)
    return 2 if found else 0


def main(argv: Sequence[str], env: Mapping[str, str] | None = None) -> int:
    env = dict(os.environ if env is None else env)
    offline, rest, refused = parse_args(argv)
    if rest[:1] in (["--help"], ["-h"]):  # 壊れた配備でも読めるよう、検査より先に出す
        print(HELP, end="")
        return 0
    if rest[:1] == ["--status"]:
        if len(rest) > 1:
            print(f"{PREFIX} --status に他の引数は付けられない: {rest[1:]}", file=sys.stderr)
            return 2
        return status(env, Path(env.get("HOME") or Path.home()), offline)
    found = [refused] if refused else []
    found += problems(env, Path(env.get("HOME") or Path.home()), Path.cwd())
    if found:
        for line in found:
            print(f"{PREFIX} {line}", file=sys.stderr)
        print(f"{PREFIX} chezmoi apply で配備してから起動する", file=sys.stderr)
        return 2
    env[SANDBOX_ENV] = "offline" if offline else "1"
    os.execvpe("pi", ["pi", "--no-approve", *rest], env)  # 戻らない


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
