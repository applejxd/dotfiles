{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|bash",
        "type": "command",
        "bash": "python $HOME/.claude/hooks/check_bash.py",
        "timeoutSec": 30
      },
      {
        "matcher": "^(Bash|bash|Read|view|Write|create|Edit|edit)$",
        "type": "command",
        "bash": "python $HOME/.claude/hooks/redirect-tmp.py",
        "timeoutSec": 30
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|edit|create",
        "type": "command",
        "bash": "bash $HOME/.claude/hooks/markdownlint.sh",
        "timeoutSec": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "bash": "python $HOME/.claude/hooks/update-adr-on-stop.py",
        "timeoutSec": 60
      }
    ]
  }
}
