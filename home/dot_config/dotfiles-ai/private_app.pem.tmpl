{{- /*
  専用 GitHub App（applejxd-dotfiles-ai）の秘密鍵 PEM（~/.config/dotfiles-ai/app.pem、mode 600）。
  Bitwarden の Secure Note 項目 `dotfiles-ai-github-app` のノート本文から初回のみ展開する。
  `.chezmoiignore.tmpl` により applejxd かつ BW_SESSION ありの未展開時のみ有効。
  see docs/spec/security.md#保護対象と置き場所
*/ -}}
{{- if and (regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username) (lookPath "bw") -}}
{{-   with (bitwarden "item" "dotfiles-ai-github-app") -}}
{{ .notes | trim }}
{{ "" }}
{{-   end -}}
{{- end -}}
