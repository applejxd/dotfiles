Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# pi を確かめる。pi 本体は mise (aqua のバイナリ版。node 不要) が 313_mise で導入する。
# 公式の install.ps1 は Read-Host で確認を聞くので apply では使えず、npm 版は node の解決順に左右される。
# ここでは PATH で競合する npm 版を外し、起動できることを確かめる。
# see docs/spec/cli-management.md#windows-の-pi

function Use-MiseNode {
  # npm は mise の node を使う。PATH 上の古い node (winget 版など) を避ける。
  $mise = Get-Command mise -CommandType Application -ErrorAction SilentlyContinue
  if (-not $mise) { throw 'mise not found (313_mise を先に実行してください)' }
  $nodeDir = (& $mise.Path where node).Trim()
  if ($LASTEXITCODE -ne 0 -or -not $nodeDir) { throw 'mise の node が未導入 (mise install を実行してください)' }
  $env:Path = "$nodeDir;$env:Path"
  # mise の node (zip 版) の global prefix は node の版付きフォルダ。版を上げると消え、PATH にも出ないので固定する
  $npmPrefix = Join-Path $env:APPDATA 'npm'
  New-Item -ItemType Directory -Force -Path $npmPrefix | Out-Null
  $env:NPM_CONFIG_PREFIX = $npmPrefix
}

$npmPi = Join-Path $env:APPDATA 'npm\node_modules\@earendil-works\pi-coding-agent'
if (Test-Path $npmPi) {
  Use-MiseNode
  Write-Host 'Removing npm-installed pi (replaced by the mise binary)...'
  & npm uninstall -g '@earendil-works/pi-coding-agent'
  if ($LASTEXITCODE -ne 0) { throw "npm uninstall -g @earendil-works/pi-coding-agent failed: $LASTEXITCODE" }
}
$mise = Get-Command mise -CommandType Application -ErrorAction SilentlyContinue
if (-not $mise) { throw 'mise not found (313_mise を先に実行してください)' }
& $mise.Path exec -- pi --version | Out-Null
if ($LASTEXITCODE -ne 0) { throw "mise の pi を起動できません: $LASTEXITCODE (mise install を確認してください)" }
