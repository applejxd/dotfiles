# エンコーディングを US-ASCII から変更
# see https://dattesar.com/powershell-utf8/
$PSDefaultParameterValues['*:Encoding'] = 'utf8'
$utf8NoBom = New-Object System.Text.UTF8Encoding($false)
[Console]::InputEncoding = $utf8NoBom
[Console]::OutputEncoding = $utf8NoBom
$OutputEncoding = $utf8NoBom

# WSL/agent processes can forward GIT_CONFIG_COUNT without every indexed
# KEY/VALUE pair, which makes all Windows Git commands fail.
$gitConfigCount = 0
$hasGitConfigCount = [int]::TryParse($env:GIT_CONFIG_COUNT, [ref]$gitConfigCount)
$invalidGitConfig = $false
if ($hasGitConfigCount) {
  for ($i = 0; $i -lt $gitConfigCount; $i++) {
    if (
      -not (Test-Path "Env:GIT_CONFIG_KEY_$i") -or
      -not (Test-Path "Env:GIT_CONFIG_VALUE_$i")
    ) {
      $invalidGitConfig = $true
      break
    }
    # Python env restoration drops empty values on Windows. For fsmonitor,
    # "false" preserves the disabled state without breaking subsequent Git calls.
    if (
      (Get-Item "Env:GIT_CONFIG_KEY_$i").Value -eq 'core.fsmonitor' -and
      (Get-Item "Env:GIT_CONFIG_VALUE_$i").Value -eq ''
    ) {
      Set-Item "Env:GIT_CONFIG_VALUE_$i" 'false'
    }
  }
}
if ($invalidGitConfig) {
  Get-ChildItem Env: |
    Where-Object Name -Match '^GIT_CONFIG_(COUNT|KEY_\d+|VALUE_\d+)$' |
    Remove-Item
}

# mise shims and directory-specific environments
$miseCommand = Get-Command mise -ErrorAction Ignore
if ($miseCommand) {
  # Full activation installs a command-not-found hook that calls PSReadLine
  # before its history is initialized during profile startup.
  $miseActivation = & $miseCommand.Path activate pwsh --shims | Out-String
  if ($LASTEXITCODE -eq 0) {
    Invoke-Expression $miseActivation
  } else {
    Write-Warning "mise activation failed with exit code $LASTEXITCODE"
  }
}

# for Claude Code
$env:Path += ";$env:USERPROFILE\.local\bin"

# see https://secon.dev/entry/2020/08/17/070735/

# テーマ
# OneDrive の MyDocuments 同期は非推奨（パスが変更されるため）
# see https://ohmyposh.dev/docs/installation/customize
# see https://github.com/JanDeDobbeleer/oh-my-posh/discussions/2089#discussioncomment-2569096
$env:Path += ";$env:LocalAppData\Programs\oh-my-posh\bin"
if (Get-Command oh-my-posh -ErrorAction Ignore) {
  Invoke-Expression (@(& oh-my-posh init pwsh --config "$env:POSH_THEMES_PATH\pure.omp.json") -join "`n")
}

# キーバインド
Set-PSReadLineOption -EditMode Emacs
Set-PSReadLineOption -BellStyle None
# 標準だと Ctrl+d は DeleteCharOrExit のため、うっかり端末が終了することを防ぐ
Set-PSReadLineKeyHandler -Chord 'Ctrl+d' -Function DeleteChar

Register-EngineEvent -SourceIdentifier PowerShell.OnIdle -Action {
  $ChocolateyProfile = "$env:ChocolateyInstall\helpers\chocolateyProfile.psm1"
  if (Test-Path($ChocolateyProfile)) {
    Import-Module "$ChocolateyProfile" -Scope Global
  }

  # C-t と C-r のラッパー (PSFzf の遅延読み込み)
  if ($PSVersionTable.PSEdition -eq "Core") {
    Import-Module PSFzf -Scope Global -ErrorAction SilentlyContinue
    if (Get-Command Set-PsFzfOption -ErrorAction Ignore) {
      Set-PsFzfOption -PSReadlineChordProvider 'Ctrl+t' -PSReadlineChordReverseHistory 'Ctrl+r'
    }
  }

  Unregister-Event -SubscriptionId $EventSubscriber.SubscriptionId
} | Out-Null

