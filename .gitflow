[gitflow]
	version = 1.0
	initialized = true
	worktreePath = .tmp/worktrees/{{ branchName }}
[gitflow "branch.develop"]
	type = base
	parent = main
	upstreamStrategy = merge
	downstreamStrategy = merge
	autoUpdate = true
	tag = false
[gitflow "branch.feature"]
	type = topic
	parent = develop
	startPoint = develop
	upstreamStrategy = squash
	downstreamStrategy = rebase
	prefix = feature/
	autoUpdate = false
	tag = false
	worktree = false
[gitflow "branch.main"]
	type = base
	upstreamStrategy = none
	downstreamStrategy = none
	autoUpdate = false
	tag = false
