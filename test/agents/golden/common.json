{
 "agent_env": {
  "GCM_INTERACTIVE": "never",
  "GIT_EDITOR": "false",
  "GIT_TERMINAL_PROMPT": "0"
 },
 "bash": {
  "allow": [
   "git diff",
   "git status",
   "git log",
   "wc",
   "grep -n",
   "find",
   "gcc",
   "g++",
   "cmake -S",
   "cmake --build",
   "uv pip list",
   "uv sync",
   "docker ps",
   "mise run"
  ],
  "ask": [
   "rm",
   "git clean",
   "git branch -D",
   "git commit",
   "git reset",
   "docker rm",
   "docker rmi",
   "gh pr create",
   "gh pr checkout",
   "gh issue create",
   "gh issue close",
   "gh issue comment",
   "pipx install",
   "uv tool install",
   "uv tool uninstall",
   "uv tool upgrade",
   "uv python install",
   "uv python uninstall",
   "cmake --install",
   "docker login",
   "docker push",
   "nc",
   "git config"
  ],
  "ask_hook_owned": [
   "rm"
  ],
  "deny": [
   "sudo",
   "git push",
   "git reset --hard",
   "git rebase",
   "git config --global",
   "git config --system",
   "git config --local",
   "git config core.hooksPath",
   "git config --unset",
   "git config --add",
   "git config --replace-all",
   "git config --edit",
   "git filter-branch",
   "git update-ref -d",
   "git reflog expire",
   "git stash clear",
   "git stash drop",
   "git worktree remove",
   "git checkout --",
   "git restore",
   "crontab",
   "at",
   "batch",
   "systemctl enable",
   "systemctl disable",
   "systemctl mask",
   "systemctl start",
   "systemctl stop",
   "systemctl restart",
   "systemctl daemon-reload",
   "systemd-run",
   "mkfs",
   "mkfs.ext4",
   "mkfs.xfs",
   "fdisk",
   "parted",
   "wipefs",
   "socat",
   "ncat",
   "telnet",
   "ssh",
   "npm install -g",
   "uv self update",
   "rustup self update",
   "chezmoi upgrade",
   "pip",
   "pip3",
   "psql",
   "mysql",
   "mongod",
   "mongosh",
   "redis-cli",
   "docker system prune",
   "docker volume prune",
   "docker image prune",
   "docker container prune",
   "docker network prune",
   "npm cache clean",
   "yarn cache clean",
   "pnpm store prune",
   "gh pr merge",
   "gh release create",
   "gh repo delete",
   "gh gist create",
   "gh secret set",
   "gh secret list",
   "gh auth token",
   "bw get",
   "bw list",
   "bw export",
   "op read",
   "op item get",
   "vault read",
   "vault kv get",
   "chezmoi secret",
   "git remote add",
   "git remote set-url",
   "scp",
   "rsync",
   "sftp",
   "aws s3 cp",
   "aws s3 sync",
   "gsutil cp",
   "az storage blob upload",
   "gh release upload"
  ],
  "deny_guide": {
   "alternative": [
    {
     "commands": [
      "npm install -g"
     ],
     "message": "npm install -g は許可されていません。グローバルに入れる CLI は mise で入れてください。chezmoi 管理の環境では、ソースの home/dot_config/mise/config.toml.tmpl の [tools] に `\"npm:<package>\" = \"latest\"` を追記して `chezmoi apply` します (`mise use -g` は次回の apply で失われうる)。chezmoi 管理でない環境なら `mise use -g npm:<package>` です。プロジェクトの依存なら -g 無しの `npm install <package>` を使ってください。"
    },
    {
     "commands": [
      "uv self update",
      "chezmoi upgrade"
     ],
     "message": "ツール自身の更新は許可されていません。導入元のパッケージマネージャ (mise / winget など) で更新してください。導入元が分からなければ、更新してほしいツールを利用者に示してください。"
    },
    {
     "commands": [
      "rustup self update"
     ],
     "message": "rustup 自体の更新は許可されていません。利用者に依頼してください。toolchain の更新は `rustup update` を使えます。"
    },
    {
     "commands": [
      "git config --global",
      "git config --system",
      "git config --local",
      "git config core.hooksPath",
      "git config --unset",
      "git config --add",
      "git config --replace-all",
      "git config --edit"
     ],
     "message": "git config の書き込みは許可されていません。ユーザー設定は chezmoi 管理の home/dot_gitconfig.tmpl を編集して `chezmoi apply` で反映してください。リポジトリ単位の設定は、変更内容を利用者に示して依頼してください。読み取りは `--global` などを付けず `git config --get <key>` / `git config --list` の形で使えます。"
    },
    {
     "commands": [
      "docker system prune",
      "docker volume prune",
      "docker image prune",
      "docker container prune",
      "docker network prune"
     ],
     "message": "docker の prune は許可されていません。消す対象を指定して `docker rm <container>` / `docker rmi <image>` を使ってください (確認が出ます)。ボリュームとネットワークの削除は利用者に依頼してください。"
    },
    {
     "commands": [
      "npm cache clean",
      "yarn cache clean",
      "pnpm store prune"
     ],
     "message": "キャッシュの削除は許可されていません (再取得に時間がかかります)。不具合の原因がキャッシュだと判断できるときだけ、実行してほしいコマンドと理由を利用者に示してください。"
    }
   ],
   "elsewhere": [
    "pip",
    "pip3"
   ],
   "user_message": "この操作はエージェントには許可されていません。迂回せず、実行してほしいコマンドと理由を利用者に示してください。",
   "user_only": [
    "sudo",
    "git push",
    "git reset --hard",
    "git rebase",
    "git filter-branch",
    "git update-ref -d",
    "git reflog expire",
    "git stash clear",
    "git stash drop",
    "git worktree remove",
    "git checkout --",
    "git restore",
    "crontab",
    "at",
    "batch",
    "systemctl enable",
    "systemctl disable",
    "systemctl mask",
    "systemctl start",
    "systemctl stop",
    "systemctl restart",
    "systemctl daemon-reload",
    "systemd-run",
    "mkfs",
    "mkfs.ext4",
    "mkfs.xfs",
    "fdisk",
    "parted",
    "wipefs",
    "socat",
    "ncat",
    "telnet",
    "ssh",
    "psql",
    "mysql",
    "mongod",
    "mongosh",
    "redis-cli",
    "gh pr merge",
    "gh release create",
    "gh repo delete",
    "gh gist create",
    "gh secret set",
    "gh secret list",
    "gh auth token",
    "bw get",
    "bw list",
    "bw export",
    "op read",
    "op item get",
    "vault read",
    "vault kv get",
    "chezmoi secret",
    "git remote add",
    "git remote set-url",
    "scp",
    "rsync",
    "sftp",
    "aws s3 cp",
    "aws s3 sync",
    "gsutil cp",
    "az storage blob upload",
    "gh release upload"
   ]
  }
 },
 "claude": {
  "auto_update": false,
  "default_permission_mode": "auto",
  "mcp_deny": [
   "mcp__supabase__execute_sql"
  ]
 },
 "copilot": {
  "auto_update": false,
  "default_permission_mode": "assisted",
  "enabled_plugins": {
   "document-skills@anthropic-agent-skills": true,
   "example-skills@anthropic-agent-skills": false
  },
  "experimental": true,
  "include_co_authored_by": false,
  "locations": [
   {
    "approvals": [
     {
      "kind": "write"
     }
    ],
    "path": "~/.local/share/chezmoi"
   }
  ],
  "model": "claude-sonnet-5.5",
  "trusted_folders": [
   "~/.local/share/chezmoi",
   "~/sandbox",
   "~/src/my-agent-core",
   "~/src/apple-agent-core"
  ]
 },
 "file": {
  "claude_read_allow": [
   "README.md",
   "pyproject.toml"
  ],
  "deny_exceptions": [
