    "wipefs",
    "socat",
    "ncat",
    "telnet",
    "ssh",
    "psql",
    "mysql",
    "mongod",
    "mongosh",
    "redis-cli",
    "gh pr merge",
    "gh release create",
    "gh repo delete",
    "gh gist create",
    "gh secret set",
    "gh secret list",
    "gh auth token",
    "bw get",
