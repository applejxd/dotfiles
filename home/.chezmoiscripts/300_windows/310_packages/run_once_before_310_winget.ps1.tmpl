winst OpenJS.NodeJS
winst jdx.mise -CheckCommand mise
winst Python.Launcher # needed by chezmoi
winst Python.Python.3.12  # needed by chezmoi
winst astral-sh.uv

# AI
winst GitHub.Copilot
winst 9PLM9XGG6VKS  # Codex App

{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}
