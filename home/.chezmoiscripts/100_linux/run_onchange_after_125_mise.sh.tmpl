#!/usr/bin/env bash

set -euo pipefail

# mise config: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

sudo -v

echo "mise をインストール/更新します..."

# Install mise if not present
if [[ ! -e "${HOME}/.local/bin/mise" ]]; then
    curl https://mise.run | sh
fi
# Temporary activation for current script session
eval "$("${HOME}/.local/bin/mise" activate --shims)"

echo "mise をインストール/更新しました"

echo "開発ツールをインストール/更新します..."

# Python
if ! type python >/dev/null 2>&1; then
    echo "Python が見つかりません。Python のビルドに必要なパッケージをインストールします..."

    # for building Python and Ruby
    # see https://github.com/pyenv/pyenv/wiki#suggested-build-environment
    sudo apt-get install -y \
        build-essential libssl-dev zlib1g-dev \
        libbz2-dev libreadline-dev libsqlite3-dev curl git \
        libncursesw5-dev xz-utils tk-dev libxml2-dev libxmlsec1-dev libffi-dev liblzma-dev \
        libyaml-dev
fi

mise self-update

# ツール 1 個の失敗で apply 全体を巻き添えにしない
# (docs/spec/structure.md#ツール-1-個の失敗で-apply-を止めない)
set +e
mise -C "$HOME" install
mise_status=$?
set -e

# npm backend (例: @bitwarden/cli) の shim 生成タイミング保険
mise reshim

if [[ "$mise_status" -ne 0 ]]; then
    cat >&2 <<'EOF'

⚠️  一部の開発ツールを導入できませんでした。
    残りの導入は続行します。未導入のものは次で確認できます:
      mise ls --missing
    個別に入れ直す例:
      mise install ruby
    詳細は docs/spec/troubleshooting.md を参照。

EOF
    echo "⚠️  完了：一部の開発ツールが入っていません"
else
    echo "✅ 完了：開発ツールをインストール/更新しました"
fi

{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}

# applejxd かつ Bitwarden から取得すべき sops の age 鍵がまだ無い場合、
# `mise install` 直後で bw が初めて使えるようになった可能性が高い。
# Bitwarden ログイン -> chezmoi apply 再実行を促す案内を出す
# (自動実行はマスターパスワード入力を要するため echo に留める)。
if [[ ! -f "${HOME}/.config/sops/age/keys.txt" ]] && command -v bw >/dev/null 2>&1; then
    cat <<'EOF'

ℹ️  Bitwarden CLI (bw) が mise 経由で利用可能になりました。
   sops 用の age 鍵 (~/.config/sops/age/keys.txt) を取得するには次を実行してください:

       bw login
       export BW_SESSION="$(bw unlock --raw)"
       chezmoi apply           # age 鍵取得 / gitconfig 等を再展開

EOF
fi
{{- end }}
