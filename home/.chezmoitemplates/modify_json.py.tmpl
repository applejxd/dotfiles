#!/usr/bin/env python3
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

REPO = Path({{ .workingTree | toJson }})
TARGET = {{ .target | toJson }}


def main() -> int:
    data = sys.stdin.buffer.read()
    common = REPO / "home" / "dot_config" / "agents" / "common.toml"
    generator = REPO / "scripts" / "agents" / "generate.py"

    if not common.is_file() or not generator.is_file():
        sys.stdout.buffer.write(data)
        return 0

    env = os.environ.copy()
    env["PYTHONUTF8"] = "1"
    env["PYTHONIOENCODING"] = "utf-8"
    result = subprocess.run(
        [
            sys.executable,
            str(generator),
            "--target",
            TARGET,
            "--common",
            str(common),
        ],
        input=data,
        stdout=subprocess.PIPE,
        env=env,
        check=False,
    )
    if result.returncode != 0:
        return result.returncode

    sys.stdout.buffer.write(result.stdout.replace(b"\r\n", b"\n"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
