# PowerShell 7 / Windows PowerShell 5.1 共通プロファイル本体。
#
# $PROFILE (Documents 配下) にはこのファイルを dot-source するだけのローダーを
# 置く。Documents は OneDrive の既知フォルダーリダイレクトで移動しうるため、
# 設定の実体は ~/.config/powershell に置き、ローダーだけを配置する。
# see home/.chezmoiscripts/300_windows/run_after_345_powershell_profile.ps1
#
# profile.ps1 は AllHosts プロファイルなので、エージェントやスクリプトからの
# 非対話起動でも毎回読み込まれる。ここから対話ブロックまでは
# Microsoft.PowerShell.{Management,Utility} と Get-Command を使わない。
# いずれも初回呼び出しで 0.25 秒前後かかり、起動時間を支配するため。

# 子プロセス出力の読み書きは非対話でも UTF-8 に揃える。
# *:Encoding も非対話で要る (外すと 5.1 の既定 UTF-16LE / ANSI に戻る)。
# see https://dattesar.com/powershell-utf8/
$PSDefaultParameterValues['*:Encoding'] = 'utf8'
$utf8NoBom = [System.Text.UTF8Encoding]::new($false)
# 端末の無い起動では Console への代入が例外になる host がある
try {
  [Console]::InputEncoding = $utf8NoBom
  [Console]::OutputEncoding = $utf8NoBom
} catch {}
$OutputEncoding = $utf8NoBom

{{ includeTemplate "powershell/git-config-env.ps1" }}

#------#
# PATH #
#------#

function Add-EnvPathEntry {
  param([Parameter(Mandatory)][string]$Path)

  $normalized = $Path.TrimEnd('\')
  $entries = $env:Path -split ';' | ForEach-Object { $_.TrimEnd('\') }
  if ($entries -notcontains $normalized) {
    $env:Path = "$env:Path;$normalized"
  }
}

# mise の activate は毎回 PATH の先頭へ追加するため、入れ子のシェルで PATH が
# 際限なく伸びる。追加後に一度だけ重複を畳み、先頭側の優先順位だけを残す。
function Remove-DuplicateEnvPathEntry {
  $seen = [System.Collections.Generic.HashSet[string]]::new(
    [System.StringComparer]::OrdinalIgnoreCase
  )
  $env:Path = (
    $env:Path -split ';' |
      Where-Object { $_ } |
      Where-Object { $seen.Add($_.TrimEnd('\')) }
  ) -join ';'
}

#-------------------#
# init のキャッシュ #
#-------------------#

# Get-CachedInitScript を定義する。関数内から読むとスコープが変わるためトップレベルに置く
. "$PSScriptRoot/cache.ps1"

# mise shims and directory-specific environments
$miseInit = Get-CachedInitScript -Name 'mise' -CommandName 'mise' -Generator {
  param([string]$Executable)

  # Full activation installs a command-not-found hook that calls PSReadLine
  # before its history is initialized during profile startup.
  $output = & $Executable activate pwsh --shims | Out-String
  if ($LASTEXITCODE -ne 0) {
    Write-Warning "mise activation failed with exit code $LASTEXITCODE"
    return $null
  }
  $output
}
if ($miseInit) {
  # キャッシュ本体が別プロセスに掴まれていると dot-source は失敗する。
  # shims が PATH に入らないと以降のツールが全て解決できなくなるため、
  # mise を直接実行する経路へフォールバックする。
  try {
    . $miseInit
  } catch {
    Write-Warning "Cached mise activation failed; running mise directly: $_"
    $miseCommand = @(Get-Command mise -ErrorAction Ignore -CommandType Application)[0]
    if ($miseCommand) {
      $miseActivation = & $miseCommand.Path activate pwsh --shims | Out-String
      # Invoke-Expression は空文字を受け付けない (ValidateNotNullOrEmpty)
      if ($LASTEXITCODE -eq 0 -and -not [string]::IsNullOrWhiteSpace($miseActivation)) {
        Invoke-Expression $miseActivation
      } else {
        Write-Warning "mise activation failed with exit code $LASTEXITCODE"
      }
    }
  }
}

# for Claude Code
Add-EnvPathEntry "$env:USERPROFILE\.local\bin"

# OneDrive の MyDocuments 同期は非推奨（パスが変更されるため）
# see https://ohmyposh.dev/docs/installation/customize
# see https://github.com/JanDeDobbeleer/oh-my-posh/discussions/2089#discussioncomment-2569096
Add-EnvPathEntry "$env:LocalAppData\Programs\oh-my-posh\bin"

Remove-DuplicateEnvPathEntry

# see https://github.com/junegunn/fzf/wiki/Windows
$env:FZF_DEFAULT_OPTS = '--reverse --border'

#------------------------#
# ここから下は対話時のみ #
#------------------------#

# stdio のリダイレクトだけでは、自前のコンソールを持って起動する
# `Start-Process pwsh -ArgumentList '-Command', ...` やタスクスケジューラを
# 取りこぼす。起動引数も見て、-Command / -File / -EncodedCommand /
# -NonInteractive が付いていれば非対話とみなす。ただし -NoExit があれば
# 実行後に対話へ移るため対話として扱う。
$startupIsNonInteractive = $false
$startupKeepsRunning = $false
foreach ($argument in [Environment]::GetCommandLineArgs()) {
  if ($argument.Length -lt 2 -or ($argument[0] -ne '-' -and $argument[0] -ne '/')) {
    # -File を省略した位置指定のスクリプト実行 (`pwsh script.ps1`)
    if ($argument.EndsWith('.ps1', [StringComparison]::OrdinalIgnoreCase)) {
      $startupIsNonInteractive = $true
    }
    continue
  }
  $switchName = $argument.Substring(1).ToLowerInvariant()
  if (
    'command'.StartsWith($switchName) -or
    'file'.StartsWith($switchName) -or
    'encodedcommand'.StartsWith($switchName) -or
    'noninteractive'.StartsWith($switchName)
  ) {
    $startupIsNonInteractive = $true
  }
  if ('noexit'.StartsWith($switchName)) {
    $startupKeepsRunning = $true
  }
}

if (
  [Console]::IsInputRedirected -or
  [Console]::IsOutputRedirected -or
  ($startupIsNonInteractive -and -not $startupKeepsRunning)
) {
  return
}

# Set-Alias は Microsoft.PowerShell.Utility の読み込みを伴うため関数で代用する。
# pbcopy はパイプライン入力が本体なので $input で明示的に渡す
# (エイリアスと違い、関数は既定では標準入力を子プロセスへ引き継がない)。
function open { explorer.exe @args }
function pbcopy { $input | clip.exe }
function pbpaste { Get-Clipboard @args }
function relogin { & (Get-Process -Id $PID).Path -NoExit }
function explorer-restart { Stop-Process -Name explorer -Force; Start-Process explorer }

# `chezmoi cd` that keeps the current shell session
function ccd { Set-Location (chezmoi source-path) }

{{- $common := includeTemplate "dot_config/agents/common.toml.tmpl" . | fromToml }}

# Copilot CLI のシェルへ [agent_env] の既定値を渡す。入れた分は finally で戻す。
# see docs/spec/structure.md と docs/spec/agent-config-generation.md#shell-ツールの環境変数
function copilot {
  $realCopilot = @(Get-Command copilot -CommandType Application -ErrorAction Ignore)[0]
  if (-not $realCopilot) {
    Write-Error 'copilot: command not found'
    return
  }
  $agentEnv = @{
{{- range $name, $value := $common.agent_env }}
    '{{ $name | replace "'" "''" }}' = '{{ $value | toString | replace "'" "''" }}'
{{- end }}
  }
  $changed = @()
  try {
    foreach ($name in $agentEnv.Keys) {
      if ($null -eq [Environment]::GetEnvironmentVariable($name)) {
        [Environment]::SetEnvironmentVariable($name, $agentEnv[$name])
        $changed += $name
      }
    }
    # パイプ入力が無いときに空の入力を流すと、対話 UI の標準入力が閉じてしまう
    if ($MyInvocation.ExpectingInput) {
      $input | & $realCopilot.Path @args
    } else {
      & $realCopilot.Path @args
    }
  } finally {
    foreach ($name in $changed) {
      [Environment]::SetEnvironmentVariable($name, $null)
    }
  }
}

# 定義するだけならコマンドの有無を調べる必要はなく、Get-Command の探索も避けられる
. "$PSScriptRoot/commands/wsl.ps1"
. "$PSScriptRoot/commands/pwgen.ps1"
. "$PSScriptRoot/commands/docker.ps1"
. "$PSScriptRoot/commands/fzf.ps1"

# テーマ
$poshTheme = if ($env:POSH_THEMES_PATH) {
  [System.IO.Path]::Combine($env:POSH_THEMES_PATH, 'pure.omp.json')
} else {
  $null
}
if ($poshTheme -and [System.IO.File]::Exists($poshTheme)) {
  # oh-my-posh はテーマ設定をセッション ID に紐付けて登録するため、init 出力は
  # キャッシュできない。別セッションで ID を採番し直すと登録が引けず、既定の
  # テーマに戻ってしまう (実測: 同じ init スクリプトでも ID が違うと別テーマ)。
  $poshCommand = @(Get-Command oh-my-posh -ErrorAction Ignore -CommandType Application)[0]
  if ($poshCommand) {
    $poshActivation = (@(& $poshCommand.Path init pwsh --config $poshTheme) -join "`n")
    # Invoke-Expression は空文字を受け付けない (ValidateNotNullOrEmpty)
    if ($LASTEXITCODE -eq 0 -and -not [string]::IsNullOrWhiteSpace($poshActivation)) {
      Invoke-Expression $poshActivation
    } else {
      Write-Warning "oh-my-posh init failed with exit code $LASTEXITCODE"
    }
  }
}

# キーバインド
if (Get-Module PSReadLine) {
  Set-PSReadLineOption -EditMode Emacs
  Set-PSReadLineOption -BellStyle None
  # 標準だと Ctrl+d は DeleteCharOrExit のため、うっかり端末が終了することを防ぐ
  Set-PSReadLineKeyHandler -Chord 'Ctrl+d' -Function DeleteChar
}

# 起動を遅らせてよいモジュールは最初のプロンプト表示後にまとめて読み込む。
# PSFzf と ZLocation だけで 1 秒ほどかかるため、登録はこの 1 箇所に集約する。
Register-EngineEvent -SourceIdentifier PowerShell.OnIdle -Action {
  $chocolateyProfile = "$env:ChocolateyInstall\helpers\chocolateyProfile.psm1"
  if ([System.IO.File]::Exists($chocolateyProfile)) {
    try {
      Import-Module $chocolateyProfile -Scope Global -ErrorAction Stop
    } catch {
      Write-Warning "Failed to import the Chocolatey profile: $_"
    }
  }

  # PSFzf の PSReadLine 連携は Windows PowerShell 5.1 では安定しないため Core のみ
  if ($PSVersionTable.PSEdition -eq 'Core') {
    try {
      Import-Module PSFzf -Scope Global -ErrorAction Stop
      Set-PsFzfOption -PSReadlineChordProvider 'Ctrl+t' -PSReadlineChordReverseHistory 'Ctrl+r'
    } catch {
      Write-Warning "Failed to set up PSFzf: $_"
    }
  }

  try {
    Import-Module ZLocation -Scope Global -ErrorAction Stop
  } catch {
    Write-Warning "Failed to import ZLocation: $_"
  }

  Register-FzfKeyHandler

  Unregister-Event -SubscriptionId $EventSubscriber.SubscriptionId
} | Out-Null
