     "pattern": "(^|&&|\\|\\||;|\\n)\\s*git(\\s+-\\S+(\\s+[^-\\s]\\S*)?)+\\s+commit(\\s|$)"
    },
    {
     "pi": "write-cat-tee-heredoc"
    },
    {
     "pi": "write-heredoc-script"
    },
    {
     "early": true,
     "message": "pip は使わないでください。依存の追加は `uv add <pkg>` (pyproject.toml と uv.lock を更新)、環境への導入は `uv pip install <pkg>` か `uv sync`、単発の CLI は `uvx <tool>` を使ってください。",
     "pattern": "(^|[;&|\\n])[ \\t]*((uv[ \\t]+run|mise[ \\t]+exec[ \\t]+--)[ \\t]+)?(pip3?(\\.\\d+)?|python[0-9.]*[ \\t]+-m[ \\t]*pip3?(\\.\\d+)?)([ \\t]|$)",
     "unless": "^\\s*(git|gh)\\s(?=[^\\n]*\\s-{1,2}(m|am|message|body|title)[\\s=])(?:[^;&|\\n'\"`$()<>\\\\]|\\\\[^\\n]|'[^']*'|\"(?:[^\"\\\\`$]|\\\\.|\\$\\(cat <<-?'(\\w+)'\\n[\\s\\S]*?\\n\\3\\n\\s*\\))*\")*$"
    },
    {
     "message": ".git (リポジトリの履歴) を rm で直接消さないでください。履歴の整理は git のコマンドで行い、消す必要があるときは利用者に依頼してください。",
     "pattern": "(^|[;&|\\n])[ \\t]*rm[ \\t]+([^\\s;&|]+[ \\t]+)*[\"']?(\\./)?([^\\s;&|\"']*/)?\\.git(/[^\\s;&|\"']*)?[\"']?(?=[\\s;&|]|$)",
     "unless": "^\\s*(git|gh)\\s(?=[^\\n]*\\s-{1,2}(m|am|message|body|title)[\\s=])(?:[^;&|\\n'\"`$()<>\\\\]|\\\\[^\\n]|'[^']*'|\"(?:[^\"\\\\`$]|\\\\.|\\$\\(cat <<-?'(\\w+)'\\n[\\s\\S]*?\\n\\3\\n\\s*\\))*\")*$"
    },
    {
     "message": "~ / $HOME / / を rm の対象にしないでください。消すものを具体的なパスで指定してください。",
     "pattern": "(^|[;&|\\n])[ \\t]*rm[ \\t]+([^\\s;&|]+[ \\t]+)*[\"']?((~|\\$HOME|\\$\\{HOME\\})/?\\*?|/\\*?)[\"']?(?=[\\s;&|]|$)",
     "unless": "^\\s*(git|gh)\\s(?=[^\\n]*\\s-{1,2}(m|am|message|body|title)[\\s=])(?:[^;&|\\n'\"`$()<>\\\\]|\\\\[^\\n]|'[^']*'|\"(?:[^\"\\\\`$]|\\\\.|\\$\\(cat <<-?'(\\w+)'\\n[\\s\\S]*?\\n\\3\\n\\s*\\))*\")*$"
    },
    {
     "message": "作業ディレクトリ全体 (. / .. / *) を再帰的に消さないでください。消すものを具体的なパスで指定してください (例: rm -rf .tmp/foo)。",
     "pattern": "(^|[;&|\\n])[ \\t]*rm[ \\t]+([^\\s;&|]+[ \\t]+)*(-[a-zA-Z]*[rR][a-zA-Z]*|--recursive)[ \\t]+([^\\s;&|]+[ \\t]+)*[\"']?(\\.{1,2}/?|\\./\\*|\\*|\\.\\*)[\"']?(?=[\\s;&|]|$)",
     "unless": "^\\s*(git|gh)\\s(?=[^\\n]*\\s-{1,2}(m|am|message|body|title)[\\s=])(?:[^;&|\\n'\"`$()<>\\\\]|\\\\[^\\n]|'[^']*'|\"(?:[^\"\\\\`$]|\\\\.|\\$\\(cat <<-?'(\\w+)'\\n[\\s\\S]*?\\n\\3\\n\\s*\\))*\")*$"
    },
