<#
  .SYNOPSIS
    Run every machine-wide (admin) setup step behind a single UAC prompt.
  .DESCRIPTION
    Detects what is missing as the signed-in user; only when something is missing,
    elevates once and runs just those steps. The elevated child never writes to a
    user profile (HKCU / %APPDATA% / ~). Result is re-checked as the signed-in user.
    see docs/spec/structure.md#管理者権限の集約
  .PARAMETER Targets
    Internal. Comma-separated allow-listed keys; set only for the elevated child.
  .PARAMETER LogPath
    Internal. File the elevated child appends its messages to (its console closes).
#>
param([string]$Targets = '', [string]$LogPath = '')

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$WingetNoUpgrade = -1978335189  # 0x8A15002B: no applicable upgrade (already installed)
$RdpRules = @('RemoteDesktop-UserMode-In-TCP', 'RemoteDesktop-UserMode-In-UDP')
$RdpSkus = @(4, 27, 48, 49, 72, 121, 122, 161, 164, 175)  # Enterprise / Pro / Education families
{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}
$RdpWanted = $true
{{- else }}
$RdpWanted = $false
{{- end }}

# winget packages whose only installers are machine-wide (or scope-unspecified MSI), so winget raises UAC for them.
# Scope = 'machine' passes --scope machine; '' passes none (the manifest declares no scope).
# Inventory: docs/spec/structure.md#winget-パッケージの-user--machine-の振り分け
$WingetMachinePackages = [ordered]@{
  'Chrome'         = @{ Id = 'Google.Chrome'; Scope = 'machine' }
  'JapaneseIME'    = @{ Id = 'Google.JapaneseIME'; Scope = 'machine' }
  '7zip'           = @{ Id = '7zip.7zip'; Scope = 'machine' }
  'HackFonts'      = @{ Id = 'SourceFoundry.HackFonts'; Scope = 'machine' }
  'PythonLauncher' = @{ Id = 'Python.Launcher'; Scope = '' }
{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}
  'iTunes'         = @{ Id = 'Apple.iTunes'; Scope = 'machine' }
  'GoogleDrive'    = @{ Id = 'Google.GoogleDrive'; Scope = 'machine' }
  'Dropbox'        = @{ Id = 'Dropbox.Dropbox'; Scope = 'machine' }
  'Ditto'          = @{ Id = 'Ditto.Ditto'; Scope = 'machine' }
  'Tailscale'      = @{ Id = 'Tailscale.Tailscale'; Scope = 'machine' }
  'Steam'          = @{ Id = 'Valve.Steam'; Scope = 'machine' }
  'Wacom'          = @{ Id = 'Wacom.WacomTabletDriver'; Scope = 'machine' }
{{- end }}
}
$AllowedTargets = @('Chocolatey', 'chocolateygui', 'Keypirinha', 'WinSCP', 'VSCode', 'LongPaths', 'RDP') + @($WingetMachinePackages.Keys)

function Write-Step {
  param([string]$Message)
  Write-Host $Message
  if ($LogPath) { Add-Content -LiteralPath $LogPath -Value $Message -Encoding UTF8 }
}

function Update-PathFromEnvironment {
  # Elevated installs change the Machine PATH; this session's copy is stale.
  $parts = @(
    [Environment]::GetEnvironmentVariable('Path', 'Machine'),
    [Environment]::GetEnvironmentVariable('Path', 'User'),
    $env:Path
  ) | Where-Object { $_ }
  $env:Path = $parts -join ';'
}

function Test-IsElevated {
  $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
  $principal = New-Object Security.Principal.WindowsPrincipal $identity
  return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

# ---------------- detection (runs unelevated) ---------------- #

function Get-ChocoPath {
  $cmd = Get-Command choco -CommandType Application -ErrorAction SilentlyContinue
  if ($cmd) { return $cmd.Source }
  Update-PathFromEnvironment
  $cmd = Get-Command choco -CommandType Application -ErrorAction SilentlyContinue
  if ($cmd) { return $cmd.Source }
  $roots = @($env:ChocolateyInstall, (Join-Path $env:ProgramData 'chocolatey')) | Where-Object { $_ }
  foreach ($root in $roots) {
    $exe = Join-Path $root 'bin\choco.exe'
    if (Test-Path -LiteralPath $exe -PathType Leaf) { return $exe }
  }
  return $null
}

function Get-InstalledChocoPackages {
  param([Parameter(Mandatory)][string]$Choco)
  $versionText = @(& $Choco --version) | Select-Object -First 1
  if ($LASTEXITCODE -ne 0) { throw "Failed to determine the Chocolatey version: $LASTEXITCODE" }
  # Strip pre-release suffixes such as 2.4.0-beta1 so [version] parses.
  $chocoVersion = [version](($versionText -split '-', 2)[0].Trim())
  $listArgs = @('list', '--limit-output')
  if ($chocoVersion.Major -lt 2) { $listArgs += '--local-only' }
  $names = @(& $Choco @listArgs | ForEach-Object { ($_ -split '\|', 2)[0] })
  if ($LASTEXITCODE -ne 0) { throw "Failed to list installed Chocolatey packages: $LASTEXITCODE" }
  return $names
}

function Test-ProgramFilesFile {
  param([Parameter(Mandatory)][string]$Relative)
  $roots = @($env:ProgramFiles, ${env:ProgramFiles(x86)}) | Where-Object { $_ }
  foreach ($root in $roots) {
    if (Test-Path -LiteralPath (Join-Path $root $Relative) -PathType Leaf) { return $true }
  }
  return $false
}

function Test-VSCodeInstalled {
  # Machine or per-user install both count (340_vscode only needs `code`).
  if (Test-ProgramFilesFile 'Microsoft VS Code\Code.exe') { return $true }
  return [bool]($env:LOCALAPPDATA -and
      (Test-Path -LiteralPath (Join-Path $env:LOCALAPPDATA 'Programs\Microsoft VS Code\Code.exe') -PathType Leaf))
}

function Test-LongPathsEnabled {
  $value = Get-ItemPropertyValue -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem' `
      -Name LongPathsEnabled -ErrorAction Ignore
  return $value -eq 1
}

function Test-RdpHostSupported {
  $sku = [int](Get-CimInstance -ClassName Win32_OperatingSystem).OperatingSystemSKU
  return $RdpSkus -contains $sku
}

function Test-RdpConfigured {
  $ts = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server'
  if ((Get-ItemPropertyValue -LiteralPath $ts -Name fDenyTSConnections -ErrorAction Ignore) -ne 0) { return $false }
  if ((Get-ItemPropertyValue -LiteralPath "$ts\WinStations\RDP-Tcp" -Name UserAuthentication -ErrorAction Ignore) -ne 1) { return $false }
  foreach ($name in $RdpRules) {
    # ActiveStore = effective state after policy; Profile flags: Domain=1 Private=2 Public=4 (Any=0 includes Public)
    $rule = Get-NetFirewallRule -Name $name -PolicyStore ActiveStore -ErrorAction SilentlyContinue |
        Select-Object -First 1
    if (-not $rule) { return $false }
    $profileBits = [int]$rule.Profile
    if ("$($rule.Enabled)" -ne 'True' -or $profileBits -eq 0 -or ($profileBits -band 4) -ne 0) { return $false }
  }
  return $true
}

function Get-WingetInstalledText {
  if (-not (Get-Command winget -CommandType Application -ErrorAction SilentlyContinue)) {
    throw 'winget (App Installer) not found; cannot check or install packages'
  }
  # One call for all ids. Redirected output is not truncated, so ids appear in full.
  $text = (& winget list --disable-interactivity --accept-source-agreements | Out-String)
  if ($LASTEXITCODE -ne 0) { throw "winget list failed: $LASTEXITCODE" }
  return $text
}

function Get-Missing {
  $missing = @()
  $choco = Get-ChocoPath
  if (-not $choco) {
    $missing += @('Chocolatey', 'chocolateygui', 'Keypirinha')
  } else {
    $installed = @(Get-InstalledChocoPackages -Choco $choco)
    foreach ($p in @('chocolateygui', 'Keypirinha')) {
      if ($installed -notcontains $p) { $missing += $p }
    }
  }
  if (-not (Test-ProgramFilesFile 'WinSCP\WinSCP.exe')) { $missing += 'WinSCP' }
  if (-not (Test-VSCodeInstalled)) { $missing += 'VSCode' }
  if ($WingetMachinePackages.Count -gt 0) {
    # These packages have no user-scope installer, so any installed copy is the machine one.
    $wingetText = Get-WingetInstalledText
    foreach ($key in $WingetMachinePackages.Keys) {
      if ($wingetText -notmatch ('(?m)\s{2,}' + [regex]::Escape($WingetMachinePackages[$key].Id) + '(\s{2,}|\s*$)')) { $missing += $key }
    }
  }
  if (-not (Test-LongPathsEnabled)) { $missing += 'LongPaths' }
  if ($RdpWanted -and (Test-RdpHostSupported) -and -not (Test-RdpConfigured)) { $missing += 'RDP' }
  return $missing
}

# ---------------- machine-wide steps (elevated) ---------------- #

function Invoke-WingetInstall {
  param([Parameter(Mandatory)][string[]]$InstallArgs)
  if (-not (Get-Command winget -CommandType Application -ErrorAction SilentlyContinue)) {
    throw 'winget (App Installer) not found for this account'
  }
  & winget install @InstallArgs --silent --disable-interactivity `
      --accept-package-agreements --accept-source-agreements
  if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne $WingetNoUpgrade) {
    throw "winget install $($InstallArgs -join ' ') failed: $LASTEXITCODE"
  }
}

function Install-ChocoPackage {
  param([Parameter(Mandatory)][string]$Id)
  $choco = Get-ChocoPath
  if (-not $choco) { throw 'choco not found after installation' }
  if (@(Get-InstalledChocoPackages -Choco $choco) -contains $Id) { return }
  & $choco install $Id -y --no-progress
  if ($LASTEXITCODE -ne 0) { throw "Chocolatey setup failed for ${Id}: $LASTEXITCODE" }
}

function Enable-Rdp {
  $ts = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server'
  Set-ItemProperty -LiteralPath $ts -Name fDenyTSConnections -Value 0
  Set-ItemProperty -LiteralPath "$ts\WinStations\RDP-Tcp" -Name UserAuthentication -Value 1
  # Never open Public: restrict the profile before enabling. Shadow rule is left alone.
  foreach ($name in $RdpRules) {
    Set-NetFirewallRule -Name $name -Profile Domain, Private -Enabled True
  }
  if (-not (Test-RdpConfigured)) {
    throw 'RDP effective state (ActiveStore) does not match; it may be overridden by policy or similar'
  }
}

function Install-Targets {
  param([string[]]$Wanted)
  $script:StepFailures = New-Object System.Collections.Generic.List[string]
  $run = {
    param([string]$Key, [scriptblock]$Action)
    if ($Wanted -notcontains $Key) { return }
    try {
      Write-Step "Setting up $Key..."
      & $Action
    } catch {
      $script:StepFailures.Add("${Key}: $($_.Exception.Message)")
      Write-Step "FAILED ${Key}: $($_.Exception.Message)"
    }
  }

  & $run 'Chocolatey' {
    if (-not (Get-ChocoPath)) {
      Invoke-WingetInstall @('--id', 'Chocolatey.Chocolatey', '--source', 'winget', '--exact')
      Update-PathFromEnvironment
    }
  }
  & $run 'chocolateygui' { Install-ChocoPackage 'chocolateygui' }
  & $run 'Keypirinha' { Install-ChocoPackage 'Keypirinha' }
  # Keypirinha requires WinSCP system-wide to detect its profiles
  & $run 'WinSCP' {
    if (-not (Test-ProgramFilesFile 'WinSCP\WinSCP.exe')) {
      Invoke-WingetInstall @('--id', 'WinSCP.WinSCP', '--exact', '--scope', 'machine')
    }
  }
  & $run 'VSCode' {
    if (-not (Test-VSCodeInstalled)) {
      Invoke-WingetInstall @('--id', 'Microsoft.VisualStudioCode', '--exact', '--scope', 'machine',
          '--override', '/silent /mergetasks=addcontextmenufiles,addcontextmenufolders')
    }
  }
  & $run 'LongPaths' {
    if (-not (Test-LongPathsEnabled)) {
      Set-ItemProperty -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem' -Name LongPathsEnabled -Value 1
    }
  }
  & $run 'RDP' { if (-not (Test-RdpConfigured)) { Enable-Rdp } }
  foreach ($key in $WingetMachinePackages.Keys) {
    if ($Wanted -notcontains $key) { continue }
    $pkg = $WingetMachinePackages[$key]
    try {
      Write-Step "Setting up $key..."
      $installArgs = @('--id', $pkg.Id, '--exact')
      if ($pkg.Scope) { $installArgs += @('--scope', $pkg.Scope) }
      Invoke-WingetInstall $installArgs
    } catch {
      $script:StepFailures.Add("${key}: $($_.Exception.Message)")
      Write-Step "FAILED ${key}: $($_.Exception.Message)"
    }
  }
}

# ---------------- elevated child entry ---------------- #

if ($Targets) {
  $wanted = @($Targets -split ',')
  $unique = @($wanted | Select-Object -Unique)
  if ($unique.Count -ne $wanted.Count -or @($wanted | Where-Object { $AllowedTargets -notcontains $_ }).Count -gt 0) {
    Write-Step "Rejected targets: $Targets"
    exit 2
  }
  try {
    Install-Targets -Wanted $wanted
  } catch {
    Write-Step "FAILED: $($_.Exception.Message)"
    exit 1
  }
  exit $(if ($script:StepFailures.Count -gt 0) { 1 } else { 0 })
}

# ---------------- normal entry (unelevated) ---------------- #

function ConvertTo-PsLiteral {
  param([Parameter(Mandatory)][string]$Value)
  return "'" + $Value.Replace("'", "''") + "'"
}

function Get-FailureHint {
  param([string[]]$Keys)
  if ($Keys -contains 'WinSCP') {
    return ' WinSCP must be machine-wide for Keypirinha: it may already be installed elsewhere (e.g. per-user).' +
        ' Check `winget list --id WinSCP.WinSCP`, uninstall it, then rerun `chezmoi apply`.'
  }
  return ''
}

$missing = @(if ($env:CHEZMOI_309_FORCE_TARGETS) { $env:CHEZMOI_309_FORCE_TARGETS -split ',' } else { Get-Missing })  # env: test only
if ($missing.Count -eq 0) {
  Write-Host 'Admin setup: nothing to do.'
  exit 0
}

if (Test-IsElevated) {
  Install-Targets -Wanted $missing
  if ($script:StepFailures.Count -gt 0) {
    throw ("Admin setup failed: " + ($script:StepFailures -join '; ') + (Get-FailureHint $missing))
  }
} else {
  if (-not $PSCommandPath) { throw 'Cannot locate this script to elevate' }
  Write-Host "Elevating once to set up: $($missing -join ', ')"
  # The child reads this file once, verifies the SHA-256 taken here, and runs that in-memory text.
  $bytes = [IO.File]::ReadAllBytes($PSCommandPath)
  $hash = [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($bytes)).Replace('-', '')
  $log = Join-Path ([IO.Path]::GetTempPath()) ("chezmoi-309-{0}.log" -f [guid]::NewGuid().ToString('N'))
  New-Item -ItemType File -Path $log | Out-Null
  $bootstrap = @(
    ('$b=[IO.File]::ReadAllBytes(' + (ConvertTo-PsLiteral $PSCommandPath) + ')'),
    '$h=[BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($b)).Replace(''-'','''')',
    ('if($h -ne ' + (ConvertTo-PsLiteral $hash) + '){exit 3}'),
    '$t=(New-Object Text.UTF8Encoding($false)).GetString($b).TrimStart([char]0xFEFF)',
    ('& ([scriptblock]::Create($t)) -Targets ' + (ConvertTo-PsLiteral ($missing -join ',')) +
        ' -LogPath ' + (ConvertTo-PsLiteral $log)),
    'exit $LASTEXITCODE'
  ) -join ';'
  $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($bootstrap))
  $startArgs = @{
    FilePath     = 'powershell.exe'
    ArgumentList = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-EncodedCommand', $encoded)
    Wait         = $true
    PassThru     = $true
  }
  if ($env:CHEZMOI_309_NO_UAC -ne '1') { $startArgs['Verb'] = 'RunAs' }  # env: test only
  try {
    $process = Start-Process @startArgs
  } catch {
    throw "Elevation was cancelled or failed (UAC); admin setup not performed: $($_.Exception.Message)"
  } finally {
    $childLog = if (Test-Path -LiteralPath $log) { @(Get-Content -LiteralPath $log -Encoding UTF8) } else { @() }
    Remove-Item -LiteralPath $log -Force -ErrorAction SilentlyContinue
  }
  if ($process.ExitCode -ne 0) {
    $why = if ($process.ExitCode -eq 3) { ' (script changed before elevation, or the elevated account could not read it)' } else { '' }
    throw ("Elevated admin setup failed with exit code $($process.ExitCode)$why. " +
        ($childLog -join ' | ') + (Get-FailureHint $missing))
  }
}

Update-PathFromEnvironment
$still = @(Get-Missing)
if ($still.Count -gt 0) {
  throw ("Still missing after admin setup: $($still -join ', ')." + (Get-FailureHint $still))
}
Write-Host 'Admin setup complete.'
