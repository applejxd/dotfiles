
<#
  .SYNOPSIS
    Install packages by scoop
  .DESCRIPTION
    Install Linux tools to user environments by scoop
#>

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

{{ includeTemplate "powershell/git-config-env.ps1" }}

$scoopRoot = if ($env:SCOOP) {
  $env:SCOOP
} else {
  Join-Path $env:USERPROFILE 'scoop'
}

$scoopShims = Join-Path $scoopRoot 'shims'
$scoopCommand = Join-Path $scoopShims 'scoop.ps1'

if (-not (Test-Path -LiteralPath $scoopCommand)) {
  Invoke-RestMethod https://get.scoop.sh | Invoke-Expression
}

# Add Scoop shims to the current process PATH
if (($env:PATH -split ';') -notcontains $scoopShims) {
  $env:PATH = "$scoopShims;$env:PATH"
}

if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
  throw "Scoop command not found: $scoopCommand"
}

function sinst {
  param(
    [Parameter(Mandatory, ValueFromRemainingArguments)]
    [string[]]$PackageId
  )

  foreach ($id in $PackageId) {
    $appPath = Join-Path $scoopRoot "apps\$id\current"

    if (Test-Path -LiteralPath $appPath) {
      Write-Host "$id is already installed."
      continue
    }

    Write-Host "Installing $id..."
    & scoop install $id

    if ($LASTEXITCODE -ne 0) {
      throw "scoop install failed for ${id}: $LASTEXITCODE"
    }
  }
}

# Linux commands (gow = Gnu on Windows)
# see https://github.com/bmatzelle/gow/wiki/executables_list
sinst sudo gow

# Build tools
sinst mingw-winlibs

# Other tools
sinst ghq pdftk
