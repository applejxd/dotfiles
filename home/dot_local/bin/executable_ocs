#!/usr/bin/env python3
"""OpenCode を OS のアクセス制御で囲って起動する ``ocs`` の入口。

本体は ``~/.local/share/ocs/`` にあり、ここから絶対パスで読み込む。
**sys.path・PYTHONPATH・カレントディレクトリからは探さない。**
see docs/spec/opencode-sandbox.md#ランチャーの構成
"""

from __future__ import annotations

import importlib
import importlib.util
import sys
from pathlib import Path

LIB = Path.home() / ".local/share/ocs"
PACKAGE = "ocs_lib"


def load(lib: Path):
    """``lib`` をパッケージとして読み込み、その ``cli`` を返す。

    ★下位モジュールはパッケージの ``__path__`` (= ``lib`` だけ) から探される。
      同名のものが先に ``sys.modules`` にあれば捨ててから読む。
    """
    for name in [n for n in sys.modules if n == PACKAGE or n.startswith(PACKAGE + ".")]:
        del sys.modules[name]
    spec = importlib.util.spec_from_file_location(
        PACKAGE, lib / "__init__.py", submodule_search_locations=[str(lib)]
    )
    if spec is None or spec.loader is None:
        raise ImportError(f"{lib} を読み込めない")
    package = importlib.util.module_from_spec(spec)
    sys.modules[PACKAGE] = package
    spec.loader.exec_module(package)
    return importlib.import_module(f"{PACKAGE}.cli")


if __name__ == "__main__":
    # 配備先へ __pycache__ を作らない (chezmoi の管理対象と中身を揃える)
    sys.dont_write_bytecode = True
    if not (LIB / "cli.py").is_file():
        print(f"境界を張れないので起動しない: 本体が無い: {LIB}", file=sys.stderr)
        print("  chezmoi apply で配備する", file=sys.stderr)
        sys.exit(1)
    sys.exit(load(LIB).main())
