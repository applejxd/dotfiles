<#
  .SYNOPSIS
    Run every machine-wide (admin) setup step behind a single UAC prompt.
  .DESCRIPTION
    Detects what is missing as the signed-in user; only when something is missing,
    elevates once and runs just those steps. The elevated child never writes to a
    user profile (HKCU / %APPDATA% / ~). Result is re-checked as the signed-in user.
    see docs/spec/structure.md#管理者権限の集約
  .PARAMETER Targets
    Internal. Comma-separated allow-listed keys; set only for the elevated child.
  .PARAMETER LogPath
    Internal. File the elevated child appends its messages to (its console closes).
#>
param([string]$Targets = '', [string]$LogPath = '')

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$WingetNoUpgrade = -1978335189  # 0x8A15002B: no applicable upgrade (already installed)
$RdpRules = @('RemoteDesktop-UserMode-In-TCP', 'RemoteDesktop-UserMode-In-UDP')
$RdpSkus = @(4, 27, 48, 49, 72, 121, 122, 161, 164, 175)  # Enterprise / Pro / Education families
$SshdRule = 'OpenSSH-Server-In-TCP'
{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}
$RdpWanted = $true
$SshdWanted = $true
$SudoWanted = $true
$WslWanted = $true
{{- else }}
$RdpWanted = $false
$SshdWanted = $false
$SudoWanted = $false
$WslWanted = $false
{{- end }}

# GPU の電力上限 (この PC の RTX 3070 だけ。hostname と、実行時の型番の両方で限定)。see docs/spec/structure.md#gpu-の電力上限
{{- if and (regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username) (eq (lower .chezmoi.hostname) "heimdall-ufbs-010") }}
$GpuPowerLimitWanted = $true
{{- else }}
$GpuPowerLimitWanted = $false
{{- end }}
$GpuPowerLimitWatts = 150
$GpuPowerModelPattern = 'RTX 3070'
$GpuPowerTaskName = 'gpu-power-limit'
$GpuPowerDir = Join-Path $env:ProgramData 'gpu-power-limit'
$GpuPowerScript = Join-Path $GpuPowerDir 'set-power-limit.ps1'

# winget packages whose only installers are machine-wide (or scope-unspecified MSI), so winget raises UAC for them.
# Scope = 'machine' passes --scope machine; '' passes none (the manifest declares no scope).
# Inventory: docs/spec/structure.md#winget-パッケージの-user--machine-の振り分け
$WingetMachinePackages = [ordered]@{
  'Chrome'         = @{ Id = 'Google.Chrome'; Scope = 'machine' }
  'JapaneseIME'    = @{ Id = 'Google.JapaneseIME'; Scope = 'machine' }
  '7zip'           = @{ Id = '7zip.7zip'; Scope = 'machine' }
  'HackFonts'      = @{ Id = 'SourceFoundry.HackFonts'; Scope = 'machine' }
  'PythonLauncher' = @{ Id = 'Python.Launcher'; Scope = '' }
{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}
  'GoogleDrive'    = @{ Id = 'Google.GoogleDrive'; Scope = 'machine' }
  'Dropbox'        = @{ Id = 'Dropbox.Dropbox'; Scope = 'machine' }
  'Ditto'          = @{ Id = 'Ditto.Ditto'; Scope = 'machine' }
  'Tailscale'      = @{ Id = 'Tailscale.Tailscale'; Scope = 'machine' }
  # sshd runs the default shell from a fixed path, so it needs the machine MSI (stable path). The MSIX under
  # WindowsApps changes its path on every update and would lock out ssh logins. File = checked instead of winget list
  # (the MSIX copy is also listed); Force installs the MSI next to the MSIX copy.
  'PowerShellMsi'  = @{ Id = 'Microsoft.PowerShell'; Scope = 'machine'; InstallerType = 'wix'; Force = $true; File = 'PowerShell\7\pwsh.exe' }
{{- if eq (lower .chezmoi.hostname) "heimdall-ufbs-010" }}
  # 機器・用途がこの PC 固有のものだけ (hostname で限定)。Stream Deck / Wacom は本体をつないだ PC、Steam はゲーム用、iTunes は iPhone の同期用
  'StreamDeck'     = @{ Id = 'Elgato.StreamDeck'; Scope = 'machine' }
  'Wacom'          = @{ Id = 'Wacom.WacomTabletDriver'; Scope = 'machine' }
  'Steam'          = @{ Id = 'Valve.Steam'; Scope = 'machine' }
  'iTunes'         = @{ Id = 'Apple.iTunes'; Scope = 'machine' }
{{- end }}
{{- end }}
}
$AllowedTargets = @('Chocolatey', 'chocolateygui', 'Keypirinha', 'WinSCP', 'VSCode', 'LongPaths', 'RDP', 'OpenSSHServer', 'SshDefaultShell', 'Sudo', 'WslPlatform', 'GpuPowerLimit') + @($WingetMachinePackages.Keys)

function Write-Step {
  param([string]$Message)
  Write-Host $Message
  if ($LogPath) { Add-Content -LiteralPath $LogPath -Value $Message -Encoding UTF8 }
}

{{ includeTemplate "powershell/env-path.ps1" }}

function Test-IsElevated {
  $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
  $principal = New-Object Security.Principal.WindowsPrincipal $identity
  return $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

# ---------------- detection (runs unelevated) ---------------- #

function Get-ChocoPath {
  $cmd = Get-Command choco -CommandType Application -ErrorAction SilentlyContinue
  if ($cmd) { return $cmd.Source }
  Update-PathFromEnvironment
  $cmd = Get-Command choco -CommandType Application -ErrorAction SilentlyContinue
  if ($cmd) { return $cmd.Source }
  $roots = @($env:ChocolateyInstall, (Join-Path $env:ProgramData 'chocolatey')) | Where-Object { $_ }
  foreach ($root in $roots) {
    $exe = Join-Path $root 'bin\choco.exe'
    if (Test-Path -LiteralPath $exe -PathType Leaf) { return $exe }
  }
  return $null
}

function Get-InstalledChocoPackages {
  param([Parameter(Mandatory)][string]$Choco)
  $versionText = @(& $Choco --version) | Select-Object -First 1
  if ($LASTEXITCODE -ne 0) { throw "Failed to determine the Chocolatey version: $LASTEXITCODE" }
  # Strip pre-release suffixes such as 2.4.0-beta1 so [version] parses.
  $chocoVersion = [version](($versionText -split '-', 2)[0].Trim())
  $listArgs = @('list', '--limit-output')
  if ($chocoVersion.Major -lt 2) { $listArgs += '--local-only' }
  $names = @(& $Choco @listArgs | ForEach-Object { ($_ -split '\|', 2)[0] })
  if ($LASTEXITCODE -ne 0) { throw "Failed to list installed Chocolatey packages: $LASTEXITCODE" }
  return $names
}

function Test-ProgramFilesFile {
  param([Parameter(Mandatory)][string]$Relative)
  $roots = @($env:ProgramFiles, ${env:ProgramFiles(x86)}) | Where-Object { $_ }
  foreach ($root in $roots) {
    if (Test-Path -LiteralPath (Join-Path $root $Relative) -PathType Leaf) { return $true }
  }
  return $false
}

function Test-VSCodeInstalled {
  # Machine or per-user install both count (347 only needs `code`).
  if (Test-ProgramFilesFile 'Microsoft VS Code\Code.exe') { return $true }
  return [bool]($env:LOCALAPPDATA -and
      (Test-Path -LiteralPath (Join-Path $env:LOCALAPPDATA 'Programs\Microsoft VS Code\Code.exe') -PathType Leaf))
}

function Test-LongPathsEnabled {
  $value = Get-ItemPropertyValue -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem' `
      -Name LongPathsEnabled -ErrorAction Ignore
  return $value -eq 1
}

function Test-RdpHostSupported {
  $sku = [int](Get-CimInstance -ClassName Win32_OperatingSystem).OperatingSystemSKU
  return $RdpSkus -contains $sku
}

function Test-RdpConfigured {
  $ts = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server'
  if ((Get-ItemPropertyValue -LiteralPath $ts -Name fDenyTSConnections -ErrorAction Ignore) -ne 0) { return $false }
  if ((Get-ItemPropertyValue -LiteralPath "$ts\WinStations\RDP-Tcp" -Name UserAuthentication -ErrorAction Ignore) -ne 1) { return $false }
  foreach ($name in $RdpRules) {
    # ActiveStore = effective state after policy; Profile flags: Domain=1 Private=2 Public=4 (Any=0 includes Public)
    $rule = Get-NetFirewallRule -Name $name -PolicyStore ActiveStore -ErrorAction SilentlyContinue |
        Select-Object -First 1
    if (-not $rule) { return $false }
    $profileBits = [int]$rule.Profile
    if ("$($rule.Enabled)" -ne 'True' -or $profileBits -eq 0 -or ($profileBits -band 4) -ne 0) { return $false }
  }
  return $true
}

function Get-WingetInstalledText {
  if (-not (Get-Command winget -CommandType Application -ErrorAction SilentlyContinue)) {
    throw 'winget (App Installer) not found; cannot check or install packages'
  }
  # One call for all ids. Redirected output is not truncated, so ids appear in full.
  $text = (& winget list --disable-interactivity --accept-source-agreements | Out-String)
  if ($LASTEXITCODE -ne 0) { throw "winget list failed: $LASTEXITCODE" }
  return $text
}

function Test-SshdConfigured {
  $svc = Get-Service -Name sshd -ErrorAction SilentlyContinue
  if (-not $svc -or @('Automatic', 'AutomaticDelayedStart') -notcontains "$($svc.StartType)" -or "$($svc.Status)" -ne 'Running') {
    return $false
  }
  # ActiveStore = effective state after policy; Public (bit 4) must not be included
  $rule = Get-NetFirewallRule -Name $SshdRule -PolicyStore ActiveStore -ErrorAction SilentlyContinue | Select-Object -First 1
  if (-not $rule) { return $false }
  $profileBits = [int]$rule.Profile
  return ("$($rule.Enabled)" -eq 'True' -and $profileBits -ne 0 -and ($profileBits -band 4) -eq 0)
}

function Get-SshDefaultShellPath {
  return (Join-Path $env:ProgramFiles 'PowerShell\7\pwsh.exe')
}

function Test-SshDefaultShell {
  $expected = Get-SshDefaultShellPath
  $value = $null
  # Get-ItemPropertyValue throws for a missing property even with -ErrorAction Ignore (Windows PowerShell 5.1)
  try { $value = Get-ItemPropertyValue -LiteralPath 'HKLM:\SOFTWARE\OpenSSH' -Name DefaultShell -ErrorAction Stop } catch {}
  return ($value -eq $expected -and (Test-Path -LiteralPath $expected -PathType Leaf))
}

function Test-SudoSupported {
  # Windows 11 24H2 以降 (System32 に sudo.exe がある)
  return (Test-Path -LiteralPath (Join-Path $env:SystemRoot 'System32\sudo.exe') -PathType Leaf)
}

function Test-SudoEnabled {
  # 設定は HKLM\...\Sudo の Enabled (0 = 無効 / 1 = forceNewWindow / 2 = disableInput / 3 = normal)。有効な方式は選び直さない
  $value = $null
  try { $value = Get-ItemPropertyValue -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Sudo' -Name Enabled -ErrorAction Stop } catch {}
  return ($null -ne $value -and [int]$value -ge 1)
}

function Test-SudoAllowedByPolicy {
  # ポリシーの Enabled = 0 は sudo を無効に固定する。値が無ければ制限なし
  try {
    return ([int](Get-ItemPropertyValue -LiteralPath 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\Sudo' -Name Enabled -ErrorAction Stop) -ge 1)
  } catch {
    return $true
  }
}

function Enable-Sudo {
  # 公式の手順 (sudo config --enable)。既定の forceNewWindow (新しい窓で実行。sudo のたびに UAC の確認が出る)
  & (Join-Path $env:SystemRoot 'System32\sudo.exe') config --enable forceNewWindow
  if ($LASTEXITCODE -ne 0) { throw "sudo config --enable forceNewWindow failed: $LASTEXITCODE" }
}

function Test-WslInstalled {
  # WSL 本体 (ディストロは問わない)。未導入だと、inbox の wsl.exe が案内を出して終了コード 1 を返す
  try {
    & wsl.exe --version 2>&1 | Out-Null
    if ($LASTEXITCODE -ne 0) { return $false }
    # wsl.exe 本体があっても VirtualMachinePlatform が無いと distro を起動できない (HCS_E_SERVICE_NOT_AVAILABLE)。vmcompute の有無で見る
    return [bool](Get-Service -Name vmcompute -ErrorAction SilentlyContinue)
  } catch {
    return $false
  }
}

function Invoke-WslCommand {
  # wsl.exe は UTF-16 で出力する。受け取る側の符号化を合わせて、失敗の理由をログに残せるようにする
  param([Parameter(Mandatory)][string[]]$WslArgs)
  $previous = [Console]::OutputEncoding
  try {
    [Console]::OutputEncoding = [Text.Encoding]::Unicode
    $text = (& wsl.exe @WslArgs 2>&1 | Out-String).Trim()
  } finally {
    [Console]::OutputEncoding = $previous
  }
  return @{ ExitCode = $LASTEXITCODE; Text = $text }
}

function Enable-Wsl {
  # 機能の有効化と WSL 本体だけ。ディストロは入れない (入れる場所の方針は別。docs/change/0022 の保留)
  # wsl.exe が先に入っていると --install は機能を有効化しないことがあるので明示する (3010 = 要再起動)
  & dism.exe /online /enable-feature /featurename:VirtualMachinePlatform /all /norestart | Out-Null
  if ($LASTEXITCODE -notin 0, 3010) { throw "dism VirtualMachinePlatform failed: $LASTEXITCODE" }
  if ((& bcdedit.exe /enum '{current}' 2>&1 | Out-String) -match 'hypervisorlaunchtype\s+Off') {
    & bcdedit.exe /set hypervisorlaunchtype auto | Out-Null
  }
  $install = Invoke-WslCommand @('--install', '--no-distribution')
  if ($install.ExitCode -ne 0) { throw "wsl --install --no-distribution failed: $($install.ExitCode) $($install.Text)" }
  # 仮想マシン プラットフォームの有効化には再起動が要る。導入した直後でも wsl --version は成功する
  if ($install.Text -match '(?i)restart|再起動') { Write-Step 'WSL: a restart is needed to finish enabling the Windows features' }
  # 最新版 (WSL containers の wslc を含む 3.x) へ。失敗しても導入自体は済んでいる
  $update = Invoke-WslCommand @('--update')
  if ($update.ExitCode -ne 0) { Write-Step "WSL: wsl --update failed ($($update.ExitCode)); run it manually" }
}

# ---- GPU の電力上限 ---- #
# 電力上限は再起動・ドライバのリセット・スリープ復帰で既定値へ戻る (Windows に永続化の手段が無い)。
# SYSTEM のタスクが、起動・ログオン・復帰のたびに設定し直す。SYSTEM が実行するスクリプトは、
# 管理者と SYSTEM しか書けない場所 (ProgramData 配下) に置き、通常ユーザーが書き換えて昇格できないようにする。
function Get-GpuPowerScriptText {
  # 型番に合う GPU だけに -pl を実行する。ドライバが立ち上がるまで最大 2 分待つ。内容は ASCII のみ
  $template = @'
$ErrorActionPreference = 'Stop'
$smi = Join-Path $env:SystemRoot 'System32\nvidia-smi.exe'
$rows = $null
for ($i = 0; $i -lt 12; $i++) {
  $out = @(& $smi --query-gpu=index,name --format=csv,noheader 2>$null)
  if ($LASTEXITCODE -eq 0 -and $out.Count -gt 0) { $rows = $out; break }
  Start-Sleep -Seconds 10
}
if (-not $rows) { exit 1 }
$target = $rows | Where-Object { $_ -match '__PATTERN__' } | Select-Object -First 1
if (-not $target) { exit 0 }
$index = ($target -split ',')[0].Trim()
& $smi -i $index -pl __LIMIT__
exit $LASTEXITCODE
'@
  return $template.Replace('__PATTERN__', $GpuPowerModelPattern).Replace('__LIMIT__', [string]$GpuPowerLimitWatts)
}

function Get-NvidiaSmiPath {
  $path = Join-Path $env:SystemRoot 'System32\nvidia-smi.exe'
  if (Test-Path -LiteralPath $path -PathType Leaf) { return $path }
  return $null
}

function Test-GpuPowerLimitApplicable {
  # 型番に合う GPU が見えるときだけ対象にする (GPU を替えた・ドライバが無い機械では何もしない)
  $smi = Get-NvidiaSmiPath
  if (-not $smi) { return $false }
  $names = @(& $smi --query-gpu=name --format=csv,noheader 2>$null)
  if ($LASTEXITCODE -ne 0) { return $false }
  return [bool]($names | Where-Object { $_ -match $GpuPowerModelPattern })
}

function Test-GpuPowerLimitConfigured {
  if (-not (Test-Path -LiteralPath $GpuPowerScript -PathType Leaf)) { return $false }
  $actual = (Get-Content -LiteralPath $GpuPowerScript -Raw) -replace "`r`n", "`n"
  $expected = (Get-GpuPowerScriptText) -replace "`r`n", "`n"
  if ($actual.Trim() -ne $expected.Trim()) { return $false }
  # 通常権限では SYSTEM のタスクを読めない (Get-ScheduledTask が無言で空を返す。実機で確認済み)。
  # スクリプトは昇格側がタスクと一緒に作るので、通常権限では内容の一致だけで設定済みとみなす (タスクを手で消したときは検知しない)
  if (-not (Test-IsElevated)) { return $true }
  $task = Get-ScheduledTask -TaskName $GpuPowerTaskName -ErrorAction Ignore
  if (-not $task) { return $false }
  if ($task.Principal.UserId -ne 'SYSTEM' -or $task.Principal.RunLevel -ne 'Highest') { return $false }
  return @($task.Triggers).Count -eq 3
}

function Enable-GpuPowerLimit {
  # ディレクトリごと作り直し、所有者と ACL を昇格後の管理者のものにする (事前に置かれたファイルを引き継がない)
  if (Test-Path -LiteralPath $GpuPowerDir) {
    $existing = Get-Item -LiteralPath $GpuPowerDir -Force
    if ($existing.Attributes -band [IO.FileAttributes]::ReparsePoint) {
      # リンク (ジャンクション・シンボリックリンク) はリンクだけを外す。再帰削除でリンク先の中身を消さない
      if ($existing.PSIsContainer) { [IO.Directory]::Delete($GpuPowerDir) } else { [IO.File]::Delete($GpuPowerDir) }
    } else {
      Remove-Item -LiteralPath $GpuPowerDir -Recurse -Force
    }
  }
  New-Item -ItemType Directory -Path $GpuPowerDir | Out-Null
  & icacls.exe $GpuPowerDir /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' '*S-1-5-32-545:(OI)(CI)RX' | Out-Null
  if ($LASTEXITCODE -ne 0) { throw "icacls failed: $LASTEXITCODE" }
  [IO.File]::WriteAllText($GpuPowerScript, (Get-GpuPowerScriptText), (New-Object Text.UTF8Encoding($false)))

  $action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument ('-NoProfile -ExecutionPolicy Bypass -File "' + $GpuPowerScript + '"')
  $boot = New-ScheduledTaskTrigger -AtStartup
  $boot.Delay = 'PT1M'
  $logon = New-ScheduledTaskTrigger -AtLogOn
  $eventClass = Get-CimClass -ClassName MSFT_TaskEventTrigger -Namespace 'Root/Microsoft/Windows/TaskScheduler'
  $resume = New-CimInstance -CimClass $eventClass -ClientOnly
  $resume.Enabled = $true
  $resume.Subscription = '<QueryList><Query Id="0" Path="System"><Select Path="System">*[System[Provider[@Name=''Microsoft-Windows-Power-Troubleshooter''] and EventID=1]]</Select></Query></QueryList>'
  $resume.Delay = 'PT10S'
  $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable `
      -ExecutionTimeLimit (New-TimeSpan -Minutes 10)
  $principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
  Register-ScheduledTask -TaskName $GpuPowerTaskName -Action $action -Trigger @($boot, $logon, $resume) `
      -Settings $settings -Principal $principal -Description "Set the GPU power limit to $GpuPowerLimitWatts W (RTX 3070 only)" -Force | Out-Null

  # 今の起動にも反映し、上限が変わったことを読み取って確かめる
  Start-ScheduledTask -TaskName $GpuPowerTaskName
  $smi = Get-NvidiaSmiPath
  $applied = $false
  for ($i = 0; $i -lt 30 -and -not $applied; $i++) {
    Start-Sleep -Seconds 2
    $limits = @(& $smi --query-gpu=power.limit --format=csv,noheader,nounits 2>$null)
    $applied = [bool]($limits | Where-Object { [math]::Round([double]($_.Trim())) -eq $GpuPowerLimitWatts })
  }
  if (-not $applied) { throw "GPU power limit did not become $GpuPowerLimitWatts W (see Task Scheduler: $GpuPowerTaskName)" }
}

function Get-Missing {
  $missing = @()
  $choco = Get-ChocoPath
  if (-not $choco) {
    $missing += @('Chocolatey', 'chocolateygui', 'Keypirinha')
  } else {
    $installed = @(Get-InstalledChocoPackages -Choco $choco)
    foreach ($p in @('chocolateygui', 'Keypirinha')) {
      if ($installed -notcontains $p) { $missing += $p }
    }
  }
  if (-not (Test-ProgramFilesFile 'WinSCP\WinSCP.exe')) { $missing += 'WinSCP' }
  if (-not (Test-VSCodeInstalled)) { $missing += 'VSCode' }
  if ($WingetMachinePackages.Count -gt 0) {
    # These packages have no user-scope installer, so any installed copy is the machine one.
    $wingetText = Get-WingetInstalledText
    foreach ($key in $WingetMachinePackages.Keys) {
      $entry = $WingetMachinePackages[$key]
      if ($entry.ContainsKey('File')) {
        if (-not (Test-ProgramFilesFile $entry.File)) { $missing += $key }
        continue
      }
      if ($wingetText -notmatch ('(?m)\s{2,}' + [regex]::Escape($WingetMachinePackages[$key].Id) + '(\s{2,}|\s*$)')) { $missing += $key }
    }
  }
  if (-not (Test-LongPathsEnabled)) { $missing += 'LongPaths' }
  if ($RdpWanted -and (Test-RdpHostSupported) -and -not (Test-RdpConfigured)) { $missing += 'RDP' }
  if ($SshdWanted -and -not (Test-SshdConfigured)) { $missing += 'OpenSSHServer' }
  if ($SshdWanted -and -not (Test-SshDefaultShell)) { $missing += 'SshDefaultShell' }
  if ($SudoWanted -and (Test-SudoSupported) -and (Test-SudoAllowedByPolicy) -and -not (Test-SudoEnabled)) { $missing += 'Sudo' }
  if ($WslWanted -and -not (Test-WslInstalled)) { $missing += 'WslPlatform' }
  if ($GpuPowerLimitWanted -and (Test-GpuPowerLimitApplicable) -and -not (Test-GpuPowerLimitConfigured)) { $missing += 'GpuPowerLimit' }
  return $missing
}

# ---------------- machine-wide steps (elevated) ---------------- #

function Invoke-WingetInstall {
  param([Parameter(Mandatory)][string[]]$InstallArgs)
  if (-not (Get-Command winget -CommandType Application -ErrorAction SilentlyContinue)) {
    throw 'winget (App Installer) not found for this account'
  }
  & winget install @InstallArgs --silent --disable-interactivity `
      --accept-package-agreements --accept-source-agreements
  if ($LASTEXITCODE -ne 0 -and $LASTEXITCODE -ne $WingetNoUpgrade) {
    throw "winget install $($InstallArgs -join ' ') failed: $LASTEXITCODE"
  }
}

function Install-ChocoPackage {
  param([Parameter(Mandatory)][string]$Id)
  $choco = Get-ChocoPath
  if (-not $choco) { throw 'choco not found after installation' }
  if (@(Get-InstalledChocoPackages -Choco $choco) -contains $Id) { return }
  & $choco install $Id -y --no-progress
  if ($LASTEXITCODE -ne 0) { throw "Chocolatey setup failed for ${Id}: $LASTEXITCODE" }
}

function Enable-Rdp {
  $ts = 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server'
  Set-ItemProperty -LiteralPath $ts -Name fDenyTSConnections -Value 0
  Set-ItemProperty -LiteralPath "$ts\WinStations\RDP-Tcp" -Name UserAuthentication -Value 1
  # Never open Public: restrict the profile before enabling. Shadow rule is left alone.
  foreach ($name in $RdpRules) {
    Set-NetFirewallRule -Name $name -Profile Domain, Private -Enabled True
  }
  if (-not (Test-RdpConfigured)) {
    throw 'RDP effective state (ActiveStore) does not match; it may be overridden by policy or similar'
  }
}

function Enable-Sshd {
  if (-not (Get-Service -Name sshd -ErrorAction SilentlyContinue)) {
    # Windows capability (needs Windows Update access). The built-in rule is created by the capability
    $cap = Add-WindowsCapability -Online -Name 'OpenSSH.Server~~~~0.0.1.0'
    if ($cap.RestartNeeded) { Write-Step 'OpenSSH Server: a restart is needed to finish installation' }
  }
  Set-Service -Name sshd -StartupType Automatic
  if ("$((Get-Service -Name sshd).Status)" -ne 'Running') { Start-Service -Name sshd }
  # Never open Public: the built-in rule has Profile=Any, so restrict it. ssh-agent is left alone.
  if (Get-NetFirewallRule -Name $SshdRule -ErrorAction SilentlyContinue) {
    Set-NetFirewallRule -Name $SshdRule -Profile Domain, Private -Enabled True
  } else {
    New-NetFirewallRule -Name $SshdRule -DisplayName 'OpenSSH Server (sshd)' -Direction Inbound -Protocol TCP `
        -LocalPort 22 -Action Allow -Profile Domain, Private -Enabled True | Out-Null
  }
  if (-not (Test-SshdConfigured)) {
    throw 'OpenSSH Server effective state (service / ActiveStore firewall) does not match; a restart or policy may be involved'
  }
}

function Enable-SshDefaultShell {
  $path = Get-SshDefaultShellPath
  # Never point sshd at a missing shell (every ssh login would fail)
  if (-not (Test-Path -LiteralPath $path -PathType Leaf)) {
    throw "$path not found; install PowerShell 7 (MSI) first"
  }
  $key = 'HKLM:\SOFTWARE\OpenSSH'
  if (-not (Test-Path -LiteralPath $key)) { New-Item -Path $key -Force | Out-Null }
  New-ItemProperty -LiteralPath $key -Name DefaultShell -PropertyType String -Value $path -Force | Out-Null
}

function Install-Targets {
  param([string[]]$Wanted)
  $script:StepFailures = New-Object System.Collections.Generic.List[string]
  $run = {
    param([string]$Key, [scriptblock]$Action)
    if ($Wanted -notcontains $Key) { return }
    try {
      Write-Step "Setting up $Key..."
      & $Action
    } catch {
      $script:StepFailures.Add("${Key}: $($_.Exception.Message)")
      Write-Step "FAILED ${Key}: $($_.Exception.Message)"
    }
  }

  & $run 'Chocolatey' {
    if (-not (Get-ChocoPath)) {
      Invoke-WingetInstall @('--id', 'Chocolatey.Chocolatey', '--source', 'winget', '--exact')
      Update-PathFromEnvironment
    }
  }
  & $run 'chocolateygui' { Install-ChocoPackage 'chocolateygui' }
  & $run 'Keypirinha' { Install-ChocoPackage 'Keypirinha' }
  # Keypirinha requires WinSCP system-wide to detect its profiles
  & $run 'WinSCP' {
    if (-not (Test-ProgramFilesFile 'WinSCP\WinSCP.exe')) {
      Invoke-WingetInstall @('--id', 'WinSCP.WinSCP', '--exact', '--scope', 'machine')
    }
  }
  & $run 'VSCode' {
    if (-not (Test-VSCodeInstalled)) {
      Invoke-WingetInstall @('--id', 'Microsoft.VisualStudioCode', '--exact', '--scope', 'machine',
          '--override', '/silent /mergetasks=addcontextmenufiles,addcontextmenufolders')
    }
  }
  & $run 'LongPaths' {
    if (-not (Test-LongPathsEnabled)) {
      Set-ItemProperty -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem' -Name LongPathsEnabled -Value 1
    }
  }
  & $run 'RDP' { if (-not (Test-RdpConfigured)) { Enable-Rdp } }
  & $run 'OpenSSHServer' { if (-not (Test-SshdConfigured)) { Enable-Sshd } }
  & $run 'Sudo' { if (-not (Test-SudoEnabled)) { Enable-Sudo } }
  & $run 'WslPlatform' { if (-not (Test-WslInstalled)) { Enable-Wsl } }
  & $run 'GpuPowerLimit' { if (-not (Test-GpuPowerLimitConfigured)) { Enable-GpuPowerLimit } }
  foreach ($key in $WingetMachinePackages.Keys) {
    if ($Wanted -notcontains $key) { continue }
    $pkg = $WingetMachinePackages[$key]
    try {
      Write-Step "Setting up $key..."
      $installArgs = @('--id', $pkg.Id, '--exact')
      if ($pkg.Scope) { $installArgs += @('--scope', $pkg.Scope) }
      if ($pkg.ContainsKey('InstallerType')) { $installArgs += @('--installer-type', $pkg.InstallerType) }
      if ($pkg.ContainsKey('Force') -and $pkg.Force) { $installArgs += '--force' }
      Invoke-WingetInstall $installArgs
    } catch {
      $script:StepFailures.Add("${key}: $($_.Exception.Message)")
      Write-Step "FAILED ${key}: $($_.Exception.Message)"
    }
  }
  # After the packages: the default shell points at the MSI-installed pwsh
  & $run 'SshDefaultShell' { if (-not (Test-SshDefaultShell)) { Enable-SshDefaultShell } }
}

# ---------------- elevated child entry ---------------- #

if ($Targets) {
  $wanted = @($Targets -split ',')
  $unique = @($wanted | Select-Object -Unique)
  if ($unique.Count -ne $wanted.Count -or @($wanted | Where-Object { $AllowedTargets -notcontains $_ }).Count -gt 0) {
    Write-Step "Rejected targets: $Targets"
    exit 2
  }
  try {
    Install-Targets -Wanted $wanted
  } catch {
    Write-Step "FAILED: $($_.Exception.Message)"
    exit 1
  }
  exit $(if ($script:StepFailures.Count -gt 0) { 1 } else { 0 })
}

# ---------------- normal entry (unelevated) ---------------- #

function ConvertTo-PsLiteral {
  param([Parameter(Mandatory)][string]$Value)
  return "'" + $Value.Replace("'", "''") + "'"
}

function Get-FailureHint {
  param([string[]]$Keys)
  if ($Keys -contains 'WinSCP') {
    return ' WinSCP must be machine-wide for Keypirinha: it may already be installed elsewhere (e.g. per-user).' +
        ' Check `winget list --id WinSCP.WinSCP`, uninstall it, then rerun `chezmoi apply`.'
  }
  return ''
}

$missing = @(if ($env:CHEZMOI_309_FORCE_TARGETS) { $env:CHEZMOI_309_FORCE_TARGETS -split ',' } else { Get-Missing })  # env: test only
if ($missing.Count -eq 0) {
  Write-Host 'Admin setup: nothing to do.'
  exit 0
}

if (Test-IsElevated) {
  Install-Targets -Wanted $missing
  if ($script:StepFailures.Count -gt 0) {
    throw ("Admin setup failed: " + ($script:StepFailures -join '; ') + (Get-FailureHint $missing))
  }
} else {
  if (-not $PSCommandPath) { throw 'Cannot locate this script to elevate' }
  Write-Host "Elevating once to set up: $($missing -join ', ')"
  # The child reads this file once, verifies the SHA-256 taken here, and runs that in-memory text.
  $bytes = [IO.File]::ReadAllBytes($PSCommandPath)
  $hash = [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($bytes)).Replace('-', '')
  $log = Join-Path ([IO.Path]::GetTempPath()) ("chezmoi-309-{0}.log" -f [guid]::NewGuid().ToString('N'))
  New-Item -ItemType File -Path $log | Out-Null
  $bootstrap = @(
    ('$b=[IO.File]::ReadAllBytes(' + (ConvertTo-PsLiteral $PSCommandPath) + ')'),
    '$h=[BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash($b)).Replace(''-'','''')',
    ('if($h -ne ' + (ConvertTo-PsLiteral $hash) + '){exit 3}'),
    '$t=(New-Object Text.UTF8Encoding($false)).GetString($b).TrimStart([char]0xFEFF)',
    ('& ([scriptblock]::Create($t)) -Targets ' + (ConvertTo-PsLiteral ($missing -join ',')) +
        ' -LogPath ' + (ConvertTo-PsLiteral $log)),
    'exit $LASTEXITCODE'
  ) -join ';'
  $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($bootstrap))
  $startArgs = @{
    FilePath     = 'powershell.exe'
    ArgumentList = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-EncodedCommand', $encoded)
    Wait         = $true
    PassThru     = $true
  }
  if ($env:CHEZMOI_309_NO_UAC -ne '1') { $startArgs['Verb'] = 'RunAs' }  # env: test only
  try {
    $process = Start-Process @startArgs
  } catch {
    throw "Elevation was cancelled or failed (UAC); admin setup not performed: $($_.Exception.Message)"
  } finally {
    $childLog = if (Test-Path -LiteralPath $log) { @(Get-Content -LiteralPath $log -Encoding UTF8) } else { @() }
    Remove-Item -LiteralPath $log -Force -ErrorAction SilentlyContinue
  }
  if ($process.ExitCode -ne 0) {
    $why = if ($process.ExitCode -eq 3) { ' (script changed before elevation, or the elevated account could not read it)' } else { '' }
    throw ("Elevated admin setup failed with exit code $($process.ExitCode)$why. " +
        ($childLog -join ' | ') + (Get-FailureHint $missing))
  }
}

Update-PathFromEnvironment
$still = @(Get-Missing)
# 機能の有効化は再起動後に vmcompute が現れる。導入を試みた後は再起動待ちとして警告に留める (失敗なら Install-Targets が throw 済み)
if ($still -contains 'WslPlatform' -and $missing -contains 'WslPlatform') {
  Write-Warning 'WSL: restart Windows to finish enabling VirtualMachinePlatform, then run: mise run restore:wsl'
  $still = @($still | Where-Object { $_ -ne 'WslPlatform' })
}
if ($still.Count -gt 0) {
  throw ("Still missing after admin setup: $($still -join ', ')." + (Get-FailureHint $still))
}
Write-Host 'Admin setup complete.'
