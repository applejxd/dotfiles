# see below for documentation
# https://mise.jdx.dev/configuration.html
# 宣言の理由は docs/spec/structure.md#mise-による-cli-管理 が正本

{{- $raspi := eq (includeTemplate "is-raspi" .) "true" }}

[tools]
gh = "latest"
# AI CLI は mise で管理しない (docs/spec/structure.md#ai-cli-の導入)
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "windows") }}
herdr = "latest"
{{- end }}

{{- if ne .chezmoi.os "windows" }}
usage = "latest" # for mise completion

# CLI
fzf = "0.53.0"  # to prevent bug
ghq = "latest"
bat = "latest"
eza = "latest"
jj ="latest"
ripgrep = "latest"
{{- if eq .chezmoi.os "darwin" }}
jq = "latest" # hook (dot_claude/hooks/lib/agent_compat.sh) が使う。Linux は apt、Windows は winget
{{- end }}
"aqua:dylanaraps/neofetch" = "latest"

# TUI
btop = "latest"
{{- if not $raspi }}
"pipx:nvitop" = "latest" # NVIDIA GPU が前提。Raspberry Pi には無い
{{- end }}
ctop = "latest"
tmux = "latest"
"gem:tmuxinator" = "latest"
"aqua:neovim/neovim" = "latest" # unstable for vfox
lazygit = "v0.59.0" # to use correct tag
yazi = "latest"
"aqua:dev.yorhel.nl/ncdu" = "2.9.1" # see https://dev.yorhel.nl/ncdu

# dev
shellcheck = "latest"
hadolint = "latest"
"npm:markdownlint-cli2" = "latest"
ruff = "latest"
oxlint = "latest"
python = "latest"
uv = "latest"
node = "latest"
deno = "latest"

# backends (keep the latest for building tools)
rust = "latest"
go = "latest"
ruby = "latest"

# others
chezmoi = "latest"
sops = "latest"

# see https://mise.jdx.dev/dev-tools/backends/go.html
"go:github.com/d-kuro/gwq/cmd/gwq" = "latest"

# see https://mise.jdx.dev/dev-tools/backends/cargo.html
"aqua:bvaisvil/zenith" = "latest"

{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}
"npm:@google/gemini-cli" = "latest"
# snap 版が動かないため npm backend (docs/spec/security.md#bitwarden連携)
"npm:@bitwarden/cli" = "latest"
# Claude sandbox の seccomp フィルタ。WSL2 では無いと脱出できる
# (docs/spec/agent-sandbox.md#wsl2-での抜け穴-seccomp-フィルタ)
"npm:@anthropic-ai/sandbox-runtime" = "latest"
yt-dlp = "latest"
{{- else }}
aws-cli = "latest"
{{- end }}

{{- if eq .chezmoi.os "linux" }}

# OpenCode の隔離起動 (ocs) の境界。版とチェックサムを固定する
# (docs/spec/structure.md#mise-による-cli-管理)
[tools."github:fencesandbox/fence"]
version = "0.1.67"

[tools."github:fencesandbox/fence".platforms]
linux-x64 = { asset_pattern = "fence_*_Linux_x86_64.tar.gz", checksum = "sha256:cfe2af18c6feaf0269e524c8904de2bb14a1503054e59ebf584a902096bad2c7" }
linux-arm64 = { asset_pattern = "fence_*_Linux_arm64.tar.gz", checksum = "sha256:db22029e7f6b770112a95002f3ff06f5467086bc6463053f861fb97ef57b2a70" }
{{- end }}

[settings]
# for task runner
experimental = true
# for API keys
sops.age_key_file = "~/.config/sops/age/keys.txt"

{{- if not $raspi }}

# プリコンパイル済みバイナリは Tkinter を含まない
# (all_compile を使わない理由は docs/spec/structure.md#mise-の-settings)
[settings.python]
compile = true
{{- else }}

# プレビルドが無いとき ruby-build へ落ちるのを止める
# (docs/spec/structure.md#ruby-はプレビルドで入れる)
[settings.ruby]
compile = false
{{- end }}
{{- end }}
