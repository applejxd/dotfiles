# AI CLI の permission / hook / sandbox / MCP の単一ソース。
#
# 生成先:
#   ~/.claude/settings.json              <- [bash] [file] [web] [claude] [sandbox] [[hooks]]
#   ~/.copilot/permissions-config.json   <- [bash.allow] [copilot.locations]
#   ~/.copilot/settings.json             <- [web] [copilot] [sandbox]
#   ~/.copilot/hooks/from-claude.json    <- [[hooks]]
#   ~/.copilot/mcp-config.json           <- [[mcp]]
#   ~/.codex/config.toml の mcp_servers  <- [[mcp]]
#   ~/.config/opencode/opencode.json     <- [bash] [file] [opencode] [[mcp]]
#
# ★仕組み・判断基準・既知の不具合・実測値は docs/spec/agent-permissions.md が正本。
#   値を足す前にそちらを読むこと。ここには「その行を編集するときに要る注記」
#   だけを置き、経緯は書かない。
#
# このファイルは chezmoi テンプレート。ユーザ・OS の出し分けはここに書く
# (生成側は展開後の表だけを見る)。

# ---------------------------------------------------------------------------
# Bash 系
# ---------------------------------------------------------------------------
[bash]
# 人が書くのはこの 3 リストだけ。パターンは素のトークン列 (例: "git push")。
# 照合は normalize 後のセグメント先頭トークン一致
# (cd && X -> X, git -C foo X -> git X, compound は &&/;/| で分割)。
# 評価順は deny -> ask -> allow。具体形を deny に置けば一般形を ask にできる
# (例: "git reset --hard" は deny、"git reset" は ask)。
#
# ★OpenCode だけは「後に書いた規則が勝つ」。generate.py が allow -> ask -> deny
#   の順に並べて同じ優先順位を作るので、リストの書き方は変えなくてよい。
# see docs/spec/agent-permissions.md 「3 層構成」「`ask` に載せるかどうかの判断軸」

# 自動承認。読み取り専用・冪等なものだけ
#
# ★Copilot へは **先頭トークンのコマンド名だけ** が渡る。"git diff" と書くと
#   Copilot では git 全体が承認される。破壊的な形を ask / deny に載せずに
#   allow だけ足すと、そのコマンドが Copilot で丸ごと無防備になる。
#
# ★作業ディレクトリを付け替える形式 (-C) は allow に入れない (バイパス経路)。
allow = [
  "git diff",
  "git status",
  "git log",
  "wc",
  "grep -n",
  "find",
  "gcc",
  "g++",
  "cmake -S",
  "cmake --build",
  "uv pip list",
  "uv sync",
  "docker ps",
  "mise run",
  # gh は Copilot 側で先頭トークンまで粗粒度化されるため allow に置かない。
  # 読み取り系は未掲載にして auto / assisted へ委譲し、mutation は ask / deny
  # または check_bash.py の gh api 意味解析で止める。
]

# 提案 -> ユーザーが承認 -> そのまま実行。
# 「危険だが承認すれば妥当」なもの。取り返しがつく変更はここに置く。
#
# ask に残す基準 (どれかに当たるもの):
#   1. 不可逆か            — 復旧できない削除・履歴の書き換え
#   2. 外部に見えるか      — リモートへの書き込み、外部との通信
#   3. 秘密や防御に触るか  — 認証情報、hook や permission の設定
# 引数を見れば妥当性が判断できるものは **未掲載** にして LLM 判定へ委ねる。
# allow に入れてはいけない (手動モードでも無条件に通り、かえって緩くなる)。
#
# ★Copilot は hook の ask を自動承認する既知バグがある。確実に止めたいものは
#   ask ではなく deny に置く。
# see docs/spec/agent-permissions.md 「`ask` に載せるかどうかの判断軸」、
#     docs/research/agents/harness-comparison.md 「hook の ask が自動承認される」
ask = [
  # 削除は承認制。壊滅的なターゲット (ルート・ホーム・作業ディレクトリ全体・
  # .git 配下) は check_rm_root_guard が deny する。
  # 逆に workspace 内と確証できる削除は hook が承認を省いて auto / assisted
  # へ委ねる (詳細は docs/spec/agent-permissions.md の「`rm` の承認範囲」)。
  # この委譲を成立させるため ask_hook_owned にも載せている (下の注記を参照)
  "rm",
  # 未追跡ファイルを消すので git でも復旧できない
  "git clean",
  "git branch -D",
  "git commit",
  # --hard は deny。素の reset は index を戻すだけで作業ツリーを壊さない
  "git reset",
  # curl / wget は読み取りを未掲載にして auto / assisted へ委譲する。
  # mutation / upload は hook が ask、秘密送信・直接実行・危険な出力先は deny。
  # ループバック宛と確証できる curl の mutation は ask を外す (deny 層は不変)。
  # 詳細は docs/spec/agent-permissions.md の「ループバック宛の例外」を参照。
  # コンテナ/イメージは再作成・再 pull できるが状態を失う
  "docker rm",
  "docker rmi",
  # リモートに書き込むが取り消せる gh 操作
  "gh pr create",
  "gh pr checkout",
  "gh issue create",
  "gh issue close",
  "gh issue comment",
  # gh api は check_bash.py が REST method / GraphQL operation を解析する。
  # GET / HEAD / query は未掲載、mutation と判定不能形式だけ ask にする。
  # グローバルに常駐する (pipx run は未掲載で LLM 判定に委ねる)
  "pipx install",
  # プロジェクトの外に残る変更だけを ask にする (内で完結するものは未掲載)。
  # mise 系はここに書けない。normalize が runner の先頭 `mise` を落とすため
  # 前方一致しない (check_global_env_mutation が担当)。
  "uv tool install",
  "uv tool uninstall",
  "uv tool upgrade",
  "uv python install",
  "uv python uninstall",
  "cmake --install",
  # 認証情報がホームに残る / レジストリへ公開される
  "docker login",
  "docker push",
  # 素の疎通確認 (-z など) は使うが、-e/-c/-l は check_reverse_shell が deny する
  "nc",
  # 読み取り (--get / --list) も含めて確認を挟む。hook を無効化しうる
  # 書き込み (--global / core.hooksPath 等) は deny 側
  "git config",
]
# ★ask のうち「hook が承認要否まで判定する」もの。
#   ask には残しつつ Claude の permissions.ask へは出力しない
#   (静的 ask を出すと hook の exemption がどのモードでも無効化されるため)。
#   足したら check_bash.py の _ASK_EXEMPTIONS にも条件を書く。対応は
#   test_hook_owned_ask_is_not_emitted_as_a_static_claude_rule が検証する。
#
# ★OpenCode には除外が効かない (hook 機構が無く、委譲先が存在しない)。
#   そのため OpenCode へは素の ask として出る。ここに足すものは
#   「hook が無ければ毎回 ask で妥当」な粒度に保つこと。
# see docs/spec/agent-permissions.md 「`rm` の承認範囲」
ask_hook_owned = [
  "rm",
]
# 承認の余地なく拒否。
# 判断基準: 外部に出る / システムを変える / 取り返しがつかない / 規約違反。
deny = [
  "sudo",
  # リモートに公開されるものは手動操作に委ねる
  "git push",
  "git reset --hard",
  "git rebase",
  # core.hooksPath の書き換えで hook 自体を無効化できる。
  # 読み取り (--get / --list) は allow 側にあるので通る
  "git config --global",
  "git config --system",
  "git config --local",
  "git config core.hooksPath",
  "git config --unset",
  "git config --add",
  "git config --replace-all",
  "git config --edit",
  # 履歴・参照を書き換える / 作業内容を失わせる操作
  "git filter-branch",
  "git update-ref -d",
  "git reflog expire",
  "git stash clear",
  "git stash drop",
  "git worktree remove",
  # 追跡ファイルの変更を破棄する (git でも復旧できない)
  "git checkout --",
  "git restore",
  # スケジュール実行で監視外に逃がす
  "crontab",
  "at",
  "batch",
  # サービスの状態を変える (status / show などの読み取りは許可)
  "systemctl enable",
  "systemctl disable",
  "systemctl mask",
  "systemctl start",
  "systemctl stop",
  "systemctl restart",
  "systemctl daemon-reload",
  "systemd-run",
  # ディスク・デバイスの破壊
  "mkfs",
  "mkfs.ext4",
  "mkfs.xfs",
  "fdisk",
  "parted",
  "wipefs",
  # 待ち受け・トンネル (外部からの侵入経路)
  "socat",
  "ncat",
  # 外部への通信・横展開の経路
  "telnet",
  "ssh",
  # システム全体を汚す
  "npm install -g",
  # ツール自身を置き換える操作 (実質不可逆で影響が全プロジェクトに及ぶ)。
  # mise の self-update / implode は check_tool_self_update が担当する。
  "uv self update",
  "rustup self update",
  "chezmoi upgrade",
  # pip は全面禁止 (uv / uvx を使う)。hook の check_pip_redirect が
  # プロジェクト種別を問わず代替案付きで hard-deny する
  "pip",
  "pip3",
  # DB クライアント。mongod はサーバのデーモン、クライアントは mongosh
  "psql",
  "mysql",
  "mongod",
  "mongosh",
  "redis-cli",
  # -a --volumes はデータボリュームまで消す
  "docker system prune",
  "docker volume prune",
  "docker image prune",
  "docker container prune",
  "docker network prune",
  # キャッシュ削除は再取得に時間がかかる
  "npm cache clean",
  "yarn cache clean",
  "pnpm store prune",
  # リモートに影響する gh 操作 (push と同じ基準)
  "gh pr merge",
  "gh release create",
  "gh repo delete",
  # ローカルの内容を外部へ出す経路 (git push を deny にしているのと同じ基準)
  "gh gist create",
  "gh secret set",
  "gh secret list",
  # トークンを直接引く操作 (gh api graphql は Projects v2 で使うので ask 側)
  "gh auth token",
  # 秘密情報ストアからの読み出し (Bitwarden / 1Password / Vault)
  "bw get",
  "bw list",
  "bw export",
  "op read",
  "op item get",
  "vault read",
  "vault kv get",
  "chezmoi secret",
  # リモート先を差し替えると push 先が変わる
  "git remote add",
  "git remote set-url",
  "scp",
  "rsync",
  "sftp",
  # クラウドストレージへの転送
  "aws s3 cp",
  "aws s3 sync",
  "gsutil cp",
  "az storage blob upload",
  "gh release upload",
]

[file]
# ★キー名の `claude_` は歴史的なもので、現在は Claude と OpenCode が読む。
#   Copilot の permissions-config.json にはファイル規則が無いので渡らない
#   (等価な保護は [sandbox] deny と check_file_read.py が担う)。
#   OpenCode へは read / edit の permission rule として出る。
#   `**` 記法は OpenCode に無いため generate.py が `*` 主体へ変換する
#   (see docs/spec/agent-permissions.md 「glob の記法差」)。
#
# ★allow のリスト (下の claude_read_allow) だけは OpenCode へ出さない。
#   OpenCode は allow が既定なので同じ意味の規則が増えるだけになる。
claude_read_allow = [
  "README.md",
  "pyproject.toml",
]

# Claude / OpenCode に反映: Read(...) を ask に追加
claude_read_ask_globs = [
  ".env.*",
]

# Claude / OpenCode に反映: Edit(...) を ask に追加
# (書き込み系 permission rule は Edit(path) に統一。Write(path) は v2.1.210 で deprecated)
claude_write_ask_globs = [
  ".env.*",
  "mise.toml",
]

# Claude / OpenCode: Read(...) deny に展開。hook の bash ポリシーには反映しない
#
# ★`**/*key*` のような部分一致 glob は使わない。keyhac.bat / tokenizer.py の
#   ような正当なファイルを巻き込む。拡張子・接尾辞・既知の名前で指定する。
claude_read_deny_globs = [
  "**/.ssh/**",
  "**/.gnupg/**",
  "**/sops/age/**",
  "**/.aws/credentials",
  "**/.netrc",
  "**/.npmrc",
  "**/.pypirc",
  "**/id_rsa*",
  "**/id_ed25519*",
  "**/id_ecdsa*",
  "**/id_dsa*",
  "**/*.pem",
  "**/*.key",
  "**/*.p12",
  "**/*.pfx",
  "**/*.jks",
  "**/*.keystore",
  "**/key.txt",
  "**/keys.txt",
  "**/*_key",
  "**/*.token",
  "**/*_token",
  "**/token.json",
  "**/service-account*.json",
  "**/secrets/**",
  "**/*secret*",
  "**/*credential*",
  "**/*password*",
  ".env",
  "~/.copilot/settings.json",
  "~/.copilot/config.json",
  # エージェント CLI のランタイム設定。MCP サーバ定義の headers / env に
  # PAT や API キーが平文で入りうる (`claude mcp add --env ...` など)。
  # 設定ファイル自体は chezmoi 管理外なので、読めなくても運用に支障はない。
  "~/.claude.json",
  # OpenCode のバックグラウンドサービス認証情報 (service.json の password)。
  # 同じ階層の opencode.json は生成物なので read は塞がない (write は下で塞ぐ)。
  "~/.config/opencode/service.json",
]

# Claude のみ反映: Edit(...) を deny に追加
# read_deny_globs と同じ理由で部分一致 glob は使わない
claude_write_deny_globs = [
  "**/.ssh/**",
  "**/.gnupg/**",
  "**/sops/age/**",
  "**/.aws/credentials",
  "**/.netrc",
  "**/.npmrc",
  "**/.pypirc",
  "**/id_rsa*",
  "**/id_ed25519*",
  "**/id_ecdsa*",
  "**/id_dsa*",
  "**/*.pem",
  "**/*.key",
  "**/*.p12",
  "**/*.pfx",
  "**/*.jks",
  "**/*.keystore",
  "**/key.txt",
  "**/keys.txt",
  "**/*_key",
  "**/*.token",
  "**/*_token",
  "**/token.json",
  "**/service-account*.json",
  "**/secrets/**",
  "**/*secret*",
  "**/*credential*",
  "**/*password*",
  ".env",
  "~/.copilot/settings.json",
  "~/.copilot/config.json",
  "~/.claude.json",
  # OpenCode 自身の permission 設定。書けるとエージェントが自分の deny を
  # 外せてしまう ([sandbox] claude_write_deny と同じ趣旨の permission 側の保険)。
  # 正本はこのリポジトリなので、変更は chezmoi apply 経由で入れる。
  "~/.config/opencode/opencode.json",
  "~/.config/opencode/service.json",
  # git の設定。diff.<name>.command / core.fsmonitor などに任意コマンドを
  # 書けるため、git diff や git status が実行手段になる (実測)。
  # see docs/research/opencode/permission/allow-list-audit.md
  "**/.git/config",
  "**/.git/hooks/**",
  "~/.gitconfig",
]

# ---------------------------------------------------------------------------
# Web 系
# ---------------------------------------------------------------------------
[web]
# Claude: permissions.allow の WebFetch(domain:...) と
#         sandbox.network.allowedDomains へ展開 (自動承認のみ。ここに無い
#         ドメインを拒否する効果は無い)
# Copilot: settings.json の allowedUrls (sandbox にドメイン単位の制御は無い)
#
# ★sandbox に効く wildcard は **先頭の `*.` と 単独の `*` だけ**。
#   `example.*` は WebFetch には効くが sandbox 側は無視する。
# see docs/spec/agent-permissions.md 「ネットワーク」
allow_domains = [
  "github.com",
  "api.github.com",
  "docs.github.com",
  "raw.githubusercontent.com",
  "*.githubusercontent.com",
  "hub.docker.com",
  "docs.docker.com",
  "pypi.org",
  "docs.python.org",
  "packaging.python.org",
  "npmjs.com",
  "docs.npmjs.com",
  "registry.npmjs.org",
  "chezmoi.io",
  "www.chezmoi.io",
  "mise.jdx.dev",
  "docs.astral.sh",
  "docs.anthropic.com",
  "docs.claude.com",
  "modelcontextprotocol.io",
  "arxiv.org",
  "alphaxiv.org",
  "stackoverflow.com",
  "dev.to",
  "qiita.com",
  "zenn.dev",
  "pre-commit.com",
]

# Copilot のみ allowedUrls/deniedUrls に反映 (Claude の permissions には
# 対応キーが無い)。ただし Claude でも sandbox.network.deniedDomains には
# 反映される: 広い allowlist wildcard の内側を個別に塞ぐのに使える。
deny_domains = []

# ---------------------------------------------------------------------------
# Sandbox 系 (OS レベルのファイルアクセス制御)
# ---------------------------------------------------------------------------
#
# 両 CLI とも whitelist (deny-by-default)。Claude は denyRead に "~/" を置き、
# allowRead で穴を開けることで Copilot と同じ方式に揃えている。
#
# ★広い名前マッチの glob を deny に置かないこと。Claude の Linux sandbox は
#   deny 対象の各パスに /dev/null を bind-mount するため、コマンド 1 回ごとに
#   数千個の mount が必要になり実用に耐えない (実測値は docs 参照)。
#
# ★パス記法は permission の Read()/Edit() glob とは別物。
#   `~/` で home 相対、`/` で絶対、無印/`./` はプロジェクト相対
#   (user 設定では ~/.claude 基準)。ホーム全体に効かせるなら `~/` を明示する。
#   Copilot は絶対パス限定・ワイルドカード非対応・存在しないパスは無効。
#
# see docs/spec/agent-permissions.md 「sandbox」
#     https://code.claude.com/docs/en/sandboxing
#     https://docs.github.com/copilot/concepts/agents/copilot-cli/understanding-local-sandboxing
[sandbox]
# 両 CLI 共通: whitelist の内側でも遮断する秘密情報 (read/write 両方)。
# 公式に "Rules that you configure are always kept" とあり、自動付与に勝つ。
# whitelist の穴 (claude_read_allow) の中に秘密がある場合の保険。
deny = [
  "~/.ssh", "~/.gnupg", "~/.config/sops/age", "~/.aws", "~/.netrc",
  "~/.npmrc", "~/.pypirc", "~/.docker/config.json",
  "~/.git-credentials", "~/.config/gh/hosts.yml",
  "~/.config/Bitwarden CLI",
  # chezmoi の age 秘密鍵。下の write 許可 (~/.config/chezmoi) の内側だが
  # より具体的なパスが勝つので遮断される。
  # このリポジトリに encrypted_ ファイルは無いため、塞いでも chezmoi は動く。
  "~/.config/chezmoi/key.txt",
  "~/.claude.json", "~/.copilot/settings.json", "~/.copilot/config.json",
  # OpenCode のサービス認証情報 (password が平文で入る)
  "~/.config/opencode/service.json",
  "~/.bash_history", "~/.zsh_history", "~/.python_history",
  "~/.node_repl_history",
  # whitelist の内側に置かれがちなもの (Claude のみ。Copilot は wildcard 不可)
  "~/**/.env", "~/**/id_rsa*", "~/**/id_ed25519*", "~/**/id_ecdsa*",
  "~/**/id_dsa*", "~/**/service-account*.json",
]

# Claude のみ: read は許すが write を禁止する対象 (改竄防止)。
# Claude sandbox の "Protected paths" がほぼ同じ範囲を常時保護しているので、
# これは cwd が $HOME の場合などに備えた多重防御。
# Copilot は deny-by-default で cwd の外に書けないため不要。
claude_write_deny = [
  "~/.claude/hooks", "~/.claude/settings.json", "~/.claude/settings.local.json",
  "~/.copilot/hooks", "~/.copilot/permissions-config.json", "~/.config/agents",
  # OpenCode の global config (permission / MCP の生成先)
  "~/.config/opencode",
  "~/.bashrc", "~/.bash_profile", "~/.bash_login", "~/.profile",
  "~/.zshrc", "~/.zshenv", "~/.zprofile", "~/.cshrc", "~/.kshrc", "~/.login",
  "~/.ssh/authorized_keys", "~/.ssh/known_hosts", "~/.gitconfig",
]

# Claude のみ: whitelist に開ける読み取りの穴。
# Copilot の allowDevToolAccess に相当する仕組みが Claude に無いので手動補償する。
# 上の deny はこの穴の内側でも効く (より具体的なパスが勝つ)。
#
# ★Copilot 側には渡さない。deny-by-default で既に触れないパスを許可することに
#   なり、防御が弱まる。
# ★このマシンでしか使わないパスはここに書かない。chezmoi 管理外の
#   ~/.config/agents/local.toml に [sandbox] claude_read_allow として書く。
# ★実在するパスだけを書く (存在しないパスは bind-mount 失敗の要因になる)。
# see docs/spec/agent-permissions.md 「このマシンだけで許可を足す」
claude_read_allow = [
  # ツールチェーン (mise / uv / cargo / node / go / TeX)
  "~/.local", "~/.cache", "~/.cargo", "~/.rustup", "~/.nvm", "~/.npm",
  "~/go", "~/.texlive",
  # ツールの設定 (git, gh, mise, nvim 等)。秘密は上の deny で個別に塞ぐ
  "~/.config", "~/.gitconfig",
  # skill 置き場。Copilot も "Personal skill roots" としてこの 2 つだけを
  # read-only 許可している (実測) ので合わせる。
  "~/.claude/skills", "~/.agents/skills",
]

# Claude のみ: cwd + セッション temp 以外に書き込みを許す場所。
# パッケージマネージャがキャッシュを書けないとビルドが失敗するため。
# Copilot 側の同等物は copilot_write_allow (下記)。
claude_write_allow = [
  "~/.cache", "~/.npm", "~/.cargo/registry", "~/.local/share/mise",
  "~/.local/state",
  # uvx が実行のたびに一時環境を作る場所 (copilot_write_allow に同じ)
  "~/.local/share/uv/tools",
  # chezmoi の永続 state (chezmoistate.boltdb)。書けないと
  # `chezmoi managed` / `chezmoi diff` が read-only file system で落ちる。
  # 内側の key.txt は上の deny で塞いである。
  "~/.config/chezmoi",
]

# Copilot のみ: 開発ツールへの許可を明示的に与える。
# allowDevToolAccess を切っている (下記) ので、必要な範囲はここが全て負う。
# 内容は claude_read_allow / claude_write_allow とほぼ同じ。
# ホーム外 (/usr /opt) は Claude では既定で読めるので Copilot にだけ要る。
#
# ★~/.local/share/mise は write に入れない (PATH 上のツールを差し替えられる)。
# see docs/adr/0008-explicit-dev-tool-grants.md
copilot_read_allow = [
  # ツールチェーン。~/.local は bin (mise 本体) / share/mise / share/uv を含む
  # ★~/.cache と ~/.npm はここに書かない。下の copilot_write_allow と
  #   同一パスになり RO 側に潰される (下記の注記)。
  "~/.local", "~/.cargo", "~/.rustup", "~/.nvm",
  "~/go", "~/.texlive",
  # ツールの設定。秘密は上の deny で個別に塞ぐ
  "~/.config", "~/.gitconfig",
  # ホーム外 (Claude は denyRead が "~/" 配下だけなので元から読める)
  "/usr/include",               # システムヘッダ
  "/usr/local",                 # include / lib / share / cuda をまとめて
  "/usr/src",                   # カーネルヘッダ (DKMS, CUDA ドライバ)
  "/opt",                       # サードパーティのツールチェーン
]

# ★read と write に **同じパス** を書いてはいけない。同一パスの RO/RW 競合は
#   RO へ解決され、write 指定が無言で消える。書きたい場所は write だけに書く
#   (write は read を含む)。generate.py が重複を検出して apply を止める。
#   親子関係 (~/.local と ~/.local/state 等) は具体的な方が勝つので問題ない。
copilot_write_allow = [
  # パッケージマネージャのキャッシュ。書けないとビルドが毎回やり直しになる
  # (~/.cache/uv / ~/.cache/pre-commit / ~/.cache/go-build を含む)
  "~/.cache", "~/.npm", "~/.cargo/registry", "~/.local/state",
  # uvx が実行のたびに一時環境を作る場所。RO だと pre-commit の uvx hook
  # (ruff / yamllint) が os error 30 で落ちる。PATH には載らない。
  "~/.local/share/uv/tools",
  # chezmoi の永続 state。書けないと `chezmoi managed` / `diff` が落ちる。
  # 内側の key.txt は上の deny で塞いである。
  "~/.config/chezmoi",
]

# Copilot のみ: PATH やキャッシュの自動 read-only 付与を切る。
# 上の copilot_read_allow / copilot_write_allow で明示的に置き換える。
copilot_allow_dev_tool_access = false

# Copilot 側の deniedPaths は上の `deny` から自動導出する。
# ワイルドカードを含むものは除外される (Copilot は非対応)。
# 存在しないパスの deny は黙って無効化されるが、後で作られたときに効くよう
# `deny` には残してある。
# see docs/spec/agent-permissions.md 「sandbox」
#
# なお ~/.ssh を denied にすると git over SSH は使えなくなるが、
# sandbox の auth.git / auth.gh が GitHub へのトークンを注入するため
# HTTPS 経由の git / gh は sandbox 内でも動作する。

# Claude のみ: sandbox のネットワークを whitelist (deny-by-default) にする。
# true にすると許可外ドメインは承認プロンプトではなく **拒否** される。
# Claude Code v2.1.219 以降が必要。
#
# Copilot にはドメイン単位の制御が無く (allowOutbound の on/off だけ)、
# outbound は全ドメイン許可のままなので、この設定は Claude 専用。
# `allowedUrls` は「プロンプトを省略する URL」であって通信制限ではない。
claude_network_strict = true

# Claude のみ: sandbox のネットワーク許可に **追加** するドメイン。
# [web] allow_domains (WebFetch 用のドキュメントサイト) と合算される。
# こちらには shell が実際に通信する先 (パッケージ配布 CDN 等) だけを書く。
# 混ぜると CDN が WebFetch で自動承認されるので分けている。
# 不足しても破綻はせず「sandbox 外での再実行を求める承認」に落ちる。
claude_network_allow = [
  # Python (uv / pip): pypi.org はメタデータ、実体は files.pythonhosted.org
  "files.pythonhosted.org",
  # GitHub: git clone / リリース資産のダウンロード
  # (objects.githubusercontent.com は [web] の *.githubusercontent.com で拾う)
  "codeload.github.com",
  # Rust (cargo)
  "crates.io", "static.crates.io", "index.crates.io",
  # Go modules
  "proxy.golang.org", "sum.golang.org",
  # Deno / JSR
  "deno.land", "jsr.io",
  # mise のバージョン一覧
  "mise-versions.jdx.dev",
]

# Claude のみ: sandbox が使う seccomp フィルタ (apply-seccomp) のパス。
# Claude は npm のグローバル領域しか自動検出しないが、このリポジトリは mise で
# 入れるので、公式の代替手段 (settings.json でパスを直接指す) で橋渡しする。
# {arch} は generate.py が x64 / arm64 に置換する。パスが無いマシンでは
# 設定を出力しないので、共有の common.toml に書いても他環境を壊さない。
# see docs/spec/agent-permissions.md 「seccomp」
seccomp_apply_path = "~/.local/share/mise/installs/npm-anthropic-ai-sandbox-runtime/latest/node_modules/@anthropic-ai/sandbox-runtime/vendor/seccomp/{arch}/apply-seccomp"

# ---------------------------------------------------------------------------
# Claude 固有
# ---------------------------------------------------------------------------
[claude]
# CLI 側のバックグラウンド更新を止める (本体は公式インストーラーで導入)。
# settings.json の env.DISABLE_AUTOUPDATER="1" へ変換する。
auto_update = false

# 新規セッションの権限モード。default / acceptEdits / auto / dontAsk /
# bypassPermissions から選ぶ。ask / deny と hook はどのモードでも効く。
# 出典: https://code.claude.com/docs/en/permission-modes
default_permission_mode = "auto"

mcp_deny = [
  "mcp__supabase__execute_sql",
]

# ---------------------------------------------------------------------------
# Copilot 固有
# ---------------------------------------------------------------------------
[copilot]
# settings.json の autoUpdate へ反映。本体は公式インストーラー (Unix は
# gh.io/copilot-install、Windows は winget) で更新する。
auto_update = false

# Copilot が作成するコミットへ Co-authored-by trailer を追加しない
include_co_authored_by = false

# 新規対話セッションの権限モード。manual / assisted / allow-all から選ぶ。
# 再開セッション・非対話実行では無視される。
# 出典: `copilot help config` (ローカル CLI が権威ある一覧を持つ)
default_permission_mode = "assisted"
# assisted は experimental な auto-approval 機能に依存する
experimental = true

# settings.json の trustedFolders へ反映
trusted_folders = [
  "~/.local/share/chezmoi",
  "~/sandbox",
  "~/src/my-agent-core",
  "~/src/apple-agent-core",
]

# settings.json の enabledPlugins へ反映 (書いたキーだけを上書きし、
# ここに無いプラグインはユーザーの設定をそのまま残す)。
#
# document-skills と example-skills は中身が同一で、両方有効にすると
# 17 スキルが二重登録される。実際に使われている方だけを残す。
[copilot.enabled_plugins]
"document-skills@anthropic-agent-skills" = true
"example-skills@anthropic-agent-skills" = false

# permissions-config.json の locations へ反映
# 各 location の approvals に bash.allow 由来の commands も自動追加される
[[copilot.locations]]
path = "~/.local/share/chezmoi"
approvals = [
  { kind = "write" },
]

# ---------------------------------------------------------------------------
# OpenCode 固有
# ---------------------------------------------------------------------------
[opencode]
# opencode.json の update へ反映 ("disable" / "notify")。本体は公式
# インストーラーで導入し、更新は `opencode upgrade` を明示的に実行する。
auto_update = false

# ★[web] は OpenCode へ渡さない。webfetch の resource は「URL 全体」で、
#   `*` が `/` も跨ぐため `*://*.example.com/*` が
#   `https://evil.test/x.example.com/y` にも当たる。ドメイン許可を正しく
#   表現できないので、誤った allowlist を出すより出さない方を選んでいる。
# ★[claude] mcp_deny も渡さない。OpenCode のツール名は `<server>_<tool>` で
#   Claude の `mcp__<server>__<tool>` と別体系のため、機械変換すると
#   実在しない名前を deny したまま気付けなくなる。
# see docs/spec/agent-permissions.md 「OpenCode へ渡さないもの」

# OpenCode のカスタムエージェント (V1 の「モード」に相当。mode は非推奨)。
# permission = "allow" は全 action / 全 resource の allow へ展開される (実測)。
# ★bypass は permission 層を丸ごと無効にする。秘密ファイルの read deny も外れる。
# see docs/research/opencode/permission/bypass-agent.md
[opencode.agent.bypass]
description = "全ツールを無確認で実行する (permission を全て allow で上書き)"
permission = "allow"

# OpenCode 専用の shell allow ([bash] とは共用しない。前提が違う)。
# ここに載せたものだけが無確認で実行される。任意コード実行を含むものは載せない。
# ★リダイレクトは resource に残ったまま前方一致するので、載せたコマンドは
#   すべて `> path` による任意書き込みの手段にもなる (実測)。
# see docs/research/opencode/permission/allow-list-audit.md
[opencode.shell]
allow = [
  "git log",
  "wc",
  "grep -n",
  "uv pip list",
  "docker ps",
]

# 誘導。pattern に一致したら deny して message を返す。
# pattern は JavaScript の正規表現で、生のコマンド全体に当てる
# (scanner は変数代入を落とすため e.resources は使わない)。
# ★deny にすること。ask では自動実行で素通りする。
# see docs/change/0002-opencode-ask-by-default.md 「段階 2 の詳細」
[[opencode.shell.guide]]
pattern = '(^|&&|\|\||;|\n)\s*cd\s'
message = "cd は使わないでください。shell ツールの workdir 引数でディレクトリを指定できます。"

# 編集後の整形。Claude / Copilot では PostToolUse hook (format-file.sh /
# markdownlint.sh) がやっていることを、OpenCode では組み込み機能が担う。
#
# ★このテーブルを書くと **組み込み formatter も全部有効になる**
#   (公式: "An object also enables the built-ins")。ruff / clang-format /
#   prettier / shfmt は組み込みにあるので、ここへ書くのは
#   **組み込みに無いものだけ**。
# ★command は argv 配列で、シェルは通らない。`$FILE` が絶対パスに置換される。
# ★組み込みに無い名前は command と extensions の両方が要る
#   (片方だけだと OpenCode が黙って無視する)。generate.py が検査して止める。
# see docs/spec/agent-permissions.md 「整形 (formatter)」

# markdownlint-cli2 は組み込みに無い。mise の "npm:markdownlint-cli2" が
# PATH へ shim を置くので素の名前で呼べる。未導入のマシンでは OpenCode が
# 失敗をログに残して次の formatter へ進むだけで、編集自体は通る。
[opencode.formatter.markdownlint]
command = ["markdownlint-cli2", "--fix", "$FILE"]
extensions = [".md", ".markdown"]

# ---------------------------------------------------------------------------
# MCP サーバ (Claude Code / Copilot CLI / Codex CLI / OpenCode 共通の単一ソース)
# ---------------------------------------------------------------------------
# フィールド:
#   id         サーバ名 (英数字・ハイフン・アンダースコアのみ)
#   purpose    用途 (生成物には出ない。レビュー用)
#   transport  "http" (url) か "stdio" (command / args)
#
# ★トークンをここに書かない。headers に秘密が要るサーバは環境変数参照として
#   各 CLI 側で設定する (ADR-0005)。
# see docs/spec/agent-permissions.md 「MCP サーバ」
[[mcp]]
id = "deepwiki"
purpose = "GitHub リポジトリのドキュメントを検索する"
transport = "http"
url = "https://mcp.deepwiki.com/mcp"

{{- if not (regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username) }}

# DuckDuckGo 検索。applejxd は Copilot CLI 内蔵の web 検索を使うので入れない。
# ★`--from ddgs[mcp]` が要る。素の `uvx ddgs mcp` は
#   "Error: MCP dependencies not installed" で起動しない (実測)。
[[mcp]]
id = "ddgs"
purpose = "DuckDuckGo で web 検索する"
transport = "stdio"
command = "uvx"
args = ["--from", "ddgs[mcp]", "ddgs", "mcp"]
{{- end }}

# ---------------------------------------------------------------------------
# Hooks (Claude Code / Copilot CLI 共通の単一ソース)
# ---------------------------------------------------------------------------
# フィールド:
#   id            識別子 (生成物には出ない。テスト・レビュー用)
#   script        ~/.claude/hooks/ 配下のファイル名 (両 CLI が同じ実体を共有)
#   runner        "python3" / "bash" (素の Ubuntu に `python` は無い)
#   purpose       用途メモ
#   *_event       hook イベント名。空文字にするとその CLI には出力しない
#   *_matcher     省略すると matcher キー自体を出力しない (= 全ツール)
#   timeout_sec   Claude の timeout / Copilot の timeoutSec へ反映
#
# ★matcher は両 CLI で意味論が違うので共通化しない。
#   Claude: tool 名の完全一致を `|` で OR 連結 (PascalCase のみ)
#   Copilot: `^(?:pattern)$` として anchored。PascalCase も照合されるため両方書く
# ★イベントは PreToolUse を使い permissionRequest は使わない
#   (後者は後勝ちマージで、リポジトリ側の hook に決定を奪われる)。
# see docs/spec/agent-permissions.md 「hook」

[[hooks]]
id = "check_bash"
script = "check_bash.py"
runner = "python3"
purpose = "[bash] deny を両 CLI で、ask を Claude で強制する (permission リストの補完)"
claude_event = "PreToolUse"
claude_matcher = "Bash"
copilot_event = "PreToolUse"
copilot_matcher = "^(Bash|bash|powershell)$"
timeout_sec = 30

[[hooks]]
id = "redirect-tmp"
script = "redirect-tmp.py"
runner = "python3"
purpose = "/tmp への書き込みを検出して ./.tmp へ誘導する (読み取り専用操作は許可)"
# スクリプトが処理する kind は bash / create / edit の 3 つだけなので matcher
# もそれに合わせる (無駄な hook 起動を避ける)。view (Read) は常に許可なので
# hook を呼ぶ必要が無く、matcher から除外している。
claude_matcher = "Bash|Write|Edit"
claude_event = "PreToolUse"
copilot_event = "PreToolUse"
copilot_matcher = "^(Bash|bash|powershell|Write|create|Edit|edit)$"
timeout_sec = 30

[[hooks]]
id = "check_file_read"
script = "check_file_read.py"
runner = "python3"
purpose = "[file] claude_read_deny_globs を Copilot のファイル読み取りにも適用する"
# ★Copilot 専用 (claude_event を書かない)。
#   Claude は同じリストから Read() の deny permission を生成済みで、CLI 本体が
#   評価するため hook は要らない。付けると全ファイル読み取りに Python の
#   プロセス起動 (数十 ms) が乗るだけで、防御は増えない。
#   一方 Copilot は permissions-config.json にファイル規則が無く、sandbox の
#   deniedPaths も絶対パス限定・ワイルドカード非対応で cwd は自動許可される。
#   つまりリポジトリ内の秘密ファイルを止める手段が hook しかない。
#   詳細は docs/adr/0007-filesystem-guard-boundary.md
copilot_event = "PreToolUse"
copilot_matcher = "^(Read|view)$"
timeout_sec = 30

[[hooks]]
id = "markdownlint"
script = "markdownlint.sh"
runner = "bash"
purpose = "Markdown 編集後に markdownlint --fix と残存違反の警告"
claude_event = "PostToolUse"
claude_matcher = "Edit|Write"
copilot_event = "PostToolUse"
copilot_matcher = "^(Edit|Write|edit|create)$"
timeout_sec = 30

[[hooks]]
id = "format-file"
script = "format-file.sh"
runner = "bash"
purpose = "編集したファイルを拡張子に応じて整形 (ruff / clang-format / prettier)"
claude_event = "PostToolUse"
claude_matcher = "Edit|Write"
copilot_event = "PostToolUse"
copilot_matcher = "^(Edit|Write|edit|create)$"
timeout_sec = 30

[[hooks]]
id = "checkpoint_precompact"
script = "checkpoint_precompact.py"
runner = "python3"
purpose = "圧縮の直前に機械的な事実だけを checkpoint へ記録する (保険)"
# ★絶対にブロックしない。context-limit エラーからの回復として発火した自動圧縮
#   を止めると、元のエラーが表面化して現在のリクエストが失敗する。
# ★Copilot も PascalCase で登録する。camelCase だと入力に hook_event_name が
#   入らない (docs/research/agents/compaction-hooks.md 記録 E3)。
claude_event = "PreCompact"
copilot_event = "PreCompact"
timeout_sec = 30

[[hooks]]
id = "checkpoint_restore"
script = "checkpoint_restore.py"
runner = "python3"
purpose = "圧縮の直後に自分の checkpoint をコンテキストへ戻す"
# ★Claude 専用 (copilot_event を書かない)。
#   Claude はここで作業再開の「前」に割り込める。Copilot には対応イベントが
#   無いため checkpoint_restore_pending が PostToolUse に相乗りする。
claude_event = "SessionStart"
claude_matcher = "compact"
timeout_sec = 30

[[hooks]]
id = "checkpoint_restore_pending"
script = "checkpoint_restore_pending.py"
runner = "python3"
purpose = "Copilot で圧縮直後の最初のツール実行に相乗りして checkpoint を戻す"
# ★Copilot 専用 (claude_event を書かない)。Claude は SessionStart で足りる。
# ★matcher を付けない。圧縮の後に最初に来るツールが何かは選べないため。
#   全ツールで発火するので、印が無いときは git もスキル読込もせず stat 1 回で
#   抜けること。checkpoint_core.pending_dir() がホーム固定なのはこのため。
# ★PascalCase で登録する。理由は checkpoint_precompact と同じ (記録 E3)。
copilot_event = "PostToolUse"
timeout_sec = 30
