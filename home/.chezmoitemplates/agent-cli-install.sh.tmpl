{{- /*
AI CLI (Claude Code / Copilot CLI / OpenCode V2) を各社公式のインストーラーで導入する。
呼び出し側は 100_linux / 200_mac の run_onchange_after_ スクリプト。
共有するのは本体だけで、呼び出し側が shebang と set -eu を置く。
*/ -}}
# 既に入っているものは触らない。更新は README の手順 (手動) に従う。
# 公式インストーラーはどれも導入先が PATH にあるかを確認する。特に Copilot CLI は
# 見つからないと rc ファイル追記の可否を /dev/tty から対話で聞くため、
# chezmoi apply が止まらないよう先に通しておく。
PATH="${HOME}/.local/bin:${HOME}/.opencode/bin:${PATH}"
export PATH

# AI CLI を mise 管理から公式インストーラーへ移したとき、mise の shim と
# installs は残る。これが 2 通りに悪さをする。
#
#   - shim は PATH 上で ~/.local/bin より前にあるので、公式版を入れても
#     起動するのは shim のまま (実測: shims が 50 番目、~/.local/bin が 60 番目)
#   - 版を解決できない shim は「mise use -g で global default version を
#     指定しろ」と言って止まる。~/.config/mise/config.toml は chezmoi 管理なので、
#     言われたとおり mise use -g しても次の apply で宣言が消え、同じ状態へ戻る。
#     さらに mise registry の opencode は aqua:anomalyco/opencode (V1 系) で、
#     生成する設定は V2 スキーマなので configuration invalid になる
#
# see docs/spec/troubleshooting.md
mise_root="${HOME}/.local/share/mise"

# shim 名と installs 名は一致しない (claude-code の shim は claude) ので別に消す。
for stale in claude copilot opencode omp; do
    if [ -e "${mise_root}/shims/${stale}" ]; then
        echo "mise の残骸 shim を削除します: ${stale}"
        rm -f "${mise_root:?}/shims/${stale}"
    fi
done
for stale in claude claude-code copilot opencode omp; do
    if [ -e "${mise_root}/installs/${stale}" ]; then
        echo "mise の残骸を削除します: installs/${stale}"
        rm -rf "${mise_root:?}/installs/${stale:?}"
    fi
done

# 残骸 shim は実体が無くても command -v を満たす。そのまま「導入済み」と
# 判定すると公式版の導入が永久にスキップされるので、shim は数えない。
is_installed() {
    resolved=$(command -v "$1" 2>/dev/null) || return 1
    case "${resolved}" in
        "${mise_root}/shims/"*) return 1 ;;
        *) return 0 ;;
    esac
}

# 各インストーラーは本体を pipe で流し込むので、失敗を個別に受け止められるよう
# 関数に包む。特に oh-my-pi は api.github.com の releases/latest を curl -fsSL で
# 引くため、未認証のレート制限 (60 回/時) を超えると 403 で落ちる。
install_claude() { curl -fsSL https://claude.ai/install.sh | bash; }
install_copilot() { curl -fsSL https://gh.io/copilot-install | bash; }
# --no-modify-path: インストーラーが .zshrc / .bashrc へ PATH を追記すると
# chezmoi 管理のシェル設定と衝突する。PATH は shellenv.sh 側で通している。
install_opencode() { curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path; }
install_omp() { curl -fsSL https://omp.sh/install | sh; }

# 1 つの導入失敗で残り全部を巻き添えにしない。呼び出し側は set -euo pipefail だが、
# if の条件に置いた失敗では errexit が働かないので、ここで取りこぼしを集める。
failed_clis=""

ensure_cli() {
    name="$1"
    command_name="$2"
    installer="$3"

    if is_installed "${command_name}"; then
        echo "${name} は導入済みです"
        return 0
    fi
    echo "${name} を導入します..."
    if "${installer}"; then
        echo "${name} を導入しました"
    else
        echo "⚠️  ${name} の導入に失敗しました" >&2
        failed_clis="${failed_clis}${failed_clis:+ }${command_name}"
    fi
}

ensure_cli 'Claude Code' claude install_claude
ensure_cli 'Copilot CLI' copilot install_copilot
ensure_cli 'OpenCode V2' opencode install_opencode
# oh-my-pi (omp)。Pi のフォークで LSP / DAP / subagent を持つ。
# ★境界 (ocs) の外で動く。permission 機構を持たない設計なので、
#   保護は「どこで起動するか」と git の使い方に依存する。
#   see docs/change/0006-pi-harness-trial.md
# 設定は ~/.omp/agent/ だが、omp は ~/.claude も config root として読むため
# 既存の skills (16 個) は追加設定なしで見える。
ensure_cli 'oh-my-pi' omp install_omp

if [ -n "${failed_clis}" ]; then
    # ここで非ゼロを返すと apply 全体が止まり、後続のスクリプトまで巻き添えに
    # なる。外部インストーラーの一時的な不調で dotfiles の適用を止めたくないので
    # 警告に留める。再実行の手順は docs/spec/troubleshooting.md にもある。
    cat >&2 <<EOF

⚠️  導入できなかった CLI:${failed_clis}
    GitHub API のレート制限 (未認証で 60 回/時) に当たると 403 で失敗する。
    残量は次で見られる:
      curl -s https://api.github.com/rate_limit
    時間をおいて chezmoi apply を再実行するか、手で入れる:
      curl -fsSL https://claude.ai/install.sh | bash
      curl -fsSL https://gh.io/copilot-install | bash
      curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path
      curl -fsSL https://omp.sh/install | sh
EOF
    echo "⚠️  完了：一部の AI CLI が入っていません"
else
    echo "✅ 完了：AI CLI を導入しました"
fi
