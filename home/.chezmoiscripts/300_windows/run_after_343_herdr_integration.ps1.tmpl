Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$homeDir = {{ .chezmoi.homeDir | toJson }}
$miseCommand = Get-Command mise -CommandType Application -ErrorAction SilentlyContinue
if (-not $miseCommand) {
  # 同じ apply の Winget スクリプトで mise を初めて導入した場合。
  $env:Path = [Environment]::GetEnvironmentVariable('Path', 'Machine') + ';' + [Environment]::GetEnvironmentVariable('Path', 'User')
  $miseCommand = Get-Command mise -CommandType Application -ErrorAction Stop
}
{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}
$agentCommand = 'copilot'
{{- else }}
$agentCommand = 'claude'
{{- end }}
$herdrPath = & $miseCommand.Path -C $homeDir which herdr
if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($herdrPath)) {
  throw "Failed to resolve Herdr via mise (exit code $LASTEXITCODE)"
}
if (-not (Test-Path -LiteralPath $herdrPath -PathType Leaf)) {
  throw "Herdr is not available at $herdrPath"
}

$agentPath = & $miseCommand.Path -C $homeDir which $agentCommand
if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace($agentPath)) {
  throw "Failed to resolve $agentCommand via mise (exit code $LASTEXITCODE)"
}
if (-not (Test-Path -LiteralPath $agentPath -PathType Leaf)) {
  throw "$agentCommand is not available at $agentPath"
}
$env:Path = (Split-Path -Parent $agentPath) + ';' + $env:Path
& $herdrPath integration install $agentCommand
if ($LASTEXITCODE -ne 0) {
  throw "Herdr integration installation failed with exit code $LASTEXITCODE"
}

$skillDir = Join-Path $homeDir '.claude\skills\herdr'
$skillPath = Join-Path $skillDir 'SKILL.md'

$startInfo = New-Object System.Diagnostics.ProcessStartInfo
$startInfo.FileName = $herdrPath
$startInfo.Arguments = '--skill'
$startInfo.UseShellExecute = $false
$startInfo.RedirectStandardOutput = $true
$startInfo.RedirectStandardError = $true
$startInfo.StandardOutputEncoding = New-Object System.Text.UTF8Encoding($false)
$startInfo.StandardErrorEncoding = New-Object System.Text.UTF8Encoding($false)

$process = New-Object System.Diagnostics.Process
$process.StartInfo = $startInfo
try {
  [void] $process.Start()
  $errorTask = $process.StandardError.ReadToEndAsync()
  $skillText = $process.StandardOutput.ReadToEnd()
  $process.WaitForExit()
  $skillError = $errorTask.GetAwaiter().GetResult()

  if ($process.ExitCode -ne 0) {
    throw "Herdr agent skill generation failed with exit code $($process.ExitCode): $skillError"
  }
}
finally {
  $process.Dispose()
}

if ($skillText -notmatch '(?m)^name:\s*herdr\s*$') {
  throw 'Herdr returned an invalid agent skill'
}

New-Item -ItemType Directory -Path $skillDir -Force | Out-Null
$skillUpdateId = [System.Guid]::NewGuid().ToString('N')
$skillTempPath = Join-Path $skillDir ".$skillUpdateId.tmp"
$skillBackupPath = Join-Path $skillDir ".$skillUpdateId.bak"
$utf8WithoutBom = New-Object System.Text.UTF8Encoding($false)
try {
  [System.IO.File]::WriteAllText($skillTempPath, $skillText, $utf8WithoutBom)
  if (Test-Path -LiteralPath $skillPath -PathType Leaf) {
    [System.IO.File]::Replace($skillTempPath, $skillPath, $skillBackupPath)
  }
  else {
    [System.IO.File]::Move($skillTempPath, $skillPath)
  }
}
finally {
  if (Test-Path -LiteralPath $skillTempPath) {
    Remove-Item -LiteralPath $skillTempPath -Force
  }
  if (Test-Path -LiteralPath $skillBackupPath) {
    Remove-Item -LiteralPath $skillBackupPath -Force
  }
}
