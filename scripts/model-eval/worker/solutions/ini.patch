diff --git a/src/tk/ini.py b/src/tk/ini.py
new file mode 100644
index 0000000..6d96c70
--- /dev/null
+++ b/src/tk/ini.py
@@ -0,0 +1,88 @@
+"""ini の模範解答 (隠しテストの検証用)。"""
+
+from __future__ import annotations
+
+import re
+
+_COMMENT = re.compile(r"\s[#;].*$")
+
+
+def _strip_comment(s: str) -> str:
+    return _COMMENT.sub("", s).strip()
+
+
+def parse_ini(text: str) -> dict[str, dict[str, str]]:
+    raw: dict[str, dict[str, str]] = {}
+    section = None
+    last = None  # (section, key)
+    for no, line in enumerate(text.splitlines(), 1):
+        s = line.strip()
+        if not s:
+            continue
+        if s[0] in "#;":
+            continue
+        if s.startswith("[") and s.endswith("]"):
+            name = s[1:-1].strip()
+            if not name:
+                raise ValueError(f"empty section name at line {no}")
+            section = name
+            raw.setdefault(name, {})
+            last = None
+            continue
+        if line[0] in " \t":
+            if last is None:
+                raise ValueError(f"unexpected continuation at line {no}")
+            sec, key = last
+            raw[sec][key] += "\n" + _strip_comment(line)
+            continue
+        if "=" in line:
+            k, v = line.split("=", 1)
+            k = k.strip().lower()
+            if not k:
+                raise ValueError(f"empty key at line {no}")
+            if section is None:
+                raise ValueError(f"key before section at line {no}")
+            raw[section][k] = _strip_comment(v)
+            last = (section, k)
+            continue
+        raise ValueError(f"invalid line {no}")
+
+    done: dict[tuple[str, str], str] = {}
+
+    def resolve(sec: str, key: str, stack: tuple) -> str:
+        if (sec, key) in done:
+            return done[(sec, key)]
+        if (sec, key) in stack:
+            raise ValueError(f"cycle: {sec}:{key}")
+        if sec not in raw or key not in raw[sec]:
+            raise ValueError(f"unknown reference {sec}:{key}")
+        val = raw[sec][key]
+        out = []
+        i = 0
+        while i < len(val):
+            ch = val[i]
+            if ch != "$":
+                out.append(ch)
+                i += 1
+                continue
+            nxt = val[i + 1 : i + 2]
+            if nxt == "$":
+                out.append("$")
+                i += 2
+            elif nxt == "{":
+                j = val.find("}", i + 2)
+                if j < 0:
+                    raise ValueError("unclosed ${")
+                ref = val[i + 2 : j]
+                if ":" in ref:
+                    rs, rk = ref.split(":", 1)
+                else:
+                    rs, rk = sec, ref
+                out.append(resolve(rs, rk.lower(), (*stack, (sec, key))))
+                i = j + 1
+            else:
+                raise ValueError("bad $")
+        done[(sec, key)] = "".join(out)
+        return done[(sec, key)]
+
+    return {sec: {k: resolve(sec, k, ()) for k in kv} for sec, kv in raw.items()}
