# see https://www.chezmoi.io/reference/special-files/chezmoiignore/

# OS dependent modules
{{ if eq .chezmoi.os "windows" }}
# Unix のみ
.chezmoiscripts/000_unix/
.chezmoiscripts/000_unix/**
.chezmoiscripts/400_unix/
.chezmoiscripts/400_unix/**
.config/*
# pi の MCP (検索) は Windows native でも必要
!.config/agents/
!.config/agents/agentcore_websearch_mcp.py
# 検索の核と MCP サーバ (スキル web-search の外の中立な場所)。鍵の同期 (349) も呼ぶので Windows にも配る
!.config/agents/websearch/
!.config/agents/websearch/**
# Git の user (Bitwarden 由来) と global ignore。~/.config/git/config が [include] で読む。
# ディレクトリだけを戻す。/** で戻すと、下の「一度だけ展開する」除外まで打ち消す
!.config/git/
# Windows 向け mise 設定は gh / Herdr を宣言する (AI CLI は 314 が公式手段で導入)
!.config/mise/
!.config/mise/config.toml
# PowerShell プロファイルの実体 (Documents 配下は 1 行のローダーのみ)
!.config/powershell/
!.config/powershell/**
.config/tmuxinator/
.config/tmuxinator/**
.bash_profile
.bashrc
.gdbinit
.profile
.tmux.conf
.Xmodmap
.xsession
.xsessionrc
.zshenv
.zshrc
# pi 本体と設定は Windows にも配る。prompts (/fleet など) は Windows では配らない
.pi/agent/prompts/
.pi/agent/prompts/**
{{- else }}
# windows のみで導入
.chezmoiscripts/300_windows/
.chezmoiscripts/300_windows/**
.config/powershell/
.config/powershell/**
.wslconfig
AppData/
AppData/**
Documents/
Documents/**
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
# Mac OS X のみ
.chezmoiscripts/200_mac/
.chezmoiscripts/200_mac/**
.config/shell/osxenv.sh
.config/shell/osxrc.sh
.mackup.cfg
{{- end }}

{{- if ne .chezmoi.os "linux" }}
# pi のコマンド実行を包む囲い (bwrap は Linux 専用)。shellPath は pi の settings.json の modify が Linux だけに入れる
# see docs/spec/sandbox/pi-sandbox-runner.md
.local/bin/pi-sandbox-runner
.local/bin/pib
.local/bin/pib-shell
.config/pi-sandbox
.config/pi-sandbox/**
{{- end }}

{{- if eq .chezmoi.os "linux" }}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
.chezmoiscripts/100_linux/110_native/
.chezmoiscripts/100_linux/110_native/**
{{-   else }}
# WSL のみで導入
.chezmoiscripts/100_linux/120_wsl.sh
.config/shell/wslenv.sh
{{-     if eq (includeTemplate "is-raspi" .) "true" }}
# Raspberry Pi (ヘッドレス) では導入しない。
# VS Code 本体は SD カードを数百 MB 食うが、Remote-SSH で繋ぐ側に
# あればよい。i3 / polybar / X11 関連も接続する画面が無いと使わない。
.chezmoiscripts/100_linux/110_native/
.chezmoiscripts/100_linux/110_native/**
.config/i3/
.config/i3/**
.config/polybar/
.config/polybar/**
.Xmodmap
.xsession
.xsessionrc
{{-     end }}
{{-   end }}
{{- else }}
# Linux のみで導入
.chezmoiscripts/100_linux/
.chezmoiscripts/100_linux/**
{{- end }}

{{- if eq (includeTemplate "no-sudo" .) "true" }}
# sudo 無しモード。root が要るスクリプトは除外する (run_once の記録は残らないので、
# sudo が使えるようになった次の apply で走る)。125 は apt の部分だけ中で分岐する
# see docs/spec/development.md#sudo-無しモード
.chezmoiscripts/100_linux/110_native/
.chezmoiscripts/100_linux/110_native/**
.chezmoiscripts/100_linux/120_wsl.sh
.chezmoiscripts/100_linux/121_ubuntu.sh
.chezmoiscripts/100_linux/130_shell.sh
{{- end }}

{{- if not (regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username) }}
# 個人 PC のみで導入
.config/git/user
.config/sops/age/keys.txt
# YouTube (yt-dlp) の字幕は個人 PC だけ。制約のある環境の機にはスクリプト自体を配らない
# see docs/spec/imozuru.md#youtube
.agents/skills/imozuru/scripts/fetch_youtube.py
.vscode-server/
.vscode-server/**
{{- end }}

# 会社 PC は検索を AgentCore の MCP に一本化する。それに依存しない自作の検索の核と imozuru は個人用 (is-work でない機) だけに配る
# see docs/spec/web-search.md#配る範囲、docs/spec/imozuru.md#配る範囲
{{- if eq (includeTemplate "is-work" .) "true" }}
.config/agents/websearch/
.config/agents/websearch/**
.agents/skills/imozuru/
.agents/skills/imozuru/**
{{- end }}

# pi-mcp-adapter の設定 (~/.pi/agent/mcp-adapter.json) は、adapter を入れる機 (is-work) だけ。他の機は pi 組み込みの MCP が mcp.json を読む
# see docs/spec/mcp-servers.md#子のエージェントへの検索-mcp-の渡し方
{{- if ne (includeTemplate "is-work" .) "true" }}
.pi/agent/mcp-adapter.json
{{- end }}

# Bitwarden 由来のファイルは一度のみ展開する
# (毎回 Bitwarden を引くと chezmoi diff がマスターパスワードを要求するため)
#
# 展開済みかどうかとは別に BW_SESSION の有無でも判定する。セッションが無いと
# chezmoi が bw unlock を走らせ、未ログインの環境では
# 「You are not logged in.」で apply 全体が止まるため。
# 展開するときは次を実行する:
#   bw login && export BW_SESSION="$(bw unlock --raw)" && chezmoi apply
{{- $bwSession := ne (env "BW_SESSION") "" }}

{{- if or (not $bwSession) (stat (joinPath .chezmoi.homeDir ".config/sops/age/keys.txt")) }}
.config/sops/age/keys.txt
{{- end }}

{{- if or (not $bwSession) (stat (joinPath .chezmoi.homeDir ".config/git/user")) }}
.config/git/user
{{- end }}

# Python bytecode (generated at runtime, not part of dotfiles)
**/__pycache__
**/__pycache__/**
**/*.pyc

# Orca (stablyai/orca) が生成・管理する実体。いずれもマシン固有の内容
# (Windows 側の絶対パス、バージョンピン、worktree 実体) を含み、Orca 自身が
# 再生成・更新するため chezmoi では追跡しない。
# ここに列挙しておくと `chezmoi add` も警告を出して取り込みを拒否する。
#
.orca
.orca/**
.orca-relay
.orca-relay/**
.orca-wsl
.orca-wsl/**
.local/share/orca
.local/share/orca/**
.local/bin/orca-ide
orca
orca/**

# npx skills (vercel-labs/skills) が管理する skill ストア。
# Orca が初回起動時にインストールを促し、以降も Orca 側が更新を管理するため
# chezmoi では追跡しない (二重管理を避ける)。
# ★~/.agents/skills は自作 skill の置き場でもある (2026-11 に ~/.claude/skills から移した)。
#   `.agents` を丸ごと除外すると自作 skill が配備されず、旧い置き場の削除だけが走る。
#   除外は Orca が入れる 3 つの skill とロックファイルだけにする。
.agents/.skill-lock.json
.agents/skills/computer-use
.agents/skills/computer-use/**
.agents/skills/orca-cli
.agents/skills/orca-cli/**
.agents/skills/orchestration
.agents/skills/orchestration/**

# powerpoint-studio スキルが実行時に作る成果物。
# スキル本体 (SKILL.md / scripts / assets / references / lock ファイル) は
# chezmoi の配布対象だが、以下は実行のたびに再生成されるため追跡しない。
# ここに列挙しておくと `chezmoi add` も警告を出して取り込みを拒否する。
#
# - .venv / node_modules: uv と npm が作る依存の実体
# - .pytest_cache / .ruff_cache / .tmp: ツールの作業領域
# - evals/*: 評価の入出力。生成物と実行ログで、レビュー対象ではない
.agents/skills/powerpoint-studio/.venv
.agents/skills/powerpoint-studio/.venv/**
.agents/skills/powerpoint-studio/node_modules
.agents/skills/powerpoint-studio/node_modules/**
.agents/skills/powerpoint-studio/.pytest_cache
.agents/skills/powerpoint-studio/.pytest_cache/**
.agents/skills/powerpoint-studio/.ruff_cache
.agents/skills/powerpoint-studio/.ruff_cache/**
.agents/skills/powerpoint-studio/.tmp
.agents/skills/powerpoint-studio/.tmp/**
.agents/skills/powerpoint-studio/evals/files
.agents/skills/powerpoint-studio/evals/files/**
.agents/skills/powerpoint-studio/evals/runs
.agents/skills/powerpoint-studio/evals/runs/**
.agents/skills/powerpoint-studio/evals/blind
.agents/skills/powerpoint-studio/evals/blind/**
.agents/skills/powerpoint-studio/evals/final-verification
.agents/skills/powerpoint-studio/evals/final-verification/**

# conference-video スキルが実行時に作る成果物 (powerpoint-studio と同じ扱い)。
# スキル本体 (SKILL.md / scripts / assets / references / tests / vendor / lock) は配布対象。
# 成果物の保存先はスキルの外 (~/.conference-video/<slug>/) なので、ここに列挙するのはツールの作業領域だけ。
.agents/skills/conference-video/.venv
.agents/skills/conference-video/.venv/**
.agents/skills/conference-video/.pytest_cache
.agents/skills/conference-video/.pytest_cache/**
.agents/skills/conference-video/.ruff_cache
.agents/skills/conference-video/.ruff_cache/**
.agents/skills/conference-video/.tmp
.agents/skills/conference-video/.tmp/**
.agents/skills/conference-video/**/__pycache__
.agents/skills/conference-video/**/__pycache__/**
