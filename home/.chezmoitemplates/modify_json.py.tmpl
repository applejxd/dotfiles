#!/usr/bin/env python3
from __future__ import annotations

import glob
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path({{ .workingTree | toJson }})
TARGET = {{ .target | toJson }}
# common.toml は chezmoi テンプレートなので、描画済みの内容を受け取る。
# 配備先 (~/.config/agents/common.toml) は modify_ の実行時点ではまだ
# 更新されていない (.claude/ の方が .config/ より先に適用される) ため使えない。
COMMON = {{ .common | toJson }}

# generate.py は tomllib (Python 3.11 以上) を使う。一方 chezmoi が modify
# script を動かすのは [interpreters.py] の Python で、そこが 3.10 以下のことが
# ある。その値は chezmoi init のときに確定するので、apply 中に mise が新しい
# Python を入れても同じ apply では効かない。だから起動側でここで選び直す。
VERSIONED_PYTHONS = ("python3.14", "python3.13", "python3.12", "python3.11")
# mise / uv は shim を PATH に出さないことがあるので、既定の導入先も直接見る。
# これがあると sudo で system Python を入れずに済む。
TOOLCHAIN_GLOBS = (
    "~/.local/share/mise/installs/python/*/bin/python3.*",
    "~/.local/share/uv/python/*/bin/python3.*",
)
MINOR_VERSION = re.compile(r"^python3\.(\d+)$")


def _has_tomllib(python: str) -> bool:
    try:
        probe = subprocess.run(
            [python, "-c", "import tomllib"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        return False
    return probe.returncode == 0


def _toolchain_python() -> str | None:
    """mise / uv が入れた Python のうち、最も新しい 3.11 以上を返す。"""
    found: list[tuple[int, str]] = []
    for pattern in TOOLCHAIN_GLOBS:
        for path in glob.glob(os.path.expanduser(pattern)):
            matched = MINOR_VERSION.match(os.path.basename(path))
            if not matched or int(matched.group(1)) < 11:
                continue
            if os.access(path, os.X_OK):
                found.append((int(matched.group(1)), path))
    if not found:
        return None
    # 同じ版が複数あっても (3.13 と 3.13.6 など) 実体は同じなので先頭でよい
    return max(found)[1]


def generator_python() -> str:
    """generate.py を動かせる Python を返す。

    見つからないときは現在の Python を返し、生成側の import ガードに
    「3.11 以上が要る」と理由を説明させる (ここで黙って失敗させない)。
    """
    try:
        import tomllib  # noqa: F401
    except ModuleNotFoundError:
        pass
    else:
        return sys.executable

    for name in VERSIONED_PYTHONS:
        found = shutil.which(name)
        if found:
            return found
    # mise などの shim は版番号付きの名前を持たないので、実際に試す
    for name in ("python3", "python"):
        found = shutil.which(name)
        if found and _has_tomllib(found):
            return found
    return _toolchain_python() or sys.executable


def main() -> int:
    data = sys.stdin.buffer.read()
    generator = REPO / "scripts" / "agents" / "generate.py"

    if not COMMON or not generator.is_file():
        sys.stdout.buffer.write(data)
        return 0

    env = os.environ.copy()
    env["PYTHONUTF8"] = "1"
    env["PYTHONIOENCODING"] = "utf-8"
    with tempfile.TemporaryDirectory() as work:
        common = Path(work) / "common.toml"
        common.write_text(COMMON, encoding="utf-8")
        result = subprocess.run(
            [
                generator_python(),
                str(generator),
                "--target",
                TARGET,
                "--common",
                str(common),
            ],
            input=data,
            stdout=subprocess.PIPE,
            env=env,
            check=False,
        )
    if result.returncode != 0:
        return result.returncode

    sys.stdout.buffer.write(result.stdout.replace(b"\r\n", b"\n"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
