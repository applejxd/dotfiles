#!/bin/bash

set -euo pipefail

{{ template "sudo-keepalive.sh.tmpl" . }}
start_sudo_keepalive

echo "Starting macOS system setup..." >&2

# for x86_64 architecture
yes A | softwareupdate --install-rosetta

#---------------#
# Load Homebrew #
#---------------#

brew_path=""
if [[ $(uname -m) == arm64 ]]; then
    brew_path="/opt/homebrew/bin/brew"
elif [[ $(uname -m) == x86_64 ]]; then
    brew_path="/usr/local/bin/brew"
fi
eval "$($brew_path shellenv)"
brew update

#-------------#
# Brew bundle #
#-------------#

if [[ $(uname -m) == arm64 ]]; then
    # GUI apps
    brew bundle --file={{ joinPath .chezmoi.workingTree "scripts" "osx" "brew_mas_cask.rb" | quote }}

    # sudo が要る GUI アプリ (認証は冒頭の start_sudo_keepalive で取得済み)
    brew install avast-security
    # Needs Rosetta2
    brew install google-japanese-ime
    brew install karabiner-elements
    brew install xquartz
    brew install qlvideo
fi

#--------#
# Others #
#--------#

# iTerm2 Shell integration
if [ ! -e ~/.iterm2_shell_integration.zsh ]; then
    curl -L https://iterm2.com/shell_integration/install_shell_integration.sh | bash
fi

# For bits/stdc++.h
if [[ $(which gcc) != "/opt/homebrew/bin/gcc" ]]; then
    brew install gcc
    gcc_path=$(ls /opt/homebrew/bin/gcc-[0-9]*)
    gpp_path=$(ls /opt/homebrew/bin/g++-[0-9]*)

    ln -fs "$gcc_path" /opt/homebrew/bin/gcc
    ln -fs "$gpp_path" /opt/homebrew/bin/g++
fi

# For LaTeX
# see https://texwiki.texjp.org/?TeX%20Live%2FMac
if [[ ! -e /usr/local/texlive ]]; then
    brew install mactex
    eval "$(/usr/libexec/path_helper)"
    sudo tlmgr update --self --all
    sudo tlmgr paper a4
fi
