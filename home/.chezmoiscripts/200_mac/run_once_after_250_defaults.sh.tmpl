#!/bin/bash

set -euo pipefail

{{ template "sudo-keepalive.sh.tmpl" . }}
start_sudo_keepalive

# 起動時の音をミュート (Apple Silicon では拒否されうる。失敗しても残りの設定を続ける)
sudo nvram StartupMute=%01 || echo "⚠️ nvram StartupMute を設定できませんでした (飛ばします)" >&2

# 「共有」->「リモートログイン」(SSH サーバ)。公開鍵は 400_unix/run_after_440_authorized_keys が足す。
# systemsetup は実行元のターミナルにフルディスクアクセスが無いと失敗する。そのときは launchd の
# デーモンを直接読み込む。設定アプリの表示は、再起動まで追従しないことがある。
# see docs/spec/security.md#macos-の-ssh-サーバリモートログイン
if ! sudo launchctl print system/com.openssh.sshd >/dev/null 2>&1; then
    if ! sudo systemsetup -setremotelogin on >/dev/null 2>&1; then
        if ! sudo launchctl load -w /System/Library/LaunchDaemons/ssh.plist; then
            echo "⚠️ リモートログインを有効にできませんでした。手動で: システム設定 > 一般 > 共有 > リモートログイン" >&2
        fi
    fi
fi

#----------#
# defaults #
#----------#

# see https://github.com/ulwlu/dotfiles/blob/master/system/macos.sh

# 設定項目一覧
# defaults domain

# 設定値変更の確認
# defaults read > backup.conf
# diff -u backup.conf <(defaults read)

# 設定値の型の確認
# defaults read-type com.apple.AppleMultitouchTrackpad Clicking

# 「タップでクリック」
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool true
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true

# 「3本指のトラック」
defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadThreeFingerDrag -bool true
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool true

# 「メニューバーに Bluetooth を表示」
defaults write com.apple.controlcenter "NSStatusItem Visible Bluetooth" -bool true
defaults write ~/Library/Preferences/ByHost/com.apple.controlcenter.plist Bluetooth -int 18

# 「メニューバーにサウンドを表示」
defaults write com.apple.controlcenter "NSStatusItem Visible Sound" -bool true
defaults write ~/Library/Preferences/ByHost/com.apple.controlcenter.plist Sound -int 18

killall SystemUIServer || true

# 「新規 Finder ウィンドウでホームを表示」
# see https://gist.github.com/ChristopherA/98628f8cd00c94f11ee6035d53b0d3c6
defaults write com.apple.finder NewWindowTarget -string "PfHm"

killall Finder || true

# 「"Siri に頼む"を無効にする」
defaults write com.apple.assistant.support.plist "Assistant Enabled" -bool false
# 「メニューバーに Siri を非表示」
defaults write com.apple.Siri StatusMenuVisible -bool false

# 「Dock」->「画面上の位置」->「左」
defaults write com.apple.dock orientation -string left
killall Dock || true

# 「Mac を自動的に最新の状態に保つ」
# defaults write com.apple.SoftwareUpdate ScheduleFrequency -int 1

# 「ファイアウォールをオンにする」
sudo defaults write /Library/Preferences/com.apple.alf globalstate -int 1
