 "hooks": [
  {
   "id": "markdownlint",
   "post_edit": true,
   "purpose": "Markdown 編集後に markdownlint --fix と残存違反の警告",
   "runner": "bash",
   "script": "markdownlint.sh",
   "timeout_sec": 30
  },
  {
   "id": "format-file",
   "post_edit": true,
   "purpose": "編集したファイルを拡張子に応じて整形 (ruff / clang-format / prettier)",
   "runner": "bash",
   "script": "format-file.sh",
   "timeout_sec": 30
  }
 ],
 "opencode": {
  "agent": {
   "bypass": {
    "bypass": true,
    "description": "通常の確認 (ask) を無確認で通す。deny と誘導は通常どおり効く",
    "mode": "primary",
    "permission": {
     "task": {
      "*": "deny",
      "bypass-fleet-worker": "allow",
      "bypass-worker": "allow",
      "commit": "allow",
      "explore": "allow",
      "review": "allow"
     }
    }
   },
   "bypass-worker": {
    "bypass": true,
    "description": "bypass から起動する作業用の子エージェント。通常の確認 (ask) を無確認で通す",
    "mode": "subagent",
    "permission": {
     "task": "deny"
    }
   }
  },
  "agents": {
   "bypass-fleet-worker": {
    "bypass": true,
    "description": "bypass の /fleet の作業役。親が割り当てた 1 つの作業を、指定された担当ファイルの範囲で実装し、確認して結果を返す。通常の確認 (ask) を無確認で通す。コミットはしない。/fleet 以外から直接使わない",
    "mode": "subagent",
    "permissions": [
     {
      "action": "subagent",
      "effect": "deny",
      "resource": "*"
     },
     {
      "action": "question",
      "effect": "deny",
      "resource": "*"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git add *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git commit *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git stash *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git checkout *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git switch *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git restore *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git reset *"
     }
    ],
    "system_from": "fleet-worker"
   },
   "commit": {
    "description": "変更を読み、論理単位ごとの対象ファイルとコミットメッセージ全文 (計画) を返す。ステージもコミットもしない。呼ぶ前に、docs/change/ があるリポジトリでは commit スキルの「コミット前の docs 反映」を親が済ませる。親は差分を読まずにこれへ任せる。返された計画の全文 (対象とメッセージ) を commit スキルの承認時の提示の形で返答に示し、利用者の承認を待って返答を終える (件名だけに縮めない。承認前にステージやコミットをしない)。承認されたら commit スキルの手順 3〜6 に従い、差分は読み直さずに単位ごとに git add -- <パス> と git commit -m '<件名>' -m '<本文>' を別々に実行する。shell は同じ応答に並べず、完了を待って 1 つずつ実行する (並べると .git/index.lock で失敗する)",
    "mode": "subagent",
    "permissions": [
     {
      "action": "edit",
      "effect": "deny",
      "resource": "*"
     },
     {
      "action": "subagent",
      "effect": "deny",
      "resource": "*"
     },
     {
      "action": "question",
      "effect": "deny",
      "resource": "*"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "*"
     },
     {
      "action": "shell",
      "effect": "allow",
      "resource": "git status *"
     },
     {
      "action": "shell",
      "effect": "allow",
      "resource": "git diff *"
     },
     {
      "action": "shell",
      "effect": "allow",
      "resource": "git log *"
     },
     {
      "action": "shell",
      "effect": "allow",
      "resource": "git branch --show-current"
     },
     {
      "action": "shell",
      "effect": "allow",
      "resource": "git rev-parse --show-toplevel"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "*>*"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "*--output*"
     }
    ],
    "system": "あなたはコミットの計画係です。親から呼ばれ、変更を読んでコミットの計画を返します。\n利用者への提示・ステージ・コミットは親が行います。\n\n- 最初に skill ツールで commit スキルを読み込む。分け方・メッセージの書式は\n  それに従い、手順 2 (メッセージ作成だけを依頼された場合) として扱う\n- 単位はファイル単位で分ける。同じファイルの中を分ける必要があるときは、単位をまとめるか、\n  分けられなかったことを書く\n- 単位ごとに、対象のパス (git status --short の行) とメッセージの全文を、スキルの\n  「承認時の提示」の形で返す。親はそれをそのまま利用者に示し、git commit -m '<件名>' -m '<本文>' に\n  使うので、全文を省略せずに書く\n- ファイルは read / glob / grep ツールで読む。shell で cat / ls / find / echo などを使わない\n- shell は 1 回の応答で 1 つだけ呼び、完了結果を受け取ってから次を呼ぶ。1 回の呼び出しは\n  1 コマンドとし、; や && でつなげず、リダイレクトや 2>&1 を付けない。作業ディレクトリは\n  cd ではなく shell ツールの workdir で指定する\n- 対象外のステージ済み変更や、部分ステージ (同じファイルの index と作業ツリーの両方に差分) が\n  あれば、計画に添えて書く\n\nファイルは編集しない。git add / git commit などで状態を変えない。\n"
   },
   "explore": {
    "description": "Fast agent specialized for exploring codebases. Use this when you need to quickly find files by patterns (eg. \"src/components/**/*.tsx\"), search code for keywords (eg. \"API endpoints\"), or answer questions about the codebase (eg. \"how do API endpoints work?\"). When calling this agent, specify the desired thoroughness level: \"quick\" for basic searches, \"medium\" for moderate exploration, or \"very thorough\" for comprehensive analysis across multiple locations and naming conventions. 読み取り専用（read / glob / grep / webfetch / websearch）。Git の履歴やコマンドの実行が要る調査は親へ返す。",
    "mode": "subagent",
    "permissions": [
     {
      "action": "edit",
      "effect": "deny",
      "resource": "*"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "*"
     },
     {
      "action": "subagent",
      "effect": "deny",
      "resource": "*"
     },
     {
      "action": "question",
      "effect": "deny",
      "resource": "*"
     }
    ]
   },
   "fleet-worker": {
    "description": "/fleet の作業役。親が割り当てた 1 つの作業を、指定された担当ファイルの範囲で実装し、確認して結果を返す。コミットはしない。/fleet 以外から直接使わない",
    "mode": "subagent",
    "permissions": [
     {
      "action": "subagent",
      "effect": "deny",
      "resource": "*"
     },
     {
      "action": "question",
      "effect": "deny",
      "resource": "*"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git add *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git commit *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git stash *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git checkout *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git switch *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git restore *"
     },
     {
      "action": "shell",
      "effect": "deny",
      "resource": "git reset *"
     }
    ],
    "system": "あなたは並列作業の作業役です。取りまとめ役 (親エージェント) から 1 つの作業を渡され、\n結果を親へ返します。ほかの作業役が同じ作業ツリーで同時に動いています。\nユーザーとは直接やり取りできません。\n\n- 担当ファイルとして渡されたものだけを編集する。担当外の変更が必要だと分かったら、\n  編集せずに理由と必要な変更を報告する\n- 既存の関数や振る舞いを変えたら、grep で呼び出し元を探して読み、その変更で壊れる所や、\n  直した誤りを前提にしている所 (誤りを打ち消す処理など) が無いか確かめる\n- 確かめ用・比較用のファイルは作らない (試すなら python -c など)。どうしても要るときは\n  作業ツリーの .tmp/ の下に作り、報告の前に消す。作業ツリーの外 ($TMPDIR や ../ も) へは書かない\n- ファイルは read / glob / grep ツールで読み、edit / write ツールで書く。shell の cat / head /\n  ls / ヒアドキュメント / リダイレクトで読み書きしない\n- 完了条件と確認方法が渡されたら、それに従って確かめる。確認方法のコマンドは渡された形の\n  まま単独で実行する (パイプや ; でつながない。作業ディレクトリは cd ではなく workdir で\n  指定する)。確かめられなかったら、そう書く (推測で成功と書かない)\n- git の操作 (add / commit / stash / checkout / reset など) はしない。\n  作業ツリーはほかの作業役と共有している\n- 次を返して終わる\n  - 変更したファイルと、変更の要点\n  - 実行した確認と、その結果\n  - 呼び出し元への影響 (確かめた範囲と、見つけたもの)\n  - 残った問題・判断が要る点・担当外で必要な変更\n"
   },
   "plan": {
    "description": "Read-only agent for exploring the codebase and planning work before implementation.",
    "mode": "primary",
    "permissions": [
     {
      "action": "edit",
      "effect": "deny",
      "resource": "*"
     },
     {
