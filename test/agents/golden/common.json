    },
    {
     "pi": "read-sed-n"
    },
    {
     "message": "allow されたコマンドの出力をリダイレクトで書き込まないでください。ファイルを作る・書き換えるときは write / edit ツールを使ってください。",
     "pattern": "(^|&&|\\|\\||;|\\n)\\s*(wc|grep\\s+-n|git\\s+log|uv\\s+pip\\s+list|docker\\s+ps)\\b[^\\n]*>(?!&\\s*(\\d+|-)(?=$|[\\s;|&)])|>?\\s*/dev/null(?=$|[\\s;|&)]))"
    },
    {
     "message": "git log の --output でファイルへ書き込まないでください。ファイルを作るときは write ツールを使ってください。",
     "pattern": "(^|[;&|\\n(`{])\\s*git[ \\t]+log(?=[ \\t]|\\\\\\n)(?:[^;&|\\n'\"\\\\]|\\\\[\\s\\S]|'[^']*'|\"(?:[^\"\\\\]|\\\\[\\s\\S])*\")*?(?:[ \\t]|\\\\\\n)['\"]?--output['\"]?(=|[ \\t])"
    },
    {
