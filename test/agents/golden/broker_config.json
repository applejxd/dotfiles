{
 "both": {
  "node": {
   "cluster": "pis-broker",
   "id": "pis-broker"
  },
  "static_resources": {
   "clusters": [
    {
     "dns_lookup_family": "V4_ONLY",
     "load_assignment": {
      "cluster_name": "copilot_upstream",
      "endpoints": [
       {
        "lb_endpoints": [
         {
          "endpoint": {
           "address": {
            "socket_address": {
             "address": "api.individual.githubcopilot.com",
             "port_value": 443
            }
           }
          }
         }
        ]
       }
      ]
     },
     "name": "copilot_upstream",
     "transport_socket": {
      "name": "envoy.transport_sockets.tls",
      "typed_config": {
       "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext",
       "common_tls_context": {
        "validation_context": {
         "match_typed_subject_alt_names": [
          {
           "matcher": {
            "suffix": "githubcopilot.com"
           },
           "san_type": "DNS"
          }
         ],
         "trusted_ca": {
          "filename": "/etc/ssl/ca.pem"
         }
        }
       },
       "sni": "api.individual.githubcopilot.com"
      }
     },
     "type": "LOGICAL_DNS"
    },
    {
     "dns_lookup_family": "V4_ONLY",
     "load_assignment": {
      "cluster_name": "github_upstream",
      "endpoints": [
       {
        "lb_endpoints": [
         {
          "endpoint": {
           "address": {
            "socket_address": {
             "address": "api.github.com",
             "port_value": 443
            }
           }
          }
         }
        ]
       }
      ]
     },
     "name": "github_upstream",
     "transport_socket": {
      "name": "envoy.transport_sockets.tls",
      "typed_config": {
       "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext",
       "common_tls_context": {
        "validation_context": {
         "match_typed_subject_alt_names": [
          {
           "matcher": {
            "exact": "api.github.com"
           },
           "san_type": "DNS"
          }
         ],
         "trusted_ca": {
          "filename": "/etc/ssl/ca.pem"
         }
        }
       },
       "sni": "api.github.com"
      }
     },
     "type": "LOGICAL_DNS"
    }
   ],
   "listeners": [
    {
     "address": {
      "socket_address": {
       "address": "127.0.0.1",
       "port_value": 12345
      }
     },
     "filter_chains": [
      {
       "filters": [
        {
         "name": "envoy.filters.network.http_connection_manager",
         "typed_config": {
          "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
          "access_log": [
           {
            "name": "envoy.access_loggers.stdout",
            "typed_config": {
             "@type": "type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog",
             "log_format": {
              "text_format_source": {
               "inline_string": "ACCESS %REQ(:METHOD)% %REQ(:PATH)% %RESPONSE_CODE%\n"
              }
             }
            }
           }
          ],
          "http_filters": [
           {
            "name": "envoy.filters.http.credential_injector",
            "typed_config": {
             "@type": "type.googleapis.com/envoy.extensions.filters.http.credential_injector.v3.CredentialInjector",
             "credential": {
              "name": "envoy.http.injected_credentials.generic",
              "typed_config": {
               "@type": "type.googleapis.com/envoy.extensions.http.injected_credentials.generic.v3.Generic",
               "credential": {
                "name": "copilot_token",
                "sds_config": {
                 "path_config_source": {
                  "path": "/state/dir/copilot-sds.json",
                  "watched_directory": {
                   "path": "/state/dir"
                  }
                 }
                }
               },
               "header": "Authorization",
               "header_value_prefix": "Bearer "
              }
             },
             "overwrite": true
            }
           },
           {
            "name": "envoy.filters.http.router",
            "typed_config": {
             "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
            }
           }
          ],
          "merge_slashes": true,
          "normalize_path": true,
          "route_config": {
           "name": "copilot",
           "virtual_hosts": [
            {
             "domains": [
              "*"
             ],
             "name": "copilot",
             "routes": [
              {
               "direct_response": {
                "body": {
                 "inline_string": "pis-broker-copilot"
                },
                "status": 200
               },
               "match": {
                "path": "/__pis_broker"
               }
              },
              {
               "match": {
                "headers": [
                 {
                  "name": ":method",
                  "string_match": {
                   "exact": "POST"
                  }
                 }
                ],
                "path": "/v1/messages"
               },
               "route": {
                "cluster": "copilot_upstream",
                "host_rewrite_literal": "api.individual.githubcopilot.com",
                "idle_timeout": "3600s",
                "timeout": "0s"
               }
              },
              {
               "match": {
                "headers": [
                 {
                  "name": ":method",
                  "string_match": {
                   "exact": "POST"
                  }
                 }
                ],
                "path": "/responses"
               },
               "route": {
                "cluster": "copilot_upstream",
                "host_rewrite_literal": "api.individual.githubcopilot.com",
                "idle_timeout": "3600s",
                "timeout": "0s"
               }
              },
              {
               "match": {
                "headers": [
                 {
                  "name": ":method",
                  "string_match": {
                   "exact": "POST"
                  }
                 }
                ],
                "path": "/chat/completions"
               },
               "route": {
                "cluster": "copilot_upstream",
                "host_rewrite_literal": "api.individual.githubcopilot.com",
                "idle_timeout": "3600s",
                "timeout": "0s"
               }
              },
              {
               "direct_response": {
                "body": {
                 "inline_string": "pis-broker: path or method not allowed"
                },
                "status": 403
               },
               "match": {
                "prefix": "/"
               }
              }
             ]
            }
           ]
          },
          "stat_prefix": "copilot",
          "stream_idle_timeout": "3600s"
         }
        }
       ]
      }
     ],
     "name": "copilot"
    },
    {
     "address": {
      "pipe": {
       "mode": 384,
       "path": "/agent/dir/gh.sock"
      }
     },
     "filter_chains": [
      {
       "filters": [
        {
         "name": "envoy.filters.network.http_connection_manager",
         "typed_config": {
          "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
          "access_log": [
           {
            "name": "envoy.access_loggers.stdout",
            "typed_config": {
             "@type": "type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog",
             "log_format": {
              "text_format_source": {
               "inline_string": "ACCESS github %REQ(:METHOD)% %REQ(:AUTHORITY)% %REQ(:PATH)% %RESPONSE_CODE%\n"
              }
             }
            }
           }
          ],
          "http_filters": [
           {
            "name": "envoy.filters.http.credential_injector",
            "typed_config": {
             "@type": "type.googleapis.com/envoy.extensions.filters.http.credential_injector.v3.CredentialInjector",
             "credential": {
              "name": "envoy.http.injected_credentials.generic",
              "typed_config": {
               "@type": "type.googleapis.com/envoy.extensions.http.injected_credentials.generic.v3.Generic",
               "credential": {
                "name": "gh_token",
                "sds_config": {
                 "path_config_source": {
                  "path": "/state/dir/gh-sds.json",
                  "watched_directory": {
                   "path": "/state/dir"
                  }
                 }
                }
               },
               "header": "Authorization",
               "header_value_prefix": "Bearer "
              }
             },
             "overwrite": true
            }
           },
           {
            "name": "envoy.filters.http.router",
            "typed_config": {
             "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
            }
           }
          ],
          "merge_slashes": true,
          "normalize_path": true,
          "route_config": {
           "name": "github",
           "virtual_hosts": [
            {
             "domains": [
              "api.github.com"
             ],
             "name": "github",
             "routes": [
              {
               "match": {
                "prefix": "/"
               },
               "route": {
                "cluster": "github_upstream",
                "host_rewrite_literal": "api.github.com",
                "idle_timeout": "3600s",
                "timeout": "0s"
               }
              }
             ]
            },
            {
             "domains": [
              "*"
             ],
             "name": "deny",
             "routes": [
              {
               "direct_response": {
                "body": {
                 "inline_string": "pis-broker: host not allowed"
                },
                "status": 403
               },
               "match": {
                "prefix": "/"
               }
              }
             ]
            }
           ]
          },
          "stat_prefix": "github",
          "stream_idle_timeout": "3600s"
         }
        }
       ]
      }
     ],
     "name": "github"
    }
   ]
  }
