#!/usr/bin/env python3
"""pi の stock プロファイルの ~/.pi/agent/settings.json。標準入力の現状を変換して出す。

自作ハーネスが入れた設定だけを取り除き、packages を pi-stock-packages の内容にする。
利用者のキー (テーマ・既定のモデルなど) は触らない。何度流しても同じ結果になる。
see docs/spec/agent-config-generation.md#pi-の設定
"""
from __future__ import annotations

import json
import sys

PACKAGES_TEXT = {{ .packages | toJson }}
# 検索の子 (researcher・evidence-auditor) の system prompt。機の検索・取得のツール名に合わせた文面 (.chezmoitemplates の 2 ファイル)
SEARCH_AGENT_PROMPTS = {
    "researcher": {{ .researcherPrompt | toJson }},
    "evidence-auditor": {{ .evidenceAuditorPrompt | toJson }},
}
# 会社 PC (is-work) か。検索の MCP が機で違う (家は websearch、会社 PC は agentcore-websearch)
IS_WORK = {{ if eq .isWork "true" }}True{{ else }}False{{ end }}
# 家の機で、起動時の選択とモデルの切り替え (Ctrl+P) の対象にするモデル。家は Copilot だけを使うので、Bedrock の認証情報が
# 環境変数や ~/.aws に残っていても、pi が Bedrock のモデルで無意識に起動しない (Copilot が使えないときの自動の選択も含む)。
# /model で明示して選ぶのは妨げない。利用者が enabledModels を書いていれば保つ。会社 PC は触らない (Bedrock を使う)
HOME_ENABLED_MODELS = ["github-copilot/*"]
# 家の機の親のセッションの既定 (Sol・high)。3 つのキーが全部無いときと、前の既定 (Sonnet・xhigh) のままのときだけ置く。
# 利用者が別の値を選んでいれば保つ。会社 PC は触らない。see docs/spec/agent-config-generation.md#pi-subagents-の設定
HOME_PARENT_DEFAULT = {
    "defaultProvider": "github-copilot",
    "defaultModel": "gpt-6.2-sol",
    "defaultThinkingLevel": "high",
}
LEGACY_HOME_PARENT_DEFAULT = {
    "defaultProvider": "github-copilot",
    "defaultModel": "claude-sonnet-5.5",
    "defaultThinkingLevel": "xhigh",
}

# pi のシェル。Linux (Ubuntu / WSL) だけが、コマンド実行の囲い (pib-shell) を指す。空文字なら触らない。
# pib-shell は、環境変数 PIB_SANDBOX が立っているとき (= pib で起動したとき) だけ囲う。普段の pi は素の bash と同じ
SHELL_PATH = {{ .shellPath | toJson }}

# 自作ハーネスだけが入れる extensions / skills の項目 (scripts/agents/generate.py の宣言に対応)
HARNESS_EXTENSION_MARKS = (".config/pi/harness", "!extensions/**", "+extensions/", "-builtin:")
HARNESS_SKILL_MARKS = ("~/.claude/skills", "-~/.agents/skills/", "-~/.claude/skills/")
# Orca が ~/.agents/skills/ へ入れるスキルを、ディレクトリ名で除外する (戻すときは利用者が +skills/<名前> を足す)
# see docs/spec/agent-config-generation.md#pi-の設定
EXCLUDED_SKILLS = ("!computer-use", "!orca-cli", "!orchestration")

# pi の既定 (read・bash・edit・write) に、読み取り専用の探索ツールを足す (増分指定)。plan mode の探索と通常の探索で使う
# 利用者が +/- だけの増分指定に変えていたら保つ。自作ハーネスの全置換の値 (["read"] など) は初期値に置き換える
DEFAULT_TOOLS = ["+grep", "+find", "+ls"]

# 圧縮 (compaction): 窓が 100 万のモデルは 70 万で圧縮する。reserveTokens = 窓 - 発動点 = 300000 (窓の 3 割)
# 窓の大きさが違うモデルは補わない。利用者が別の値を書いていれば保つ (無いときだけ補う)
COMPACTION_RESERVE_TOKENS = 300000
COMPACTION_MODELS = (
    "github-copilot/claude-sonnet-5.5",
    "github-copilot/claude-opus-5.5",
    "github-copilot/claude-sonnet-5",
    "github-copilot/gpt-6-sol",
    "github-copilot/gpt-6.2-sol",
    "github-copilot/gemini-4-carbon",
    "github-copilot/gpt-5.3-codex",
    "github-copilot/gemini-3.8-flash",
) + (() if IS_WORK else ("github-copilot/gemini-4-neon",))


def add_compaction_overrides(data: dict) -> None:
    compaction = data.get("compaction")
    if compaction is None:
        compaction = {}
    if not isinstance(compaction, dict):
        return  # 想定外の形は触らない
    overrides = compaction.get("modelOverrides")
    if overrides is None:
        overrides = {}
    if not isinstance(overrides, dict):
        return
    for model in COMPACTION_MODELS:
        entry = overrides.get(model)
        if entry is None:
            entry = {}
        if not isinstance(entry, dict):
            continue
        entry.setdefault("reserveTokens", COMPACTION_RESERVE_TOKENS)
        overrides[model] = entry
    compaction["modelOverrides"] = overrides
    data["compaction"] = compaction


# pi-subagents の組み込みの子の tools を読み取り専用に絞る (subagents.agentOverrides.<name>.tools 。docs/agents.md)。
# 組み込みの既定: scout = read, grep, find, ls, bash, write, contact_supervisor / oracle = read, grep, find, ls, bash。
# bash・write を外す (scout は親への問い合わせ contact_supervisor を残す)。reviewer (読み取り専用) と worker は変えない。
# 検索の子 (researcher・evidence-auditor) は、組み込みの tools が pi-web-access のツール名 (stock では入れない) なので、
# 機の検索・取得の MCP を mcp: で渡す。家は websearch (検索も取得も)、会社 PC は agentcore-websearch (検索) と webfetch (取得)。
# 利用者がすでに同じ役の tools を書いていれば保つ (無いときだけ補う)。
# see docs/spec/mcp-servers.md#子のエージェントへの検索-mcp-の渡し方
SEARCH_MCP = ["mcp:agentcore-websearch", "mcp:webfetch"] if IS_WORK else ["mcp:websearch"]
AGENT_TOOL_OVERRIDES = {
    "scout": ["read", "grep", "find", "ls", "contact_supervisor"],
    "oracle": ["read", "grep", "find", "ls"],
    "researcher": ["read", "write", *SEARCH_MCP],
    "evidence-auditor": ["read", *SEARCH_MCP],
}
# 前の既定の tools (会社 PC は取得の MCP を足す前)。この配列のままなら、利用者が選んだ値ではないので新しい既定へ移す
LEGACY_AGENT_TOOLS = {
    "researcher": ["read", "write", "mcp:agentcore-websearch"],
    "evidence-auditor": ["read", "mcp:agentcore-websearch"],
} if IS_WORK else {}


# 役割ごとのモデル (subagents.agentOverridesByProvider.<プロバイダ>.<役>.model。`:` の後ろは思考の深さ)。
# pi-subagents が、親のセッションのモデルのプロバイダ (/model で替えても追従する) ごとに層を重ねる (docs/models.md)。
# `advisor` は `oracle` の別名で、設定は正規名の `oracle` に書く。
# see docs/spec/agent-config-generation.md#pi-subagents-の設定
PROVIDER_AGENT_MODELS = {
    "github-copilot": {
        "scout": "github-copilot/claude-sonnet-5.5:low",
        "researcher": "github-copilot/claude-sonnet-5.5:medium",
        "worker": "github-copilot/claude-sonnet-5.5:medium",
        "reviewer": "github-copilot/gpt-6.2-sol:high",
        "evidence-auditor": "github-copilot/gemini-4-carbon:medium",
        "oracle": "github-copilot/gemini-4-carbon:high",
    },
    "amazon-bedrock": {
        "scout": "amazon-bedrock/us.anthropic.claude-sonnet-5-5:low",
        "researcher": "amazon-bedrock/us.anthropic.claude-sonnet-5-5:medium",
        "worker": "amazon-bedrock/us.anthropic.claude-sonnet-5-5:medium",
        "reviewer": "amazon-bedrock/us.openai.gpt-6.1-sol:high",
        "evidence-auditor": "amazon-bedrock/us.openai.gpt-6.1-sol:high",
        "oracle": "amazon-bedrock/us.openai.gpt-6.1-sol:high",
    },
}


# 前の既定値 (プロバイダ, 役) -> モデルの一覧。この値のままなら、利用者が選んだ値ではないので新しい既定へ移す
LEGACY_AGENT_MODELS = {
    ("github-copilot", "reviewer"): ("github-copilot/gpt-6.1-sol:high",),
    ("github-copilot", "evidence-auditor"): (
        "github-copilot/gpt-6.1-sol:high",
        "github-copilot/gpt-6.2-sol:high",
    ),
    ("github-copilot", "oracle"): (
        "github-copilot/claude-sonnet-5.5:xhigh",
        "github-copilot/gpt-6.1-sol:high",
        "github-copilot/gpt-6.2-sol:high",
    ),
    ("amazon-bedrock", "oracle"): ("amazon-bedrock/us.anthropic.claude-sonnet-5-5:xhigh",),
}

# 家の機だけで Copilot の割り当てを上書きし、変更した役の前の既定を移行対象にする。
HOME_COPILOT_MODELS = {
    "scout": "github-copilot/gemini-4-neon:medium",
    "researcher": "github-copilot/gemini-4-neon:xhigh",
    "worker": "github-copilot/claude-sonnet-5.5:high",
    "evidence-auditor": "github-copilot/gpt-6.2-sol:high",
    "delegate": "github-copilot/gemini-4-neon:high",
}


def is_incremental(value: object) -> bool:
    return (
        isinstance(value, list)
        and len(value) > 0
        and all(isinstance(i, str) and i.startswith(("+", "-")) for i in value)
    )


def packages() -> list[str]:
    lines = (line.strip() for line in PACKAGES_TEXT.splitlines())
    return [line for line in lines if line and not line.startswith("#")]


def drop_marked(items: object, marks: tuple[str, ...]) -> list[object]:
    if not isinstance(items, list):
        return []
    return [i for i in items if not (isinstance(i, str) and any(i.startswith(m) or m in i for m in marks))]


def read_stdin() -> str:
    """標準入力を UTF-8 として読む。読めなければ、旧版が cp932 で書いた残りとして読み直す。

    背景と撤去の条件は docs/spec/agent-config-generation.md#旧版が書いた-cp932-のファイルの移行
    """
    data = sys.stdin.buffer.read()
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        text = data.decode("cp932")
    return text.replace("\r\n", "\n").replace("\r", "\n")  # text モードの標準入力と同じ改行の扱い


def main() -> int:
    # 標準出力は UTF-8 に固定する (Windows の既定は cp932)。入力は read_stdin が UTF-8 で読む。see docs/spec/agent-config-generation.md#modify-スクリプトの文字コード
    sys.stdout.reconfigure(encoding="utf-8")
    raw = read_stdin()
    try:
        data = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        sys.stdout.write(raw)  # 壊れた入力は触らない
        return 0
    if not isinstance(data, dict):
        sys.stdout.write(raw)
        return 0
    if not is_incremental(data.get("defaultTools")):
        data["defaultTools"] = list(DEFAULT_TOOLS)
    skills_not_list = "skills" in data and not isinstance(data["skills"], list)
    for key, marks in (("extensions", HARNESS_EXTENSION_MARKS), ("skills", HARNESS_SKILL_MARKS)):
        if key in data and not (key == "skills" and skills_not_list):
            kept = drop_marked(data[key], marks)
            if kept:
                data[key] = kept
            else:
                del data[key]
    skills = data.get("skills", [])
    if not skills_not_list:  # 配列でなければ触らない
        data["skills"] = skills + [i for i in EXCLUDED_SKILLS if i not in skills]
    data["packages"] = packages()
    if not IS_WORK and "enabledModels" not in data:
        data["enabledModels"] = list(HOME_ENABLED_MODELS)
    if not IS_WORK:
        parent = {key: data.get(key) for key in HOME_PARENT_DEFAULT}
        if not (HOME_PARENT_DEFAULT.keys() & data.keys()) or parent == LEGACY_HOME_PARENT_DEFAULT:
            data.update(HOME_PARENT_DEFAULT)
    if SHELL_PATH and "shellPath" not in data:  # 利用者が別のシェルを書いていれば保つ (pib が、囲いを指していないと知らせる)
        data["shellPath"] = SHELL_PATH
    subagents = data.get("subagents")
    if not isinstance(subagents, dict):
        subagents = {}
    overrides = subagents.get("agentOverrides")
    if not isinstance(overrides, dict):
        overrides = {}
    for name, tools in AGENT_TOOL_OVERRIDES.items():
        entry = overrides.get(name)
        if not isinstance(entry, dict):
            entry = {}
        if entry.get("tools") == LEGACY_AGENT_TOOLS.get(name):
            entry["tools"] = list(tools)
        entry.setdefault("tools", list(tools))
        overrides[name] = entry
    for name, prompt in SEARCH_AGENT_PROMPTS.items():
        # 組み込みの prompt は存在しないツール名を勧めるので、この repo の文面で置き換える (毎回これに揃える。管理するキー)
        overrides[name]["systemPrompt"] = prompt
    by_provider = subagents.get("agentOverridesByProvider")
    if not isinstance(by_provider, dict):
        by_provider = {}
    for provider, roles in PROVIDER_AGENT_MODELS.items():
        layer = by_provider.get(provider)
        if not isinstance(layer, dict):
            layer = {}
        home_models = HOME_COPILOT_MODELS if not IS_WORK and provider == "github-copilot" else {}
        for name, model in (roles | home_models).items():
            # 新たにモデルを割り当てる役では、共通の上書きに利用者が書いたモデルを優先する。
            common = overrides.get(name)
            if name not in roles and isinstance(common, dict) and "model" in common:
                continue
            entry = layer.get(name)
            if not isinstance(entry, dict):
                entry = {}
            legacy = LEGACY_AGENT_MODELS.get((provider, name), ())
            if name in home_models and name in roles:
                legacy += (roles[name],)
            if entry.get("model") in legacy:
                entry["model"] = model
            entry.setdefault("model", model)
            layer[name] = entry
        by_provider[provider] = layer
    subagents["agentOverridesByProvider"] = by_provider
    subagents["agentOverrides"] = overrides
    data["subagents"] = subagents
    add_compaction_overrides(data)
    json.dump(data, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
