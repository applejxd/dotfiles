#!/bin/bash

#-----------------#
# OS dependencies #
#-----------------#

{{- if eq .chezmoi.os "linux" }}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
# WSL
alias pbcopy='clip.exe'
alias pbpaste='powershell.exe Get-Clipboard'

function open() {
    if [ "$#" != 1 ]; then
        explorer.exe .
    else
        if [ -e "$1" ]; then
            explorer.exe "$(wslpath -w "$1")" 2> /dev/null
        else
            echo "open: $1 : No such file or directory"
        fi
    fi
}

# fcitx / キーリピート設定 (wslenv.sh から移動。起動は対話の最上位シェルだけ)
if [[ "$SHLVL" = 1 ]]; then
    (fcitx-autostart >/dev/null 2>&1 &)
    xset -r 49 >/dev/null 2>&1
fi
{{-   else }}
alias pbcopy='xsel --clipboard --input'
alias pbpaste='xsel --clipboard --output'
alias open="xdg-open"
{{-   end }}
alias ls="ls --color=auto"
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
# macOS
# shellcheck source=/dev/null
source "${HOME}/.config/shell/osxrc.sh"
{{- end }}

{{- if contains "NAS" .chezmoi.hostname }}
# QNAP NAS向け設定
if [[ -e /opt/etc/profile ]]; then
    source /opt/etc/profile
fi
{{- end }}

#--------#
# Editor #
#--------#

if command -v nvim >/dev/null 2>&1; then
    alias vi='nvim'
    alias vim='nvim'
elif command -v vim >/dev/null 2>&1; then
    alias vi='vim'
fi

{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}
alias agent='copilot'
{{- else }}
alias agent='claude'
{{- end }}

{{- if regexMatch "(?i)(^|\\\\)applejxd$" .chezmoi.username }}

# コーディング試験の練習用。初回のプロファイル設定は
# see docs/spec/structure.md#コーディング試験の練習用-vs-codecode-exam
function code-exam() {
    local dir
    dir="${HOME}/coding-test/$(date +%F)"
    mkdir -p "$dir" || return
    code --disable-extensions --profile coding-test "$dir"
}
{{- end }}

# Copilot CLI の既定値 (未設定のときだけ入れる)。正本は common.toml.tmpl の [agent_env]
# see docs/spec/structure.md#シェルの起動契約
{{- $common := includeTemplate "dot_config/agents/common.toml.tmpl" . | fromToml }}
function copilot() {
    {{- range $k, $v := $common.agent_env }}
    {{ $k }}=${ {{- $k }}-'{{ $v | replace "'" "'\\''" }}'} \
    {{- end }}
    command copilot "$@"
}

#---------#
# Plugins #
#---------#

# z (rupa/z)。clone は chezmoi apply が行う (home/.chezmoiexternal.toml.tmpl)
# `command -v z` は無関係な z コマンドでも真になるため、z.sh の有無で判定する
Z_DIR="${HOME}/.z"
export _Z_DATA="${Z_DIR}/.z"
if [ -r "${Z_DIR}/z.sh" ]; then
    # shellcheck source=/dev/null
    source "${Z_DIR}/z.sh"
fi

#-----------------#
# Command Wrapper #
#-----------------#

# The default options of "less" command
export LESS="-iMR -gSW -z-4 -x4"

# with number: -v
alias dirs="dirs -v"

# "cat" cloning
if command -v "bat" >/dev/null 2>&1; then
    alias cat="bat --paging=never -p"
fi

# "cat" cloning
if command -v "eza" >/dev/null 2>&1; then
    alias ls="eza"
    alias lt='eza -T -L 3 -a -I "node_modules|.git|.cache|.venv"'
    alias ltl='eza -T -L 3 -a -I "node_modules|.git|.cache|.venv" -l'
fi

# adding git syntax sugar
if command -v "hub" >/dev/null 2>&1; then
    eval "$(hub alias -s)"
fi

# "diff" cloning & unified format: -u
if command -v "colordiff" >/dev/null 2>&1; then
    alias diff="colordiff -u"
else
    alias diff="diff -u"
fi

# history preserved yazi command
if command -v "yazi" >/dev/null 2>&1; then
    function y() {
        local tmp cwd
        tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
        command yazi "$@" --cwd-file="$tmp"
        IFS= read -r -d '' cwd < "$tmp"
        if [ "$cwd" != "$PWD" ] && [ -d "$cwd" ]; then
            builtin cd -- "$cwd" || return
        fi
        rm -f -- "$tmp"
    }
fi

# `chezmoi cd` that keeps the current shell session
if command -v "chezmoi" >/dev/null 2>&1; then
    function ccd() {
        cd {{ .chezmoi.workingTree | squote }} || return
    }
fi

#----------------#
# original alias #
#----------------#

alias up="cd .."
alias upp="cd ../.."
alias uppp="cd ../../.."

alias ll="ls -l"
alias la="ls -a"
alias lla="ls -la"
alias lal="ls -al"
alias lt="ls --tree"

# count the number of characters
alias wcc="pbpaste | wc -m"
# clear format
alias fcr="pbpaste | pbcopy"

alias search="find . -type f -print0 | xargs -0 grep -n"

#--------------------#
# original functions #
#--------------------#

# Search and Move to The Directory
# see http://www.rickynews.com/blog/2014/07/19/useful-bash-aliases/
# see http://rksz.hateblo.jp/entry/2014/10/27/201939
function jcd() {
    if [[ "$1" ]]; then
        JUMPDIR=$(find . -type d -maxdepth 1 | grep "$1" | tail -1)
        if [[ -d $JUMPDIR && -n $JUMPDIR ]]; then
            cd "$JUMPDIR" || return
        else
            echo "directory not found"
        fi
    fi
}

# Remove empty directries up to 2 levels
# see http://www.rickynews.com/blog/2014/07/19/useful-bash-aliases/
function cleanup() {
    find . -type d -maxdepth 2 -empty -exec rmdir -v {} \; 2>/dev/null
    find . -type d -maxdepth 2 -empty -exec rmdir -v {} \; 2>/dev/null
}

# see http://www.rickynews.com/blog/2014/07/19/useful-bash-aliases/
function sha1() {
    echo -n "$1" | openssl sha1 | sed "s/^.* //"
}

#-----------#
# functions #
#-----------#

# 大きめの関数は functions/ に分けている (archive: extract / zpack / zunpack, cpp: runcpp)
for _shellrc_fn in archive cpp; do
    # shellcheck source=/dev/null
    source "${HOME}/.config/shell/functions/${_shellrc_fn}.sh"
done
unset _shellrc_fn
