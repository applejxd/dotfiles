# see https://www.chezmoi.io/reference/special-files/chezmoiignore/

# OS dependent modules
{{ if eq .chezmoi.os "windows" }}
# Unix のみ
.chezmoiscripts/000_unix/
.chezmoiscripts/000_unix/**
.config/
.config/**
.config/tmuxinator/
.config/tmuxinator/**
.bash_profile
.bashrc
.gdbinit
.profile
.tmux.conf
.Xmodmap
.xsession
.xsessionrc
.zshenv
.zshrc
{{- else }}
# windows のみで導入
.chezmoiscripts/300_windows/
.chezmoiscripts/300_windows/**
.wslconfig
AppData/
AppData/**
Documents/
Documents/**
{{- end }}

{{- if ne .chezmoi.os "darwin" }}
# Mac OS X のみ
.chezmoiscripts/200_mac/
.chezmoiscripts/200_mac/**
.config/shell/osxenv.sh
.config/shell/osxrc.sh
.mackup.cfg
{{- end }}

{{- if eq .chezmoi.os "linux" }}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
.chezmoiscripts/100_linux/110_native/
.chezmoiscripts/100_linux/110_native/**
{{-   else }}
# WSL のみで導入
.chezmoiscripts/100_linux/190_wsl.sh
.config/shell/wslenv.sh
{{-   end }}
{{- else }}
# Linux のみで導入
.chezmoiscripts/100_linux/
.chezmoiscripts/100_linux/**
{{- end }}

{{- if ne .chezmoi.username "applejxd" }}
# 個人 PC のみで導入
.config/sops/age/keys.txt
.vscode-server/
.vscode-server/**
{{- end }}

{{- if and (eq .chezmoi.username "applejxd") (not (lookPath "bw")) }}
# applejxd ユーザで bw コマンドがない場合は bitwarden セクションをスキップ
.config/sops/age/keys.txt
{{- end }}

# 以下は一度のみコピー・復号
# (毎回 Bitwarden を引くと chezmoi diff がマスターパスワードを要求するため)

{{- if (stat (joinPath .chezmoi.homeDir ".config/sops/age/keys.txt")) }}
.config/sops/age/keys.txt
{{- end }}

{{- if (stat (joinPath .chezmoi.homeDir ".gitconfig")) }}
.gitconfig
{{- end }}

# Python bytecode (generated at runtime, not part of dotfiles)
**/__pycache__
**/__pycache__/**
**/*.pyc
