#!/bin/bash

set -euo pipefail

{{ template "sudo-keepalive.sh.tmpl" . }}
start_sudo_keepalive

echo "WSL の設定を行います..."

conf=/etc/wsl.conf
new="$(mktemp)"
cur="$(mktemp)"
trap 'rm -f "$new" "$cur"' EXIT

# WSL config
cat > "$new" << 'EOF'
[automount]
options = "metadata"
enabled = true
# see docs/spec/platform-wsl.md#wsl
mountFsTab = false

[interop]
enabled = true
appendWindowsPath = false

[boot]
systemd=true

[user]
default={{ .chezmoi.username }}
EOF

# 既存の内容は昇格して一度だけ読む (読めないときは set -e で止め、不一致と取り違えない)
has_conf=false
if [[ -e "$conf" ]]; then
    sudo cat "$conf" | tee "$cur" > /dev/null
    has_conf=true
fi

# 隔離ディストロ ([automount] enabled=false) では書き換えない
# see docs/spec/sandbox/wsl-sandbox.md
if $has_conf && awk '
    /^\[automount\]/ { s = 1; next }
    /^\[/ { s = 0 }
    s && tolower($0) ~ /^[ \t]*enabled[ \t]*=[ \t]*false[ \t\r]*(#.*)?$/ { found = 1 }
    END { exit !found }
' "$cur"; then
    echo "⚠️ $conf は automount が無効 (隔離ディストロ) なので、書き換えずに飛ばします" >&2
    exit 0
fi

# 内容が変わるときだけ、退避と差分の表示をしてから書き換える
if $has_conf && ! cmp -s "$cur" "$new"; then
    # 同名の退避を上書きしないよう、一意な名前を確保してから中身を写す
    backup="$(sudo mktemp "$conf.bak.$(date +%Y%m%d-%H%M%S).XXXXXX")"
    sudo cp -p "$conf" "$backup"
    echo "既存の $conf を $backup に退避しました。差分:"
    diff -u --label "$conf" --label "新しい内容" "$cur" "$new" || true
fi

if ! $has_conf || ! cmp -s "$cur" "$new"; then
    sudo install -m 644 "$new" "$conf"
fi

# Ubuntu 24.04 以前は systemd-timesyncd が既定で有効で、WSL の Hyper-V 時刻同期と干渉して
# adjtimex の tick が偏り、単調時計が遅れる (Canonical は無効化を推奨)。止めて mask する
# see docs/spec/platform-wsl.md#wsl-の時刻同期
if [[ -d /run/systemd/system ]] && systemctl cat systemd-timesyncd.service > /dev/null 2>&1 \
    && [[ "$(systemctl is-enabled systemd-timesyncd.service 2> /dev/null || true)" != masked ]]; then
    sudo systemctl mask --now systemd-timesyncd.service
    echo "systemd-timesyncd を止めて mask しました (WSL は Hyper-V の時刻同期に任せます)"
fi

# timesyncd を止めても、すでに偏った tick は誰かが戻すまで残る。標準値からずれていれば戻す (再起動でも戻る)
if [[ -d /run/systemd/system ]]; then
    sudo python3 - << 'PY'
import ctypes
import os

ADJ_TICK = 0x4000


class Timex(ctypes.Structure):
    _fields_ = [
        ("modes", ctypes.c_uint), ("offset", ctypes.c_long), ("freq", ctypes.c_long),
        ("maxerror", ctypes.c_long), ("esterror", ctypes.c_long), ("status", ctypes.c_int),
        ("constant", ctypes.c_long), ("precision", ctypes.c_long), ("tolerance", ctypes.c_long),
        ("time_sec", ctypes.c_long), ("time_usec", ctypes.c_long), ("tick", ctypes.c_long),
        ("ppsfreq", ctypes.c_long), ("jitter", ctypes.c_long), ("shift", ctypes.c_int),
        ("stabil", ctypes.c_long), ("jitcnt", ctypes.c_long), ("calcnt", ctypes.c_long),
        ("errcnt", ctypes.c_long), ("stbcnt", ctypes.c_long), ("tai", ctypes.c_int),
        ("pad", ctypes.c_int * 11),
    ]


libc = ctypes.CDLL(None, use_errno=True)
nominal = round(1_000_000 / os.sysconf("SC_CLK_TCK"))
current = Timex()
if libc.adjtimex(ctypes.byref(current)) >= 0 and current.tick != nominal:
    change = Timex()
    change.modes = ADJ_TICK
    change.tick = nominal
    if libc.adjtimex(ctypes.byref(change)) >= 0:
        print(f"adjtimex の tick を {current.tick} から {nominal} へ戻しました")
PY
fi

echo "✅ 完了：WSL の設定を行いました"
