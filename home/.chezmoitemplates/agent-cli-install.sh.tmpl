{{- /*
pi を公式のインストーラーで導入する。
呼び出し側は 100_linux / 200_mac の run_onchange_after_ スクリプト。
共有するのは本体だけで、呼び出し側が shebang と set -eu を置く。
*/ -}}
{{ template "retry-marker.sh.tmpl" (dict "homeDir" .chezmoi.homeDir "name" "agent-cli-failed") }}

# 既に入っているものは触らない。更新は pi update (手動)。
PATH="${HOME}/.local/bin:${HOME}/bin:${PATH}"
export PATH

mise_root="${HOME}/.local/share/mise"

# 版を解決できない mise の shim は「mise use -g で global default version を指定しろ」と言って止まり、
# 残骸 shim は実体が無くても command -v を満たす。そのまま「導入済み」と判定すると公式版の導入が
# 永久にスキップされるので、shim は数えない。
# see docs/spec/troubleshooting-bootstrap.md#ai-cli-が-mise-に-global-default-version-を指定しろと言う
is_installed() {
    resolved=$(command -v "$1" 2>/dev/null) || return 1
    case "${resolved}" in
        "${mise_root}/shims/"*) return 1 ;;
        *) return 0 ;;
    esac
}

# インストーラーは本体を pipe で流し込むので、失敗を個別に受け止められるよう関数に包む。
# Node.js が無いとインストーラーが /dev/tty で導入の可否を聞くので、mise の node が無ければ失敗にする
# (次の apply で走り直す)。標準出力を端末から外すのは、最後の「Start pi now? [Y/n]」を出させないため
install_pi() {
    (
        PATH="${PATH}:${mise_root}/shims"
        command -v node >/dev/null 2>&1 || { echo "node が無い (mise の node が入った後に入れる)" >&2; exit 1; }
        curl -fsSL https://pi.dev/install.sh | sh | cat
    )
}

failed_clis=""

if is_installed pi; then
    echo "pi は導入済みです"
else
    echo "pi を導入します..."
    if install_pi; then
        echo "pi を導入しました"
    else
        echo "⚠️  pi の導入に失敗しました" >&2
        failed_clis="pi"
    fi
fi

if [ -n "${failed_clis}" ]; then
    # ここで非ゼロを返すと apply 全体が止まり、後続のスクリプトまで巻き添えになる。
    # 外部インストーラーの一時的な不調で dotfiles の適用を止めたくないので警告に留め、
    # 印を書き直して次の apply で走り直させる。
    mark_for_retry "${failed_clis}"
    cat >&2 <<'MSG'

⚠️  pi を導入できませんでした。次の chezmoi apply で入っていなければ導入し直します。
    すぐに入れるなら手で入れる:
      curl -fsSL https://pi.dev/install.sh | sh
MSG
    echo "⚠️  完了：pi が入っていません"
else
    echo "✅ 完了：pi を導入しました"
fi
