  "**/.env",
  "**/.env.*",
  "~/.copilot/settings.json",
  "~/.copilot/config.json",
  "~/.claude.json",
  # OpenCode 自身の permission 設定。書けるとエージェントが自分の deny を
  # 外せてしまう ([sandbox] claude_write_deny と同じ趣旨の permission 側の保険)。
  # 正本はこのリポジトリなので、変更は chezmoi apply 経由で入れる。
  "~/.config/opencode/opencode.json",
  "~/.config/opencode/service.json",
  # ocs の状態 ([sandbox] deny と同じ趣旨の permission 側の保険)
  "~/.local/state/opencode-sandbox/**",
  # プロジェクト側の OpenCode 設定。ここに書いた permission は
  # グローバルの deny に勝つ (実測)。書けると自分で権限を広げられる。
  # see docs/research/opencode/permission/gaps.md
  "**/.opencode/opencode.json",
  "**/.opencode/opencode.jsonc",
  # git の設定。diff.<name>.command / core.fsmonitor などに任意コマンドを
  # 書けるため、git diff や git status が実行手段になる (実測)。
  # see docs/research/opencode/permission/allow-list-audit.md
  "**/.git/config",
  "**/.git/hooks/**",
  "~/.gitconfig",
]

# deny の例外 (仕組みと CLI ごとの差は docs/spec/agent-config-generation.md#deny-の例外envexample-など)
# ★TOML の都合で、[file] の他のキーより後ろに置く。
[[file.deny_exceptions]]
deny = "**/.env.*"
except = ["**/.env.example", "**/.env.sample", "**/.env.template"]

# ---------------------------------------------------------------------------
# Web 系
# ---------------------------------------------------------------------------
[web]
# Claude: permissions.allow の WebFetch(domain:...) と
#         sandbox.network.allowedDomains へ展開 (自動承認のみ。ここに無い
#         ドメインを拒否する効果は無い)
# Copilot: settings.json の allowedUrls (sandbox にドメイン単位の制御は無い)
#
# ★sandbox に効く wildcard は **先頭の `*.` と 単独の `*` だけ**。
#   `example.*` は WebFetch には効くが sandbox 側は無視する。
# see docs/spec/agent-sandbox.md 「ネットワーク」
allow_domains = [
  "github.com",
  "api.github.com",
  "docs.github.com",
  "raw.githubusercontent.com",
  "*.githubusercontent.com",
  "hub.docker.com",
  "docs.docker.com",
  "pypi.org",
  "docs.python.org",
  "packaging.python.org",
  "npmjs.com",
  "docs.npmjs.com",
  "registry.npmjs.org",
  "chezmoi.io",
  "www.chezmoi.io",
  "mise.jdx.dev",
  "docs.astral.sh",
  "docs.anthropic.com",
  "docs.claude.com",
  "claude.ai",
  "modelcontextprotocol.io",
  # Pi / oh-my-pi のドキュメント (CHG-0006 で試用中)
  "pi.dev",
  "omp.sh",
  "arxiv.org",
  "alphaxiv.org",
  "stackoverflow.com",
  "dev.to",
  "qiita.com",
  "zenn.dev",
  "pre-commit.com",
]

# Copilot のみ allowedUrls/deniedUrls に反映 (Claude の permissions には
# 対応キーが無い)。ただし Claude でも sandbox.network.deniedDomains には
# 反映される: 広い allowlist wildcard の内側を個別に塞ぐのに使える。
deny_domains = []

# ---------------------------------------------------------------------------
# Sandbox 系 (OS レベルのファイルアクセス制御)
# ---------------------------------------------------------------------------
#
# 両 CLI とも whitelist (deny-by-default)。Claude は denyRead に "~/" を置き、
# allowRead で穴を開けることで Copilot と同じ方式に揃えている。
#
# ★広い名前マッチの glob を deny に置かないこと。Claude の Linux sandbox は
#   deny 対象の各パスに /dev/null を bind-mount するため、コマンド 1 回ごとに
#   数千個の mount が必要になり実用に耐えない (実測値は docs 参照)。
#
# ★パス記法は permission の Read()/Edit() glob とは別物。
#   `~/` で home 相対、`/` で絶対、無印/`./` はプロジェクト相対
#   (user 設定では ~/.claude 基準)。ホーム全体に効かせるなら `~/` を明示する。
#   Copilot は絶対パス限定・ワイルドカード非対応・存在しないパスは無効。
#
# see docs/spec/agent-sandbox.md 「sandbox」
#     https://code.claude.com/docs/en/sandboxing
#     https://docs.github.com/copilot/concepts/agents/copilot-cli/understanding-local-sandboxing
[sandbox]
# 両 CLI 共通: whitelist の内側でも遮断する秘密情報 (read/write 両方)。
# 公式に "Rules that you configure are always kept" とあり、自動付与に勝つ。
# whitelist の穴 (claude_read_allow) の中に秘密がある場合の保険。
deny = [
  "~/.ssh", "~/.gnupg", "~/.config/sops/age", "~/.aws", "~/.netrc",
  "~/.npmrc", "~/.pypirc", "~/.docker/config.json",
  "~/.git-credentials", "~/.config/gh/hosts.yml",
  "~/.config/Bitwarden CLI",
  # chezmoi の age 秘密鍵。下の write 許可 (~/.config/chezmoi) の内側だが
  # より具体的なパスが勝つので遮断される。
  # このリポジトリに encrypted_ ファイルは無いため、塞いでも chezmoi は動く。
  "~/.config/chezmoi/key.txt",
  "~/.claude.json", "~/.copilot/settings.json", "~/.copilot/config.json",
  # OpenCode のサービス認証情報 (password が平文で入る)
  "~/.config/opencode/service.json",
  # ocs の状態 (起動前の退避・境界の定義)。下の write 許可 (~/.local/state) の
  # 内側なので名指しで塞ぐ。Copilot は無いパスの deny を捨てるので、chezmoi が
  # 先に作る (home/dot_local/state)
  # see docs/spec/opencode-sandbox.md#状態の置き場
  "~/.local/state/opencode-sandbox",
  "~/.bash_history", "~/.zsh_history", "~/.python_history",
  "~/.node_repl_history",
  # whitelist の内側に置かれがちなもの (Claude のみ。Copilot は wildcard 不可)
  "~/**/.env", "~/**/id_rsa*", "~/**/id_ed25519*", "~/**/id_ecdsa*",
  "~/**/id_dsa*", "~/**/service-account*.json",
]

# Claude のみ: read は許すが write を禁止する対象 (改竄防止)。
# Claude sandbox の "Protected paths" がほぼ同じ範囲を常時保護しているので、
# これは cwd が $HOME の場合などに備えた多重防御。
# Copilot は deny-by-default で cwd の外に書けないため不要。
claude_write_deny = [
  "~/.claude/hooks", "~/.claude/settings.json", "~/.claude/settings.local.json",
  "~/.copilot/hooks", "~/.copilot/permissions-config.json", "~/.config/agents",
  # OpenCode の global config (permission / MCP の生成先)
  "~/.config/opencode",
  "~/.bashrc", "~/.bash_profile", "~/.bash_login", "~/.profile",
  "~/.zshrc", "~/.zshenv", "~/.zprofile", "~/.cshrc", "~/.kshrc", "~/.login",
  "~/.ssh/authorized_keys", "~/.ssh/known_hosts", "~/.gitconfig",
]

# Claude のみ: whitelist に開ける読み取りの穴。
# Copilot の allowDevToolAccess に相当する仕組みが Claude に無いので手動補償する。
# 上の deny はこの穴の内側でも効く (より具体的なパスが勝つ)。
#
# ★Copilot 側には渡さない。deny-by-default で既に触れないパスを許可することに
#   なり、防御が弱まる。
# ★このマシンでしか使わないパスはここに書かない。chezmoi 管理外の
#   ~/.config/agents/local.toml に [sandbox] claude_read_allow として書く。
# ★実在するパスだけを書く (存在しないパスは bind-mount 失敗の要因になる)。
# see docs/spec/agent-sandbox.md 「このマシンだけで許可を足す」
claude_read_allow = [
  # ツールチェーン (mise / uv / cargo / node / go / TeX)
  "~/.local", "~/.cache", "~/.cargo", "~/.rustup", "~/.nvm", "~/.npm",
  "~/go", "~/.texlive",
  # ツールの設定 (git, gh, mise, nvim 等)。秘密は上の deny で個別に塞ぐ
  "~/.config", "~/.gitconfig",
  # skill 置き場。Copilot も "Personal skill roots" としてこの 2 つだけを
  # read-only 許可している (実測) ので合わせる。
  "~/.claude/skills", "~/.agents/skills",
]

# Claude のみ: cwd + セッション temp 以外に書き込みを許す場所。
# パッケージマネージャがキャッシュを書けないとビルドが失敗するため。
# Copilot 側の同等物は copilot_write_allow (下記)。
claude_write_allow = [
  "~/.cache", "~/.npm", "~/.cargo/registry", "~/.local/share/mise",
  "~/.local/state",
  # uvx が実行のたびに一時環境を作る場所 (copilot_write_allow に同じ)
  "~/.local/share/uv/tools",
  # chezmoi の永続 state (chezmoistate.boltdb)。書けないと
  # `chezmoi managed` / `chezmoi diff` が read-only file system で落ちる。
  # 内側の key.txt は上の deny で塞いである。
  "~/.config/chezmoi",
]

# Copilot のみ: 開発ツールへの許可を明示的に与える。
# allowDevToolAccess を切っている (下記) ので、必要な範囲はここが全て負う。
# 内容は claude_read_allow / claude_write_allow とほぼ同じ。
# ホーム外 (/usr /opt) は Claude では既定で読めるので Copilot にだけ要る。
#
# ★~/.local/share/mise は write に入れない (PATH 上のツールを差し替えられる)。
# see docs/adr/0008-explicit-dev-tool-grants.md
copilot_read_allow = [
  # ツールチェーン。~/.local は bin (mise 本体) / share/mise / share/uv を含む
  # ★~/.cache と ~/.npm はここに書かない。下の copilot_write_allow と
  #   同一パスになり RO 側に潰される (下記の注記)。
  "~/.local", "~/.cargo", "~/.rustup", "~/.nvm",
  "~/go", "~/.texlive",
  # ツールの設定。秘密は上の deny で個別に塞ぐ
  "~/.config", "~/.gitconfig",
  # ホーム外 (Claude は denyRead が "~/" 配下だけなので元から読める)
  "/usr/include",               # システムヘッダ
  "/usr/local",                 # include / lib / share / cuda をまとめて
  "/usr/src",                   # カーネルヘッダ (DKMS, CUDA ドライバ)
  "/opt",                       # サードパーティのツールチェーン
]

# ★read と write に **同じパス** を書いてはいけない。同一パスの RO/RW 競合は
#   RO へ解決され、write 指定が無言で消える。書きたい場所は write だけに書く
#   (write は read を含む)。generate.py が重複を検出して apply を止める。
#   親子関係 (~/.local と ~/.local/state 等) は具体的な方が勝つので問題ない。
copilot_write_allow = [
  # パッケージマネージャのキャッシュ。書けないとビルドが毎回やり直しになる
  # (~/.cache/uv / ~/.cache/pre-commit / ~/.cache/go-build を含む)
  "~/.cache", "~/.npm", "~/.cargo/registry", "~/.local/state",
  # uvx が実行のたびに一時環境を作る場所。RO だと pre-commit の uvx hook
  # (ruff / yamllint) が os error 30 で落ちる。PATH には載らない。
  "~/.local/share/uv/tools",
  # chezmoi の永続 state。書けないと `chezmoi managed` / `diff` が落ちる。
  # 内側の key.txt は上の deny で塞いである。
  "~/.config/chezmoi",
]

# Copilot のみ: PATH やキャッシュの自動 read-only 付与を切る。
# 上の copilot_read_allow / copilot_write_allow で明示的に置き換える。
copilot_allow_dev_tool_access = false

# Copilot 側の deniedPaths は上の `deny` から自動導出する。
# ワイルドカードを含むものは除外される (Copilot は非対応)。
# 存在しないパスの deny は黙って無効化されるが、後で作られたときに効くよう
# `deny` には残してある。
# see docs/spec/agent-sandbox.md 「sandbox」
#
# なお ~/.ssh を denied にすると git over SSH は使えなくなるが、
# sandbox の auth.git / auth.gh が GitHub へのトークンを注入するため
# HTTPS 経由の git / gh は sandbox 内でも動作する。

# Claude のみ: sandbox のネットワークを whitelist (deny-by-default) にする。
# true にすると許可外ドメインは承認プロンプトではなく **拒否** される。
# Claude Code v2.1.219 以降が必要。
#
# Copilot にはドメイン単位の制御が無く (allowOutbound の on/off だけ)、
# outbound は全ドメイン許可のままなので、この設定は Claude 専用。
# `allowedUrls` は「プロンプトを省略する URL」であって通信制限ではない。
claude_network_strict = true

# shell が実際に通信する先 (パッケージ配布 CDN 等) の許可。
# **Claude の sandbox と OpenCode の境界の両方**に効く (Copilot にはドメイン
# 単位の制御が無いので効かない)。
# [web] allow_domains (WebFetch 用のドキュメントサイト) と合算される。
# 混ぜると CDN が WebFetch で自動承認されるので分けている。
# 不足しても破綻はせず「sandbox 外での再実行を求める承認」に落ちる。
shell_network_allow = [
  # Python (uv / pip): pypi.org はメタデータ、実体は files.pythonhosted.org
  "files.pythonhosted.org",
  # GitHub: git clone / リリース資産のダウンロード
  # (objects.githubusercontent.com は [web] の *.githubusercontent.com で拾う)
  "codeload.github.com",
  # Rust (cargo)
  "crates.io", "static.crates.io", "index.crates.io",
  # Go modules
  "proxy.golang.org", "sum.golang.org",
  # Deno / JSR
  "deno.land", "jsr.io",
  # mise のバージョン一覧
  "mise-versions.jdx.dev",
]

# Claude のみ: sandbox が使う seccomp フィルタ (apply-seccomp) のパス。
# Claude は npm のグローバル領域しか自動検出しないが、このリポジトリは mise で
# 入れるので、公式の代替手段 (settings.json でパスを直接指す) で橋渡しする。
# {arch} は generate.py が x64 / arm64 に置換する。パスが無いマシンでは
# 設定を出力しないので、共有の common.toml に書いても他環境を壊さない。
# see docs/spec/agent-sandbox.md 「seccomp」
seccomp_apply_path = "~/.local/share/mise/installs/npm-anthropic-ai-sandbox-runtime/latest/node_modules/@anthropic-ai/sandbox-runtime/vendor/seccomp/{arch}/apply-seccomp"

# ---------------------------------------------------------------------------
# プロバイダ (モデル API の接続先)
# ---------------------------------------------------------------------------
# ★ハーネスから切り離す。 境界内からモデルへ到達できないとハーネスは動かないが、
#   その接続先は「どのハーネスか」ではなく「どのプロバイダを使うか」で決まる。
#   ハーネス側に書くと、同じプロバイダを使う別ハーネスを足すたびに同じドメインを
#   書き直すことになる (ハーネス × プロバイダで増殖する)。
#
# 使う側は providers = ["github-copilot", ...] で参照する。
# 不足すると proxy が CONNECT を 403 で落とすだけなので、症状は
# 「応答が来ない」になる。
# see docs/change/0007-harness-profiles.md

[provider.github-copilot]
network_allow = ["api.githubcopilot.com", "*.githubcopilot.com"]

[provider.anthropic]
network_allow = ["api.anthropic.com"]

[provider.openai]
network_allow = ["api.openai.com"]

# ★profile が無いと Bedrock が有効にならない。network_allow は region と揃える。
# see docs/spec/agent-config-generation.md#モデルの割り当て
[provider.amazon-bedrock]
profile = "default"
region = "us-east-1"
network_allow = ["bedrock-runtime.us-east-1.amazonaws.com"]

# ---------------------------------------------------------------------------
# Claude 固有
# ---------------------------------------------------------------------------
[claude]
# CLI 側のバックグラウンド更新を止める (本体は公式インストーラーで導入)。
# settings.json の env.DISABLE_AUTOUPDATER="1" へ変換する。
auto_update = false

# 新規セッションの権限モード。default / acceptEdits / auto / dontAsk /
# bypassPermissions から選ぶ。ask / deny と hook はどのモードでも効く。
# 出典: https://code.claude.com/docs/en/permission-modes
default_permission_mode = "auto"

mcp_deny = [
  "mcp__supabase__execute_sql",
]

# ---------------------------------------------------------------------------
# Copilot 固有
# ---------------------------------------------------------------------------
[copilot]
# settings.json の autoUpdate へ反映。本体は公式インストーラー (Unix は
# gh.io/copilot-install、Windows は winget) で更新する。
auto_update = false

# settings.json の model へ反映 (新規セッションの既定モデル)
model = "claude-opus-5.5"

# Copilot が作成するコミットへ Co-authored-by trailer を追加しない
include_co_authored_by = false

# 新規対話セッションの権限モード。manual / assisted / allow-all から選ぶ。
# 再開セッション・非対話実行では無視される。
# 出典: `copilot help config` (ローカル CLI が権威ある一覧を持つ)
default_permission_mode = "assisted"
# assisted は experimental な auto-approval 機能に依存する
experimental = true

# settings.json の trustedFolders へ反映
trusted_folders = [
  "~/.local/share/chezmoi",
  "~/sandbox",
  "~/src/my-agent-core",
  "~/src/apple-agent-core",
]

# settings.json の enabledPlugins へ反映 (書いたキーだけを上書きし、
# ここに無いプラグインはユーザーの設定をそのまま残す)。
#
# document-skills と example-skills は中身が同一で、両方有効にすると
# 17 スキルが二重登録される。実際に使われている方だけを残す。
[copilot.enabled_plugins]
"document-skills@anthropic-agent-skills" = true
"example-skills@anthropic-agent-skills" = false

# permissions-config.json の locations へ反映
# 各 location の approvals に bash.allow 由来の commands も自動追加される
[[copilot.locations]]
path = "~/.local/share/chezmoi"
approvals = [
  { kind = "write" },
]

# ---------------------------------------------------------------------------
# pi と OpenCode が共有する節 ([pi] が正本)
# ---------------------------------------------------------------------------
# pi のハーネスの判定器が読む。OpenCode へは generate.py が同じ値を [opencode.*] の位置へ写す
# (CHG-0020 の段 6 で OpenCode を撤去するまで)。[opencode.*] 側に同じキーを書くと生成が止まる。
# see docs/spec/agent-config-generation.md#pi-と共有する節

# 無確認で実行してよい shell コマンド ([bash] allow とは共用しない。前提が違う)。
# ここに載せたものだけが無確認で実行される。任意コード実行を含むものは載せない。
# ★リダイレクトは resource に残ったまま前方一致するので、載せたコマンドは
#   すべて `> path` による任意書き込みの手段にもなる (実測)。
# see docs/research/opencode/permission/allow-list-audit.md
[pi.shell]
allow = [
  "git log",
  "wc",
  "grep -n",
  "uv pip list",
  "docker ps",
]

# shell 出力の伏字化。誘導と結果フィルタを抜けて shell を通ったものへの安全網。
# ★境界ではない。base64 や tr で変換されるとすり抜ける (実測)。事故と素朴な
#   プロンプトインジェクションを想定した層で、意図的な持ち出しは止まらない。
# ★shell の出力にだけ掛ける。read / grep へ広げないこと。伏せた本文を元に
#   edit されると、ファイルへ [伏字:…] がそのまま書き込まれる。
# see docs/research/opencode/permission/output-filter-and-subagents.md
[pi.redact]
enabled = true
# 保護対象のパスを参照したコマンドは、出力全体を伏せる。
# 判定表は [file] read_deny_globs から生成する。
# ★`**/*secret*` のような部分一致 glob は自動で除かれる。コマンドには
#   docs/spec/secret-handling.md のような正当なパスも載るため。
deny_path_output = true
# 出力全体を伏せる判定の除外。pattern ではなくコマンド全体に当てる。
# ★保護パス名を「文章として」書いたときの誤爆を外すためのもの。
#   git commit -m '… ~/.claude.json …' で出力が丸ごと消えるのを防ぐ。
# ★`git commit -m x && cat ~/.ssh/id_rsa` のような連結は素通りする。
#   そこは誘導 (cat の deny) が受け持つ。伏字化は境界ではない。
deny_path_unless = '(^|&&|;|\n)\s*(git|gh)\s[^\n]*\s-{1,2}(m|am|message|body|title)[\s=]'

# 内容の形で伏せるもの。pattern は JavaScript の正規表現で、
# **大文字小文字を区別せず**当てる (GITHUB_TOKEN と github_token を分けない)。
# ★当たった範囲がそのまま置き換わる。値だけに当てること。前置きの語は
#   後読み `(?<=…)` で外に出す。
[[pi.redact.rule]]
name = "秘密鍵"
pattern = '-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z ]*PRIVATE KEY-----'

[[pi.redact.rule]]
name = "age 秘密鍵"
pattern = 'AGE-SECRET-KEY-1[0-9A-Z]{50,}'

[[pi.redact.rule]]
name = "AWS アクセスキー"
pattern = '\b(AKIA|ASIA)[0-9A-Z]{16}\b'

[[pi.redact.rule]]
name = "GitHub トークン"
pattern = '\bgh[pousr]_[A-Za-z0-9]{30,}\b'

[[pi.redact.rule]]
name = "Slack トークン"
pattern = '\bxox[abprs]-[A-Za-z0-9-]{10,}\b'

[[pi.redact.rule]]
name = "API キー"
pattern = '\bsk-[A-Za-z0-9_-]{20,}\b'

[[pi.redact.rule]]
name = "Google API キー"
pattern = '\bAIza[0-9A-Za-z_-]{35}\b'

[[pi.redact.rule]]
name = "JWT"
pattern = '\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}'

# 代入の形。値が「不透明な長い文字列」か「引用符で囲まれたもの」のときだけ
# 伏せる。★これを緩めると `const token = getToken()` のような**コード**まで
# 伏字になり、shell 経由の grep が読めなくなる。
[[pi.redact.rule]]
name = "代入された秘密"
pattern = '''(?<=(password|passwd|secret|token|api[_-]?key|access[_-]?key|client[_-]?secret)["']?\s*[=:]\s*)("[^"\n]{6,}"|'[^'\n]{6,}'|[A-Za-z0-9_\-+/=.]{16,})'''

# 作業ツリーの外でも external_directory の確認なしに読める場所 (スキルの置き場)。
# [opencode.sandbox] work_read も足される。edit は確認のまま。
# see docs/spec/agent-config-generation.md#作業ツリーの外の読み取り
[pi.external_read]
paths = [
  "~/.claude/skills",
  "~/.agents/skills",
  "~/.config/opencode/skills",
]

# 確認なしに実行してよいスキルのスクリプト。[pi.external_read] paths の中に限る。
# ★引数で書き込み先や実行するものを決められる形は載せない (exact で引数を固定する)。
# ★runner に `uv run --no-project python` を足さないこと。作業ツリーの
#   .python-version に書かれた実行ファイルを起動する (実測)。
# see docs/spec/agent-config-generation.md#スキルのスクリプト
[pi.skill_scripts]
runners = { py = ["python3"], sh = ["bash"] }
redirect_message = "スキルのスクリプトにはリダイレクト (> / >> / < / 2>&1 など) を付けずに呼んでください。stdout も stderr もそのまま返ります。ファイルへ書くときは write ツールを使ってください。"

[[pi.skill_scripts.allow]]
script = "~/.claude/skills/sdd-docs/scripts/lint_docs.py"

[[pi.skill_scripts.allow]]
script = "~/.claude/skills/sdd-docs/scripts/check_refs.py"
# --save は引数のパスへ書く。既定の置き場を使う形だけを完全一致で通す
exact = ["--save", "--baseline"]

[[pi.skill_scripts.allow]]
script = "~/.config/opencode/skills/checkpoint/scripts/checkpoint.py"
# write は標準入力を引数のパスへ書くので載せない
subcommands = ["paths", "lint", "read"]

# 誘導 (deny と案内)。pi の判定器と OpenCode の guide plugin の両方が使う。
# id で OpenCode の [[opencode.shell.guide]] の並びへ差し込む (pi = "<id>")。
# pattern / unless は Python と JavaScript の両方で同じ意味になる正規表現だけを書く。
# see docs/spec/pi-decide.md#誘導

# 読み取りを read ツールへ寄せる。目的は確認回数ではなく保護で、
# shell 経由では read の deny が効かないため。
# ★パイプ・リダイレクトを含む形は除外する。read で代替できないので
#   deny すると作業が止まるだけになる。head -c / tail -f も同様。
[[pi.guide]]
id = "read-cat-head-tail"
pattern = '(^|&&|;|\n)\s*(cat|head|tail)\s'
unless = '[|<>]|\s-{1,2}(c|f|bytes|follow)\b'
message = "cat / head / tail でファイルを読まないでください。read ツールを使ってください (offset と limit で範囲を指定できます)。"

[[pi.guide]]
id = "read-sed-n"
pattern = '(^|&&|;|\n)\s*sed\s+-n\s'
unless = '[|<>]'
message = "sed -n でファイルを読まないでください。read ツールを使ってください (offset と limit で範囲を指定できます)。"

# ヒアドキュメントを write ツールへ寄せる。目的は確認 1 回あたりの負担で、
# 実履歴ではヒアドキュメント付きが 177 件 (16.9%)・中央値 1,012 字だった。
# 読めない長文を形式的に承認するより、1 行の確認 + 差分で見せるほうがよい。
# 保護にもなる: `python3 - <<PY` で書く経路には edit の deny が効かない。
# ★`<<<` (here-string) は 1 行なので対象外。`[^<]` で除いている。
# ★末尾に改行を要求する。これが無いと `echo 'a << b'` のようなクォート内の
#   `<<` まで当たる。本物のヒアドキュメントは必ず本文と終端行が続く。
# ★unless は git / gh のメッセージ指定を外す。ヒアドキュメントの例を
#   コミットメッセージに書いただけで deny される誤爆を実地で踏んだ。
#   連結 (`git commit -m x && cat > f <<EOF`) は素通りする。伏字化の
#   deny_path_unless と同じ割り切り。
# ★実履歴ではヒアドキュメント行にパイプが続く例が 0 件。代替は塞がらない。
# see docs/change/closed/0002-opencode-ask-by-default.md 「段階 3」
[[pi.guide]]
id = "write-cat-tee-heredoc"
pattern = '(^|&&|;|\n)\s*(cat\s*>>?\s*\S+|tee\s+(-a\s+)?\S+)\s*<<'
unless = '(^|&&|;|\n)\s*(git|gh)\s[^\n]*\s-{1,2}(m|am|message|body|title)[\s=]'
message = "cat > file や tee でファイルを作らないでください。write ツールを使ってください (差分が見えるうえ、edit の permission が効きます)。"

[[pi.guide]]
id = "write-heredoc-script"
pattern = '''(^|[^<])<<-?\s*["']?\w+["']?[^\n]*\n'''
unless = '(^|&&|;|\n)\s*(git|gh)\s[^\n]*\s-{1,2}(m|am|message|body|title)[\s=]'
message = "ヒアドキュメントでスクリプトを渡さないでください。write ツールでファイルに書いてから実行してください (確認画面が 1 行になり、中身は差分で見えます)。"

# ~/.pi/agent/settings.json へ出す設定。ここに書いたキーは生成器の持ち物で、消すと settings.json からも消える。
# 書けるキー: defaultThinkingLevel / skills / enabledModels。既定のモデルは [opencode.model] の default 階層。
# see docs/spec/pi-harness.md#pi-の設定
[pi.settings]
defaultThinkingLevel = "high"
skills = ["~/.claude/skills"]

# pi を Fence で囲うときの追加分 (境界のそのほかのキーは [opencode.sandbox] を共有する。
# 段 6 で OpenCode を撤去するときに、共有キーをここへ移す)。pis --boundary が使う。
# ★read の ~/.config/agents は判定器 (decide.py) が common.toml を読むために要る。書き込みは開けない。
# ★protected は、dotfiles のリポジトリを作業ツリーにしたときに書き込みを塞ぐ相対パス。
# see docs/spec/pi-harness.md#境界
[pi.sandbox]
read = [
  "~/bin",
  "~/.pi/agent/install",
  "~/.pi/agent/bin",
  "~/.config/pi/harness",
  "~/.config/agents",
  "~/.claude/hooks",
]
control_dirs = [
  "~/.config/pi",
  "~/.pi",
  "~/.claude/hooks",
  "~/.local/share/pi-sandbox",
]
protected = [
  "home/dot_config/pi",
  "home/dot_claude/hooks",
  "home/dot_pi",
]

# pi のプロンプトテンプレート (~/.pi/agent/prompts/<名前>.md になり、/<名前> で呼ぶ)。
# 文面は pi のツール (guarded_task) に合わせてある。[opencode.commands] とは別 (段 6 で OpenCode 側を消す)。
# $ARGUMENTS は呼び出しの引数全部。
# see docs/spec/pi-harness.md#fleet
[pi.commands.fleet]
description = "依頼を並列に動かせる作業に分け、作業役 (worker) を同時に起動して進める"
argument_hint = "<依頼>"
template = """
次の依頼を、並列に動かせる小さな作業に分けて進めてください。あなたは取りまとめ役です。

依頼:
$ARGUMENTS

手順:

1. 必要なら先にコードを読み、依頼を作業に分ける。各作業について、目的・担当ファイル・
   完了条件・確認方法を決める。担当ファイルは作業どうしで重ねない
2. 作業の依存関係を決め、同時に動かせる組 (波) に分ける。1 つの波は 4 件まで。
   分ける価値が無い小さな依頼なら、分けずに自分で進める
3. 作業の一覧・波・担当ファイルを示してから始める
4. 波ごとに、各作業を 1 回の応答の中で guarded_task ツールを並べて、agent を worker にして渡す
   (並べて呼んだ子は同時に走り、全部が終わると結果がそろって返る)。
   今あるファイルの探索は explore、第三者の検証は review に任せてよい。
   guarded_task が無い役割 (reader など) のときは、調査だけの依頼なら自分で読み、実装を含む依頼なら
   計画を示すところで止めて、役割の切り替え (pis --role implementer) を利用者に頼む。
   子の結果が blocked (承認待ちで未完了) なら、その操作を利用者に示して判断を仰ぐ。
   拒否された作業を自分の shell で肩代わりしない。
   依頼文には、目的・担当ファイル・触ってはいけないファイル・完了条件・確認方法を
   すべて書く (子エージェントはこの会話を見られない)
5. 結果を読み、失敗・担当外の変更・報告された問題 (呼び出し元への影響を含む) があれば、
   直すか作業を切り直してから次の波へ進む
6. 最後に全体の差分を読み、リポジトリで定められた検証を実行し、作業ごとの結果・
   検証の結果・残った問題をまとめて報告する。コミットはしない
"""

# ~/.pi/agent/keybindings.json の中身そのもの (ファイルごと生成器の持ち物。手で足したキーは次の apply で消える)。
# 操作の ID と既定は pi の /hotkeys と docs/keybindings.md。空の配列はその操作の割り当てを外す。
# ★app.clear (既定は Ctrl+C) を外さないと、Ctrl+C を app.interrupt へ足しても入力の消去が先に効く。
[pi.keybinds]
"app.interrupt" = ["escape", "ctrl+c"]
"app.clear" = []
"app.exit" = "ctrl+d"

# pi の判定器の役割 (プロファイル)。判定器の `role` に名前を渡す。pi だけが読む。
# tools に無いツールは deny。default は、どの規則にも当たらない操作の扱い。
# ★評価の順番は判定器のコードに固定してある (この並びに意味は無い)。
# see docs/spec/pi-decide.md
# shell_allow を書くと、その役割では [pi.shell] allow の代わりにそれを使う。
# shell_deny はその役割だけの禁止 (bypass でも外れない)。
# task は子エージェントの起動 ([pi.agents])。子は同じ判定器で動く。
# 末尾が * の項目は前方一致。mcp__* は MCP のツール全部 (規則が無いので既定の扱いになる)。
[pi.profiles.implementer]
tools = ["bash", "read", "edit", "write", "grep", "find", "ls", "task", "mcp__*"]
default = "ask"

[pi.profiles.reader]
tools = ["read", "grep", "find", "ls"]
default = "deny"

# コミットの計画役。読むだけで、git の状態の把握だけを確認なしで通す。
# ★git status / git diff は .git/config 経由でコマンドを起動しうる。全体の [pi.shell] allow には載せない
# see docs/spec/agent-config-generation.md#コミットの確認
[pi.profiles.committer]
tools = ["bash", "read", "grep", "find", "ls"]
default = "deny"
shell_allow = [
  "git status",
  "git diff",
  "git log",
  "git branch --show-current",
  "git rev-parse --show-toplevel",
]
# 計画を返すだけなので、git の状態を変える操作は bypass でも通さない
shell_deny = [
  "git add",
  "git commit",
  "git stash",
  "git checkout",
  "git switch",
  "git restore",
  "git reset",
]

# 並列作業などの作業役。実装役と同じだが、git の状態を変える操作を禁じる (作業ツリーを共有するため)。
[pi.profiles.worker]
tools = ["bash", "read", "edit", "write", "grep", "find", "ls"]
default = "ask"
shell_deny = [
  "git add",
  "git commit",
  "git stash",
  "git checkout",
  "git switch",
  "git restore",
  "git reset",
]

# 子エージェント。親の guarded_task ツールから起動する (子からさらに子は起動できない)。
# profile は [pi.profiles] の名前、tier は [opencode.model.tier.*] の階層 (無ければ親と同じモデル)。
# inherit_bypass = true なら、親が bypass のとき子も bypass で動く (ask を allow にする)。
# ★ask に git commit などが残る役割 (committer) には付けない
# see docs/spec/pi-harness.md#子エージェント
[pi.agents.explore]
profile = "reader"
inherit_bypass = true
description = "読み取り専用の探索役。今あるファイルを探して読み、要点を返す。shell は使えない"
system = """
あなたは読み取り専用の探索役です。親から依頼された調査を、ファイルを探して読むことで行い、
見つけたことを根拠のパスと行とともに簡潔に返します。ファイルは編集しません。
Git の履歴やコマンドの実行が要る調査は、できないことを書いて親へ返します。
"""

[pi.agents.review]
profile = "reader"
tier = "second_opinion"
inherit_bypass = true
description = "別系統のモデルで、設計案・差分・調査結果の欠陥を指摘する。読むだけ。差分は依頼文に含めて渡す"
system = """
あなたはレビュー役です。依頼文の対象 (設計案・差分・調査結果) を読み、欠陥・見落とし・誤りを
重大度 (BLOCKER / MAJOR / MINOR) と根拠付きで指摘します。修正はしません。確信が無いものは
「未確認」と書きます。
"""

[pi.agents.commit]
profile = "committer"
tier = "routine"
description = "変更を読み、論理単位ごとの対象ファイルとコミットメッセージ全文 (計画) を返す。ステージもコミットもしない"
system = """
あなたはコミットの計画係です。git status / git diff / git log で変更を読み、commit スキルの
書式に従って、ファイル単位の論理単位ごとに対象のパスとメッセージの全文を返します。
ステージもコミットもしません。shell は 1 回に 1 コマンドで、連結やリダイレクトを付けません。
"""

[pi.agents.worker]
profile = "worker"
tier = "worker"
inherit_bypass = true
description = "割り当てられた 1 つの作業を、指定された担当ファイルの範囲で実装して確かめ、結果を返す。コミットはしない"
system = """
あなたは作業役です。依頼された 1 つの作業を、担当ファイルの範囲で実装し、確認方法を実行して
結果を返します。担当外のファイルは変えず、git の状態を変える操作 (add / commit / stash /
checkout / switch / restore / reset) はしません。既存の振る舞いを変えたら呼び出し元を探して読み、
影響を報告に書きます。
"""

# ---------------------------------------------------------------------------
# OpenCode 固有
# ---------------------------------------------------------------------------
[opencode]
# opencode.json の update へ反映 ("disable" / "notify")。本体は公式
# インストーラーで導入し、更新は `opencode upgrade` を明示的に実行する。
auto_update = false
{{- if eq (includeTemplate "llm-provider" .) "amazon-bedrock" }}

# opencode.json の websearch へ反映。検索は [[mcp]] の agentcore-websearch に一本化する。
websearch = false
{{- end }}

{{- if and (hasKey .chezmoi "os") (eq .chezmoi.os "windows") }}

# 常駐サービスのポート。WSL と同じ番号だと 127.0.0.1 で衝突する
# see docs/spec/agent-config-generation.md#常駐サービスのポート
[opencode.service]
port = 4098
{{- end }}

# 既定モデルとエージェントごとの割り当て。PC ごとのプロバイダは
# .chezmoitemplates/llm-provider が決め、ほかのプロバイダは policies で塞ぐ。
# ★ID は実在を確認してから書く (公式のモデル一覧か TUI の /models)。
#   default には #variant を付けられない。
# see docs/spec/agent-config-generation.md#モデルの割り当て
[opencode.model]
provider = "{{ includeTemplate "llm-provider" . }}"

# エージェント ID = 階層名。組み込み (plan / explore など) も上書きできる。
# ★主エージェント (build / plan) は選んでもモデルが変わらない。子エージェントだけ書く。
[opencode.model.agents]
commit = "routine"
review = "second_opinion"
fleet-worker = "worker"
bypass-fleet-worker = "worker"

# 階層名は用途 (default / routine / worker / deep / second_opinion)。
# see docs/spec/agent-config-generation.md#階層
[opencode.model.tier.amazon-bedrock]
default = "global.anthropic.claude-sonnet-5-5"
routine = "global.anthropic.claude-sonnet-5-5#low"
worker = "global.anthropic.claude-sonnet-5-5#medium"
deep = "global.anthropic.claude-opus-5-5#high"
second_opinion = "global.openai.gpt-6-sol"

[opencode.model.tier.github-copilot]
default = "claude-opus-5.5"
routine = "claude-sonnet-5.5#medium"
worker = "claude-sonnet-5.5#medium"
deep = "claude-opus-5.5#xhigh"
second_opinion = "gpt-6-astra"

# ★[web] は OpenCode へ渡さない。webfetch の resource は「URL 全体」で、
#   `*` が `/` も跨ぐため `*://*.example.com/*` が
#   `https://evil.test/x.example.com/y` にも当たる。ドメイン許可を正しく
#   表現できないので、誤った allowlist を出すより出さない方を選んでいる。
# ★[claude] mcp_deny も渡さない。OpenCode のツール名は `<server>_<tool>` で
#   Claude の `mcp__<server>__<tool>` と別体系のため、機械変換すると
#   実在しない名前を deny したまま気付けなくなる。
# see docs/spec/agent-config-generation.md 「OpenCode へ渡さないもの」

# OpenCode のカスタムエージェント (V1 の「モード」に相当。トップレベルの mode は非推奨)。
# ★bypass = true は generate.py が読む印で opencode.json には出ない。印のあるエージェントは
#   通常と同じ permission のまま、guide-plugin が ask を allow にする (deny はそのまま効く)。
#   ここに "*" = "allow" を書かない (deny の後ろに付いて静的 deny を上書きする)。
# ★mode は消さない。消すと OpenCode の既定の mode になり、all / subagent ならモデルが bypass を起動できる。
# see docs/adr/0014-bypass-as-ask-upgrade.md
[opencode.agent.bypass]
description = "通常の確認 (ask) を無確認で通す。deny と誘導は通常どおり効く"
mode = "primary"
bypass = true
# 起動できる子の許可リスト。一覧に無い子 (承認制の general / fleet-worker、リポジトリや
# plugin が足す子) は確認で止まるので呼ばせない。子を足すときはここも見直す。
# see docs/spec/agent-config-generation.md#bypass-から呼べる子エージェント
permission = { task = { "*" = "deny", bypass-worker = "allow", bypass-fleet-worker = "allow", explore = "allow", review = "allow", commit = "allow" } }

# bypass からだけ呼べる子エージェント (task は V2 の subagent)。
# see docs/spec/agent-config-generation.md#bypass-から呼べる子エージェント
[opencode.agent.bypass-worker]
description = "bypass から起動する作業用の子エージェント。通常の確認 (ask) を無確認で通す"
mode = "subagent"
bypass = true
permission = { task = "deny" }

# 親が bypass のとき、作業ツリーの外を読む確認 (read / grep / glob) を plugin が allow にする子。
# bypass の task の allow の部分集合で、bypass = true のエージェントは書けない (generate.py が検査)。
# see docs/spec/agent-config-generation.md#bypass-から呼べる子エージェント
[opencode.bypass_children]
agents = ["explore", "review", "commit"]

# V2 形式のエージェント定義 (opencode.json の agents へ出す)。モデルは
# [opencode.model.agents] で階層を割り当てる (ここに model は書かない)。
# system は組み込みの基底プロンプトを置き換える。permissions は全体の規則の後ろに付く。
# see docs/spec/agent-config-generation.md#子エージェント
[opencode.agents.commit]
description = "変更を読み、論理単位ごとの対象ファイルとコミットメッセージ全文 (計画) を返す。ステージもコミットもしない。呼ぶ前に、docs/change/ があるリポジトリでは commit スキルの「コミット前の docs 反映」を親が済ませる。親は差分を読まずにこれへ任せる。返された計画の全文 (対象とメッセージ) を commit スキルの承認時の提示の形で返答に示し、利用者の承認を待って返答を終える (件名だけに縮めない。承認前にステージやコミットをしない)。承認されたら commit スキルの手順 3〜6 に従い、差分は読み直さずに単位ごとに git add -- <パス> と git commit -m '<件名>' -m '<本文>' を別々に実行する。shell は同じ応答に並べず、完了を待って 1 つずつ実行する (並べると .git/index.lock で失敗する)"
mode = "subagent"
system = """
あなたはコミットの計画係です。親から呼ばれ、変更を読んでコミットの計画を返します。
利用者への提示・ステージ・コミットは親が行います。

- 最初に skill ツールで commit スキルを読み込む。分け方・メッセージの書式は
  それに従い、手順 2 (メッセージ作成だけを依頼された場合) として扱う
- 単位はファイル単位で分ける。同じファイルの中を分ける必要があるときは、単位をまとめるか、
  分けられなかったことを書く
- 単位ごとに、対象のパス (git status --short の行) とメッセージの全文を、スキルの
  「承認時の提示」の形で返す。親はそれをそのまま利用者に示し、git commit -m '<件名>' -m '<本文>' に
  使うので、全文を省略せずに書く
- ファイルは read / glob / grep ツールで読む。shell で cat / ls / find / echo などを使わない
- shell は 1 回の応答で 1 つだけ呼び、完了結果を受け取ってから次を呼ぶ。1 回の呼び出しは
  1 コマンドとし、; や && でつなげず、リダイレクトや 2>&1 を付けない。作業ディレクトリは
  cd ではなく shell ツールの workdir で指定する
- 対象外のステージ済み変更や、部分ステージ (同じファイルの index と作業ツリーの両方に差分) が
  あれば、計画に添えて書く

ファイルは編集しない。git add / git commit などで状態を変えない。
"""
# ★読むだけ。shell は全体を deny してから読み取りの形だけ allow し、書き出しを deny する (後勝ち)。
# see docs/spec/agent-config-generation.md#コミットの確認
permissions = [
  { action = "edit", resource = "*", effect = "deny" },
  { action = "subagent", resource = "*", effect = "deny" },
  { action = "question", resource = "*", effect = "deny" },
  { action = "shell", resource = "*", effect = "deny" },
  { action = "shell", resource = "git status *", effect = "allow" },
  { action = "shell", resource = "git diff *", effect = "allow" },
  { action = "shell", resource = "git log *", effect = "allow" },
  { action = "shell", resource = "git branch --show-current", effect = "allow" },
  { action = "shell", resource = "git rev-parse --show-toplevel", effect = "allow" },
  { action = "shell", resource = "*>*", effect = "deny" },
  { action = "shell", resource = "*--output*", effect = "deny" },
]

# 相談役。読むだけ。★shell は開けない (git diff / git status も外部コマンドを実行しうる)。
# 差分は親が依頼文に含めて渡す。see docs/research/opencode/permission/allow-list-audit.md
[opencode.agents.review]
description = "別系統のモデルによる相談役。設計案・差分・調査結果を渡すと、欠陥・見落とし・代替案を率直に返す。ファイルは読むだけで、編集もコマンド実行もしない。差分や判断材料は依頼文に含めて渡す"
mode = "subagent"
system = """
あなたは相談役 (セカンドオピニオン) です。親エージェントとは別系統のモデルで、
親の判断を検証するために呼ばれます。同意するためではなく、誤りを見つけるためにいます。

- 渡された材料と、必要なら read / grep / glob で読んだコードだけを根拠にする。
  推測は推測と明示する
- 指摘は重大度の順 (BLOCKER / MAJOR / MINOR / NIT) に、ファイルと行を添えて書く
- 正しいと判断したことは短く「問題なし」と書き、理由を 1 行添える
- 親の前提そのものが疑わしいときは、それを最初に書く
- 代替案があれば、採る場合の代償と一緒に示す
- 材料が足りず判断できない点は、何があれば判断できるかを書く

ファイルは編集しない。コマンドも実行しない。
"""
permissions = [
  { action = "edit", resource = "*", effect = "deny" },
  { action = "shell", resource = "*", effect = "deny" },
  { action = "subagent", resource = "*", effect = "deny" },
  { action = "question", resource = "*", effect = "deny" },
]

# 組み込みの探索役。system は書かない (組み込みのプロンプトを使う)。全体の規則が組み込みの
# 拒否を上書きするので、拒否をここで並べ直す。see docs/spec/agent-config-generation.md#子エージェント
[opencode.agents.explore]
description = "Fast agent specialized for exploring codebases. Use this when you need to quickly find files by patterns (eg. \"src/components/**/*.tsx\"), search code for keywords (eg. \"API endpoints\"), or answer questions about the codebase (eg. \"how do API endpoints work?\"). When calling this agent, specify the desired thoroughness level: \"quick\" for basic searches, \"medium\" for moderate exploration, or \"very thorough\" for comprehensive analysis across multiple locations and naming conventions. 読み取り専用（read / glob / grep / webfetch / websearch）。Git の履歴やコマンドの実行が要る調査は親へ返す。"
mode = "subagent"
permissions = [
  { action = "edit", resource = "*", effect = "deny" },
  { action = "shell", resource = "*", effect = "deny" },
  { action = "subagent", resource = "*", effect = "deny" },
  { action = "question", resource = "*", effect = "deny" },
]

# 組み込みの計画役。system は書かない。★restate_global_deny は生成時だけのキーで、全体の
# edit / shell の deny をこの後ろへ写す (計画ファイルの allow で秘密の deny を緩めないため)。
# see docs/spec/agent-config-generation.md#子エージェント
[opencode.agents.plan]
description = "Read-only agent for exploring the codebase and planning work before implementation."
mode = "primary"
permissions = [
  { action = "edit", resource = "*", effect = "deny" },
  { action = "edit", resource = "~/.opencode/plan/*", effect = "allow" },
  { action = "subagent", resource = "*", effect = "deny" },
  { action = "subagent", resource = "explore", effect = "allow" },
  { action = "subagent", resource = "review", effect = "allow" },
  { action = "shell", resource = "*", effect = "ask" },
]
restate_global_deny = ["edit", "shell"]

# /fleet の作業役。編集とシェルは全体の規則のまま (承認制)。同じ作業ツリーを共有するので
# 担当ファイルは親が割り当てる。see docs/spec/agent-config-generation.md#並列作業fleet
[opencode.agents.fleet-worker]
description = "/fleet の作業役。親が割り当てた 1 つの作業を、指定された担当ファイルの範囲で実装し、確認して結果を返す。コミットはしない。/fleet 以外から直接使わない"
mode = "subagent"
system = """
あなたは並列作業の作業役です。取りまとめ役 (親エージェント) から 1 つの作業を渡され、
結果を親へ返します。ほかの作業役が同じ作業ツリーで同時に動いています。
ユーザーとは直接やり取りできません。

- 担当ファイルとして渡されたものだけを編集する。担当外の変更が必要だと分かったら、
  編集せずに理由と必要な変更を報告する
- 既存の関数や振る舞いを変えたら、grep で呼び出し元を探して読み、その変更で壊れる所や、
  直した誤りを前提にしている所 (誤りを打ち消す処理など) が無いか確かめる
- 確かめ用・比較用のファイルは作らない (試すなら python -c など)。どうしても要るときは
  作業ツリーの .tmp/ の下に作り、報告の前に消す。作業ツリーの外 ($TMPDIR や ../ も) へは書かない
- ファイルは read / glob / grep ツールで読み、edit / write ツールで書く。shell の cat / head /
  ls / ヒアドキュメント / リダイレクトで読み書きしない
- 完了条件と確認方法が渡されたら、それに従って確かめる。確認方法のコマンドは渡された形の
  まま単独で実行する (パイプや ; でつながない。作業ディレクトリは cd ではなく workdir で
  指定する)。確かめられなかったら、そう書く (推測で成功と書かない)
- git の操作 (add / commit / stash / checkout / reset など) はしない。
  作業ツリーはほかの作業役と共有している
- 次を返して終わる
  - 変更したファイルと、変更の要点
  - 実行した確認と、その結果
  - 呼び出し元への影響 (確かめた範囲と、見つけたもの)
  - 残った問題・判断が要る点・担当外で必要な変更
"""
permissions = [
  { action = "subagent", resource = "*", effect = "deny" },
  { action = "question", resource = "*", effect = "deny" },
  { action = "shell", resource = "git add *", effect = "deny" },
  { action = "shell", resource = "git commit *", effect = "deny" },
  { action = "shell", resource = "git stash *", effect = "deny" },
  { action = "shell", resource = "git checkout *", effect = "deny" },
  { action = "shell", resource = "git switch *", effect = "deny" },
  { action = "shell", resource = "git restore *", effect = "deny" },
  { action = "shell", resource = "git reset *", effect = "deny" },
]

# bypass の /fleet の作業役。指示と禁止は fleet-worker と同じで、ほかは通常の確認を無確認で通す。
# ★bypass = true が「bypass からだけ起動できる」印 (外すと build からも起動できる)。
# ★fleet-worker の deny を足したらここにも足す (テストが突き合わせる)。
# see docs/spec/agent-config-generation.md#bypass-から呼べる子エージェント
[opencode.agents.bypass-fleet-worker]
description = "bypass の /fleet の作業役。親が割り当てた 1 つの作業を、指定された担当ファイルの範囲で実装し、確認して結果を返す。通常の確認 (ask) を無確認で通す。コミットはしない。/fleet 以外から直接使わない"
mode = "subagent"
bypass = true
system_from = "fleet-worker"
permissions = [
  { action = "subagent", resource = "*", effect = "deny" },
  { action = "question", resource = "*", effect = "deny" },
  { action = "shell", resource = "git add *", effect = "deny" },
  { action = "shell", resource = "git commit *", effect = "deny" },
  { action = "shell", resource = "git stash *", effect = "deny" },
  { action = "shell", resource = "git checkout *", effect = "deny" },
  { action = "shell", resource = "git switch *", effect = "deny" },
  { action = "shell", resource = "git restore *", effect = "deny" },
  { action = "shell", resource = "git reset *", effect = "deny" },
]

# スラッシュコマンド (opencode.json の commands へ出す)。template の `$ARGUMENTS` は
# 引数に置き換わる。★「!」+ バッククォートはシェルとして権限の確認なしに実行されるので書かない。
[opencode.commands.fleet]
description = "依頼を並列に動かせる作業に分け、作業役 (fleet-worker / bypass-fleet-worker) を同時に起動して進める"
subagent = false
template = """
次の依頼を、並列に動かせる小さな作業に分けて進めてください。あなたは取りまとめ役です。

依頼:
$ARGUMENTS

手順:

1. 必要なら先にコードを読み、依頼を作業に分ける。各作業について、目的・担当ファイル・
   完了条件・確認方法を決める。担当ファイルは作業どうしで重ねない
2. 作業の依存関係を決め、同時に動かせる組 (波) に分ける。1 つの波は 4 件まで。
   分ける価値が無い小さな依頼なら、分けずに自分で進める
3. 作業の一覧・波・担当ファイルを示してから始める
4. 波ごとに、各作業を 1 回の応答の中で subagent ツールを並べて作業役に渡す
   (並べて呼んだ子は同時に走り、全部が終わると結果がそろって返る)。
   作業役は、subagent ツールに bypass-fleet-worker が載っていればそれ、無ければ
   fleet-worker を使う (呼べるのはどちらか一方だけ)。
   どちらも載っていないとき (plan など) は、調査だけの依頼なら explore と review に
   分担し、実装を含む依頼なら計画を示すところで止めて、作業役を呼べるエージェントへの
   切り替えを利用者に頼む。拒否された作業を自分の shell で肩代わりしない。
   今あるファイルの探索は explore、Git の履歴やコマンドの実行が要る調査は作業役、
   第三者の検証は review に任せてよい。
   依頼文には、目的・担当ファイル・触ってはいけないファイル・完了条件・確認方法を
   すべて書く (子エージェントはこの会話を見られない)
5. 結果を読み、失敗・担当外の変更・報告された問題 (呼び出し元への影響を含む) があれば、
   直すか作業を切り直してから次の波へ進む
6. 最後に全体の差分を読み、リポジトリで定められた検証を実行し、作業ごとの結果・
   検証の結果・残った問題をまとめて報告する。コミットはしない
"""

# 誘導。pattern に一致したら deny して message を返す。
# pattern は JavaScript の正規表現で、生のコマンド全体に当てる
# (scanner は変数代入を落とすため e.resources は使わない)。
# unless は任意の除外条件。pattern に当たっても unless に当たれば見送る。
# ★deny にすること。ask では自動実行で素通りする。
# see docs/change/closed/0002-opencode-ask-by-default.md 「段階 2」
[[opencode.shell.guide]]
pattern = '(^|&&|\|\||;|\n)\s*cd\s'
message = "cd は使わないでください。shell ツールの workdir 引数でディレクトリを指定できます。"

# 読み取りを read ツールへ寄せる誘導の本体は [[pi.guide]]。ここは並びの位置だけを決める。
[[opencode.shell.guide]]
pi = "read-cat-head-tail"

[[opencode.shell.guide]]
pi = "read-sed-n"

# allow に載っているコマンドの「書き込み形」を塞ぐ (CHG-0002 段階 4a の副産物)。
# ★allow は **前方一致**で、リダイレクトは resource に残る。つまり
#   `git log` が allow に載っている時点で `git log > ~/.bashrc` が
#   **無確認で通る**。これは 4a を検討する過程で見つけた**既存の穴**。
# ★guide 規則は effect が allow でも走る (plugin は deny のときだけ手前で
#   抜ける)。so allow を維持したまま、書き込み形だけここで deny できる。
# ★fd の付け替え (2>&1 / >&-) と /dev/null は書き込みではないので、> ごとに先読みで外す。
#   unless で外すとコマンド全体に当たり、`wc f 2>&1 > ~/.bashrc` が素通りする。
# ★対象は [pi.shell] allow と揃えること。allow を増やすならここも足し、
#   引数でファイルへ書けるオプション (git log の --output など) も点検して下のように塞ぐ。
# see docs/change/closed/0002-opencode-ask-by-default.md 「段階 4a」
# see docs/spec/agent-command-policy.md#opencode-の-allow-したコマンドの書き込み形
[[opencode.shell.guide]]
pattern = '(^|&&|\|\||;|\n)\s*(wc|grep\s+-n|git\s+log|uv\s+pip\s+list|docker\s+ps)\b[^\n]*>(?!&\s*(\d+|-)(?=$|[\s;|&)])|>?\s*/dev/null(?=$|[\s;|&)]))'
message = "allow されたコマンドの出力をリダイレクトで書き込まないでください。ファイルを作る・書き換えるときは write / edit ツールを使ってください。"

# allow の `git log *` に当たる `git log --output=<パス>` を止める (CHG-0017 段 5)。
# ★当てるのは git log で始まる部分 (次の区切りまで) だけ。引用の中は飛ばす。
# see docs/spec/agent-command-policy.md#opencode-の-allow-したコマンドの書き込み形
[[opencode.shell.guide]]
pattern = '''(^|[;&|\n(`{])\s*git[ \t]+log(?=[ \t]|\\\n)(?:[^;&|\n'"\\]|\\[\s\S]|'[^']*'|"(?:[^"\\]|\\[\s\S])*")*?(?:[ \t]|\\\n)['"]?--output['"]?(=|[ \t])'''
message = "git log の --output でファイルへ書き込まないでください。ファイルを作るときは write ツールを使ってください。"

# git commit の前にオプションを置いた形 (`git -c core.hooksPath=/dev/null commit`) を止める。
# ★隔離起動はシェルの既定が allow なので、`git commit *` の ask に当たらない形は確認も hook も
#   無しで通る。コミットは親が自分で行うので、全体の規則で塞ぐ。
# see docs/spec/agent-config-generation.md#コミットの確認
[[opencode.shell.guide]]
pattern = '(^|&&|\|\||;|\n)\s*git(\s+-\S+(\s+[^-\s]\S*)?)+\s+commit(\s|$)'
message = "git commit の前にオプションを置かないでください。`git commit -m '<件名>' -m '<本文>'` の形で実行してください (確認と hook を通すため)。"

# ヒアドキュメントを write ツールへ寄せる誘導の本体は [[pi.guide]]。ここは並びの位置だけを決める。
[[opencode.shell.guide]]
pi = "write-cat-tee-heredoc"

[[opencode.shell.guide]]
pi = "write-heredoc-script"

# pip を uv へ誘導する (CHG-0011 2b)。pip / pip3 は共通 deny が先に止めるが、early = true で
# plugin の execute.before が先に止めて message を返す。
# ★ocs でも効く (drop_shell は permission のフィルタで guide は対象外)。
# ★`uv pip ...` は行頭が uv なので当たらない。poetry / pipenv は止めない。
# see docs/spec/agent-command-policy.md#opencode-の-pip-誘導と-rm-の誘導
# see docs/research/opencode/permission/early-guard.md
[[opencode.shell.guide]]
pattern = '''(^|[;&|\n])[ \t]*((uv[ \t]+run|mise[ \t]+exec[ \t]+--)[ \t]+)?(pip3?(\.\d+)?|python[0-9.]*[ \t]+-m[ \t]*pip3?(\.\d+)?)([ \t]|$)'''
unless = '''^\s*(git|gh)\s(?=[^\n]*\s-{1,2}(m|am|message|body|title)[\s=])(?:[^;&|\n'"`$()<>\\]|\\[^\n]|'[^']*'|"(?:[^"\\`$]|\\.|\$\(cat <<-?'(\w+)'\n[\s\S]*?\n\3\n\s*\))*")*$'''
early = true
message = "pip は使わないでください。依存の追加は `uv add <pkg>` (pyproject.toml と uv.lock を更新)、環境への導入は `uv pip install <pkg>` か `uv sync`、単発の CLI は `uvx <tool>` を使ってください。"

# 危険な rm / find の「うっかり防止」。止める具体例だけを正規表現で限る。完全な保護ではない。
# ★ocs の中でも効く (ADR-0012 の部分変更)。通常の掃除 (.tmp/ や build の削除) は止めない。
# ★prose (git commit -m の本文) は上の pip と同じ unless で外す。unless はコマンドが
#   git / gh の 1 コマンドだけのときに限る (連結・置換を含めると見送らない)。
# see docs/spec/agent-command-policy.md#opencode-の-pip-誘導と-rm-の誘導
[[opencode.shell.guide]]
pattern = '''(^|[;&|\n])[ \t]*rm[ \t]+([^\s;&|]+[ \t]+)*["']?(\./)?([^\s;&|"']*/)?\.git(/[^\s;&|"']*)?["']?(?=[\s;&|]|$)'''
unless = '''^\s*(git|gh)\s(?=[^\n]*\s-{1,2}(m|am|message|body|title)[\s=])(?:[^;&|\n'"`$()<>\\]|\\[^\n]|'[^']*'|"(?:[^"\\`$]|\\.|\$\(cat <<-?'(\w+)'\n[\s\S]*?\n\3\n\s*\))*")*$'''
message = ".git (リポジトリの履歴) を rm で直接消さないでください。履歴の整理は git のコマンドで行い、消す必要があるときは利用者に依頼してください。"

[[opencode.shell.guide]]
pattern = '''(^|[;&|\n])[ \t]*rm[ \t]+([^\s;&|]+[ \t]+)*["']?((~|\$HOME|\$\{HOME\})/?\*?|/\*?)["']?(?=[\s;&|]|$)'''
unless = '''^\s*(git|gh)\s(?=[^\n]*\s-{1,2}(m|am|message|body|title)[\s=])(?:[^;&|\n'"`$()<>\\]|\\[^\n]|'[^']*'|"(?:[^"\\`$]|\\.|\$\(cat <<-?'(\w+)'\n[\s\S]*?\n\3\n\s*\))*")*$'''
message = "~ / $HOME / / を rm の対象にしないでください。消すものを具体的なパスで指定してください。"

[[opencode.shell.guide]]
pattern = '''(^|[;&|\n])[ \t]*rm[ \t]+([^\s;&|]+[ \t]+)*(-[a-zA-Z]*[rR][a-zA-Z]*|--recursive)[ \t]+([^\s;&|]+[ \t]+)*["']?(\.{1,2}/?|\./\*|\*|\.\*)["']?(?=[\s;&|]|$)'''
unless = '''^\s*(git|gh)\s(?=[^\n]*\s-{1,2}(m|am|message|body|title)[\s=])(?:[^;&|\n'"`$()<>\\]|\\[^\n]|'[^']*'|"(?:[^"\\`$]|\\.|\$\(cat <<-?'(\w+)'\n[\s\S]*?\n\3\n\s*\))*")*$'''
message = "作業ディレクトリ全体 (. / .. / *) を再帰的に消さないでください。消すものを具体的なパスで指定してください (例: rm -rf .tmp/foo)。"

[[opencode.shell.guide]]
pattern = '''(^|[;&|\n])[ \t]*find[ \t]+(-[HLP][ \t]+)*["']?(/|~/?|\$HOME/?|\$\{HOME\}/?|(\./)?\.git(/[^\s;&|"']*)?)["']?(?=[ \t])[^\n;&|]*[ \t](-delete|-exec(dir)?[ \t]+rm)\b'''
unless = '''^\s*(git|gh)\s(?=[^\n]*\s-{1,2}(m|am|message|body|title)[\s=])(?:[^;&|\n'"`$()<>\\]|\\[^\n]|'[^']*'|"(?:[^"\\`$]|\\.|\$\(cat <<-?'(\w+)'\n[\s\S]*?\n\3\n\s*\))*")*$'''
message = "/ ~ .git を起点にした find の -delete / -exec rm はしないでください。起点を消す範囲の具体的なディレクトリに絞ってください。"

# OpenCode を丸ごと OS のアクセス制御で囲う (隔離起動 ocs)。
# ランチャーが Fence で境界を張ってから opencode --standalone を起動する。
# ★generate.py は Fence の有無に関係なく設定を出力する。実体が無いマシンでは
#   ランチャーが起動を断る。
# see docs/spec/opencode-sandbox.md
[opencode.sandbox]
enabled = true
# Fence の実体。版は mise/config.toml.tmpl が固定する。
runtime_path = "~/.local/share/mise/installs/github-fencesandbox-fence/latest/fence"

# 読み取りは既定で拒否し、ここ (と work_read) に並べた所だけ開ける。
# 無いパスは起動時に落とす。
# see docs/spec/opencode-sandbox.md#境界の中身
read = [
  "~/.opencode",
  "~/.local/share/mise",
  "~/.local/bin",
  # ~/.config/opencode は丸ごと開けない (service.json がある)
  "~/.config/opencode/guide-plugin",
  "~/.config/opencode/checkpoint-plugin",
  "~/.config/opencode/skills",
  "~/.config/opencode-sandbox",
  "~/.config/shell",
  "~/.config/mise",
  "~/.config/chezmoi",
  # git の利用者名とメール (worktree で commit するため)
  "~/.gitconfig",
  "~/.config/git",
  "~/.claude/skills",
  "~/.agents/skills",
]

# 作業用の親ディレクトリ。秘密を置かない場所だけを書く (中に紛れた秘密は読める)。
work_read = [
  "~/src",
  "~/worktrees",
  "~/papers",
  "~/.local/share/chezmoi",
]

# 起動ディレクトリ・worktree の共有 .git・XDG_DATA_HOME/opencode はランチャーが足す。
write = [
  "~/.cache",
]

# 開けた場所の内側にある秘密を隠す。[sandbox] deny のうち glob でないものも足される。
# ホーム配下は、開けた場所の内側にあるときだけ Fence へ渡す。
deny_read = [
  # 常駐サービスや agent のソケット (Fence は /run を既定で読める)
  "/run/user",
]

# ここ、またはその祖先では起動しない (起動ディレクトリは書き込みが許されるため)。
unsafe_workspace = [
  "~",
  "/mnt",
  "/tmp",
  "/var/tmp",
  "/dev/shm",
]

# 配備済みの制御ファイルの置き場。そのもの・祖先・子孫のどこでも起動せず、
# .opencode/sandbox.toml の write とも重ねさせない。ここの編集は ocs の外で行う。
# see docs/spec/opencode-sandbox.md#起動ディレクトリの制限
control_dirs = [
  "~/.local/share/ocs",
  "~/.local/bin",
  "~/.config/opencode",
  "~/.config/opencode-sandbox",
  "~/.config/agents",
  "~/.local/state/opencode-sandbox",
]

# 隔離版の設定ディレクトリ。★ワークスペースの外に置く。
# 内側からは allowRead のみ (= 書けない) になり、緩和設定を自分で広げられない。
# ランチャーが起動のたびに生成し直す。
config_dir = "~/.config/opencode-sandbox"

# 境界内から出てよいドメインの追加分 (OpenCode の境界だけに効く)。
# [web] allow_domains と [sandbox] shell_network_allow に足す形で使う。
# ★ここには **ハーネス自身のサービス**だけを書く。モデル API の接続先は
#   [provider.*] に置き、下の providers で参照する (プロバイダを替えても
#   ここを触らずに済む)。
# ★wildcard は **先頭の `*.` と 単独の `*` だけ**効く。
network_allow = [
  # OpenCode 本体のサービス (更新確認・カタログ)
  "opencode.ai",
  "*.opencode.ai",
]

# 使うモデル API のプロバイダ。[provider.*] の network_allow を合算する。
# ★入れ忘れると境界内からモデルへ到達できない。proxy が CONNECT を 403 で
#   落とすだけなので、症状は「応答が来ない」になる。
providers = ["github-copilot", "anthropic", "openai"]

# 隔離版の permission を、通常版の宣言から導出するための指定。
# ★通常版 (~/.config/opencode) は 225 件のまま。ここは隔離版だけに効く。
#
# 判定の基準 (外部レビューの区分):
#   OS   境界が到達させない。permission が無くても守られる → 捨てる
#   ツール read/edit は止まるが **shell からは届く** → 残す (誤操作の抑止)
#   運用  事故防止。強制ではない → 残す
#
# ★「残したから守られている」と読んではいけない。permission は任意コードへの
#   境界ではない。ワークスペース内の秘密と .git/hooks は shell から届く。
# see docs/change/closed/0004-opencode-sandbox.md 「段階 3」
# 境界を定義するもの。起動ディレクトリとリポジトリの根からの相対で書く。
# ★「次回の隔離起動時に、実行コード・境界設定・緩和設定の選択を決定する
#   入力一式」を信頼の鎖から導出する。ファイル名の列挙では足りない。
#   保護対象を、変更できる生成器から次回上書きできるなら保護は迂回されている。
# 変更するときは境界の外 (ランチャーを使わない) で行う。
protected = [
  "home/dot_config/agents",
  "home/dot_config/opencode/guide-plugin",
  "home/dot_local/bin",
  # ocs の本体。~/.local/bin/ocs が絶対パスで読み込む
  "home/dot_local/share/ocs",
  "scripts/agents",
  "home/dot_config/mise",
  # ★.opencode/plugins は置かれると**自動ロードされる**。Fence の denyWrite は
  #   無いパスに効かないので、ランチャーが空のディレクトリを先に作る。
  # see docs/spec/opencode-sandbox.md#保護対象denywrite
  ".opencode",
]

# 境界の存在と範囲をエージェントへ伝える。
# ★説明上の対策であって、書き込み失敗を保証するものではない。
#   実測で `ls ~/.ssh` の ENOENT を見て「存在しないので作れます」と誤診した。
#   実行していれば鍵は消える領域へ書かれていた。
# see docs/research/opencode/permission/sandbox-runtime.md 「20. 境界は見えない」
system_prompt = """
この環境は OS のアクセス制御で囲われています。次を前提に判断してください。

1. ホスト HOME の大部分は隠されています。`ENOENT`（存在しない）は
   ホスト上の不存在を意味しません。隠されているだけのことがあります。
2. 成果の永続化先は、この作業ディレクトリです。他の永続化先や
   読み取り専用の例外は、明示されたものに限られます。
3. 一時領域への書き込みは、ホストの同名パスへの反映を意味しません。
   隔離の終了時に破棄されます。
4. 鍵の生成・認証設定・ホストへの展開（`chezmoi apply` など）は、
   境界の外で行う操作です。ここでは行わず、必要なら利用者へ依頼してください。
5. 内側の観測だけで「ホストへ反映できた」と報告しないでください。
6. 拒否されたアクセスを、別パス・symlink・別ツールで回避しないでください。
   回避せず、拒否された事実を報告してください。
7. ホストで実行されるコード（`.chezmoiscripts/`・mise タスク・シェル起動設定・
   Git hooks・ランチャー）を変更したときは、対象と**実行される契機**を
   報告してください。
"""

# --- ここから下はサブテーブル。★ベアキーを後ろに足さないこと ---
#     足すとこのサブテーブルに属してしまい、[opencode.sandbox] から消える。

[opencode.sandbox.permissions]
# 既定を ask から allow へ反転する。境界内なので列挙をやめる。
# ★ワークスペースの破壊は止まらない。snapshot による復旧で扱う (保証ではない)。
default_shell_effect = "allow"

# 境界内から到達できないので捨てる shell 規則 (先頭一致の正規表現)。
drop_shell = [
  # 特権・デバイス・サービス管理
  '^(sudo|systemctl|systemd-run|service|crontab|at|batch)\b',
  '^(mkfs[.a-z0-9]*|mount|umount|fdisk|parted|wipefs|dd)\b',
  # 境界外の設定
  '^git config --(global|system)',
  # グローバル領域への導入 (境界内では消えるだけ)
  '^(npm install -g|pipx install|uv tool (install|uninstall|upgrade))',
  '^(uv python (install|uninstall)|rustup self|uv self|pip3? )',
  '^(npm cache clean|yarn cache clean|pnpm store prune)',
  '^docker (container|image|network|system|volume) prune',
  '^cmake --install',
  # 既定が allow になるので個別の allow は不要
  '^(git log|wc|grep -n|uv pip list|docker ps)\b',
  # ★確認をやめ snapshot による復旧で扱う
  '^(rm|mv|cp|truncate|shred|find)\b',
  # ★git commit は捨てない (会話での承認に加えて実行時の確認を残す)
  # see docs/spec/agent-config-generation.md#コミットの確認
]

# 境界が隠すので捨てる read/edit 規則 (パスの先頭一致)。
# ★ワークスペース相対の glob (*secret* など) は **捨てない**。
#   境界の外の話ではなく、shell から届く。
# ★[pi.external_read] で開けた場所への edit の ask は捨てない。
drop_path_prefixes = [
  "~/",
  "$HOME/",
  "/home/",
  "/root/",
  "/etc/",
  "/var/",
  "/usr/",
]

# 隔離版の既定モデル。**上から順**に、資格情報がある provider を選ぶ。
# ★初回だけ置く。以降は TUI で選んだ値を尊重する (ランチャーは上書きしない)。
# ★provider ID とモデル ID は実在を確認してから書く。無いものを書くと
#   起動しても応答が来ない。確認方法は公式のモデル一覧。
[[opencode.sandbox.model_preference]]
provider = "github-copilot"
model = "claude-opus-5"

# プロジェクト個別の追加許可はここに書かず、<起動ディレクトリ>/.opencode/sandbox.toml に書く。
# see docs/spec/opencode-sandbox.md#プロジェクトごとの追加

[opencode.sandbox.policies]
# グローバル設定に置くとプロジェクト設定から解除できない。
# ★任意コードへの境界ではない。permission 検査を通る操作にしか効かず、
#   plugin のコードを sandbox しない。不正な statement は警告付きで破棄される
#   ので、置いた事実ではなく**有効性**を確認する。
# ★hard-deny には承認による例外が無い。通常業務で承認付き利用を想定する操作は
#   ここへ置かない。
deny = [
  "shell:git push *",
  "shell:gh repo delete *",
  "shell:chezmoi apply *",
  "shell:chezmoi re-add *",
]

# ID・既定値・キー記法は公式一覧が正本。
# ★公式一覧は最新版向け。未知の ID は **黙って無視される** (「拒否する」と
#   書かれているが 2.0.12 の実測では他の行だけ生きる)。足す前に実在を確認する:
#     strings -n 4 ~/.opencode/bin/opencode | grep -x '<id>'
# 無効化は false か "none"。<leader> は既定 ctrl+x。
# see docs/spec/agent-config-generation.md 「キーバインド」
[opencode.keybinds]
# ★app.exit の既定は "ctrl+c,ctrl+d,<leader>q"。ctrl+c を外さずに
#   session.interrupt へ渡すと Ctrl+C でアプリごと終了する。
"app.exit" = "ctrl+d"
"session.interrupt" = "ctrl+c,escape"
"service.restart" = "<leader>v"

# 確認画面に出すコマンドの説明。長いワンライナーは目視で追えないので、
# 安価なモデルに 1 行で要約させる。
# ★権限ダイアログ自体には出せない (message も metadata も描画されない)。
#   表示は TUI plugin の toast 経由になる。
# ★説明は判断の補助であって判定器ではない。偽装は原理的に防げない。
# see docs/change/0003-ask-command-description.md
[opencode.ask_description]
enabled = true
# これ未満の長さのコマンドは説明しない (短いものは読めば分かる)
min_command_length = 60
duration_ms = 20000
timeout_ms = 5000
# 上から順に試し、使えたものを採用する。一覧に載っていても利用可能とは
# 限らないので、失敗したら次へ倒す。
# ★Bedrock 優先。provider 未設定なら一覧に無いので即座に次へ落ちる (実測)。
# ★us-east-1 前提。新しい Anthropic モデルは推論プロファイル (us. 接頭辞) が
#   要ることが多いので、素の ID も次に並べて取りこぼさないようにする。
# ★同一系統の中では実測の遅延順。安さより速さを優先する
#   (確認が出るまでの待ち時間になる)。
# see docs/research/opencode/plugin/ask-description.md 「モデルの比較」
models = [
  "amazon-bedrock/us.anthropic.claude-haiku-5-5",
  "amazon-bedrock/anthropic.claude-haiku-5-5",
  "github-copilot/claude-haiku-4.5",
  "github-copilot/gpt-5.4-mini",
]

# git commit はモデルを呼ばず、コマンドから抜き出した件名と本文を出す。
# line_width は本文 1 行の桁数の上限 (全角は 2 桁。端末が狭ければ縮める)、max_lines は行数の上限。
# see docs/spec/agent-config-generation.md#git-commit-の件名と本文
[opencode.ask_description.commit]
enabled = true
line_width = 72
max_lines = 8

# 編集後の整形。Claude / Copilot では PostToolUse hook (format-file.sh /
# markdownlint.sh) がやっていることを、OpenCode では組み込み機能が担う。
#
# ★このテーブルを書くと **組み込み formatter も全部有効になる**
#   (公式: "An object also enables the built-ins")。ruff / clang-format /
#   prettier / shfmt は組み込みにあるので、ここへ書くのは
#   **組み込みに無いものだけ**。
# ★command は argv 配列で、シェルは通らない。`$FILE` が絶対パスに置換される。
# ★組み込みに無い名前は command と extensions の両方が要る
#   (片方だけだと OpenCode が黙って無視する)。generate.py が検査して止める。
# see docs/spec/agent-config-generation.md 「整形 (formatter)」

# markdownlint-cli2 は組み込みに無い。mise の "npm:markdownlint-cli2" が
# PATH へ shim を置くので素の名前で呼べる。未導入のマシンでは OpenCode が
# 失敗をログに残して次の formatter へ進むだけで、編集自体は通る。
[opencode.formatter.markdownlint]
command = ["markdownlint-cli2", "--fix", "$FILE"]
extensions = [".md", ".markdown"]

# ---------------------------------------------------------------------------
# MCP サーバ (Claude Code / Copilot CLI / Codex CLI / OpenCode 共通の単一ソース)
# ---------------------------------------------------------------------------
# フィールド:
#   id         サーバ名 (英数字・ハイフン・アンダースコアのみ)
#   purpose    用途 (生成物には出ない。レビュー用)
#   transport  "http" (url) か "stdio" (command / args)
#
# ★トークンをここに書かない。headers に秘密が要るサーバは環境変数参照として
#   各 CLI 側で設定する (ADR-0005)。
# see docs/spec/agent-config-generation.md 「MCP サーバ」
# ★deepwiki は索引が古く、実ソースと食い違う説明を返すため 2026-09-25 に外した。
{{- if eq (includeTemplate "llm-provider" .) "amazon-bedrock" }}

# Bedrock では Claude Code 内蔵の WebSearch が使えないので AgentCore Web Search で補う。
# Gateway の URL は環境変数 AGENTCORE_GATEWAY_URL から読む (ラッパーが渡す)。
# see docs/spec/agent-config-generation.md#agentcore-web-search
[[mcp]]
id = "agentcore-websearch"
purpose = "Bedrock AgentCore Web Search で web 検索する"
clis = ["claude", "opencode", "pi"]
transport = "stdio"
command = "uv"
args = [
  "run", "--no-project", "--quiet",
  '{{ .chezmoi.homeDir }}/.config/agents/agentcore_websearch_mcp.py',
  "--service", "bedrock-agentcore", "--region", "us-east-1", "--disable-telemetry",
]
{{- end }}

# ---------------------------------------------------------------------------
# Hooks (Claude Code / Copilot CLI 共通の単一ソース)
# ---------------------------------------------------------------------------
# フィールド:
#   id            識別子 (生成物には出ない。テスト・レビュー用)
#   script        ~/.claude/hooks/ 配下のファイル名 (両 CLI が同じ実体を共有)
#   runner        "python3" / "bash" (素の Ubuntu に `python` は無い)
#   purpose       用途メモ
#   *_event       hook イベント名。空文字にするとその CLI には出力しない
#   *_matcher     省略すると matcher キー自体を出力しない (= 全ツール)
#   timeout_sec   Claude の timeout / Copilot の timeoutSec へ反映
#
# ★matcher は両 CLI で意味論が違うので共通化しない。
#   Claude: tool 名の完全一致を `|` で OR 連結 (PascalCase のみ)
#   Copilot: `^(?:pattern)$` として anchored。PascalCase も照合されるため両方書く
# ★イベントは PreToolUse を使い permissionRequest は使わない
#   (後者は後勝ちマージで、リポジトリ側の hook に決定を奪われる)。
# see docs/spec/agent-permissions.md 「hook」

[[hooks]]
id = "check_bash"
script = "check_bash.py"
runner = "python3"
purpose = "[bash] deny を両 CLI で、ask を Claude で強制する (permission リストの補完)"
claude_event = "PreToolUse"
claude_matcher = "Bash"
copilot_event = "PreToolUse"
copilot_matcher = "^(Bash|bash|powershell)$"
timeout_sec = 30

[[hooks]]
id = "redirect-tmp"
script = "redirect-tmp.py"
runner = "python3"
purpose = "/tmp への書き込みを検出して ./.tmp へ誘導する (読み取り専用操作は許可)"
# スクリプトが処理する kind は bash / create / edit の 3 つだけなので matcher
# もそれに合わせる (無駄な hook 起動を避ける)。view (Read) は常に許可なので
# hook を呼ぶ必要が無く、matcher から除外している。
claude_matcher = "Bash|Write|Edit"
claude_event = "PreToolUse"
copilot_event = "PreToolUse"
copilot_matcher = "^(Bash|bash|powershell|Write|create|Edit|edit)$"
timeout_sec = 30

[[hooks]]
id = "check_file_read"
script = "check_file_read.py"
runner = "python3"
purpose = "[file] read_deny_globs を Copilot のファイル読み取りにも適用する"
# ★Copilot 専用 (claude_event を書かない)。
#   Claude は同じリストから Read() の deny permission を生成済みで、CLI 本体が
#   評価するため hook は要らない。付けると全ファイル読み取りに Python の
#   プロセス起動 (数十 ms) が乗るだけで、防御は増えない。
#   一方 Copilot は permissions-config.json にファイル規則が無く、sandbox の
#   deniedPaths も絶対パス限定・ワイルドカード非対応で cwd は自動許可される。
#   つまりリポジトリ内の秘密ファイルを止める手段が hook しかない。
#   詳細は docs/adr/0007-filesystem-guard-boundary.md
copilot_event = "PreToolUse"
copilot_matcher = "^(Read|view)$"
timeout_sec = 30

[[hooks]]
id = "markdownlint"
script = "markdownlint.sh"
runner = "bash"
purpose = "Markdown 編集後に markdownlint --fix と残存違反の警告"
claude_event = "PostToolUse"
claude_matcher = "Edit|Write"
copilot_event = "PostToolUse"
copilot_matcher = "^(Edit|Write|edit|create)$"
timeout_sec = 30

[[hooks]]
id = "format-file"
script = "format-file.sh"
runner = "bash"
purpose = "編集したファイルを拡張子に応じて整形 (ruff / clang-format / prettier)"
claude_event = "PostToolUse"
claude_matcher = "Edit|Write"
copilot_event = "PostToolUse"
copilot_matcher = "^(Edit|Write|edit|create)$"
timeout_sec = 30

# 撤去した hook のスクリプト名。hook を撤去したらここへ足すこと
# (足し忘れると settings.json の古い登録が外部の hook として残る)。
# see docs/spec/agent-config-generation.md#外部ツールとの共存-orca--herdr
[retired_hooks]
scripts = [
    "block-dangerous-commands.sh",
    "update-adr-on-stop.py",
    "checkpoint_precompact.py",
    "checkpoint_restore.py",
    "checkpoint_restore_pending.py",
]
