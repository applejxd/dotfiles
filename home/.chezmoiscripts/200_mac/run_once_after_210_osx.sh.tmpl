#!/bin/bash

set -euo pipefail

{{ template "sudo-keepalive.sh.tmpl" . }}
start_sudo_keepalive

# 失敗を警告に留めて続けると run_once_ は成功と記録するので、終わりに印を書き直して次の apply で走り直させる
# see docs/spec/troubleshooting-bootstrap.md#スクリプトを走らせ直す
{{ template "retry-marker.sh.tmpl" (dict "homeDir" .chezmoi.homeDir "name" "osx-failed") }}
failed_steps=""

echo "Starting macOS system setup..." >&2

# Rosetta 2 (Apple Silicon だけ。oahd が動いていれば導入済み)。
# 失敗しても Homebrew や arm64 ネイティブのアプリは動くので、警告して続ける
if [[ $(uname -m) == arm64 ]] && ! /usr/bin/pgrep -q oahd; then
    if ! sudo softwareupdate --install-rosetta --agree-to-license; then
        echo "⚠️ Rosetta 2 を導入できませんでした。Rosetta が要るアプリは後で失敗します" >&2
        failed_steps="${failed_steps} rosetta"
    fi
fi

#---------------#
# Load Homebrew #
#---------------#

brew_path=""
if [[ $(uname -m) == arm64 ]]; then
    brew_path="/opt/homebrew/bin/brew"
elif [[ $(uname -m) == x86_64 ]]; then
    brew_path="/usr/local/bin/brew"
fi
eval "$($brew_path shellenv)"
brew update

#-------------#
# Brew bundle #
#-------------#

if [[ $(uname -m) == arm64 ]]; then
    # GUI apps
    brew bundle --file={{ joinPath .chezmoi.workingTree "scripts" "osx" "brew_mas_cask.rb" | quote }}

    # sudo が要る GUI アプリ (認証は冒頭の start_sudo_keepalive で取得済み)。失敗しても残り (gcc・mactex) を続ける
    if ! brew install avast-security; then
        echo "⚠️ brew install avast-security に失敗しました。次の apply でやり直します" >&2
        failed_steps="${failed_steps} avast-security"
    fi
    # Needs Rosetta2 (Rosetta を導入できなかったときに備え、失敗しても残りを続ける)
    for cask in google-japanese-ime karabiner-elements xquartz qlvideo; do
        if ! brew install "$cask"; then
            echo "⚠️ brew install $cask に失敗しました。次の apply でやり直します" >&2
            failed_steps="${failed_steps} ${cask}"
        fi
    done
fi

#--------#
# Others #
#--------#

# iTerm2 Shell integration
if [ ! -e ~/.iterm2_shell_integration.zsh ]; then
    curl -L https://iterm2.com/shell_integration/install_shell_integration.sh | bash
fi

# For bits/stdc++.h
brew_bin=$(dirname "$brew_path")
if [[ $(command -v gcc) != "$brew_bin/gcc" ]]; then
    brew install gcc
    # 末尾の版数を数値で比べて最大を選ぶ (sort -V は macOS で保証が無い)。無ければ何も出さない
    latest_versioned() {
        local prefix=$1 best="" best_n=-1 f n
        for f in "$brew_bin"/"$prefix"-[0-9]*; do
            [[ -e $f ]] || continue
            n=${f##*-}
            [[ $n =~ ^[0-9]+$ ]] || continue
            if ((n > best_n)); then
                best=$f
                best_n=$n
            fi
        done
        printf '%s' "$best"
    }
    gcc_path=$(latest_versioned gcc)
    gpp_path=$(latest_versioned g++)

    if [[ -n $gcc_path && -n $gpp_path && ${gcc_path##*-} == "${gpp_path##*-}" ]]; then
        ln -fs "$gcc_path" "$brew_bin/gcc"
        ln -fs "$gpp_path" "$brew_bin/g++"
    else
        echo "⚠️ $brew_bin に版数の揃った gcc-N / g++-N が見つからないため、リンク作成をスキップします" >&2
    fi
fi

# For LaTeX
# see https://texwiki.texjp.org/?TeX%20Live%2FMac
if [[ ! -e /usr/local/texlive ]]; then
    brew install mactex
    eval "$(/usr/libexec/path_helper)"
    sudo tlmgr update --self --all
    sudo tlmgr paper a4
fi

if [[ -n "${failed_steps# }" ]]; then
    # 非ゼロで終えると apply 全体が止まるので、警告に留めて印を書き直す (次の apply で走り直る)
    echo "⚠️ 失敗した手順:${failed_steps}。次の chezmoi apply で走り直します" >&2
    mark_for_retry "${failed_steps# }"
fi
